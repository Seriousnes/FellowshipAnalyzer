@namespace FellowshipAnalyzer.Heroes.Rime.Guides
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Heroes.Rime.Analysis
@inject RimeCombatLogParser Parser

<GuideSection Title="Winter Orb Efficiency">
    <Explanation>
        <ol>
            <li>Winter Orbs are generated by <strong>Frost Bolt</strong>, <strong>Cold Snap</strong>, <strong>Freezing Torrent</strong>, and <strong>Bursting Ice</strong> (1 orb each).</li>
            <li>Spenders (<strong>Glacial Blast</strong> and <strong>Ice Comet</strong>) consume 3 orbs.</li>
            <li>You can hold a maximum of 5 orbs — avoid overcapping.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Orb Overview" Stats="@BuildOverviewStats()" />
        <StackedBar Segments="@BuildStackedBar()" />
        <div style="margin-top: 12px;">
            <FindingsList Findings="@BuildFindings()" />
        </div>
    </ChildContent>
</GuideSection>

@code {
    private WinterOrbTracker Tracker => Parser.WinterOrbTracker!;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var overcapRate = (Tracker.Generated + Tracker.Wasted) > 0
            ? (double)Tracker.Wasted / (Tracker.Generated + Tracker.Wasted) * 100
            : 0;

        return
        [
            new OverviewStat(
                $"{Tracker.Generated}",
                "Generated",
                "Total Winter Orbs generated during the encounter."),
            new OverviewStat(
                $"{Tracker.Spent}",
                "Spent",
                "Total Winter Orbs consumed by spenders."),
            new OverviewStat(
                $"{Tracker.Wasted}",
                "Overcapped",
                $"Orbs lost to overcap ({overcapRate:F0}% of potential).",
                Tracker.Wasted == 0 ? PerformanceTier.Perfect
                    : overcapRate < 10 ? PerformanceTier.Good
                    : overcapRate < 20 ? PerformanceTier.Ok
                    : PerformanceTier.Fail),
        ];
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar()
    {
        return
        [
            new StackedBarSegment("Spent", Tracker.Spent, PerformanceColors.Good,
                $"Spent: {Tracker.Spent} orbs consumed by spenders"),
            new StackedBarSegment("Overcapped", Tracker.Wasted, PerformanceColors.Fail,
                $"Overcapped: {Tracker.Wasted} orbs lost to cap"),
            new StackedBarSegment("Remaining", Tracker.Current, "#6688aa",
                $"Remaining: {Tracker.Current} orbs at fight end"),
        ];
    }

    private IEnumerable<Finding> BuildFindings()
    {
        yield return new Finding(
            Tracker.Wasted == 0 ? "info" : "warning",
            Tracker.Wasted == 0
                ? "No Winter Orb gains were lost to overcap."
                : $"{Tracker.Wasted} Winter Orb gains were lost to overcap.",
            null);
    }
}
