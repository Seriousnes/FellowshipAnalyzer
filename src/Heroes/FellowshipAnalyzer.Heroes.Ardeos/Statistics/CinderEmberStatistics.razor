@inherits AnalyzerStatistic<CinderEmberTracker>

<StatCard Title="Cinders & Embers">
    <Info>
        <p>Cinders build toward Embers (100 Cinders make 1 Ember, up to 4 Embers). These are the amounts held at the end of the encounter.</p>
    </Info>
    <ChildContent>
        <StatRow Value="@($"{Analyzer.CurrentEmbers} / {CinderEmberTracker.MaxEmbers}")">
            Embers held at encounter end
        </StatRow>
        <StatRow Value="@($"{Analyzer.CurrentCinders} / {CinderEmberTracker.CindersPerEmber}")">
            Cinders toward the next Ember
        </StatRow>
    </ChildContent>
</StatCard>
