@inherits AnalyzerStatistic<RollingFlamesAnalyzer>
@using ArdeosSpells = FellowshipAnalyzer.Core.Common.Spells.Ardeos

<StatCard>
    <Header>
        <SpellLink Spell="ArdeosSpells.Talents.RollingFlames" />
    </Header>
    <Info>
        <p>Rolling Flames reduces Engulfing Flames' cooldown from Searing Blaze damage and Infernal Wave casts.</p>
        <ul>
            @foreach (var cdr in Analyzer.CooldownReductions)
            {
                <li>
                    <SpellLink Spell="cdr.Spell" /> generated @Seconds(cdr.GeneratedMs)
                    (@Pct(cdr.Efficiency) effective, @Seconds(cdr.WastedMs) wasted).
                </li>
            }
        </ul>
    </Info>
    <ChildContent>
        @foreach (var cdr in Analyzer.CooldownReductions)
        {
            <StatRow Value="@Seconds(cdr.EffectiveMs)"
                     Tooltip="@($"{Seconds(cdr.GeneratedMs)} generated, {Seconds(cdr.WastedMs)} wasted")">
                <SpellLink Spell="cdr.Spell" /> reduction, @Pct(cdr.Efficiency) of @Seconds(cdr.GeneratedMs) generated
            </StatRow>
        }
    </ChildContent>
</StatCard>

@code {
    private static string Seconds(int milliseconds) => $"{milliseconds / 1000d:0.0}s";
    private static string Pct(double ratio) => $"{ratio * 100:F0}%";
}
