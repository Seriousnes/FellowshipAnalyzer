@inherits Analyzer
@using FellowshipAnalyzer.Core.UI
@using ArdeosSpells = FellowshipAnalyzer.Core.Common.Spells.Ardeos

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic =>
        @<StatCard>
            <Header>
                <SpellLink Spell="ArdeosSpells.Talents.ReignOfFire" />
            </Header>
            <Info>
                <p>Detonate procs Reign of Fire, restoring a <SpellLink Spell="ArdeosSpells.Spells.FireBall" /> charge and empowering the next Fire Ball. A proc at 2 charges overcaps the restored charge, and an empowerment that expires without a Fire Ball cast is lost.</p>
            </Info>
            <ChildContent>
                <StatRow Value="@Procs.ToString()">
                    procs granted by Detonate
                </StatRow>
                <StatRow Value="@ChargesWasted.ToString()"
                         Color="@PerformanceColors.ToColor(Tier(ChargesWasted, ChargeRate))"
                         Tooltip="Procs gained while Fire Ball was already at 2 charges.">
                    <SpellLink Spell="ArdeosSpells.Spells.FireBall" /> charges wasted (proc at 2 charges)
                </StatRow>
                <StatRow Value="@EmpowermentsWasted.ToString()"
                         Color="@PerformanceColors.ToColor(Tier(EmpowermentsWasted, EmpowerRate))">
                    empowerments wasted (buff expired unused)
                </StatRow>
            </ChildContent>
        </StatCard>;

    private double ChargeRate => Procs > 0 ? (double)ChargesWasted / Procs : 0d;
    private double EmpowerRate => Procs > 0 ? (double)EmpowermentsWasted / Procs : 0d;

    private static QualitativePerformance Tier(int wasted, double rate) =>
        wasted == 0 ? QualitativePerformance.Perfect
            : rate < 0.10 ? QualitativePerformance.Good
            : rate < 0.20 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;
}
