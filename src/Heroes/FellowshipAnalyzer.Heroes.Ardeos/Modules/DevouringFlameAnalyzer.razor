@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@inherits Analyzer

@code {
    public override RenderFragment? Statistic =>
        @<StatCard>
            <Header>
                @Legendaries.DevouringFlame.Name
            </Header>
            <ChildContent>
                <ItemDamageDone Amount="@((long)totalIncreasedDamage)" ShowShare=true />
            </ChildContent>
        </StatCard>
    ;
}
