@inherits Analyzer
@using ArdeosSpells = FellowshipAnalyzer.Core.Common.Spells.Ardeos

@code {
    public override RenderFragment? Statistic =>
        @<StatCard>
            <Header>
                <SpellLink Spell="ArdeosSpells.Talents.RollingFlames" />
            </Header>
            <ChildContent>
                @foreach (var cdr in CooldownReductions)
                {
                    <StatRow Value="@Seconds(cdr.CooldownReduction.Effective)"
                             Tooltip="@($"{Seconds(cdr.CooldownReduction.Total)} generated, {Seconds(cdr.CooldownReduction.Wasted)} wasted")">
                        <SpellLink Spell="cdr.Spell" /> reduction, @Pct(cdr.CooldownReduction.Efficiency) of @Seconds(cdr.CooldownReduction.Total) generated
                    </StatRow>
                }
            </ChildContent>
        </StatCard>;

    private static string Seconds(int milliseconds) => $"{milliseconds / 1000d:0.0}s";
    private static string Pct(double ratio) => $"{ratio * 100:F0}%";
}
