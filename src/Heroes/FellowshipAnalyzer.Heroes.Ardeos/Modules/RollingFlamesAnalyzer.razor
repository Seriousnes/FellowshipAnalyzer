@inherits Analyzer
@using ArdeosSpells = FellowshipAnalyzer.Core.Common.Spells.Ardeos

@code {
    public override RenderFragment? Statistic =>
        @<StatCard>
            <Header>
                <SpellLink Spell="ArdeosSpells.Talents.RollingFlames" />
            </Header>
            <ChildContent>
                @foreach (var cdr in CooldownReductions)
                {
                    <StatRow Value="@TimeFormat.Seconds(cdr.CooldownReduction.Effective, 1)"
                             Tooltip="@($"{TimeFormat.Seconds(cdr.CooldownReduction.Total, 1)} generated, {TimeFormat.Seconds(cdr.CooldownReduction.Wasted, 1)} wasted")">
                        <SpellLink Spell="cdr.Spell" /> reduction, @NumberFormat.Percent(cdr.CooldownReduction.Efficiency) of @TimeFormat.Seconds(cdr.CooldownReduction.Total, 1) generated
                    </StatRow>
                }
            </ChildContent>
        </StatCard>;
}
