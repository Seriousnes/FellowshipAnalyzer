@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inject ArdeosCombatLogParser Parser

@{
    var reports = Parser.DetonateDotCoverageReports;
}

@if (reports.Count > 0)
{
    <GuideSection Title="Detonate — DoT Coverage">
        <Explanation>
            <p>
                <SpellLink Spell="Spells.Detonate" />'s damage scales with the number of active DoTs on
                the target when it fires, and it does not consume them. Keep
                <SpellLink Spell="Spells.SearingBlaze" />, <SpellLink Spell="Spells.EngulfingFlames" />
                and <SpellLink Spell="Spells.FireBall" /> rolling — plus
                <SpellLink Spell="Spells.FireFrogs" />, <SpellLink Spell="Spells.Apocalypse" /> and
                <SpellLink Spell="Spells.Incinerate" /> when available — so every
                <SpellLink Spell="Spells.Detonate" /> lands on a fully layered target.
            </p>
        </Explanation>
        <ChildContent>
            <CastOverview Title="Coverage Overview" Stats="@BuildOverviewStats()" />
            @foreach (var entry in reports)
            {
                <div class="detonate-pull">
                    <PullBanner Pull="@entry.Pull" />
                    <CastOverview Title="@entry.Pull.Name" Stats="@BuildPullStats(entry.Result)" />
                    <FindingsList Findings="@MapFindings(entry.Result)" />
                </div>
            }
        </ChildContent>
    </GuideSection>
}

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var results = Parser.DetonateDotCoverageReports.Select(entry => entry.Result).ToList();
        var hits = results.Sum(report => report.DetonateHits);
        var casts = results.Sum(report => report.DetonateCasts);
        var wellLayered = results.Sum(report => report.WellLayeredHits);
        var weightedDots = results.Sum(report => report.AverageDotsPerHit * report.DetonateHits);
        var average = hits > 0 ? weightedDots / hits : 0d;
        var wellLayeredPercent = hits > 0 ? (int)Math.Round((double)wellLayered / hits * 100) : 0;
        var maxDots = results.Count > 0 ? results.Max(report => report.MaxDotsObserved) : 0;

        return
        [
            new OverviewStat($"{casts}", "Detonate Casts",
                "Total Detonate casts across every pull."),
            new OverviewStat($"{average:0.0}", "Avg DoTs / Hit",
                "Average number of Ardeos DoTs active on the target each time Detonate hit it.",
                Tier(average)),
            new OverviewStat($"{wellLayeredPercent}%", "Well Layered",
                "Share of Detonate hits that landed on a target carrying 3 or more DoTs.",
                PercentTier(wellLayeredPercent)),
            new OverviewStat($"{maxDots}", "Best Coverage",
                "Most Ardeos DoTs seen active on a single Detonate hit."),
        ];
    }

    private IEnumerable<OverviewStat> BuildPullStats(DetonateDotCoverageReport report)
    {
        var wellLayeredPercent = report.DetonateHits > 0
            ? (int)Math.Round((double)report.WellLayeredHits / report.DetonateHits * 100)
            : 0;

        return
        [
            new OverviewStat($"{report.DetonateHits}", "Detonate Hits",
                "Detonate damage instances in this pull (one per target hit)."),
            new OverviewStat($"{report.AverageDotsPerHit:0.0}", "Avg DoTs / Hit",
                "Average Ardeos DoTs active on the target per Detonate hit in this pull.",
                Tier(report.AverageDotsPerHit)),
            new OverviewStat($"{wellLayeredPercent}%", "Well Layered",
                "Share of this pull's Detonate hits on a target with 3 or more DoTs.",
                PercentTier(wellLayeredPercent)),
            new OverviewStat($"{report.MaxDotsObserved}", "Best Coverage",
                "Most DoTs active on a single Detonate hit in this pull."),
        ];
    }

    private IEnumerable<Finding> MapFindings(DetonateDotCoverageReport report) =>
        report.Findings.Select(finding => new Finding(
            finding.Severity,
            finding.Message,
            finding.Timestamp is null ? null : Parser.FormatTimestamp(finding.Timestamp.Value)));

    private static PerformanceTier Tier(double averageDots) => averageDots switch
    {
        >= 4 => PerformanceTier.Perfect,
        >= 3 => PerformanceTier.Good,
        >= 2 => PerformanceTier.Ok,
        _ => PerformanceTier.Fail,
    };

    private static PerformanceTier PercentTier(int percent) => percent switch
    {
        >= 75 => PerformanceTier.Perfect,
        >= 50 => PerformanceTier.Good,
        >= 25 => PerformanceTier.Ok,
        _ => PerformanceTier.Fail,
    };
}
