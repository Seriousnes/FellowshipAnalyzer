@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inherits GuideComponent<ArdeosCombatLogParser>

@{
    RenderFragment ef = @<SpellLink Spell="Spells.EngulfingFlames" />;
    RenderFragment wf = @<SpellLink Spell="Spells.Wildfire" />;
}

<GuideSection Title="Engulfing Flames Economy">
    <LeftPanel>
        <p>
            Pool @ef charges to have 2 available for an @wf window, but avoid sitting on capped charges for extended periods.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Economy Overview" Stats="@BuildOverviewStats()" />
        @if (DevouringFlameEquipped())
        {
            <CastOverview Title="Devouring Flame (Draconic Bracers)" Stats="@BuildDevouringFlameStats()" />
        }
        <CastDetail Title="Wildfire Windows"
                    Description="Each row is one Wildfire cast and the Engulfing Flames casts during setup."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.EngulfingFlamesEconomyAnalyzers.Count > 0;

    private List<EngulfingFlamesEconomyAnalyzer> Analyzers() =>
        Parser.EngulfingFlamesEconomyAnalyzers.Select(entry => entry.Analyzer).ToList();

    private bool DevouringFlameEquipped() => Analyzers().Any(analyzer => analyzer.DevouringFlameEquipped);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();
        var evaluated = analyzers.Sum(analyzer => analyzer.WindowsEvaluated);
        var doubleApplied = analyzers.Sum(analyzer => analyzer.DoubleAppliedWindows);
        var doubleRate = evaluated > 0 ? (int)Math.Round((double)doubleApplied / evaluated * 100) : 0;
        var wasted = analyzers.Sum(analyzer => analyzer.WastedCharges);
        var overcapSeconds = analyzers.Sum(analyzer => analyzer.CappedSeconds);

        return
        [
            new OverviewStat(
                $"{evaluated}",
                "Windows",
                "Total Wildfire readiness windows evaluated across every pull."),
            new OverviewStat(
                $"{doubleRate}%",
                "Double Applied",
                $"{doubleApplied} of {evaluated} windows had {EngulfingFlamesEconomyAnalyzer.DoubleApplicationThreshold} or more Engulfing Flames casts in the setup.",
                PercentTier(doubleRate)),
            new OverviewStat(
                $"{wasted}",
                "Wasted Charges",
                "Engulfing Flames recharge periods spent at maximum charges across every pull.",
                wasted == 0 ? QualitativePerformance.Perfect : wasted <= 2 ? QualitativePerformance.Ok : QualitativePerformance.Fail),
            new OverviewStat(
                $"{overcapSeconds:0.#}s",
                "Time at Max",
                "Total time Engulfing Flames spent at maximum charges across every pull."),
        ];
    }

    private IEnumerable<OverviewStat> BuildDevouringFlameStats()
    {
        var equipped = Analyzers().Where(analyzer => analyzer.DevouringFlameEquipped).ToList();
        var totalDuration = equipped.Sum(analyzer => (double)analyzer.PullDurationMs);

        double Weighted(Func<EngulfingFlamesEconomyAnalyzer, double> select) =>
            totalDuration > 0 ? equipped.Sum(analyzer => select(analyzer) * analyzer.PullDurationMs) / totalDuration : 0;

        var anyUptime = Weighted(analyzer => analyzer.DevouringFlameAnyUptime) * 100;
        var doubleUptime = Weighted(analyzer => analyzer.DevouringFlameDoubleUptime) * 100;
        var averageInstances = Weighted(analyzer => analyzer.DevouringFlamePrimaryAverageInstances);
        var modeledBonus = averageInstances * EngulfingFlamesEconomyAnalyzer.DevouringFlameBonusPerInstance;

        return
        [
            new OverviewStat(
                $"{anyUptime:0.#}%",
                "Engulfing Flames Uptime",
                "Share of the pull with at least one Engulfing Flames instance active on an enemy.",
                PerformanceTiers.FromThresholds(anyUptime, 90, 75, 50)),
            new OverviewStat(
                $"{doubleUptime:0.#}%",
                "Double Instance Uptime",
                "Share of the pull with two or more concurrent Engulfing Flames instances active on one enemy.",
                PerformanceTiers.FromThresholds(doubleUptime, 40, 25, 10)),
            new OverviewStat(
                $"{modeledBonus:0.#}%",
                "Modeled Damage Bonus",
                $"{EngulfingFlamesEconomyAnalyzer.DevouringFlameBonusPerInstance}% per instance times {averageInstances:0.00} average instances on the primary target.",
                PerformanceTiers.FromThresholds(modeledBonus, 9, 6, 3)),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.EngulfingFlamesEconomyAnalyzers.ToItemRows(Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(EngulfingFlamesEconomyAnalyzer.ReadinessWindow window)
    {
        var perf = window.EngulfingFlamesCastCount >= EngulfingFlamesEconomyAnalyzer.DoubleApplicationThreshold
            ? QualitativePerformance.Perfect
            : window.EngulfingFlamesCastCount == 1 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var stats = new[]
        {
            new PerCastStat(
                $"{window.EngulfingFlamesCastCount}/{EngulfingFlamesEconomyAnalyzer.DoubleApplicationThreshold}",
                "EF in Setup",
                $"Engulfing Flames casts in the setup before Wildfire ({EngulfingFlamesEconomyAnalyzer.DoubleApplicationThreshold} is the target).",
                Performance: perf),
            new PerCastStat(
                $"{window.ChargesAtReady}/{Spells.EngulfingFlames.Charges}",
                "Charges at Ready",
                "Engulfing Flames charges available the instant Wildfire came off cooldown. Context only."),
            new PerCastStat(
                $"{window.HeldMs / 1000d:0.0}s",
                "Held",
                "How long Wildfire was held after it came off cooldown. Context only."),
        };

        var sequence = window.EngulfingFlamesCasts
            .Select(_ => new SpellCastEntry(Spells.EngulfingFlames.Id, QualitativePerformance.Perfect))
            .Append(new SpellCastEntry(Spells.Wildfire.Id))
            .ToArray();

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = window.CastTimestamp,
            Sequence = sequence,
            AdditionalContent = new AdditionalContent(
                "Usage Notes",
                @<div>@BuildNote(window)</div>),
        };
    }

    private static string BuildNote(EngulfingFlamesEconomyAnalyzer.ReadinessWindow window)
    {
        if (window.EngulfingFlamesCastCount >= EngulfingFlamesEconomyAnalyzer.DoubleApplicationThreshold)
            return "Both Engulfing Flames casts were made in the setup.";

        if (window.EngulfingFlamesCastCount == 1)
            return "Only one Engulfing Flames cast was made in the setup - pool both charges before Wildfire becomes available.";

        return "No Engulfing Flames cast was made in the setup - pool both charges before Wildfire becomes available.";
    }

    private static QualitativePerformance PercentTier(int percent) => PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
