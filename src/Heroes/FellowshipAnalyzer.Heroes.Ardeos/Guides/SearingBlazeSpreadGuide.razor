@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inject ArdeosCombatLogParser Parser

<GuideSection Title="Searing Blaze Spread">
    <Explanation>
        <p>
            On multi-target pulls keep <SpellLink Spell="Spells.SearingBlaze" /> rolling on every enemy.
            Each pull is scored on how many enemies took the Searing Blaze DoT against the size of the
            pack.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Spread Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Searing Blaze by Pull"
                    Description="Each row is one AoE pull, showing how many enemies Searing Blaze reached against the pull's enemy count."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.SearingBlazeSpreadAnalyzers.Select(entry => entry.Analyzer).ToList();
        var pulls = analyzers.Count;
        var averageScore = pulls > 0 ? (int)Math.Round(analyzers.Average(analyzer => (double)CoverageScore(analyzer))) : 0;
        var totalTargets = analyzers.Sum(analyzer => analyzer.DistinctTargets);

        return
        [
            new OverviewStat(
                $"{pulls}",
                "AoE Pulls",
                "Multi-target pulls scored for Searing Blaze spread."),
            new OverviewStat(
                $"{averageScore}%",
                "Avg Spread",
                "Average Searing Blaze coverage across every AoE pull.",
                PercentTier(averageScore)),
            new OverviewStat(
                $"{totalTargets}",
                "Targets Hit",
                "Total distinct enemies that took Searing Blaze across all pulls."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData()
    {
        return Parser.SearingBlazeSpreadAnalyzers.Select(entry => BuildPullData(entry.Analyzer, entry.Pull));
    }

    private PerCastData BuildPullData(SearingBlazeSpreadAnalyzer analyzer, Pull pull)
    {
        var score = CoverageScore(analyzer);
        var perf = PercentTier(score);
        var coverageLabel = analyzer.TargetCount > 0
            ? $"{analyzer.DistinctTargets}/{analyzer.TargetCount}"
            : $"{analyzer.DistinctTargets}";

        var stats = new[]
        {
            new PerCastStat(
                coverageLabel,
                "Enemies Hit",
                "Distinct enemies that took Searing Blaze, against the pull's enemy count.",
                Performance: perf),
            new PerCastStat(
                $"{analyzer.TotalApplications}",
                "Applications",
                "Total Searing Blaze applications during the pull."),
        };

        return new PerCastData
        {
            Performance = perf,
            Stats = stats,
            Timestamp = Parser.FormatTimestamp(pull.StartTime),
            Sequence = [],
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="@pull" />,
            AdditionalContent = new AdditionalContent("Notes", @<div>@BuildNote(analyzer, score)</div>),
        };
    }

    private static int CoverageScore(SearingBlazeSpreadAnalyzer analyzer) =>
        analyzer.DistinctTargets == 0 ? 0 : (int)Math.Round(analyzer.Coverage * 100);

    private static string BuildNote(SearingBlazeSpreadAnalyzer analyzer, int score)
    {
        if (analyzer.DistinctTargets == 0)
            return "No Searing Blaze applications were detected on this AoE pull.";

        if (analyzer.TargetCount <= 0)
            return $"Searing Blaze reached {analyzer.DistinctTargets} enemies (the enemy roster was not reported, so coverage is estimated).";

        if (score >= 75)
            return $"Searing Blaze covered {analyzer.DistinctTargets} of {analyzer.TargetCount} enemies on this pull.";

        return $"Searing Blaze reached only {analyzer.DistinctTargets} of {analyzer.TargetCount} enemies - keep the DoT spread across the pack.";
    }

    private static PerformanceTier PercentTier(int percent) => percent switch
    {
        >= 75 => PerformanceTier.Perfect,
        >= 50 => PerformanceTier.Good,
        >= 25 => PerformanceTier.Ok,
        _ => PerformanceTier.Fail,
    };
}
