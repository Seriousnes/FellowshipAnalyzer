@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inject ArdeosCombatLogParser Parser

<GuideSection Title="Searing Blaze Spread">
    <Explanation>
        <p>
            On multi-target pulls keep <SpellLink Spell="Spells.SearingBlaze" /> rolling on every enemy.
            Each pull is scored on how many enemies took the Searing Blaze DoT against the size of the
            pack.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Spread Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Searing Blaze by Pull"
                    Description="Each row is one AoE pull, showing how many enemies Searing Blaze reached against the pull's enemy count."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var reports = Parser.SearingBlazeSpreadReports.Select(entry => entry.Result).ToList();
        var pulls = reports.Count;
        var averageScore = pulls > 0 ? (int)Math.Round(reports.Average(report => report.ScoreCard.Score)) : 0;
        var totalTargets = reports.Sum(report => report.DistinctTargets);

        return
        [
            new OverviewStat(
                $"{pulls}",
                "AoE Pulls",
                "Multi-target pulls scored for Searing Blaze spread."),
            new OverviewStat(
                $"{averageScore}%",
                "Avg Spread",
                "Average Searing Blaze coverage across every AoE pull.",
                PercentTier(averageScore)),
            new OverviewStat(
                $"{totalTargets}",
                "Targets Hit",
                "Total distinct enemies that took Searing Blaze across all pulls."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData()
    {
        return Parser.SearingBlazeSpreadReports.Select(entry => BuildPullData(entry.Result, entry.Pull));
    }

    private PerCastData BuildPullData(SearingBlazeSpreadReport report, Pull pull)
    {
        var perf = PercentTier(report.ScoreCard.Score);
        var coverageLabel = report.TargetCount > 0
            ? $"{report.DistinctTargets}/{report.TargetCount}"
            : $"{report.DistinctTargets}";

        var stats = new[]
        {
            new PerCastStat(
                coverageLabel,
                "Enemies Hit",
                "Distinct enemies that took Searing Blaze, against the pull's enemy count.",
                Performance: perf),
            new PerCastStat(
                $"{report.TotalApplications}",
                "Applications",
                "Total Searing Blaze applications during the pull."),
        };

        return new PerCastData
        {
            Performance = perf,
            Stats = stats,
            Timestamp = Parser.FormatTimestamp(pull.StartTime),
            Sequence = [],
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="@pull" />,
            AdditionalContent = report.Findings.Count > 0
                ? new AdditionalContent("Notes", @<div>@report.Findings[0].Message</div>)
                : null,
        };
    }

    private static PerformanceTier PercentTier(int percent) => percent switch
    {
        >= 75 => PerformanceTier.Perfect,
        >= 50 => PerformanceTier.Good,
        >= 25 => PerformanceTier.Ok,
        _ => PerformanceTier.Fail,
    };
}
