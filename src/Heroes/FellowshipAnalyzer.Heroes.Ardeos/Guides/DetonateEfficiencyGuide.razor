@using DetonateCast = FellowshipAnalyzer.Heroes.Ardeos.Modules.DetonateEfficiencyAnalyzer.DetonateCast
@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using FellowshipAnalyzer.Heroes.Ardeos.Core
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inherits GuideComponent<ArdeosCombatLogParser>
@inject ChartPalette Palette

<GuideSection Title="Detonate">
    <LeftPanel>
        <p>
            Cast <SpellLink Spell="Spells.Detonate" /> with as many DoTs active as possible, or press it early
            to avoid overcapping on Embers.
        </p>
        @if (HasApocalypticSurge)
        {
            <p>
                Try to avoid letting <SpellLink Spell="Spells.ApocalypticSurge" /> stacks expire unused.
            </p>
        }
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Detonate Overview" Stats="@BuildOverviewStats()" />

        @if (Charted is { } charted)
        {
            <SubSection Title="DoT Layering">
                <HelperText>
                    Active DoT instances across every enemy through @charted.Pull.Name, with each Detonate
                    marked at the total active instances when it was cast.
                    @if (Parser.DetonateEfficiencyAnalyzers.Count > 1)
                    {
                        <text>Use the pull selector in the report header to chart another pull.</text>
                    }
                </HelperText>
                <AuraStackGraph Samples="@ChartSamples(charted.Analyzer)"
                                Bands="@ChartBands(charted.Analyzer)"
                                Markers="@ChartMarkers(charted.Analyzer)"
                                YAxisTitle="Active DoT instances"
                                Height="300" />
            </SubSection>
        }

        <CastDetail Title="Detonate Casts"
                    Description="Each card is one Detonate, rated on the active DoT instances per enemy when it was cast."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.DetonateEfficiencyAnalyzers.Count > 0;


    private bool HasApocalypticSurge => Parser.SelectedCombatant.HasTalent(Talents.ApocalypticSurge.Id);

    private IReadOnlyList<Dot> TrackedDots => Parser.ArdeosDotTracker!.Dots;

    private int TotalDots => TrackedDots.Count;

    private PullAnalyzer<DetonateEfficiencyAnalyzer>? Charted
    {
        get
        {
            var analyzers = Parser.DetonateEfficiencyAnalyzers.Where(entry => entry.Analyzer.TotalCasts > 0).ToList();
            if (analyzers.Count == 0)
                return null;

            foreach (var entry in analyzers)
            {
                if (entry.Pull.IsBoss)
                    return entry;
            }
            return analyzers.MaxBy(entry => entry.Analyzer.TotalCasts);
        }
    }

    private static IReadOnlyList<int> ChartSamples(DetonateEfficiencyAnalyzer analyzer) =>
        [.. analyzer.LayerTimeline.Select(sample => sample.Timestamp)];

    private IReadOnlyList<AuraStackBand> ChartBands(DetonateEfficiencyAnalyzer analyzer)
    {
        var timeline = analyzer.LayerTimeline;
        var dots = TrackedDots;
        var bands = new List<AuraStackBand>(dots.Count);

        for (var slot = 0; slot < dots.Count; slot++)
        {
            var index = slot;
            bands.Add(new AuraStackBand(
                DotName(dots[index]),
                ArdeosChartColors.Dots.Series(Palette, ArdeosDots.IndexOf(dots[index])),
                [.. timeline.Select(sample => sample.Instances[index])]));
        }

        return bands;
    }

    private IReadOnlyList<AuraStackMarkers> ChartMarkers(DetonateEfficiencyAnalyzer analyzer)
    {
        var timeline = analyzer.LayerTimeline;
        var wellLayered = new int?[timeline.Count];
        var underLayered = new int?[timeline.Count];

        var sample = 0;
        foreach (var cast in analyzer.Casts)
        {
            while (sample + 1 < timeline.Count && timeline[sample + 1].Timestamp <= cast.Timestamp)
                sample++;

            if (cast.AverageInstances >= DetonateEfficiencyAnalyzer.WellLayeredAverage)
                wellLayered[sample] = cast.TotalInstances;
            else
                underLayered[sample] = cast.TotalInstances;
        }

        return
        [
            new AuraStackMarkers("Detonate: well layered", Palette.Performance(QualitativePerformance.Good), wellLayered),
            new AuraStackMarkers("Detonate: not well layered", Palette.Performance(QualitativePerformance.Fail), underLayered),
        ];
    }

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var casts = Parser.DetonateEfficiencyAnalyzers.SelectMany(entry => entry.Analyzer.Casts).ToList();
        var totalCasts = casts.Count;
        var averageInstances = totalCasts == 0 ? 0 : casts.Average(cast => cast.AverageInstances);
        var wellLayered = casts.Count(cast => cast.AverageInstances >= DetonateEfficiencyAnalyzer.WellLayeredAverage);
        var wellLayeredPct = totalCasts == 0 ? 0 : (int)Math.Round((double)wellLayered / totalCasts * 100);
        var averageDots = totalCasts == 0 ? 0 : casts.Average(cast => cast.DistinctDots);

        var stats = new List<OverviewStat>
        {
            new(
                $"{totalCasts}",
                "Detonate Casts",
                "Total Detonate casts across every pull."),
            new(
                $"{averageInstances:0.0}",
                "Avg Instances / Enemy",
                "Average active DoT instances per enemy when Detonate was cast.",
                AverageTier(averageInstances)),
            new(
                $"{averageDots:0.0}/{TotalDots}",
                "Avg DoTs at Cast",
                "Average distinct damage-over-time effects active on any enemy when Detonate was cast."),
            new(
                $"{wellLayeredPct}%",
                "Well-Layered",
                $"{wellLayered} of {totalCasts} Detonates averaged {DetonateEfficiencyAnalyzer.WellLayeredAverage} or more active instances per enemy.",
                PercentTier(wellLayeredPct)),
        };

        if (HasApocalypticSurge)
        {
            var analyzers = Parser.DetonateEfficiencyAnalyzers.Select(entry => entry.Analyzer).ToList();
            var freeCasts = analyzers.Sum(analyzer => analyzer.FreeCasts);
            var wastedStacks = analyzers.Sum(analyzer => analyzer.SurgeStacksWasted);

            stats.Add(new OverviewStat(
                $"{freeCasts}",
                "Free Casts",
                "Free Detonate casts across every pull."));
            stats.Add(new OverviewStat(
                $"{wastedStacks}",
                "Wasted Surge Stacks",
                "Apocalyptic Surge stacks that expired unused.",
                wastedStacks == 0 ? QualitativePerformance.Perfect
                    : wastedStacks <= 2 ? QualitativePerformance.Ok
                    : QualitativePerformance.Fail));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.DetonateEfficiencyAnalyzers.ToItemRows(Parser, analyzer => analyzer.Casts, (cast, pull) => BuildCastRow(cast));

    private PerCastRow BuildCastRow(DetonateCast cast)
    {
        var perf = AverageTier(cast.AverageInstances);

        var stats = new List<PerCastStat>
        {
            new(
                $"{cast.TotalInstances}",
                "DoT Instances",
                "Active DoT instances across every enemy when this Detonate was cast.",
                Performance: perf),
            new(
                $"{cast.DistinctDots}/{TotalDots}",
                "Active DoTs",
                "Distinct damage-over-time effects active on at least one enemy at the cast.",
                Performance: DotCountTier(cast.DistinctDots)),
            new(
                $"{cast.TargetsWithDoTs}",
                "Enemies With DoTs",
                "Enemies with at least one damage-over-time effect active at the cast."),
            new(
                $"{cast.MaxTargetInstances}",
                "Peak On An Enemy",
                "The most instances active on any single enemy at the cast."),
        };

        if (HasApocalypticSurge)
        {
            stats.Add(new PerCastStat(
                cast.Free ? "Yes" : "No",
                "Free Cast",
                "Whether this Detonate was free."));
        }

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats.ToArray(),
            Timestamp = cast.Timestamp,
            AdditionalContent = new AdditionalContent(
                "DoTs At Cast",
                @<Checklist Items="@BuildChecklist(cast)" />),
            Details = @<div>@BuildNote(cast)</div>,
        };
    }

    private static IEnumerable<CheckItem> BuildChecklist(DetonateCast cast) =>
        cast.Coverage.Select(entry => DotChecklist.Item(
            entry,
            entry.Targets > 1 ? $"{entry.Targets} enemies" : null));

    private static string DotName(Dot dot) => dot.Cast?.Name ?? dot.Effect.Name;

    private static string BuildNote(DetonateCast cast)
    {
        if (cast.TargetsWithDoTs == 0)
            return "No enemy had a damage-over-time effect active, so this Detonate was cast into nothing.";

        var missing = cast.Coverage.Where(entry => !entry.Active).Select(entry => DotName(entry.Dot)).ToList();
        var opening = $"Cast with {cast.TotalInstances} instance{(cast.TotalInstances == 1 ? "" : "s")} active across {cast.TargetsWithDoTs} " +
            $"{(cast.TargetsWithDoTs == 1 ? "enemy" : "enemies")}, averaging {cast.AverageInstances:0.0} per enemy.";

        return missing.Count == 0
            ? $"{opening} Every damage-over-time effect was active."
            : $"{opening} Missing {JoinNames(missing)}.";
    }

    private static string JoinNames(List<string> names)
    {
        if (names.Count == 1)
            return names[0];

        var builder = new System.Text.StringBuilder();
        for (var i = 0; i < names.Count; i++)
        {
            if (i > 0)
                builder.Append(i == names.Count - 1 ? " and " : ", ");
            builder.Append(names[i]);
        }
        return builder.ToString();
    }

    private static QualitativePerformance AverageTier(double average) => PerformanceTiers.FromThresholds(average, 4, 3, 2);

    private static QualitativePerformance DotCountTier(int dots) => PerformanceTiers.FromThresholds(dots, 5, 4, 2);

    private static QualitativePerformance PercentTier(int percent) => PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
