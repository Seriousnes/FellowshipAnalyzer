@using System.Text
@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inject ArdeosCombatLogParser Parser

@{
    RenderFragment wf = @<SpellLink Spell="Spells.Wildfire" />;
    RenderFragment ef = @<SpellLink Spell="Spells.EngulfingFlames" />;
}

<GuideSection Title="Wildfire Burn Windows">
    <Explanation>
        <p>
            Every damage-over-time effect should be laid on the target before @wf, @ef twice among them,
            and the buff spent on <SpellLink Spell="Spells.Detonate" /> rather than on more setup.
        </p>
        <p>
            Each window is scored on the enemy @wf is aimed at, read at the instant of the cast. Setup
            counts as complete with at least @WildfireComboAnalyzer.DistinctDotSuccessThreshold of the
            @WildfireComboAnalyzer.TotalDots DoTs ticking and
            @WildfireComboAnalyzer.EngulfingInstanceThreshold Engulfing Flames instances, and a clean
            window follows with at least @WildfireComboAnalyzer.DetonateSpamThreshold Detonate casts
            inside the buff. <SpellLink Spell="Spells.Pyromania" /> and
            <SpellLink Spell="Spells.Incinerate" /> are cooldown-limited against @wf, so they are
            surfaced as bonus alignment rather than required for a clean window.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Window Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Wildfire Windows"
                    Description="Each window shows the DoTs ticking on the target when Wildfire landed and the Detonate spam inside the buff."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.WildfireComboAnalyzers.Select(entry => entry.Analyzer).ToList();
        var total = analyzers.Sum(analyzer => analyzer.EvaluatedWindows);
        var successful = analyzers.Sum(analyzer => analyzer.SuccessfulWindows);
        var successRate = total > 0 ? (int)Math.Round((double)successful / total * 100) : 0;
        var windows = analyzers.SelectMany(analyzer => analyzer.Windows).ToList();
        var averageDots = windows.Count > 0 ? windows.Average(window => window.DistinctDots) : 0d;
        var averageDetonate = windows.Count > 0 ? windows.Average(window => window.DetonateCasts) : 0d;

        return
        [
            new OverviewStat(
                $"{total}",
                "Windows",
                "Total Wildfire burn windows evaluated across every pull."),
            new OverviewStat(
                $"{successRate}%",
                "Success Rate",
                $"{successful} clean / {total} evaluated: setup DoTs in place and Detonate spam followed.",
                PercentTier(successRate)),
            new OverviewStat(
                $"{averageDots:0.0}/{WildfireComboAnalyzer.TotalDots}",
                "Avg DoTs at Cast",
                "Average distinct fire DoTs ticking on the target when Wildfire landed."),
            new OverviewStat(
                $"{averageDetonate:0.0}",
                "Avg Detonate Casts",
                "Average Detonate casts spammed inside the Wildfire buff."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.WildfireComboAnalyzers.ToItemRows(Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(WildfireComboAnalyzer.WildfireWindowEvaluation window)
    {
        var perf = window.Successful ? QualitativePerformance.Perfect
            : window.Partial ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var dotsPerf = window.DistinctDots >= WildfireComboAnalyzer.DistinctDotSuccessThreshold ? QualitativePerformance.Perfect
            : window.DistinctDots >= WildfireComboAnalyzer.PartialSetupFloor ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var engulfingPerf = window.EngulfingInstances >= WildfireComboAnalyzer.EngulfingInstanceThreshold ? QualitativePerformance.Perfect
            : window.EngulfingInstances >= 1 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var detonatePerf = window.DetonateCasts >= WildfireComboAnalyzer.DetonateSpamThreshold ? QualitativePerformance.Perfect
            : window.DetonateCasts >= 1 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var stats = new[]
        {
            new PerCastStat(
                $"{window.DistinctDots}/{WildfireComboAnalyzer.TotalDots}",
                "DoTs Ticking",
                "Distinct fire DoTs ticking on the target when Wildfire landed (4 or more is a complete setup).",
                Performance: dotsPerf),
            new PerCastStat(
                $"{window.EngulfingInstances}/{WildfireComboAnalyzer.EngulfingInstanceThreshold}",
                "EF Instances",
                "Concurrent Engulfing Flames instances on the target at the cast (the standard window stacks it twice).",
                Performance: engulfingPerf),
            new PerCastStat(
                $"{window.DetonateCasts}",
                "Detonate in Window",
                "Detonate casts spammed inside the Wildfire buff (3 or more is a clean follow-up).",
                Performance: detonatePerf),
            new PerCastStat(
                window.HasPyromania ? "Yes" : "No",
                "Pyromania",
                "Whether Pyromania aligned in the setup before Wildfire. Bonus alignment, not required for a clean window."),
            new PerCastStat(
                window.HasIncinerate ? "Yes" : "No",
                "Incinerate",
                "Whether Incinerate extended the DoTs into this window. Bonus alignment, not required for a clean window."),
        };

        var sequence = window.CastsInWindow
            .Select(c => new SpellCastEntry(c.Ability.Id))
            .ToArray();

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = window.StartTimestamp,
            Sequence = sequence,
            AdditionalContent = new AdditionalContent(
                "DoTs At Cast",
                @<AuraChecklist Items="@ArdeosChecklist.Items(window.Coverage)" />),
            Details = @<div>@BuildOutcome(window)</div>,
        };
    }

    private static string BuildOutcome(WildfireComboAnalyzer.WildfireWindowEvaluation window)
    {
        if (window.Successful)
        {
            var note = window is { HasPyromania: true, HasIncinerate: true }
                ? " Pyromania and Incinerate both aligned to extend the burn."
                : window.HasPyromania
                    ? " Pyromania aligned with this window."
                    : window.HasIncinerate
                        ? " Incinerate extended the DoTs into this window."
                        : string.Empty;
            return $"Wildfire landed with {window.DistinctDots} of {WildfireComboAnalyzer.TotalDots} DoTs ticking and {window.EngulfingInstances} Engulfing Flames instances, then Detonate was spammed {window.DetonateCasts} times inside the buff." + note;
        }

        var reasons = new List<string>();

        if (window.DistinctDots == 0)
        {
            reasons.Add("no fire DoTs were ticking on the target when Wildfire landed");
        }
        else if (window.DistinctDots < WildfireComboAnalyzer.DistinctDotSuccessThreshold)
        {
            var missing = MissingDots(window);
            reasons.Add(missing.Count > 0
                ? $"the setup was incomplete (missing {JoinNames(missing)})"
                : "the setup was incomplete before Wildfire");
        }

        if (window is { DistinctDots: > 0, EngulfingInstances: < WildfireComboAnalyzer.EngulfingInstanceThreshold })
        {
            reasons.Add(window.EngulfingInstances == 0
                ? "Engulfing Flames was not ticking on the target"
                : $"Engulfing Flames held only {window.EngulfingInstances} instance (the standard window stacks it twice)");
        }

        if (window.DetonateCasts == 0)
            reasons.Add("Detonate was not spammed inside the Wildfire buff");
        else if (window.DetonateCasts < WildfireComboAnalyzer.DetonateSpamThreshold)
            reasons.Add($"only {window.DetonateCasts} Detonate cast{(window.DetonateCasts == 1 ? " " : "s ")}landed inside the Wildfire buff");

        if (reasons.Count == 0)
            reasons.Add("the window only partially matched the expected burn setup");

        return JoinReasons(reasons);
    }

    private static List<string> MissingDots(WildfireComboAnalyzer.WildfireWindowEvaluation window)
    {
        var names = new List<string>();
        foreach (var dot in ArdeosDots.All)
        {
            if (!window.ActiveDots.Contains(dot))
                names.Add(dot.Name);
        }
        return names;
    }

    private static string JoinNames(List<string> names)
    {
        if (names.Count == 1)
            return names[0];

        var builder = new StringBuilder();
        for (var i = 0; i < names.Count; i++)
        {
            if (i > 0)
                builder.Append(i == names.Count - 1 ? " and " : ", ");
            builder.Append(names[i]);
        }

        return builder.ToString();
    }

    private static string JoinReasons(List<string> reasons)
    {
        if (reasons.Count == 1)
            return Capitalise(reasons[0]) + ".";

        var builder = new StringBuilder();
        for (var i = 0; i < reasons.Count; i++)
        {
            if (i > 0)
                builder.Append(i == reasons.Count - 1 ? ", and " : ", ");
            builder.Append(i == 0 ? Capitalise(reasons[i]) : reasons[i]);
        }

        builder.Append('.');
        return builder.ToString();
    }

    private static string Capitalise(string value) =>
        value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private static QualitativePerformance PercentTier(int percent) => PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
