@using System.Text
@using FellowshipAnalyzer.Core.Common.Spells.Ardeos
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Ardeos.Spells
@inject ArdeosCombatLogParser Parser

<GuideSection Title="Wildfire Burn Windows">
    <Explanation>
        <p>
            Ardeos's burst is a burn window anchored on <SpellLink Spell="Spells.Wildfire" />. The
            standard window lays the DoTs first with <SpellLink Spell="Spells.FireFrogs" />,
            <SpellLink Spell="Spells.Apocalypse" />, <SpellLink Spell="Spells.FireBall" /> and
            <SpellLink Spell="Spells.EngulfingFlames" /> twice, then
            <SpellLink Spell="Spells.Pyromania" /> into <SpellLink Spell="Spells.Wildfire" />, followed
            by <SpellLink Spell="Spells.Detonate" /> spam. <SpellLink Spell="Spells.Incinerate" />
            extends the DoTs into the burn when it is available.
        </p>
        <p>
            Each window below is scored on the setup cast before Wildfire and the Detonate spam after
            it. <SpellLink Spell="Spells.Pyromania" /> and <SpellLink Spell="Spells.Incinerate" /> are
            cooldown-limited relative to Wildfire, so they are surfaced as bonus alignment rather than
            required for a clean window.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Window Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Wildfire Windows"
                    Description="Each window shows the setup casts before Wildfire and the Detonate spam after it, grouped by the pull it occurred in."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.WildfireComboAnalyzers.Select(entry => entry.Analyzer).ToList();
        var total = analyzers.Sum(analyzer => analyzer.EvaluatedWindows);
        var successful = analyzers.Sum(analyzer => analyzer.SuccessfulWindows);
        var successRate = total > 0 ? (int)Math.Round((double)successful / total * 100) : 0;
        var withPyromania = analyzers.Sum(analyzer => analyzer.WindowsWithPyromania);
        var averageDetonate = total > 0
            ? analyzers.SelectMany(analyzer => analyzer.Windows).Average(window => window.DetonateCasts)
            : 0d;

        return
        [
            new OverviewStat(
                $"{total}",
                "Windows",
                "Total Wildfire burn windows evaluated across every pull."),
            new OverviewStat(
                $"{successRate}%",
                "Success Rate",
                $"{successful} clean / {total} evaluated: setup complete and Detonate spam followed.",
                PercentTier(successRate)),
            new OverviewStat(
                $"{withPyromania}",
                "With Pyromania",
                "Windows where Pyromania aligned in the setup before Wildfire."),
            new OverviewStat(
                $"{averageDetonate:0.0}",
                "Avg Detonate Casts",
                "Average Detonate casts spammed in the six seconds after Wildfire."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.WildfireComboAnalyzers.ToItemRows(Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(WildfireComboAnalyzer.WildfireWindowEvaluation window)
    {
        var perf = window.Successful ? QualitativePerformance.Perfect
            : window.Partial ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var setupPerf = window.CoreSetupCount >= WildfireComboAnalyzer.CoreSetupSuccessThreshold ? QualitativePerformance.Perfect
            : window.CoreSetupCount >= 2 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var detonatePerf = window.DetonateCasts >= WildfireComboAnalyzer.DetonateSpamThreshold ? QualitativePerformance.Perfect
            : window.DetonateCasts >= 1 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var stats = new[]
        {
            new PerCastStat(
                $"{window.CoreSetupCount}/4",
                "Core Setup",
                "How many of Fire Frogs, Apocalypse, Fire Ball and Engulfing Flames were cast in the six seconds before Wildfire.",
                Performance: setupPerf),
            new PerCastStat(
                $"{window.DetonateCasts}",
                "Detonate",
                "Detonate casts spammed in the six seconds after Wildfire (3 or more is a clean follow-up).",
                Performance: detonatePerf),
            new PerCastStat(
                window.HasPyromania ? "Yes" : "No",
                "Pyromania",
                "Whether Pyromania aligned in the setup before Wildfire. Bonus alignment, not required for a clean window."),
            new PerCastStat(
                window.HasIncinerate ? "Yes" : "No",
                "Incinerate",
                "Whether Incinerate extended the DoTs into this window. Bonus alignment, not required for a clean window."),
        };

        var sequence = window.CastsInWindow
            .Select(c => new SpellCastEntry(c.Ability.Id))
            .ToArray();

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = window.StartTimestamp,
            Sequence = sequence,
            AdditionalContent = new AdditionalContent(
                "Usage Notes",
                @<div>@BuildOutcome(window)</div>),
        };
    }

    private static string BuildOutcome(WildfireComboAnalyzer.WildfireWindowEvaluation window)
    {
        if (window.Successful)
        {
            var note = window is { HasPyromania: true, HasIncinerate: true }
                ? " Pyromania and Incinerate both aligned to extend the burn."
                : window.HasPyromania
                    ? " Pyromania aligned with this window."
                    : window.HasIncinerate
                        ? " Incinerate extended the DoTs into this window."
                        : string.Empty;
            return "Opened Wildfire with the setup rotation in place and followed with Detonate spam." + note;
        }

        var reasons = new List<string>();

        var missing = new List<string>();
        if (!window.HasFireFrogs)
            missing.Add("Fire Frogs");
        if (!window.HasApocalypse)
            missing.Add("Apocalypse");
        if (!window.HasFireBall)
            missing.Add("Fire Ball");
        if (!window.HasEngulfingFlames)
            missing.Add("Engulfing Flames");

        if (window.CoreSetupCount == 0)
            reasons.Add("no setup abilities were cast before Wildfire");
        else if (window.CoreSetupCount < WildfireComboAnalyzer.CoreSetupSuccessThreshold && missing.Count > 0)
            reasons.Add($"the setup was incomplete before Wildfire (missing {JoinNames(missing)})");

        if (window.DetonateCasts == 0)
            reasons.Add("Detonate was not spammed after Wildfire");
        else if (window.DetonateCasts < WildfireComboAnalyzer.DetonateSpamThreshold)
            reasons.Add($"only {window.DetonateCasts} Detonate cast{(window.DetonateCasts == 1 ? " " : "s ")}followed Wildfire");

        if (window is { HasEngulfingFlames: true, EngulfingFlamesCount: < WildfireComboAnalyzer.StandardEngulfingFlamesCasts })
            reasons.Add("Engulfing Flames was cast only once (the standard window uses it twice)");

        if (reasons.Count == 0)
            reasons.Add("the window only partially matched the expected burn setup");

        return JoinReasons(reasons);
    }

    private static string JoinNames(List<string> names)
    {
        if (names.Count == 1)
            return names[0];

        var builder = new StringBuilder();
        for (var i = 0; i < names.Count; i++)
        {
            if (i > 0)
                builder.Append(i == names.Count - 1 ? " and " : ", ");
            builder.Append(names[i]);
        }

        return builder.ToString();
    }

    private static string JoinReasons(List<string> reasons)
    {
        if (reasons.Count == 1)
            return Capitalise(reasons[0]) + ".";

        var builder = new StringBuilder();
        for (var i = 0; i < reasons.Count; i++)
        {
            if (i > 0)
                builder.Append(i == reasons.Count - 1 ? ", and " : ", ");
            builder.Append(i == 0 ? Capitalise(reasons[i]) : reasons[i]);
        }

        builder.Append('.');
        return builder.ToString();
    }

    private static string Capitalise(string value) =>
        value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];

    private static QualitativePerformance PercentTier(int percent) => PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
