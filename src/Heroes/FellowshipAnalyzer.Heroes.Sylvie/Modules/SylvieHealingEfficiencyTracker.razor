@inherits HealingEfficiencyTracker

@code {
    public override RenderFragment? Statistic => TotalEffective > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard Title="Healing Per Mana">
            <Info>
                <p>
                    Per-spell healing to mana efficiency.
                </p>
            </Info>
            <ChildContent>
                @foreach (var spell in TopSpells())
                {
                    <StatRow Value="@($"{spell.HealingPerResource:N0}")" Tooltip="@Tooltip(spell)">
                        <SpellLink Spell="spell.SpellId" />
                    </StatRow>
                }
            </ChildContent>
        </StatCard>;

    private IEnumerable<SpellHealingEfficiency> TopSpells() =>
        BySpell
            .Where(spell => spell is { ResourceSpent: > 0, Effective: > 0 })
            .OrderByDescending(spell => spell.Effective)
            .Take(6);

    private static string Tooltip(SpellHealingEfficiency spell) =>
        $"{spell.Effective:N0} effective over {spell.Heals:N0} heals from {spell.Casts:N0} casts costing {spell.ResourceSpent:N0} mana, " +
        $"{spell.HealingPerExecutionSecond:N0} per second of execution time, {spell.OverhealShare * 100:F0}% overheal.";
}
