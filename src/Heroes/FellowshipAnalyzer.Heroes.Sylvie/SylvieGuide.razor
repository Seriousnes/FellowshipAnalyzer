@inherits ReportComponent<SylvieCombatLogParser>

@if (Parser.OverhealAnalyzers.Count > 0)
{
    <OverhealGuide />
}

@if (Parser.PinkFlutterflyAnalyzers.Count > 0 || Parser.BlueyAnalyzers.Count > 0)
{
    <FlutterflyGuide />
}

@if (Parser.HeartBloomRampAnalyzers.Count > 0)
{
    <HeartBloomGuide />
}

@if (Parser.LifePetalAnalyzers.Count > 0)
{
    <LifePetalGuide />
}

@if (Parser.FlutterflyHealingBuffAnalyzers.Count > 0)
{
    <FlutterflyBuffGuide />
}

@if (Parser.AbsorbWasteAnalyzers.Count > 0)
{
    <AbsorbWasteGuide />
}

@if (Parser.CureAilmentAnalyzers.Count > 0)
{
    <CureAilmentGuide />
}

@if (Parser.ManaEfficiencyAnalyzers.Count > 0)
{
    <ManaGuide />
}
