@inherits ReportComponent<SylvieCombatLogParser>

@if (Parser.PinkFlutterflyAnalyzers.Count > 0 || Parser.BlueyAnalyzers.Count > 0)
{
    <FlutterflyGuide />
}

@if (Parser.HeartBloomRampAnalyzers.Count > 0)
{
    <HeartBloomGuide />
}

@if (Parser.LifePetalAnalyzers.Count > 0)
{
    <LifePetalGuide />
}

@if (Parser.PricklyVineAnalyzers.Count > 0)
{
    <PricklyVineGuide />
}

@if (Parser.SafeHavenAnalyzers.Count > 0)
{
    <SafeHavenGuide />
}
