@inherits AnalyzerStatistic<SylvieHealingEfficiencyTracker>

<StatCard Title="Healing Per Mana">
    <Info>
        <p>
            What each spell healed for against the mana it cost and the global cooldown it occupied.
            Every figure is that spell's own absolute; nothing here is normalised against the best
            spell in the log.
        </p>
    </Info>
    <ChildContent>
        @foreach (var spell in TopSpells())
        {
            <StatRow Value="@($"{spell.HealingPerResource:N0}")" Tooltip="@Tooltip(spell)">
                <SpellLink Spell="spell.SpellId" />
            </StatRow>
        }
        <HelperText>
            Healing per point of mana. A spell the game data prices at nothing is left out.
        </HelperText>
    </ChildContent>
</StatCard>

@code {
    private IEnumerable<SpellHealingEfficiency> TopSpells() =>
        Analyzer.BySpell
            .Where(spell => spell is { ResourceSpent: > 0, Effective: > 0 })
            .OrderByDescending(spell => spell.Effective)
            .Take(6);

    private static string Tooltip(SpellHealingEfficiency spell) =>
        $"{spell.Effective:N0} landed over {spell.Heals:N0} heals from {spell.Casts:N0} casts costing {spell.ResourceSpent:N0} mana, " +
        $"{spell.HealingPerExecutionSecond:N0} per second of execution time, {spell.OverhealShare * 100:F0}% overheal.";
}
