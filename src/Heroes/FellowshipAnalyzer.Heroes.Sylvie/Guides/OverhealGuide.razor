@inherits ReportComponent<SylvieCombatLogParser>

<GuideSection Title="Overheal">
    <Explanation>
        <p>
            Every heal the log carries reports how much of it landed and how much fell on a bar that
            was already full. Each ability below is measured against its own output and nothing else -
            a heal-over-time parked on four allies for a whole pull and a cooldown pressed on a dying
            tank have nothing to say about one another, and the game's floor for both is the same zero.
        </p>
        <p>
            A large overheal share is not automatically a mistake. A periodic heal that ticks whether
            or not anybody is hurt buys its value in the moments it catches damage, and the rest of it
            is the price of that. What the number tells you is where the mana went.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Healing" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Overheal By Pull"
                    Description="What each pull's healing landed on, ability by ability."
                    Casts="@BuildPerPullData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.OverhealAnalyzers.Select(entry => entry.Analyzer).ToList();
        var effective = analyzers.Sum(analyzer => analyzer.TotalEffective);
        var overheal = analyzers.Sum(analyzer => analyzer.TotalOverheal);
        var total = effective + overheal;
        if (total == 0) return [];

        var stats = new List<OverviewStat>
        {
            new($"{effective:N0}", "Healing Landed", $"Effective healing across every pull, against {overheal:N0} that fell on full bars."),
            new($"{(double)overheal / total * 100:F1}%", "Overheal", "Share of all healing that landed on a bar that was already full."),
        };

        foreach (var spell in TopSpells(analyzers).Take(4))
        {
            stats.Add(new OverviewStat(
                $"{spell.OverhealShare * 100:F1}%",
                SpellName(spell.SpellId),
                $"{spell.Overheal:N0} of this ability's own {spell.TotalHealing:N0} healing across {spell.Heals:N0} heals fell on full bars."));
        }

        return stats;
    }

    private static IEnumerable<AbilityOverheal> TopSpells(IReadOnlyList<OverhealAnalyzer> analyzers)
    {
        var merged = new Dictionary<int, AbilityOverheal>();
        foreach (var analyzer in analyzers)
        {
            foreach (var spell in analyzer.BySpell)
            {
                merged[spell.SpellId] = merged.TryGetValue(spell.SpellId, out var running)
                    ? running with
                    {
                        Heals = running.Heals + spell.Heals,
                        Effective = running.Effective + spell.Effective,
                        Overheal = running.Overheal + spell.Overheal,
                    }
                    : spell;
            }
        }

        return merged.Values.OrderByDescending(spell => spell.TotalHealing);
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.OverhealAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = QualitativePerformance.Ok,
            Stats = BuildPullStats(analyzer),
        });

    private static PerCastStat[] BuildPullStats(OverhealAnalyzer analyzer)
    {
        var stats = new List<PerCastStat>
        {
            new($"{analyzer.TotalEffective:N0}", "Landed", $"Effective healing this pull, against {analyzer.TotalOverheal:N0} overheal."),
            new($"{analyzer.OverhealShare * 100:F1}%", "Overheal", "Share of this pull's healing that fell on full bars."),
        };

        foreach (var spell in analyzer.BySpell.Take(4))
        {
            stats.Add(new PerCastStat(
                $"{spell.OverhealShare * 100:F0}%",
                SpellName(spell.SpellId),
                $"{spell.Overheal:N0} of this ability's own {spell.TotalHealing:N0} healing over {spell.Heals:N0} heals fell on full bars."));
        }

        return [.. stats];
    }

    private static string SpellName(int spellId) => SpellRegistry.MaybeGet(spellId)?.Name ?? $"Spell {spellId}";
}
