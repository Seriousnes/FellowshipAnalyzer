@inherits GuideComponent<SylvieCombatLogParser>

<GuideSection Title="Life Petal">
    <LeftPanel>
        <p>
            Cast <SpellLink Spell="Spells.LifePetal" /> on cooldown unless you are holding it for
            a known damage event.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Life Petal By Pull"
                    Description="Charges available and reduction realised through each pull."
                    Casts="@BuildPerPullData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.LifePetalAnalyzers.Count > 0;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.LifePetalAnalyzers.Select(entry => entry.Analyzer).ToList();
        var reduction = analyzers.Aggregate(
            new CooldownReductionResult(), (total, analyzer) => total + analyzer.CooldownReduction);
        var casts = analyzers.Sum(analyzer => analyzer.Casts);
        if (casts == 0 && reduction.Total == 0) return [];

        var generated = reduction.Total;
        var applied = reduction.Effective;
        var efficiency = reduction.Efficiency;
        var measured = analyzers.Sum(analyzer => (long)analyzer.MeasuredMs);
        var capped = analyzers.Sum(analyzer => (long)analyzer.ChargeCappedMs);
        var cappedShare = measured > 0 ? capped / (double)measured : 0;

        return
        [
            new OverviewStat(
                $"{casts}",
                "Life Petals",
                "Casts across every pull."),
            new OverviewStat(
                $"{efficiency * 100:F1}%",
                "Reduction Realised",
                $"{applied / 1000:N0}s of the {generated / 1000:N0}s the Nettlebolts generated shortened a recharge.",
                PerformanceTiers.FromThresholds(efficiency * 100, 85, 70, 50)),
            new OverviewStat(
                $"{reduction.Wasted / 1000:N0}s",
                "Reduction Lost",
                "Reduction that shortened nothing."),
            new OverviewStat(
                $"{cappedShare * 100:F1}%",
                "Both Charges Available",
                $"{capped / 1000:N0}s of {measured / 1000:N0}s with both charges available.",
                PerformanceTiers.FromThresholds(100 - (cappedShare * 100), 85, 70, 50)),
        ];
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.LifePetalAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = PerformanceTiers.FromThresholds(analyzer.CooldownReduction.Efficiency * 100, 85, 70, 50),
            Stats =
            [
                new PerCastStat(
                    $"{analyzer.Casts}",
                    "Casts",
                    "Life Petals cast this pull."),
                new PerCastStat(
                    $"{analyzer.CooldownReduction.Efficiency * 100:F0}%",
                    "Reduction Realised",
                    $"{analyzer.CooldownReduction.Effective / 1000:N0}s of the {analyzer.CooldownReduction.Total / 1000:N0}s generated shortened a recharge.",
                    PerformanceTiers.FromThresholds(analyzer.CooldownReduction.Efficiency * 100, 85, 70, 50)),
                new PerCastStat(
                    $"{analyzer.ChargeCappedShare * 100:F0}%",
                    "Both Charges Available",
                    $"{analyzer.ChargeCappedMs / 1000:N0}s of this pull with both charges available.",
                    PerformanceTiers.FromThresholds(100 - (analyzer.ChargeCappedShare * 100), 85, 70, 50)),
                new PerCastStat(
                    $"{analyzer.NettleboltsAtFullCharges}",
                    "Nettlebolts At Full",
                    "Nettlebolts hit with both charges available."),
            ],
        });
}
