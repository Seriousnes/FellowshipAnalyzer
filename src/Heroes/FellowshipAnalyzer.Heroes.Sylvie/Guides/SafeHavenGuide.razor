@inherits GuideComponent<SylvieCombatLogParser>

<GuideSection Title="Safe Haven">
    <LeftPanel>
        <p>
            Proper placement of <SpellLink Spell="Spells.SafeHaven" /> can be difficult to achieve, 
            but it is a powerful tool for keeping allies alive.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Every Safe Haven"
                    Description="Who each placement affected, and for how much of its duration."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.SafeHavenAnalyzers.Count > 0;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.SafeHavenAnalyzers.Select(entry => entry.Analyzer).ToList();
        var casts = analyzers.Sum(analyzer => analyzer.Casts);
        if (casts == 0) return [];

        var allyMs = analyzers.Sum(analyzer => analyzer.AllyMs);
        var offered = analyzers.Sum(analyzer =>
            analyzer.Placements.Sum(placement => (long)placement.Allies * placement.AvailableMs));
        var held = offered > 0 ? allyMs / (double)offered : 0;
        var affected = analyzers.Sum(analyzer => analyzer.AlliesAffected);
        var empty = analyzers.Sum(analyzer => analyzer.CastsWithoutAnAlly);
        var carriedMs = analyzers.Sum(analyzer => analyzer.PrepullAllyMs);

        var stats = new List<OverviewStat>
        {
            new OverviewStat(
                $"{casts}",
                "Safe Havens",
                "Casts across every pull."),
            new OverviewStat(
                $"{held * 100:F1}%",
                "Held",
                $"{allyMs / 1000:N0} of the {offered / 1000:N0} ally-seconds the placements offered, measured against the {SylvieKit.SafeHavenDurationMs / 1000}s duration and clamped where a pull ended first."),
            new OverviewStat(
                $"{affected / (double)casts:F1}",
                "Allies Per Placement",
                $"{affected} allies affected across {casts} placements."),
            new OverviewStat(
                $"{empty}/{casts}",
                "Affected Nobody",
                "Placements no ally was ever inside.",
                PerformanceTiers.FromThresholds(100 - (empty / (double)casts * 100), 100, 90, 75)),
        };

        if (carriedMs > 0)
        {
            stats.Add(new OverviewStat(
                $"{carriedMs / 1000:N0}s",
                "Prepull Placement",
                "Ally-seconds from a placement made before the pull started, left out of the figures above."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.SafeHavenAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer.Placements,
            (placement, pull) => new PerCastRow
            {
                Performance = placement.Allies == 0
                    ? QualitativePerformance.Fail
                    : QualitativePerformance.Good,
                Timestamp = placement.Timestamp,
                Stats =
                [
                    new PerCastStat(
                        $"{placement.Allies}",
                        "Allies",
                        "Allies inside this placement at any point."),
                    new PerCastStat(
                        $"{placement.HeldShare * 100:F0}%",
                        "Held",
                        $"{placement.AllyMs / 1000:N0} of the {(long)placement.Allies * placement.AvailableMs / 1000:N0} ally-seconds this placement offered." +
                        (placement.Truncated ? " The pull ended before it expired." : string.Empty)),
                ],
            });
}
