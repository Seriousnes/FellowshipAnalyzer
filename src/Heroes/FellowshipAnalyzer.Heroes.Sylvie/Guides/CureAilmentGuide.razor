@inherits ReportComponent<SylvieCombatLogParser>

<GuideSection Title="Cure Ailment">
    <LeftPanel>
        <p>
            <SpellLink Spell="Spells.CureAilment" /> is on a six second cooldown, so keeping it moving
            is most of what it is worth. The table shows what you removed and when.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Dispels By Pull"
                    Description="What came off the party in each pull."
                    Casts="@BuildPerPullData()" />
    </RightPanel>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.CureAilmentAnalyzers.Select(entry => entry.Analyzer).ToList();
        var dispels = analyzers.Sum(analyzer => analyzer.CureAilmentDispels);
        var other = analyzers.Sum(analyzer => analyzer.OtherDispels);
        if (dispels == 0 && other == 0) return [];

        var auras = analyzers
            .SelectMany(analyzer => analyzer.RemovedAuras)
            .GroupBy(aura => aura.SpellId)
            .Select(group => (group.First().Name, Count: group.Sum(aura => aura.Count)))
            .OrderByDescending(aura => aura.Count)
            .ToList();

        var stats = new List<OverviewStat>
        {
            new(
                $"{dispels}",
                "Cure Ailments",
                "Auras Cure Ailment took off the party across every pull. What it removed is in the log; what it never got to is not an event, so this counts removals and does not guess at the rest."),
            new(
                $"{other}",
                "Other Dispels",
                "Auras removed by something other than Sylvie's kit. They answer to a different cooldown, so they are counted apart and say nothing about how she used hers."),
        };

        foreach (var (name, count) in auras.Take(3))
        {
            stats.Add(new OverviewStat(
                $"{count}",
                string.IsNullOrEmpty(name) ? "Unnamed Aura" : name,
                "Times Cure Ailment removed this debuff."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.CureAilmentAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = QualitativePerformance.Ok,
            Stats =
            [
                new PerCastStat(
                    $"{analyzer.CureAilmentDispels}",
                    "Cure Ailments",
                    $"Auras removed this pull across {analyzer.TargetsCleansed} allies."),
                new PerCastStat(
                    $"{analyzer.OtherDispels}",
                    "Other Dispels",
                    "Auras removed this pull by something other than Sylvie's kit, answering to a different cooldown."),
                new PerCastStat(
                    analyzer.RemovedAuras.Count > 0 ? analyzer.RemovedAuras[0].Name : "None",
                    "Most Removed",
                    analyzer.RemovedAuras.Count > 0
                        ? $"Removed {analyzer.RemovedAuras[0].Count} times this pull."
                        : "Cure Ailment removed nothing this pull."),
            ],
        });
}
