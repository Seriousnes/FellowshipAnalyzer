@inherits GuideComponent<SylvieCombatLogParser>

<GuideSection Title="Heart Bloom">
    <LeftPanel>
        <p>
            Keep the flutterflies assigned through the ramp into each
            <SpellLink Spell="Spells.HeartBloom" />.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Every Heart Bloom"
                    Description="What fed each cast, and what it released."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.HeartBloomRampAnalyzers.Count > 0;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.HeartBloomRampAnalyzers.Select(entry => entry.Analyzer).ToList();
        var casts = analyzers.Sum(analyzer => analyzer.CastCount);
        if (casts == 0) return [];

        var withBlueyOnAlly = analyzers.Sum(analyzer => analyzer.CastsWithBlueyOnAlly);
        var fullReleases = analyzers.Sum(analyzer => analyzer.FullyReleasedCasts);
        var fed = analyzers.Sum(analyzer => analyzer.TotalFed);

        return
        [
            new OverviewStat(
                $"{casts}",
                "Heart Blooms",
                $"Casts across every pull, releasing {analyzers.Sum(analyzer => analyzer.TotalReleases)} times against {SylvieKit.HeartBloomReleases} per cast."),
            new OverviewStat(
                $"{fullReleases}/{casts}",
                "Fully Released",
                "Casts that released in full.",
                PerformanceTiers.FromThresholds((double)fullReleases / casts * 100, 95, 85, 70)),
            new OverviewStat(
                $"{withBlueyOnAlly}/{casts}",
                "Bluey On An Ally",
                "Casts with Bluey on somebody other than Sylvie."),
            new OverviewStat(
                $"{fed:N0}",
                "Flutterfly Healing Fed",
                "Flutterfly healing, overheal included, over the accumulation windows."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.HeartBloomRampAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer.Casts,
            (cast, pull) => new PerCastRow
            {
                Performance = cast.ReleasedInFull ? QualitativePerformance.Good : QualitativePerformance.Ok,
                Timestamp = cast.Timestamp,
                Stats =
                [
                    new PerCastStat(
                        $"{cast.FlutterflyFed:N0}",
                        "Fed In",
                        $"Flutterfly healing over the {cast.AccumulationMs / 1000.0:F0}s since the previous cast, {cast.FlutterflyOverheal:N0} of it overheal."),
                    new PerCastStat(
                        $"{cast.TotalHealing:N0}",
                        "Released",
                        $"{cast.Effective:N0} effective healing and {cast.Overheal:N0} overheal."),
                    new PerCastStat(
                        $"{cast.Releases}/{SylvieKit.HeartBloomReleases}",
                        "Releases",
                        "Release intervals for this cast.",
                        cast.ReleasedInFull ? QualitativePerformance.Good : QualitativePerformance.Ok),
                    new PerCastStat(
                        cast.BlueyOnAlly ? "On an ally" : cast.BlueyAssigned ? "On Sylvie" : "Unassigned",
                        "Bluey",
                        "Where Bluey was when the cast went out."),
                ],
            });
}
