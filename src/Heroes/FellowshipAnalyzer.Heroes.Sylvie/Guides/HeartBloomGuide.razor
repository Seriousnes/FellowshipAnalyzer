@inherits ReportComponent<SylvieCombatLogParser>

<GuideSection Title="Heart Bloom">
    <LeftPanel>
        <p>
            <SpellLink Spell="Spells.HeartBloom" /> releases a share of the healing banked before it, so
            the ramp into each cast decides what it gives back. Keep the flutterflies out and Bluey
            placed through that ramp. The table shows the flutterfly healing over each accumulation
            window and what the cast released.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Every Heart Bloom"
                    Description="What fed each cast, and what it returned."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.HeartBloomRampAnalyzers.Select(entry => entry.Analyzer).ToList();
        var casts = analyzers.Sum(analyzer => analyzer.CastCount);
        if (casts == 0) return [];

        var withBlueyOnAlly = analyzers.Sum(analyzer => analyzer.CastsWithBlueyOnAlly);
        var fullReleases = analyzers.Sum(analyzer => analyzer.FullyReleasedCasts);
        var fed = analyzers.Sum(analyzer => analyzer.TotalFed);
        var released = analyzers.Sum(analyzer => analyzer.TotalReleased);

        return
        [
            new OverviewStat(
                $"{casts}",
                "Heart Blooms",
                $"Casts across every pull, releasing {analyzers.Sum(analyzer => analyzer.TotalReleases)} times against {SylvieKit.HeartBloomReleases} per cast."),
            new OverviewStat(
                $"{fullReleases}/{casts}",
                "Ran Their Full Sixteen",
                "Casts that were seen making every release the duration allows. A pull that ended early cuts the rest off.",
                PerformanceTiers.FromThresholds((double)fullReleases / casts * 100, 95, 85, 70)),
            new OverviewStat(
                $"{withBlueyOnAlly}/{casts}",
                "Bluey On An Ally",
                "Casts made with Bluey parked on somebody other than Sylvie, doubling that ally's flutterfly healing into the bank.",
                PerformanceTiers.FromThresholds((double)withBlueyOnAlly / casts * 100, 90, 70, 40)),
            new OverviewStat(
                $"{fed:N0}",
                "Flutterfly Healing Fed",
                $"Flutterfly healing, overheal included, over the accumulation windows. The casts returned {released:N0}, " +
                "so the flutterflies are one input to the bank rather than all of it."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.HeartBloomRampAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer.Casts,
            (cast, pull) => new PerCastRow
            {
                Performance = cast.ReleasedInFull ? QualitativePerformance.Good : QualitativePerformance.Ok,
                Timestamp = cast.Timestamp,
                Stats =
                [
                    new PerCastStat(
                        $"{cast.FlutterflyFed:N0}",
                        "Fed In",
                        $"Flutterfly healing over the {cast.AccumulationMs / 1000.0:F0}s since the previous cast, {cast.FlutterflyOverheal:N0} of it overheal."),
                    new PerCastStat(
                        $"{cast.TotalHealing:N0}",
                        "Returned",
                        $"{cast.Effective:N0} landed and {cast.Overheal:N0} fell on full health. What comes back out runs ahead of the flutterfly healing that preceded it, so the flutterflies are one input to the bank rather than the whole of it."),
                    new PerCastStat(
                        $"{cast.Releases}/{SylvieKit.HeartBloomReleases}",
                        "Releases",
                        "Distinct two-second release intervals seen for this cast.",
                        cast.ReleasedInFull ? QualitativePerformance.Good : QualitativePerformance.Ok),
                    new PerCastStat(
                        cast.BlueyOnAlly ? "On an ally" : cast.BlueyAssigned ? "On Sylvie" : "Unplaced",
                        "Bluey",
                        "Where Bluey was when the cast went out."),
                ],
            });
}
