@inherits ReportComponent<SylvieCombatLogParser>
@inject FellowshipAnalyzer.Core.FellowshipLogs.ReportMasterDataService MasterData

<GuideSection Title="Butterflies">
    <Explanation>
        <p>
            Sylvie has four pink butterflies and one blue one. A pink butterfly is either sitting in
            the bank, where it heals nobody, or parked on an ally by
            <SpellLink Spell="Spells.FluttercallHeal" />, where it heals that ally on its own period
            until it is taken off. The reading below is butterfly-time parked against the four the game
            gives you, so the ceiling is the game's and not another pull's.
        </p>
        <p>
            Bluey is the blue one. <SpellLink Spell="Spells.FluttercallProtect" /> sends it to an ally
            and doubles that ally's flutterfly healing;
            <SpellLink Spell="Spells.FluttercallEmbrace" /> recalls it onto Sylvie, where it is worth
            half as much but takes a fifth off her mana costs. Both are counted, neither is scored
            against the other.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Pink Butterflies" Stats="@BuildButterflyStats()" />
        @if (Parser.BlueyAssignmentAnalyzers.Count > 0)
        {
            <CastOverview Title="Bluey" Stats="@BuildBlueyStats()" />
        }
        <CastDetail Title="Butterflies By Pull"
                    Description="Where the butterflies were through each pull, and what they healed."
                    Casts="@BuildPerPullData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildButterflyStats()
    {
        var analyzers = Parser.PinkButterflyAssignmentAnalyzers.Select(entry => entry.Analyzer).ToList();
        var assignable = analyzers.Sum(analyzer => analyzer.AssignableMs);
        if (assignable == 0) return [];

        var assigned = analyzers.Sum(analyzer => analyzer.AssignedMs);
        var share = assigned / (double)assignable;
        var effective = analyzers.Sum(analyzer => analyzer.Effective);
        var overheal = analyzers.Sum(analyzer => analyzer.Overheal);
        var total = effective + overheal;
        var moves = analyzers.Sum(analyzer => analyzer.AssignmentsOpened);
        var peakBanked = analyzers.Count > 0 ? analyzers.Max(analyzer => analyzer.PeakBanked) : 0;

        return
        [
            new OverviewStat(
                $"{share * 100:F1}%",
                "Butterflies Out",
                $"{assigned / 1000:N0} butterfly-seconds parked on an ally against the {assignable / 1000:N0} four butterflies could have covered.",
                PerformanceTiers.FromThresholds(share * 100, 98, 90, 75)),
            new OverviewStat(
                $"{peakBanked}",
                "Most Banked",
                $"The most butterflies seen waiting in the bank at once, out of {SylvieKit.PinkButterflies}. A butterfly in the bank is healing nobody."),
            new OverviewStat(
                $"{moves}",
                "Butterflies Placed",
                "Butterflies sent onto an ally during the fight. A butterfly stays where it is put, so this counts placements rather than upkeep."),
            new OverviewStat(
                total > 0 ? $"{(double)overheal / total * 100:F1}%" : "0%",
                "Butterfly Overheal",
                $"{overheal:N0} of the butterflies' own {total:N0} healing fell on full bars."),
        ];
    }

    private IEnumerable<OverviewStat> BuildBlueyStats()
    {
        var analyzers = Parser.BlueyAssignmentAnalyzers.Select(entry => entry.Analyzer).ToList();
        var pullMs = analyzers.Sum(analyzer => (long)analyzer.PullDurationMs);
        if (pullMs == 0) return [];

        var onAlly = analyzers.Sum(analyzer => (long)analyzer.OnAllyMs);
        var onSylvie = analyzers.Sum(analyzer => (long)analyzer.OnSylvieMs);
        var unplaced = analyzers.Sum(analyzer => (long)analyzer.UnplacedMs);
        var moves = analyzers.Sum(analyzer => analyzer.Reassignments);

        return
        [
            new OverviewStat(
                $"{onAlly / (double)pullMs * 100:F1}%",
                "On An Ally",
                $"{onAlly / 1000:N0}s parked on somebody other than Sylvie, where Bluey doubles that ally's flutterfly healing."),
            new OverviewStat(
                $"{onSylvie / (double)pullMs * 100:F1}%",
                "On Sylvie",
                $"{onSylvie / 1000:N0}s recalled onto Sylvie, worth half the flutterfly bonus and a fifth off her mana costs."),
            new OverviewStat(
                $"{moves}",
                "Reassignments",
                "Times Bluey was moved during the pulls. Bluey has no cooldown pressure, so this is cadence rather than a score."),
            new OverviewStat(
                $"{unplaced / 1000:N0}s",
                "Unplaced",
                "Pull time in which the log placed Bluey nowhere at all."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.PinkButterflyAssignmentAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = PerformanceTiers.FromThresholds(analyzer.AssignedShare * 100, 98, 90, 75),
            Stats = BuildPullStats(analyzer, pull),
        });

    private PerCastStat[] BuildPullStats(PinkButterflyAssignmentAnalyzer analyzer, Pull pull)
    {
        var stats = new List<PerCastStat>
        {
            new(
                $"{analyzer.AssignedShare * 100:F1}%",
                "Butterflies Out",
                $"{analyzer.AssignedMs / 1000:N0} butterfly-seconds parked against the {analyzer.AssignableMs / 1000:N0} this pull offered.",
                PerformanceTiers.FromThresholds(analyzer.AssignedShare * 100, 98, 90, 75)),
            new(
                $"{analyzer.HoldersCovered}",
                "Allies Healed",
                "Distinct allies the butterflies ticked on during this pull."),
        };

        if (Parser.For(pull).BlueyAssignmentAnalyzer is { } bluey)
        {
            stats.Add(new PerCastStat(
                bluey.OnAllyShare >= bluey.OnSylvieShare ? "Ally" : "Sylvie",
                "Bluey",
                $"{bluey.OnAllyMs / 1000:N0}s on an ally against {bluey.OnSylvieMs / 1000:N0}s on Sylvie this pull."));
        }

        foreach (var holding in analyzer.Holdings.Take(4))
        {
            stats.Add(new PerCastStat(
                $"{holding.AssignedMs / 1000:N0}s",
                HolderName(holding.Unit.ActorId),
                $"{holding.Ticks:N0} ticks for {holding.Effective:N0} landed and {holding.Overheal:N0} overhealed."));
        }

        return [.. stats];
    }

    private string HolderName(int actorId) =>
        MasterData.GetHero(actorId)?.Name.ToString() ?? (actorId == Parser.PlayerId ? "Sylvie" : $"Ally {actorId}");
}
