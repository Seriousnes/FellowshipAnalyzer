@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.UI.Components
@using FellowshipAnalyzer.Core.UI.Diagnostics
@using FellowshipAnalyzer.Core.UI.Guides
@using FellowshipAnalyzer.Core.UI.Timeline
@using FellowshipAnalyzer.Heroes.Rime.Analysis
@using FellowshipAnalyzer.Heroes.Rime.Modules
@using FellowshipAnalyzer.Core.Common.Spells
@inject RimeCombatLogParser Parser

@{
    RenderFragment bi = @<SpellLink Spell="Spells.BurstingIce" />;
    RenderFragment gb = @<SpellLink Spell="Spells.GlacialBlast" />;
    RenderFragment cs = @<SpellLink Spell="Spells.ColdSnap" />;
    RenderFragment ft = @<SpellLink Spell="Spells.FreezingTorrent" />;
    RenderFragment ic = @<SpellLink Spell="Spells.IceComet" />;
}

<GuideSection Title="Winter's Embrace Windows">
    <Explanation>
        <ol>
            <li>Build Winter Orbs to at least 3 before casting @bi</li>
            <li>Single-target windows expect @gb follow-up, with @cs or @ft added when the window can support it. @ft → @cs is also acceptable.</li>
            <li>AoE windows are identified by @bi hitting 2 or more unique targets and should contain @ic plus @cs in any order.</li>
            <li>The window timeline below is grouped per pull — each pull's windows are evaluated against the priorities that pull's type calls for.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Window Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Winter's Embrace Windows"
                    Description="Each window shows what was cast during the 3s Winter's Embrace buff, grouped by the pull it occurred in."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var reports = Parser.BasicStComboReports.Select(entry => entry.Result).ToList();
        var total = reports.Sum(report => report.EvaluatedWindows);
        var successful = reports.Sum(report => report.SuccessfulWindows);
        var successRate = total > 0 ? (int)Math.Round((double)successful / total * 100) : 0;
        var singleTargetWindows = reports.Sum(report =>
            report.Windows.Count(window => window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.SingleTarget));
        var aoeWindows = reports.Sum(report =>
            report.Windows.Count(window => window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.Aoe));

        return
        [
            new OverviewStat(
                $"{total}",
                "Windows",
                "Total Bursting Ice Winter's Embrace windows evaluated across every pull."),
            new OverviewStat(
                $"{successRate}%",
                "Success Rate",
                $"{successful} successful / {total} evaluated across single-target and AoE windows.",
                successRate >= 75 ? PerformanceTier.Perfect
                    : successRate >= 50 ? PerformanceTier.Good
                    : successRate >= 25 ? PerformanceTier.Ok
                    : PerformanceTier.Fail),
            new OverviewStat(
                $"{singleTargetWindows}",
                "Single Target",
                "Windows where Bursting Ice only hit one target."),
            new OverviewStat(
                $"{aoeWindows}",
                "AoE",
                "Windows where Bursting Ice hit 2 or more unique targets."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData()
    {
        return Parser.BasicStComboReports.SelectMany(entry =>
            entry.Result.Windows.Select(window => BuildWindowData(window, entry.Pull)));
    }

    private PerCastData BuildWindowData(BasicStComboAnalyzer.StComboWindowEvaluation window, Pull pull)
    {
        var perf = window.Successful ? PerformanceTier.Perfect
            : window.Partial ? PerformanceTier.Ok
            : PerformanceTier.Fail;

        var isAoe = window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.Aoe;
        var windowTypeLabel = isAoe ? "AoE" : "ST";
        var primaryUsage = isAoe ? $"{window.AoeSpenderCount}/2" : $"{window.StSpenderCount}/{window.ExpectedStSpenderCount}";
        var primaryUsageLabel = isAoe ? window.AoeSpenderName : window.StSpenderName;
        var finisherValue = isAoe ? $"{window.ColdSnapCount}/1" : $"{window.ColdSnapCount + window.FreezingTorrentCount}";
        var finisherLabel = isAoe ? "Cold Snap" : "Finishers";
        var finisherTooltip = isAoe
            ? $"AoE windows want one Cold Snap in any order with two {window.AoeSpenderName} casts."
            : window.ExpectsFinisher
                ? "Single-target windows with enough room should include Cold Snap or Freezing Torrent as a finisher."
                : "No extra finisher was required for this single-target window under the current baseline timing.";

        var stats = new[]
        {
            new PerCastStat(
                windowTypeLabel,
                "Type",
                isAoe
                    ? "Bursting Ice hit 2 or more unique targets in this window."
                    : "Bursting Ice hit exactly one target in this window."),
            new PerCastStat(
                $"{window.TargetCount}",
                "Targets",
                "Unique targets hit by Bursting Ice damage during this Winter's Embrace window."),
            new PerCastStat(
                primaryUsage,
                primaryUsageLabel,
                isAoe
                    ? $"AoE windows want two {window.AoeSpenderName} casts during Winter's Embrace."
                    : $"Single-target windows currently use baseline timing to estimate how many {window.StSpenderName} casts should fit.",
                Performance: perf),
            new PerCastStat(
                finisherValue,
                finisherLabel,
                finisherTooltip,
                Performance: perf),
        };

        var sequence = window.CastsInWindow
            .Select(c => new SpellCastEntry(c.Ability.Id))
            .ToArray();

        return new PerCastData
        {
            Performance = perf,
            Stats = stats,
            Timestamp = Parser.FormatTimestamp(window.StartTimestamp),
            Sequence = sequence,
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="@pull" />,
            AdditionalContent = new AdditionalContent(
                "Usage Notes",
                @<div>@window.Outcome</div>),
        };
    }
}
