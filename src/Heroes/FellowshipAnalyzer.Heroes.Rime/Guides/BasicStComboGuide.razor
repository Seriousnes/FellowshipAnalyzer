@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.UI.Components
@using FellowshipAnalyzer.Core.UI.Diagnostics
@using FellowshipAnalyzer.Core.UI.Guides
@using FellowshipAnalyzer.Core.UI.Timeline
@using FellowshipAnalyzer.Heroes.Rime.Analysis
@using FellowshipAnalyzer.Heroes.Rime.Modules
@using FellowshipAnalyzer.Core.Common.Spells
@inject RimeCombatLogParser Parser

@{
    RenderFragment bi = @<SpellLink Spell="Spells.BurstingIce" />;
    RenderFragment gb = @<SpellLink Spell="Spells.GlacialBlast" />;
    RenderFragment cs = @<SpellLink Spell="Spells.ColdSnap" />;
    RenderFragment ft = @<SpellLink Spell="Spells.FreezingTorrent" />;
    RenderFragment ic = @<SpellLink Spell="Spells.IceComet" />;
}

<GuideSection Title="Winter's Embrace Windows">
    <Explanation>
        <ol>
            <li>Build Winter Orbs to at least 3 before casting @bi</li>
            <li>Single-target windows expect @gb follow-up, with @cs or @ft added when the window can support it. @ft → @cs is also acceptable.</li>
            <li>AoE windows are identified by @bi hitting 2 or more unique targets and should contain @ic plus @cs in any order.</li>
            <li>The window timeline below is grouped per pull — each pull's windows are evaluated against the priorities that pull's type calls for.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Window Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Winter's Embrace Windows"
                    Description="Each window shows what was cast during the 3s Winter's Embrace buff, grouped by the pull it occurred in."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.BasicStComboAnalyzers.Select(entry => entry.Analyzer).ToList();
        var total = analyzers.Sum(analyzer => analyzer.EvaluatedWindows);
        var successful = analyzers.Sum(analyzer => analyzer.SuccessfulWindows);
        var successRate = total > 0 ? (int)Math.Round((double)successful / total * 100) : 0;
        var singleTargetWindows = analyzers.Sum(analyzer =>
            analyzer.Windows.Count(window => window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.SingleTarget));
        var aoeWindows = analyzers.Sum(analyzer =>
            analyzer.Windows.Count(window => window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.Aoe));

        return
        [
            new OverviewStat(
                $"{total}",
                "Windows",
                "Total Bursting Ice Winter's Embrace windows evaluated across every pull."),
            new OverviewStat(
                $"{successRate}%",
                "Success Rate",
                $"{successful} successful / {total} evaluated across single-target and AoE windows.",
                successRate >= 75 ? PerformanceTier.Perfect
                    : successRate >= 50 ? PerformanceTier.Good
                    : successRate >= 25 ? PerformanceTier.Ok
                    : PerformanceTier.Fail),
            new OverviewStat(
                $"{singleTargetWindows}",
                "Single Target",
                "Windows where Bursting Ice only hit one target."),
            new OverviewStat(
                $"{aoeWindows}",
                "AoE",
                "Windows where Bursting Ice hit 2 or more unique targets."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData()
    {
        return Parser.BasicStComboAnalyzers.SelectMany(entry =>
            entry.Analyzer.Windows.Select(window => BuildWindowData(window, entry.Pull)));
    }

    private PerCastData BuildWindowData(BasicStComboAnalyzer.StComboWindowEvaluation window, Pull pull)
    {
        var perf = window.Successful ? PerformanceTier.Perfect
            : window.Partial ? PerformanceTier.Ok
            : PerformanceTier.Fail;

        var isAoe = window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.Aoe;
        var windowTypeLabel = isAoe ? "AoE" : "ST";
        var primaryUsage = isAoe ? $"{window.AoeSpenderCount}/2" : $"{window.StSpenderCount}/{window.ExpectedStSpenderCount}";
        var primaryUsageLabel = isAoe ? window.AoeSpenderName : window.StSpenderName;
        var finisherValue = isAoe ? $"{window.ColdSnapCount}/1" : $"{window.ColdSnapCount + window.FreezingTorrentCount}";
        var finisherLabel = isAoe ? "Cold Snap" : "Finishers";
        var finisherTooltip = isAoe
            ? $"AoE windows want one Cold Snap in any order with two {window.AoeSpenderName} casts."
            : window.ExpectsFinisher
                ? "Single-target windows with enough room should include Cold Snap or Freezing Torrent as a finisher."
                : "No extra finisher was required for this single-target window under the current baseline timing.";

        var stats = new[]
        {
            new PerCastStat(
                windowTypeLabel,
                "Type",
                isAoe
                    ? "Bursting Ice hit 2 or more unique targets in this window."
                    : "Bursting Ice hit exactly one target in this window."),
            new PerCastStat(
                $"{window.TargetCount}",
                "Targets",
                "Unique targets hit by Bursting Ice damage during this Winter's Embrace window."),
            new PerCastStat(
                primaryUsage,
                primaryUsageLabel,
                isAoe
                    ? $"AoE windows want two {window.AoeSpenderName} casts during Winter's Embrace."
                    : $"Single-target windows currently use baseline timing to estimate how many {window.StSpenderName} casts should fit.",
                Performance: perf),
            new PerCastStat(
                finisherValue,
                finisherLabel,
                finisherTooltip,
                Performance: perf),
        };

        var sequence = window.CastsInWindow
            .Select(c => new SpellCastEntry(c.Ability.Id))
            .ToArray();
        var outcome = BuildOutcome(window);

        return new PerCastData
        {
            Performance = perf,
            Stats = stats,
            Timestamp = Parser.FormatTimestamp(window.StartTimestamp),
            Sequence = sequence,
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="@pull" />,
            AdditionalContent = new AdditionalContent(
                "Usage Notes",
                @<div>@outcome</div>),
        };
    }

    private static string BuildOutcome(BasicStComboAnalyzer.StComboWindowEvaluation window) =>
        window.WindowType == BasicStComboAnalyzer.BurstingIceWindowType.Aoe
            ? BuildAoeOutcome(window)
            : BuildSingleTargetOutcome(window);

    private static string BuildSingleTargetOutcome(BasicStComboAnalyzer.StComboWindowEvaluation window)
    {
        if (window.Successful)
        {
            if (window.UsedFreezingTorrentCombo)
            {
                return "Used the Winter's Embrace window well for single-target damage with the Freezing Torrent plus Cold Snap variant.";
            }

            return window.ExpectsFinisher
                ? $"Used the Winter's Embrace window well for single-target damage, fitting the expected {window.StSpenderName} casts and a finisher."
                : $"Used the Winter's Embrace window well for single-target damage, fitting the expected {window.StSpenderName} usage.";
        }

        var reasons = new List<string>();

        if (window.FirstRelevantCastName is null)
        {
            reasons.Add("No single-target follow-up spell was cast during Winter's Embrace");
        }
        else if (!window.OpenedWithExpectedCast)
        {
            reasons.Add($"Opened with {window.FirstRelevantCastName} instead of starting with {window.StSpenderName} or Freezing Torrent");
        }

        if (window.MissingStSpenderCount > 0)
        {
            reasons.Add(window.MissingStSpenderCount == 1
                ? $"one expected {window.StSpenderName} was missed"
                : $"{window.MissingStSpenderCount} expected {window.StSpenderName} casts were missed");
        }

        if (window.ExpectsFinisher && !window.HasValidFinisher)
        {
            reasons.Add("there was enough time for a finisher, but neither Cold Snap nor Freezing Torrent was used to finish the window");
        }

        if (reasons.Count == 0)
        {
            reasons.Add("The window only partially matched the expected single-target follow-up");
        }

        return JoinReasons(reasons);
    }

    private static string BuildAoeOutcome(BasicStComboAnalyzer.StComboWindowEvaluation window)
    {
        if (window.Successful)
        {
            return $"Used the AoE Winter's Embrace window well, fitting two {window.AoeSpenderName} casts and one Cold Snap in any order.";
        }

        var reasons = new List<string>();

        if (!window.HasRequiredAoeSpenders)
        {
            reasons.Add(window.AoeSpenderCount == 0
                ? $"no {window.AoeSpenderName} casts were used"
                : $"the window did not include the expected second {window.AoeSpenderName}");
        }

        if (!window.HasRequiredColdSnap)
        {
            reasons.Add("Cold Snap was missing from the AoE window");
        }

        if (reasons.Count == 0)
        {
            reasons.Add("The AoE window only partially matched the expected follow-up");
        }

        return JoinReasons(reasons);
    }

    private static string JoinReasons(List<string> reasons)
    {
        if (reasons.Count == 1)
            return reasons[0] + ".";

        var builder = new System.Text.StringBuilder();
        for (var i = 0; i < reasons.Count; i++)
        {
            if (i > 0)
            {
                builder.Append(i == reasons.Count - 1 ? ", and " : ", ");
            }

            builder.Append(reasons[i]);
        }

        builder.Append('.');
        return builder.ToString();
    }
}
