@using Incident = FellowshipAnalyzer.Heroes.Rime.Modules.WinterOrbTracker.OvercapIncident
@inject RimeCombatLogParser Parser

@{
    RenderFragment fb = @<SpellLink Spell="Spells.FrostBolt" />;
    RenderFragment ft = @<SpellLink Spell="Spells.FreezingTorrent" />;
    RenderFragment bi = @<SpellLink Spell="Spells.BurstingIce" />;
    RenderFragment cs = @<SpellLink Spell="Spells.ColdSnap" />;
}

<GuideSection Title="Winter Orb Efficiency">
    <Explanation>
        <ol>
            <li>@fb generates 3 Anima a cast, @ft 1 per tick, and @bi 1 per pulse. Every 9 Anima folds into one Winter Orb.</li>
            <li>@cs skips Anima entirely and hands you a whole orb on the spot.</li>
            <li>The pool holds 5 orbs. Anima generated at 5 is gone, so spending at 4 keeps the next gain somewhere to land.</li>
        </ol>
        <p>
            The readouts here are reconstructed from the orb count the log stamps on your own casts.
            <strong>Overcapped</strong> counts the gains that arrived on a full pool, and
            <strong>Time at Cap</strong> measures how long the pool stayed full between one cast and the next.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Orb Overview" Stats="@BuildOverviewStats()" />
        <StackedBar Segments="@BuildStackedBar()" />
        @if (OvercapsByGenerator is { Count: > 0 } breakdown)
        {
            <SubSection Title="Overcap by Generator">
                <div>
                    @foreach (var (abilityId, incidents) in breakdown)
                    {
                        <StatRow Value="@incidents.Count.ToString()"
                                 Color="@PerformanceColors.Fail"
                                 Tooltip="@DescribeIncidents(incidents)">
                            orbs lost while capped, generated by <SpellLink Spell="abilityId" />
                        </StatRow>
                    }
                </div>
            </SubSection>
        }
        else
        {
            <HelperText>No Winter Orb gains were lost to overcap.</HelperText>
        }
    </ChildContent>
</GuideSection>

@code {
    private const int MaxIncidentTimestamps = 8;

    private WinterOrbTracker Tracker => Parser.WinterOrbTracker!;

    private int FightSpanMs => Parser.FightEndTime - Parser.FightStartTime;

    private double CappedSharePercent =>
        FightSpanMs > 0 ? (double)Tracker.CappedMs / FightSpanMs * 100 : 0;

    private List<(int AbilityId, List<Incident> Incidents)> OvercapsByGenerator =>
    [
        .. Tracker.OvercapIncidents
            .GroupBy(incident => incident.AbilityId)
            .Select(group => (AbilityId: group.Key, Incidents: group.ToList()))
            .OrderByDescending(entry => entry.Incidents.Count)
            .ThenBy(entry => entry.Incidents[0].Timestamp)
    ];

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var overcapRate = Tracker.Generated > 0
            ? (double)Tracker.Wasted / Tracker.Generated * 100
            : 0;
        var cappedShare = CappedSharePercent;

        return
        [
            new OverviewStat(
                $"{Tracker.Generated}",
                "Generated",
                "Total Winter Orbs generated during the encounter."),
            new OverviewStat(
                $"{Tracker.Spent}",
                "Spent",
                "Total Winter Orbs consumed by spenders."),
            new OverviewStat(
                $"{Tracker.Wasted}",
                "Overcapped",
                $"Orbs lost to overcap ({overcapRate:F0}% of potential).",
                Tracker.Wasted == 0 ? QualitativePerformance.Perfect
                    : overcapRate < 10 ? QualitativePerformance.Good
                    : overcapRate < 20 ? QualitativePerformance.Ok
                    : QualitativePerformance.Fail),
            new OverviewStat(
                FormatDuration(Tracker.CappedMs),
                "Time at Cap",
                $"Time the pool sat at {Tracker.MaxOrbs} orbs ({cappedShare:F0}% of the fight), where every further gain is wasted.",
                Tracker.CappedMs == 0 ? QualitativePerformance.Perfect
                    : cappedShare < 5 ? QualitativePerformance.Good
                    : cappedShare < 10 ? QualitativePerformance.Ok
                    : QualitativePerformance.Fail),
        ];
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar()
    {
        return
        [
            new StackedBarSegment("Spent", Tracker.Spent, PerformanceColors.Good,
                $"Spent: {Tracker.Spent} orbs consumed by spenders"),
            new StackedBarSegment("Overcapped", Tracker.Wasted, PerformanceColors.Fail,
                $"Overcapped: {Tracker.Wasted} orbs lost to cap"),
            new StackedBarSegment("Remaining", Tracker.Current, FaVar.Steel,
                $"Remaining: {Tracker.Current} orbs at fight end"),
        ];
    }

    private string DescribeIncidents(List<Incident> incidents)
    {
        var shown = incidents
            .Take(MaxIncidentTimestamps)
            .Select(incident => Parser.FormatTimestamp(incident.Timestamp));
        var times = string.Join(", ", shown);
        var remaining = incidents.Count - MaxIncidentTimestamps;

        return remaining > 0
            ? $"Lost at {times}, and {remaining} more."
            : $"Lost at {times}.";
    }

    private static string FormatDuration(int milliseconds)
    {
        var totalSeconds = milliseconds / 1000;
        return $"{totalSeconds / 60}:{totalSeconds % 60:00}";
    }
}
