@using FellowshipAnalyzer.Heroes.Rime.Analysis
@inject RimeCombatLogParser Parser

@if (Parser.WintersEmbraceWindowAnalyzers.Count > 0)
{
    <WintersEmbraceGuide />
}

@if (Parser.WinterOrbTracker is not null)
{
    <WinterOrbGuide />
}

@if (Parser.MajorCooldownAnalyzers.Count > 0)
{
    <CooldownsGuide />
}

@if (Parser.DowntimeAnalyzers.Count > 0)
{
    <DowntimeGuide />
}
