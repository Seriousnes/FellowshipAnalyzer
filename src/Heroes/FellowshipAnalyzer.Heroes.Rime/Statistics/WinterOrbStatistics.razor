@inherits AnalyzerStatistic<WinterOrbTracker>

<StatCard Title="Winter Orb Efficiency">
    <CastOverview Title="Orb Overview" Stats="@BuildOverviewStats()" />
    <StackedBar Segments="@BuildStackedBar()" />
</StatCard>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var overcapRate = (Analyzer.Generated + Analyzer.Wasted) > 0
            ? (double)Analyzer.Wasted / (Analyzer.Generated + Analyzer.Wasted) * 100
            : 0;

        return
        [
            new OverviewStat(
                $"{Analyzer.Generated}",
                "Generated",
                "Total Winter Orbs generated during the encounter."),
            new OverviewStat(
                $"{Analyzer.Spent}",
                "Spent",
                "Total Winter Orbs consumed by spenders."),
            new OverviewStat(
                $"{Analyzer.Wasted}",
                "Overcapped",
                $"Orbs lost to overcap ({overcapRate:F0}% of potential).",
                Analyzer.Wasted == 0 ? PerformanceTier.Perfect
                    : overcapRate < 10 ? PerformanceTier.Good
                    : overcapRate < 20 ? PerformanceTier.Ok
                    : PerformanceTier.Fail),
        ];
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar()
    {
        return
        [
            new StackedBarSegment("Spent", Analyzer.Spent, PerformanceColors.Good,
                $"Spent: {Analyzer.Spent} orbs consumed by spenders"),
            new StackedBarSegment("Overcapped", Analyzer.Wasted, PerformanceColors.Fail,
                $"Overcapped: {Analyzer.Wasted} orbs lost to cap"),
            new StackedBarSegment("Remaining", Analyzer.Current, "#6688aa",
                $"Remaining: {Analyzer.Current} orbs at fight end"),
        ];
    }
}
