@inherits EventSubscriber
@using RimeCommon = FellowshipAnalyzer.Core.Common.Spells.Rime

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic => ProcsGained > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="RimeCommon.Talents.FrostweaversWrath" />
            </Header>
            <Info>
                <p>
                    Every Winter Orb you gain has a 20% chance to bank a proc that makes your next Winter Orb
                    spender a guaranteed critical strike. A proc is worth exactly one spender cast, so it is
                    lost when the buff falls off unspent and lost again when a fresh roll lands on top of one
                    still banked.
                </p>
            </Info>
            <ChildContent>
                <StatRow Value="@ProcsGained.ToString()"
                         Tooltip="Procs banked this fight, counting every fresh roll.">
                    procs banked
                </StatRow>
                <StatRow Value="@ProcsConsumed.ToString()"
                         Tooltip="Procs spent on Glacial Blast, Ice Comet, Talon Strike or Rising Talons.">
                    spent on a Winter Orb spender
                </StatRow>
                <StatRow Value="@ProcsExpired.ToString()"
                         Tooltip="Procs whose buff fell off without a spender cast.">
                    expired unspent
                </StatRow>
                <StatRow Value="@ProcsOverwritten.ToString()"
                         Tooltip="Procs replaced by a fresh roll while still banked.">
                    overwritten by a fresh roll
                </StatRow>
                <StatRow Value="@UtilisationText" Color="@PerformanceColors.ToColor(UtilisationTier)">
                    of banked procs reached a spender
                </StatRow>
            </ChildContent>
        </StatCard>;

    private string UtilisationText => $"{UtilisationShare * 100:F0}%";

    private QualitativePerformance UtilisationTier => UtilisationShare switch
    {
        >= 0.90 => QualitativePerformance.Perfect,
        >= 0.75 => QualitativePerformance.Good,
        >= 0.50 => QualitativePerformance.Ok,
        _ => QualitativePerformance.Fail,
    };
}
