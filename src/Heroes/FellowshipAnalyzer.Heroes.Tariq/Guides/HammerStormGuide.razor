@using FellowshipAnalyzer.Core.Common.Spells
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Tariq.Spells
@inherits ReportComponent<TariqCombatLogParser>

@{
    var analyzers = Parser.HammerStormAnalyzers.Select(analyzer => analyzer.Analyzer).ToList();
    var casts = analyzers.SelectMany(analyzer => analyzer.Casts).ToList();
    var talented = analyzers.Any(analyzer => analyzer.SchismTalented);
}

@if (casts.Count > 0)
{
    <GuideSection Title="Hammer Storm">
        <LeftPanel>
            <p>
                Save <SpellLink Spell="Spells.HammerStorm" /> for @HammerStormAnalyzer.TargetBreakEven or more
                targets, and let the channel finish.
            </p>
            @if (talented)
            {
                <p>
                    Spend a held <SpellLink Spell="Spells.SchismHammerStorm" /> proc rather than letting it
                    expire.
                </p>
            }
        </LeftPanel>
        <RightPanel>
            <CastOverview Title="Hammer Storm Overview" Stats="@BuildOverviewStats(analyzers, casts, talented)" />

            <CastDetail Title="Hammer Storm Channels"
                        Description="Each card is one Hammer Storm channel: the targets its first spin caught, whether a Schism proc empowered it, and how many of its spins completed."
                        Casts="@BuildCastRows(talented)" />
        </RightPanel>
    </GuideSection>
}

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats(
        List<HammerStormAnalyzer> analyzers,
        List<HammerStormCast> casts,
        bool talented)
    {
        var connected = casts.Count(cast => cast.TargetsHit > 0);
        var whiffed = casts.Count - connected;
        var empowered = analyzers.Sum(analyzer => analyzer.SchismEmpoweredCasts);
        var truncated = analyzers.Sum(analyzer => analyzer.TruncatedChannels);
        var underBreakEven = analyzers.Sum(analyzer => analyzer.UnderBreakEvenChannels);
        var averageTargets = connected == 0
            ? 0d
            : casts.Where(cast => cast.TargetsHit > 0).Average(cast => cast.TargetsHit);

        var stats = new List<OverviewStat>
        {
            new(
                $"{casts.Count}",
                "Channels",
                $"Hammer Storm casts across every pull, {empowered} of them empowered by a Schism proc."
                + (whiffed > 0 ? $" {whiffed} produced no damage at all." : string.Empty)),
            new(
                $"{underBreakEven}",
                "Under Break-Even",
                $"Channels that caught fewer than {HammerStormAnalyzer.TargetBreakEven} targets.",
                underBreakEven == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new(
                $"{truncated}",
                "Truncated Channels",
                $"Channels that dealt damage but stopped before their {Ordinal(HammerStormAnalyzer.ExpectedSpins)} spin. "
                + $"Rated as a share of the {connected} channels that connected: none is perfect, up to a twentieth is good, up to a seventh is passable.",
                CleanShareTier(connected, truncated, 100, 95, 86)),
            new(
                $"{averageTargets:0.0}",
                "Avg Targets Hit",
                $"Mean first-spin targets over the {connected} channels that connected. Target counts hold steady across a channel's spins, so the first spin reads the whole."),
            new(
                TargetSpread(analyzers),
                "Single / 5+ Targets",
                "Channels whose first spin caught exactly one target, against those that caught five or more."),
        };

        if (talented)
            stats.Add(SchismStat(analyzers));

        return stats;
    }

    private static string TargetSpread(List<HammerStormAnalyzer> analyzers)
    {
        var buckets = analyzers
            .SelectMany(analyzer => analyzer.TargetsHitDistribution)
            .GroupBy(bucket => bucket.TargetsHit)
            .ToDictionary(group => group.Key, group => group.Sum(bucket => bucket.Channels));

        if (buckets.Count == 0)
            return "-";

        var single = buckets.TryGetValue(1, out var one) ? one : 0;
        var wide = buckets.Where(bucket => bucket.Key >= 5).Sum(bucket => bucket.Value);

        return $"{single} / {wide}";
    }

    private static OverviewStat SchismStat(List<HammerStormAnalyzer> analyzers)
    {
        var skullCrusher = Sum(analyzers.Select(analyzer => analyzer.SkullCrusherProcs));
        var hammerStorm = Sum(analyzers.Select(analyzer => analyzer.HammerStormProcs));
        var gained = skullCrusher.Gained + hammerStorm.Gained;
        var consumed = skullCrusher.Consumed + hammerStorm.Consumed;
        var expired = skullCrusher.Expired + hammerStorm.Expired;
        var overwritten = skullCrusher.Overwritten + hammerStorm.Overwritten;

        if (gained == 0)
        {
            return new OverviewStat(
                "-",
                "Schism Procs Used",
                "Schism is talented but no proc was logged, so there is nothing to rate yet.");
        }

        var used = (int)Math.Round(consumed * 100d / gained);

        return new OverviewStat(
            $"{used}%",
            "Schism Procs Used",
            $"{consumed} of {gained} procs were spent; {expired} expired unused"
            + (overwritten > 0 ? $" and {overwritten} were overwritten" : string.Empty)
            + $". Skull Crusher procs: {skullCrusher.Consumed} of {skullCrusher.Gained} spent, {skullCrusher.Expired} expired. "
            + $"Hammer Storm procs: {hammerStorm.Consumed} of {hammerStorm.Gained} spent, {hammerStorm.Expired} expired.",
            PerformanceTiers.FromThresholds(used, 90, 75, 60));
    }

    private IEnumerable<PerCastData> BuildCastRows(bool talented) =>
        Parser.HammerStormAnalyzers.ToItemRows(Parser, analyzer => analyzer.Casts, (cast, pull) => BuildCastRow(cast, talented));

    private PerCastRow BuildCastRow(HammerStormCast cast, bool talented)
    {
        var performance = CastTier(cast);

        var stats = new List<PerCastStat>
        {
            new(
                $"{cast.TargetsHit}",
                "Targets Hit",
                cast.TargetsHit == 0
                    ? "The channel connected with nothing, so no target count can be read from it."
                    : cast.UnderTargetBreakEven
                        ? $"Distinct units the first spin caught, under the {HammerStormAnalyzer.TargetBreakEven} break-even."
                        : $"Distinct units the first spin caught, at or past the {HammerStormAnalyzer.TargetBreakEven} break-even.",
                cast.TargetsHit == 0 ? null
                    : cast.UnderTargetBreakEven ? QualitativePerformance.Fail
                    : QualitativePerformance.Perfect),
            new(
                $"{cast.SpinsCompleted}/{HammerStormAnalyzer.ExpectedSpins}",
                "Spins Completed",
                cast.Truncated
                    ? $"The channel was cut off before its {Ordinal(HammerStormAnalyzer.ExpectedSpins)} spin."
                    : $"Damage bursts observed for this channel, out of the {HammerStormAnalyzer.ExpectedSpins} a full channel completes.",
                SpinTier(cast)),
        };

        if (talented)
        {
            stats.Add(new PerCastStat(
                cast.SchismEmpowered ? "Yes" : "No",
                "Schism Proc",
                cast.SchismEmpowered
                    ? "A Schism proc was held when this channel was cast."
                    : "No Schism proc was held when this channel was cast."));
        }

        if (cast.NextAbilityId is { } nextId)
        {
            var name = SpellRegistry.MaybeGet(nextId)?.Name ?? "Unknown";

            stats.Add(new PerCastStat(
                name,
                "Next Cast",
                $"The first ability you cast at or after this channel's last spin. Cast order only - it does not establish that {name} ended the channel."));
        }

        return new PerCastRow
        {
            Performance = performance,
            Stats = [.. stats],
            Timestamp = cast.Timestamp,
            Details = BuildDetails(cast),
        };
    }

    private RenderFragment BuildDetails(HammerStormCast cast) =>
    @<div>
        @Outcome(cast)
        @if (cast.NextAbilityId is { } nextId && SpellRegistry.MaybeGet(nextId) is { } next)
        {
            <span>The next thing you cast was <SpellLink Spell="next" />.</span>
        }
    </div>;

    private static string Outcome(HammerStormCast cast)
    {
        if (cast.TargetsHit == 0)
            return "This channel connected with nothing, so it produced no damage.";

        var targets = cast.TargetsHit == 1 ? "1 target" : $"{cast.TargetsHit} targets";

        if (cast.Truncated)
        {
            return cast.NextAbilityId is null
                ? $"Only {cast.SpinsCompleted} of {HammerStormAnalyzer.ExpectedSpins} spins completed, on {targets}. No cast of yours followed the last spin, so the pack dying or the pull ending is the likely cause."
                : $"Only {cast.SpinsCompleted} of {HammerStormAnalyzer.ExpectedSpins} spins completed, on {targets}.";
        }

        if (cast.UnderTargetBreakEven)
            return $"The full channel completed, but on {targets}, under the {HammerStormAnalyzer.TargetBreakEven} break-even.";

        return cast.SchismEmpowered
            ? $"The full channel completed across {targets}, empowered by a Schism proc."
            : $"The full channel completed across {targets}.";
    }

    private static SchismProcEconomy Sum(IEnumerable<SchismProcEconomy> economies)
    {
        var gained = 0;
        var consumed = 0;
        var overwritten = 0;
        var expired = 0;

        foreach (var economy in economies)
        {
            gained += economy.Gained;
            consumed += economy.Consumed;
            overwritten += economy.Overwritten;
            expired += economy.Expired;
        }

        return new SchismProcEconomy(gained, consumed, overwritten, expired);
    }

    private static string Ordinal(int value) => value switch
    {
        1 => "first",
        2 => "second",
        3 => "third",
        4 => "fourth",
        _ => $"{value}th",
    };

    private static QualitativePerformance? CleanShareTier(int connected, int offenders, double perfect, double good, double ok) =>
        connected == 0
            ? null
            : PerformanceTiers.FromThresholds((connected - offenders) * 100d / connected, perfect, good, ok);

    private static QualitativePerformance SpinTier(HammerStormCast cast)
    {
        if (cast.Truncated)
            return QualitativePerformance.Fail;

        return cast.SpinsCompleted >= HammerStormAnalyzer.ExpectedSpins
            ? QualitativePerformance.Perfect
            : QualitativePerformance.Ok;
    }

    private static QualitativePerformance CastTier(HammerStormCast cast)
    {
        if (cast.Truncated || cast.UnderTargetBreakEven)
            return QualitativePerformance.Fail;

        return cast.TargetsHit == 0 ? QualitativePerformance.Ok : QualitativePerformance.Perfect;
    }
}
