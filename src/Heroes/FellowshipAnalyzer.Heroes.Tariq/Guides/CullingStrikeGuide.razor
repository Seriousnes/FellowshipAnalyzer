@using Spells = FellowshipAnalyzer.Core.Common.Spells.Tariq.Spells
@inherits ReportComponent<TariqCombatLogParser>

@{
    var analyzers = Parser.CullingStrikeAnalyzers.Select(entry => entry.Analyzer).ToList();
    var phased = analyzers.Where(analyzer => analyzer.ExecutePhaseStartTimestamp is not null).ToList();
    var opportunities = analyzers.SelectMany(analyzer => analyzer.Opportunities).ToList();
    var grin = GrinTracker();
}

@if (analyzers.Count > 0)
{
    <GuideSection Title="Culling Strike">
        <Explanation>
            <p>
                Once the boss is inside the execute window, <SpellLink Spell="Spells.CullingStrike" /> is the
                button you press every time it comes up, with at least
                @CullingStrikeAnalyzer.FullStrengthFury Fury banked. It converts what it spends into damage
                up to that point, so pressing it near empty throws the cast away as surely as not pressing it.
            </p>
            <p>
                Each time the cooldown ended is counted as one opportunity. Holding it because Fury was short
                is a Fury problem and is marked separately from holding it with Fury in the bank, which is the
                one worth fixing.
            </p>
            @if (grin is { Equipped: true })
            {
                <p>
                    <SpellLink Spell="Spells.ExecutionersGrin" /> from Executioner's Unsanitary Bands lets a
                    cast go out above the threshold. The proc is spent by the next Culling Strike whatever the
                    target's health, so the only loss you control is letting one fall off with no cast at all.
                </p>
            }
        </Explanation>
        <ChildContent>
            <CastOverview Title="Execute Phase Overview" Stats="@BuildOverviewStats(analyzers, phased, opportunities)" />

            @if (opportunities.Count > 0)
            {
                <CastDetail Title="Cooldown Opportunities"
                            Description="Each card is one moment Culling Strike came up inside the execute phase, and what happened next."
                            Casts="@BuildOpportunityRows()" />
            }

            @if (grin is { Equipped: true, Procs: > 0 })
            {
                <SubSection Title="Executioner's Grin">
                    <HelperText>
                        Procs from Executioner's Unsanitary Bands and what each one bought.
                    </HelperText>
                    <CastOverview Title="Proc Economy" Stats="@BuildGrinStats(grin)" />
                </SubSection>
            }
        </ChildContent>
    </GuideSection>
}

@code {
    private ExecutionersGrinTracker? GrinTracker() => Parser.ExecutionersGrinTracker;

    private IEnumerable<OverviewStat> BuildOverviewStats(
        List<CullingStrikeAnalyzer> analyzers,
        List<CullingStrikeAnalyzer> phased,
        List<CullingStrikeOpportunity> opportunities)
    {
        var inPhase = phased.Sum(analyzer => analyzer.CastsInPhase);
        var phaseMs = phased.Sum(analyzer => (long)analyzer.ExecutePhaseDurationMs);
        var prompt = analyzers.Sum(analyzer => analyzer.PromptCasts);
        var heldWithFury = analyzers.Sum(analyzer => analyzer.HeldWithFury);
        var heldWithoutFury = analyzers.Sum(analyzer => analyzer.HeldWithoutFury);
        var idleMs = analyzers.Sum(analyzer => (long)analyzer.IdleMs);
        var unexplained = analyzers.Sum(analyzer => analyzer.UnexplainedCastsAboveThreshold);

        var stats = new List<OverviewStat>
        {
            new(
                $"{inPhase}",
                "Casts in Phase",
                phased.Count == 0
                    ? "No boss pull was observed reaching the execute threshold."
                    : $"Culling Strikes landed inside an execute phase, over {phaseMs / 1000d:0.0}s across {phased.Count} pull{(phased.Count == 1 ? "" : "s")}."),
        };

        if (opportunities.Count > 0)
        {
            stats.Add(new OverviewStat(
                $"{prompt}/{opportunities.Count}",
                "Pressed on Cooldown",
                $"Times the cooldown came up inside the execute phase and the cast went out within {CullingStrikeAnalyzer.PromptCastGraceMs / 1000d:0.0}s.",
                prompt == opportunities.Count ? QualitativePerformance.Perfect : QualitativePerformance.Ok));

            stats.Add(new OverviewStat(
                $"{heldWithFury}",
                "Held With Fury",
                $"Times it sat available with at least {CullingStrikeAnalyzer.FullStrengthFury} Fury banked and no cast followed. Every one is a Culling Strike the phase had room for.",
                heldWithFury == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Fail));

            stats.Add(new OverviewStat(
                $"{heldWithoutFury}",
                "Held Without Fury",
                $"Times it came up under {CullingStrikeAnalyzer.FullStrengthFury} Fury, so the cast would have landed weak. Counted here rather than against Culling Strike - it belongs to the Fury economy."));

            stats.Add(new OverviewStat(
                $"{idleMs / 1000d:0.0}s",
                "Time Idle",
                "Total execute-phase time Culling Strike spent available and unpressed, past the grace allowed for the cast."));
        }

        if (unexplained > 0)
        {
            stats.Add(new OverviewStat(
                $"{unexplained}",
                "Unexplained",
                $"Casts above {ThresholdLabel} with no Executioner's Grin buff held. The game gate makes these impossible, so this many readings are unreliable rather than this many mistakes."));
        }

        return stats;
    }

    private IEnumerable<OverviewStat> BuildGrinStats(ExecutionersGrinTracker grin) =>
    [
        new OverviewStat(
            $"{grin.Procs}",
            "Procs",
            grin.Reapplications > 0
                ? $"Executioner's Grin procs this encounter. {grin.Reapplications} landed on a proc already held and added nothing."
                : "Executioner's Grin procs this encounter."),
        new OverviewStat(
            $"{grin.SpentAboveThreshold}",
            "Extra Casts Bought",
            $"Procs spent on a Culling Strike above {ThresholdLabel}, which the gate would otherwise have blocked. This is what the item is for."),
        new OverviewStat(
            $"{grin.ExpiredUnspent}",
            "Expired Unspent",
            $"Procs that fell off with no Culling Strike at all. The other {grin.SpentBelowThreshold} were spent on a cast that was already legal, which the game does for you and you cannot avoid.",
            grin.ExpiredUnspent == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Ok),
    ];

    private IEnumerable<PerCastData> BuildOpportunityRows() =>
        Parser.CullingStrikeAnalyzers.ToItemRows(Parser, analyzer => analyzer.Opportunities, (opportunity, pull) => BuildOpportunityRow(opportunity));

    private PerCastRow BuildOpportunityRow(CullingStrikeOpportunity opportunity)
    {
        var performance = opportunity.Prompt
            ? QualitativePerformance.Perfect
            : opportunity.HadFury ? QualitativePerformance.Fail : QualitativePerformance.Ok;

        var stats = new List<PerCastStat>
        {
            new(
                opportunity.CastAt is null ? "Never" : $"{opportunity.HeldMs / 1000d:0.0}s",
                "Held",
                opportunity.CastAt is null
                    ? "The pull ended with Culling Strike still available."
                    : $"How long the cooldown sat available before the cast went out, against the {CullingStrikeAnalyzer.PromptCastGraceMs / 1000d:0.0}s allowed for it.",
                performance),
            new(
                opportunity.FuryAtReady is { } fury ? $"{fury}%" : "-",
                "Fury at Ready",
                opportunity.FuryAtReady is { } banked
                    ? banked >= CullingStrikeAnalyzer.FullStrengthFury
                        ? $"Fury held when the cooldown came up. {CullingStrikeAnalyzer.FullStrengthFury} was available, so the cast would have landed at full strength."
                        : $"Fury held when the cooldown came up, short of the {CullingStrikeAnalyzer.FullStrengthFury} a full-strength cast converts."
                    : "No event carried a Fury reading at this instant."),
        };

        return new PerCastRow
        {
            Performance = performance,
            Stats = [.. stats],
            Timestamp = opportunity.ReadyAt,
            Details = Summary(opportunity),
        };
    }

    private RenderFragment Summary(CullingStrikeOpportunity opportunity) =>
    @<div>@SummaryText(opportunity)</div>;

    private static string SummaryText(CullingStrikeOpportunity opportunity)
    {
        if (opportunity.Prompt)
            return "Pressed as it came up.";

        if (opportunity.CastAt is null)
        {
            return opportunity.HadFury
                ? $"The pull ended with Culling Strike available and {opportunity.FuryAtReady}% Fury banked."
                : "The pull ended with Culling Strike available but not enough Fury to press it well.";
        }

        return opportunity.HadFury
            ? $"Held {opportunity.HeldMs / 1000d:0.0}s with Fury in the bank. Press it the moment it comes up."
            : $"Held {opportunity.HeldMs / 1000d:0.0}s at {opportunity.FuryAtReady}% Fury, below the {CullingStrikeAnalyzer.FullStrengthFury} a full-strength cast converts.";
    }

    private static string ThresholdLabel => $"{CullingStrikeAnalyzer.ExecuteHealthThreshold * 100:0}%";
}
