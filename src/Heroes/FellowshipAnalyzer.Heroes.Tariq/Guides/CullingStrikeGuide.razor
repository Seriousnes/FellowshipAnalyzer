@using Spells = FellowshipAnalyzer.Core.Common.Spells.Tariq.Spells
@inherits GuideComponent<TariqCombatLogParser>

@{
    var analyzers = Parser.CullingStrikeAnalyzers.Select(entry => entry.Analyzer).ToList();
    var phased = analyzers.Where(analyzer => analyzer.ExecutePhaseStartTimestamp is not null).ToList();
    var opportunities = analyzers.SelectMany(analyzer => analyzer.Opportunities).ToList();
    var grin = GrinTracker();
}

@if (analyzers.Count > 0)
{
    <GuideSection Title="Culling Strike">
        <LeftPanel>
            <p>
                Inside the execute phase, cast <SpellLink Spell="Spells.CullingStrike" /> on cooldown. 
                Aim to always have at least @CullingStrikeAnalyzer.FullStrengthFury Fury for every cast.
            </p>
            @if (grin is { Equipped: true })
            {
                <p>
                    Try to use <SpellLink Spell="Spells.ExecutionersGrin" /> as soon as possible, to avoid 
                    overwriting any procs.
                </p>
            }
        </LeftPanel>
        <RightPanel>
            <CastOverview Title="Execute Phase Overview" Stats="@BuildOverviewStats(analyzers, phased, opportunities)" />

            @if (opportunities.Count > 0)
            {
                <CastDetail Title="Cooldown Opportunities"
                            Description="Each card is one moment Culling Strike became available inside the execute phase, and what happened next."
                            Casts="@BuildOpportunityRows()" />
            }

            @if (grin is { Equipped: true, Procs: > 0 })
            {
                <SubSection Title="Executioner's Grin">
                    <HelperText>
                        Procs from Executioner's Unsanitary Bands and where each one was spent.
                    </HelperText>
                    <CastOverview Title="Proc Economy" Stats="@BuildGrinStats(grin)" />
                </SubSection>
            }
        </RightPanel>
    </GuideSection>
}

@code {
    protected override bool IsActive() => Parser.CullingStrikeAnalyzers.Count > 0;

    private ExecutionersGrinTracker? GrinTracker() => Parser.ExecutionersGrinTracker;

    private IEnumerable<OverviewStat> BuildOverviewStats(
        List<CullingStrikeAnalyzer> analyzers,
        List<CullingStrikeAnalyzer> phased,
        List<CullingStrikeOpportunity> opportunities)
    {
        var inPhase = phased.Sum(analyzer => analyzer.CastsInPhase);
        var phaseMs = phased.Sum(analyzer => (long)analyzer.ExecutePhaseDurationMs);
        var prompt = analyzers.Sum(analyzer => analyzer.PromptCasts);
        var heldWithFury = analyzers.Sum(analyzer => analyzer.HeldWithFury);
        var heldWithoutFury = analyzers.Sum(analyzer => analyzer.HeldWithoutFury);
        var idleMs = analyzers.Sum(analyzer => (long)analyzer.IdleMs);
        var unexplained = analyzers.Sum(analyzer => analyzer.UnexplainedCastsAboveThreshold);

        var stats = new List<OverviewStat>
        {
            new(
                $"{inPhase}",
                "Casts in Phase",
                phased.Count == 0
                    ? "No boss pull was observed reaching the execute threshold."
                    : $"Culling Strikes cast inside an execute phase, excluding those recorded above {ThresholdLabel} health, over {phaseMs / 1000d:0.0}s across {phased.Count} pull{(phased.Count == 1 ? "" : "s")}."),
        };

        if (opportunities.Count > 0)
        {
            stats.Add(new OverviewStat(
                $"{prompt}/{opportunities.Count}",
                "Cast on Cooldown",
                $"Times the cooldown became available inside the execute phase and the cast went out within {CullingStrikeAnalyzer.PromptCastGraceMs / 1000d:0.0}s.",
                prompt == opportunities.Count ? QualitativePerformance.Perfect : QualitativePerformance.Ok));

            stats.Add(new OverviewStat(
                $"{heldWithFury}",
                "Held With Fury",
                $"Times the cooldown became available inside the execute phase with no Fury reading under {CullingStrikeAnalyzer.FullStrengthFury}, and no cast followed within the {CullingStrikeAnalyzer.PromptCastGraceMs / 1000d:0.0}s grace.",
                heldWithFury == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Fail));

            stats.Add(new OverviewStat(
                $"{heldWithoutFury}",
                "Held Without Fury",
                $"Times the cooldown became available inside the execute phase under {CullingStrikeAnalyzer.FullStrengthFury} Fury and no cast followed within the grace."));

            stats.Add(new OverviewStat(
                $"{idleMs / 1000d:0.0}s",
                "Time Idle",
                "Total execute-phase time Culling Strike spent available and not cast, past the grace allowed for the cast."));
        }

        if (unexplained > 0)
        {
            stats.Add(new OverviewStat(
                $"{unexplained}",
                "Unexplained",
                $"Casts above {ThresholdLabel} with no Executioner's Grin buff active. Unreliable readings rather than mistakes."));
        }

        return stats;
    }

    private IEnumerable<OverviewStat> BuildGrinStats(ExecutionersGrinTracker grin) =>
    [
        new OverviewStat(
            $"{grin.Procs}",
            "Procs",
            grin.Reapplications > 0
                ? $"Executioner's Grin procs this encounter. {grin.Reapplications} were reapplied on a proc already active."
                : "Executioner's Grin procs this encounter."),
        new OverviewStat(
            $"{grin.SpentAboveThreshold}",
            "Extra Casts",
            $"Procs spent above {ThresholdLabel}."),
        new OverviewStat(
            $"{grin.ExpiredUnspent}",
            "Expired Unspent",
            "Procs expired unspent.",
            grin.ExpiredUnspent == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Ok),
    ];

    private IEnumerable<PerCastData> BuildOpportunityRows() =>
        Parser.CullingStrikeAnalyzers.ToItemRows(Parser, analyzer => analyzer.Opportunities, (opportunity, pull) => BuildOpportunityRow(opportunity));

    private PerCastRow BuildOpportunityRow(CullingStrikeOpportunity opportunity)
    {
        var performance = opportunity.Prompt
            ? QualitativePerformance.Perfect
            : opportunity.HadFury ? QualitativePerformance.Fail : QualitativePerformance.Ok;

        var stats = new List<PerCastStat>
        {
            new(
                opportunity.CastAt is null ? "Never" : $"{opportunity.HeldMs / 1000d:0.0}s",
                "Held",
                opportunity.CastAt is null
                    ? "The pull ended with Culling Strike still available."
                    : $"How long the cooldown was available before the cast went out, against the {CullingStrikeAnalyzer.PromptCastGraceMs / 1000d:0.0}s allowed for it.",
                performance),
            new(
                opportunity.FuryAtReady is { } fury ? $"{fury}%" : "-",
                "Fury at Ready",
                opportunity.FuryAtReady is { } banked
                    ? banked >= CullingStrikeAnalyzer.FullStrengthFury
                        ? $"Fury held when the cooldown became available, at or above {CullingStrikeAnalyzer.FullStrengthFury}."
                        : $"Fury held when the cooldown became available, short of {CullingStrikeAnalyzer.FullStrengthFury}."
                    : "No event at this instant had a Fury reading."),
        };

        return new PerCastRow
        {
            Performance = performance,
            Stats = [.. stats],
            Timestamp = opportunity.ReadyAt,
            Details = Summary(opportunity),
        };
    }

    private RenderFragment Summary(CullingStrikeOpportunity opportunity) =>
    @<div>@SummaryText(opportunity)</div>;

    private static string SummaryText(CullingStrikeOpportunity opportunity)
    {
        if (opportunity.Prompt)
            return "Cast as it became available.";

        if (opportunity.CastAt is null)
        {
            if (opportunity.FuryAtReady is not { } atEnd)
                return "The pull ended with Culling Strike available and no Fury reading.";

            return atEnd >= CullingStrikeAnalyzer.FullStrengthFury
                ? $"The pull ended with Culling Strike available and {atEnd}% Fury banked."
                : $"The pull ended with Culling Strike available and Fury under {CullingStrikeAnalyzer.FullStrengthFury}.";
        }

        return opportunity.HadFury
            ? $"Held {opportunity.HeldMs / 1000d:0.0}s. Cast it the moment it becomes available."
            : $"Held {opportunity.HeldMs / 1000d:0.0}s at {opportunity.FuryAtReady}% Fury, below {CullingStrikeAnalyzer.FullStrengthFury}.";
    }

    private static string ThresholdLabel => $"{CullingStrikeAnalyzer.ExecuteHealthThreshold * 100:0}%";
}
