@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Core.Contracts.Design
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Tariq.Spells
@inherits ReportComponentBase
@inject TariqCombatLogParser Parser
@inject ChartPalette Palette

<GuideSection Title="Fury Economy">
    <Explanation>
        <p>
            Fury caps at 100 and every generator pays a flat amount, so a cast made near the top of the
            bar throws away exactly the points that would have crossed the cap. Those lost points are the
            measure here, counted per cast rather than as time spent sitting full.
        </p>
        <p>
            <SpellLink Spell="Spells.LeapSmash" /> is the one that hurts: it returns 20 Fury, the largest
            single gain in the kit, but it plays as a mobility button and is routinely fired while the bar
            is already full.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Fury Overview" Stats="@BuildOverviewStats()" />

        @if (Charted is { } charted)
        {
            <SubSection Title="Fury Over Time">
                <HelperText>
                    Fury held at every cast through @charted.Pull.Name, as a percentage of the cap.
                    @if (Parser.FuryEconomyAnalyzers.Count > 1)
                    {
                        <text>Use the pull selector in the report header to chart another pull.</text>
                    }
                </HelperText>
                <AuraStackGraph Samples="@charted.Samples"
                                Bands="@ChartBands(charted)"
                                YAxisTitle="Fury"
                                Height="260" />
            </SubSection>
        }

        <CastDetail Title="Per-Pull Fury Economy"
                    Description="Each card is one pull, rated on the Fury points its generators threw away at the cap."
                    Casts="@BuildPerPullData()" />
    </ChildContent>
</GuideSection>

@code {
    private List<FuryEconomyAnalyzer> Analyzers() =>
        Parser.FuryEconomyAnalyzers.Select(entry => entry.Analyzer).ToList();

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();
        var wasted = analyzers.Sum(analyzer => analyzer.WastedFury);
        var potential = analyzers.Sum(analyzer => analyzer.PotentialGeneration);
        var overcap = analyzers.Sum(analyzer => analyzer.OvercapCasts);
        var generators = analyzers.Sum(analyzer => analyzer.GeneratorCasts);
        var span = analyzers.Sum(analyzer => (long)analyzer.ActiveSpanMs);

        var perMinute = span <= 0 ? 0 : wasted * 60_000d / span;
        var discipline = DisciplinePercent(potential == 0 ? 0 : (double)wasted / potential);

        var stats = new List<OverviewStat>
        {
            new(
                $"{wasted}",
                "Wasted Fury",
                $"Fury points lost to the cap across every pull, {perMinute:0.#} per minute of combat."),
            new(
                $"{discipline}%",
                "Fury Discipline",
                $"Share of the {potential} Fury your generators could have produced that actually landed in the bar.",
                DisciplineTier(discipline)),
            new(
                $"{overcap}",
                "Overcap Casts",
                $"{overcap} of {generators} generator casts pushed Fury past 100 and lost the remainder."),
        };

        if (TopWaster() is { } top)
        {
            var name = SpellName(top.SpellId);
            stats.Add(new OverviewStat(
                name,
                "Biggest Waster",
                $"{top.WastedFury} of the {wasted} wasted points came from {top.Casts} {name} casts."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.FuryEconomyAnalyzers.ToPullRows(Parser, (analyzer, pull) => BuildPullRow(analyzer));

    private PerCastRow BuildPullRow(FuryEconomyAnalyzer analyzer)
    {
        var discipline = DisciplinePercent(analyzer.WasteRate);
        var perf = DisciplineTier(discipline);
        var top = analyzer.WasteByAbility.FirstOrDefault();
        var wasterName = top.WastedFury > 0 ? SpellName(top.SpellId) : "None";

        var stats = new[]
        {
            new PerCastStat(
                $"{analyzer.WastedFury}",
                "Wasted Fury",
                $"Fury points lost to the cap in this pull, {analyzer.WastedFuryPerMinute:0.#} per minute across {analyzer.OvercapCasts} of {analyzer.GeneratorCasts} generator casts.",
                Performance: perf),
            new PerCastStat(
                wasterName,
                "Biggest Waster",
                top.WastedFury > 0
                    ? $"{top.WastedFury} points lost over {top.Casts} {wasterName} casts."
                    : "No generator cast crossed the cap in this pull."),
            new PerCastStat(
                $"{analyzer.SkullCrusherCasts} / {analyzer.HammerStormCasts} / {analyzer.CullingStrikeCasts}",
                "Skull / Hammer / Culling",
                $"Skull Crusher, Hammer Storm and Culling Strike casts - the {analyzer.SpenderCasts} spenders that drained the bar this pull."),
        };

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
        };
    }

    private AbilityWaste? TopWaster()
    {
        var top = Parser.FuryEconomyAnalyzers
            .SelectMany(entry => entry.Analyzer.WasteByAbility)
            .GroupBy(waste => waste.SpellId)
            .Select(group => new AbilityWaste(group.Key, group.Sum(waste => waste.Casts), group.Sum(waste => waste.WastedFury)))
            .OrderByDescending(waste => waste.WastedFury)
            .ThenBy(waste => waste.SpellId)
            .FirstOrDefault();

        return top.WastedFury > 0 ? top : null;
    }

    /// <summary>
    /// The pull the Fury curve plots. The report header's pull selector already clamps the analyzer
    /// stream, so a chosen pull leaves exactly one; unclamped, the boss pull reads as the interesting one
    /// and the busiest pull stands in when a dungeon run has no boss.
    /// </summary>
    private FuryCurve? Charted
    {
        get
        {
            var entries = Parser.FuryEconomyAnalyzers;
            if (Parser.FuryTracker is not { } tracker || tracker.Samples.Count == 0 || entries.Count == 0)
                return null;

            var busiest = entries.MaxBy(entry => entry.Analyzer.GeneratorCasts + entry.Analyzer.SpenderCasts);
            var chosen = entries.FirstOrDefault(entry => entry.Pull.IsBoss, busiest);
            var pull = chosen.Pull;

            var slice = tracker.Samples
                .Where(sample => sample.Timestamp >= pull.StartTime && sample.Timestamp <= pull.EndTime)
                .ToList();

            return slice.Count == 0
                ? null
                : new FuryCurve(pull, [.. slice.Select(sample => sample.Timestamp)], [.. slice.Select(sample => sample.Fury)]);
        }
    }

    private IReadOnlyList<AuraStackBand> ChartBands(FuryCurve curve) =>
        [new AuraStackBand("Fury", Palette.Resolve(nameof(FaPalette.Amber)), curve.Values)];

    private static string SpellName(int spellId) => SpellRegistry.MaybeGet(spellId)?.Name ?? "Unknown";

    private static int DisciplinePercent(double wasteRate) => (int)Math.Round((1 - wasteRate) * 100);

    private static QualitativePerformance DisciplineTier(int discipline) =>
        PerformanceTiers.FromThresholds(discipline, 97, 92, 85);

    private sealed record FuryCurve(Pull Pull, IReadOnlyList<int> Samples, IReadOnlyList<int> Values);
}
