@using FellowshipAnalyzer.Core.Common.Spells
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Tariq.Spells
@using Talents = FellowshipAnalyzer.Core.Common.Spells.Tariq.Talents
@inherits ReportComponent<TariqCombatLogParser>

@{
    var analyzers = Parser.FocusedWrathAnalyzers.Select(entry => entry.Analyzer).ToList();
    var windows = analyzers.SelectMany(analyzer => analyzer.Windows).ToList();
    var talented = analyzers.Any(analyzer => analyzer.SchismTalented);
}

@if (windows.Count > 0)
{
    <GuideSection Title="Focused Wrath">
        <LeftPanel>
            @if (talented)
            {
                <p>
                    Attempt to spend both <SpellLink Spell="Talents.Schism" /> empowered <SpellLink Spell="Spells.HammerStorm" /> with
                    the <SpellLink Spell="Spells.FocusedWrath" />, in both AoE and single target.
                </p>
            }
            else
            {
                <p>
                    Spend the charges of <SpellLink Spell="Spells.FocusedWrath" /> on
                    <SpellLink Spell="Spells.HammerStorm" /> or <SpellLink Spell="Spells.SkullCrusher" /> is mostly
                    determined by target count. For single target, or high priority targets use <SpellLink Spell="Spells.SkullCrusher" />,
                    or <SpellLink Spell="Spells.HammerStorm" /> at @HammerStormAnalyzer.TargetBreakEven or more targets.
                </p>
            }
            <p>
                See the table for the effectiveness and accuracy of each use, such as the wrong ability
                choice for the situation, or letting the buff fall off without spending both charges.
            </p>
        </LeftPanel>
        <RightPanel>
            <CastOverview Title="Focused Wrath Overview" Stats="@BuildOverviewStats(analyzers)" />

            <CastDetail Title="Focused Wrath Buffs"
                        Description="Each card is one Focused Wrath buff: the charges it carried, the spender each charge went to, and where the buff came from."
                        Casts="@BuildWrathRows()" />
        </RightPanel>
    </GuideSection>
}

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats(List<FocusedWrathAnalyzer> analyzers)
    {
        var granted = analyzers.Sum(analyzer => analyzer.ChargesGranted);
        var consumed = analyzers.Sum(analyzer => analyzer.ChargesConsumed);
        var wasted = analyzers.Sum(analyzer => analyzer.ChargesWasted);
        var fromCast = analyzers.Sum(analyzer => analyzer.ChargesFromCast);
        var fromProc = analyzers.Sum(analyzer => analyzer.ChargesFromProc);
        var correct = analyzers.Sum(analyzer => analyzer.CorrectSpenders);
        var wrong = analyzers.Sum(analyzer => analyzer.WrongSpenders);
        var unnamed = analyzers.Sum(analyzer => analyzer.UnratedConsumptions);
        var rated = correct + wrong;

        var stats = new List<OverviewStat>
        {
            new(
                $"{consumed}/{granted}",
                "Charges Spent",
                $"Charges a spender took, out of the {granted} the buffs carried. {wasted} fell off unspent. "
                + $"{fromCast} came from a Focused Wrath cast and {fromProc} from a Leap Smash proc.",
                wasted == 0
                    ? QualitativePerformance.Perfect
                    : PerformanceTiers.FromThresholds(consumed * 100d / granted, 100, 95, 85)),
        };

        if (rated > 0)
        {
            stats.Add(new OverviewStat(
                $"{correct}/{rated}",
                "Correct Spender",
                $"Charges that went to the spender their pull calls for. {wrong} went to the other one."
                + (unnamed > 0 ? $" A further {unnamed} had no spender cast to name them." : string.Empty),
                PerformanceTiers.FromThresholds(correct * 100d / rated, 95, 85, 70)));
        }

        stats.Add(new OverviewStat(
            SpenderSplit(analyzers),
            "Spender Split",
            "Charges Hammer Storm took, against those Skull Crusher took."));

        return stats;
    }

    private static string SpenderSplit(List<FocusedWrathAnalyzer> analyzers) =>
        $"{analyzers.Sum(analyzer => analyzer.HammerStormConsumptions)} / "
        + $"{analyzers.Sum(analyzer => analyzer.SkullCrusherConsumptions)}";

    private IEnumerable<PerCastData> BuildWrathRows() =>
        Parser.FocusedWrathAnalyzers.ToItemRows(Parser, analyzer => analyzer.Windows, (window, pull) => BuildWrathRow(window));

    private static PerCastRow BuildWrathRow(FocusedWrathWindow window)
    {
        var openedWith = window.FromCast ? FocusedWrathAnalyzer.StacksPerCast : 1;
        var toppedUp = window.ChargesGranted - openedWith;

        var stats = new List<PerCastStat>
        {
            new(
                $"{window.ChargesConsumed}/{window.ChargesGranted}",
                "Charges Spent",
                ChargeTooltip(window),
                ChargeTier(window)),
            new(
                SpenderNames(window),
                "Spent On",
                SpenderTooltip(window),
                SpenderTier(window)),
            new(
                window.FromCast ? "Cast" : "Leap Smash",
                "Source",
                (window.FromCast
                    ? $"A Focused Wrath cast opened this buff with {FocusedWrathAnalyzer.StacksPerCast} charges."
                    : "A Leap Smash proc opened this buff with one charge.")
                + (toppedUp switch
                {
                    0 => string.Empty,
                    1 => " A Leap Smash proc added one more while it was up.",
                    _ => $" Leap Smash procs added {toppedUp} more while it was up.",
                })),
        };

        return new PerCastRow
        {
            Performance = RowTier(window),
            Stats = [.. stats],
            Timestamp = window.OpenedAt,
        };
    }

    private static string SpenderNames(FocusedWrathWindow window)
    {
        var names = new List<string>();

        foreach (var consumption in window.Consumptions)
        {
            if (consumption.SpenderSpellId is not { } id)
                continue;

            var name = SpellRegistry.MaybeGet(id)?.Name ?? "Unknown";
            if (!names.Contains(name))
                names.Add(name);
        }

        return names.Count == 0 ? "None" : string.Join(" + ", names);
    }

    private static string ChargeTooltip(FocusedWrathWindow window)
    {
        var unspent = window.ChargesGranted - window.ChargesConsumed;

        if (unspent == 0)
            return "Every charge this buff carried went to a spender.";

        return window.ClippedByPullEnd
            ? $"The pull ended with {ChargeCount(unspent)} still on this buff."
            : $"The buff ran its full {FocusedWrathAnalyzer.BuffDurationMs / 1000}s and fell off with {ChargeCount(unspent)} left.";
    }

    private static string SpenderTooltip(FocusedWrathWindow window)
    {
        if (window.ChargesConsumed == 0)
            return "No charge from this buff reached a spender.";

        if (window.RatedSpenders == 0)
            return "No spender cast could be matched to this buff.";

        var preferred = SpellRegistry.MaybeGet(window.PreferredSpenderId)?.Name ?? "Unknown";

        return window.WrongSpenders == 0
            ? $"Every charge went to {preferred}, the spender this pull calls for."
            : $"{window.WrongSpenders} of {window.RatedSpenders} charges went to a spender other than {preferred}.";
    }

    private static string ChargeCount(int charges) => charges == 1 ? "1 charge" : $"{charges} charges";

    private static QualitativePerformance ChargeTier(FocusedWrathWindow window)
    {
        if (window.ChargesWasted > 0)
            return QualitativePerformance.Fail;

        return window.ChargesConsumed < window.ChargesGranted
            ? QualitativePerformance.Ok
            : QualitativePerformance.Perfect;
    }

    private static QualitativePerformance? SpenderTier(FocusedWrathWindow window)
    {
        if (window.RatedSpenders == 0)
            return null;

        return window.WrongSpenders == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Fail;
    }

    private static QualitativePerformance RowTier(FocusedWrathWindow window)
    {
        if (window.ChargesWasted > 0 || window.WrongSpenders > 0)
            return QualitativePerformance.Fail;

        return window.ChargesConsumed < window.ChargesGranted || window.RatedSpenders == 0
            ? QualitativePerformance.Ok
            : QualitativePerformance.Perfect;
    }
}
