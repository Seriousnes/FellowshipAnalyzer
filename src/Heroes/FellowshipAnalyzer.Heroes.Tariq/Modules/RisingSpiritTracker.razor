@inherits Analyzer

@code {
    public override RenderFragment? Statistic => Applications > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard Title="Rising Spirit">
            <ChildContent>
                <CastOverview Title="Buff Uptime" Stats="@BuildStats()" />
            </ChildContent>
        </StatCard>;

    private IEnumerable<OverviewStat> BuildStats() =>
    [
        new OverviewStat(
            $"{UptimeShare * 100:0}%",
            "Uptime",
            "Share of the dungeon Rising Spirit was active."),
        new OverviewStat(
            $"{MaxStacks}",
            "Peak Stacks",
            "The most stacks reached in this dungeon."),
        new OverviewStat(
            $"{AverageStacks:0.0}",
            "Avg Stacks",
            "Mean stacks while the buff was active, weighted by the time spent at each stack count."),
        new OverviewStat(
            $"{Applications}",
            "Applications",
            "Times the buff was applied."),
    ];
}
