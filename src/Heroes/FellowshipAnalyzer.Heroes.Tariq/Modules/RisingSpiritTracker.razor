@inherits Analyzer

@code {
    public override RenderFragment? Statistic => Applications > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard Title="Rising Spirit">
            <Info>
                There is no published stack ceiling, so the peak below is what this log reached.
            </Info>
            <ChildContent>
                <CastOverview Title="Buff Uptime" Stats="@BuildStats()" />
            </ChildContent>
        </StatCard>;

    private IEnumerable<OverviewStat> BuildStats() =>
    [
        new OverviewStat(
            $"{UptimeShare * 100:0}%",
            "Uptime",
            $"Share of the dungeon Rising Spirit was active, over {TotalActiveMs / 1000d:0.0}s of the {DungeonDurationMs / 1000d:0.0}s dungeon."),
        new OverviewStat(
            $"{MaxStacks}",
            "Peak Stacks",
            "The most stacks reached in this dungeon."),
        new OverviewStat(
            $"{AverageStacks:0.0}",
            "Avg Stacks Held",
            "Mean stacks while the buff was active, weighted by the time spent at each stack count."),
        new OverviewStat(
            $"{Applications}",
            "Applications",
            "Times the buff was applied."),
    ];
}
