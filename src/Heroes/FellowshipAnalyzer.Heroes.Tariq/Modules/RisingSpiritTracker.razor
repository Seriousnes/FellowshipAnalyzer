@inherits EventSubscriber

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic => Applications > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard Title="Rising Spirit">
            <Info>
                Rising Spirit stacks up from Spirit refund procs and falls off whole when they dry up, so its
                uptime tracks the pace the rotation sustained rather than any single cast. It is a shared gear
                buff with no published stack ceiling, so the peak below is what this log reached.
            </Info>
            <ChildContent>
                <CastOverview Title="Buff Uptime" Stats="@BuildStats()" />
            </ChildContent>
        </StatCard>;

    private IEnumerable<OverviewStat> BuildStats() =>
    [
        new OverviewStat(
            $"{UptimeShare * 100:0}%",
            "Uptime",
            $"Share of the fight Rising Spirit was up, over {TotalActiveMs / 1000d:0.0}s of the {FightDurationMs / 1000d:0.0}s fight."),
        new OverviewStat(
            $"{MaxStacks}",
            "Peak Stacks",
            "The deepest the buff stacked in this fight."),
        new OverviewStat(
            $"{AverageStacks:0.0}",
            "Avg Stacks Held",
            "Mean stacks while the buff was up, weighted by the time spent at each depth."),
        new OverviewStat(
            $"{Applications}",
            "Applications",
            "Times the buff went up from nothing, each one a refund proc landing while it was down."),
    ];
}
