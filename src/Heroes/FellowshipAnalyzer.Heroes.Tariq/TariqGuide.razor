@inherits ReportComponent<TariqCombatLogParser>

@if (Parser.FuryEconomyAnalyzers.Count > 0)
{
    <FuryEconomyGuide />
}

@if (Parser.ThunderCallWindowAnalyzers.Count > 0 || Parser.FocusedWrathAnalyzers.Count > 0)
