@inherits AnalyzerStatistic<EnergyComboPointTracker>

<StatCard Title="Energy & Combo Points">
    <Info>
        <p>
            Fight totals for Mara's two resources. Generated counts what actually landed in the bar, so
            anything lost at cap is reported separately as wasted.
        </p>
    </Info>
    <ChildContent>
        <CastOverview Title="Energy" Stats="@BuildEnergyStats()" />
        <CastOverview Title="Combo Points" Stats="@BuildComboPointStats()" />
    </ChildContent>
</StatCard>

@code {
    private IEnumerable<OverviewStat> BuildEnergyStats() =>
    [
        new OverviewStat(
            $"{Analyzer.EnergyGenerated}",
            "Generated",
            "Energy that landed in the bar over the fight, excluding anything lost at cap."),
        new OverviewStat(
            $"{Analyzer.EnergySpent}",
            "Spent",
            "Energy consumed by cast costs."),
        new OverviewStat(
            $"{Analyzer.EnergyWasted}",
            "Wasted",
            $"Energy that regenerated while already at cap ({WastePercent(Analyzer.EnergyGenerated, Analyzer.EnergyWasted)}% of everything the fight offered).",
            WasteTier(Analyzer.EnergyGenerated, Analyzer.EnergyWasted)),
        new OverviewStat(
            $"{Analyzer.EnergyCurrent}",
            "Ending",
            "Energy still banked when the fight ended."),
    ];

    private IEnumerable<OverviewStat> BuildComboPointStats() =>
    [
        new OverviewStat(
            $"{Analyzer.ComboPointsGenerated}",
            "Generated",
            "Combo points that landed in the bar, excluding anything generated at six."),
        new OverviewStat(
            $"{Analyzer.ComboPointsWasted}",
            "Wasted",
            $"Combo points generated while already at six ({WastePercent(Analyzer.ComboPointsGenerated, Analyzer.ComboPointsWasted)}% of everything the fight offered).",
            WasteTier(Analyzer.ComboPointsGenerated, Analyzer.ComboPointsWasted)),
    ];

    private static int WastePercent(int generated, int wasted)
    {
        var offered = generated + wasted;
        return offered == 0 ? 0 : (int)Math.Round((double)wasted / offered * 100);
    }

    private static QualitativePerformance? WasteTier(int generated, int wasted) =>
        generated + wasted == 0
            ? null
            : PerformanceTiers.FromThresholds(100 - WastePercent(generated, wasted), 100, 95, 85);
}
