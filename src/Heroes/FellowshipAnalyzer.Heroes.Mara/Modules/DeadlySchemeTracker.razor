@inherits Analyzer
@using MaraSpells = FellowshipAnalyzer.Core.Common.Spells.Mara

@code {
    public override RenderFragment? Statistic => Activations > 0 || HighestStacks > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="MaraSpells.Talents.DeadlyScheme" />
            </Header>
            <ChildContent>
                <CastOverview Title="Deadly Scheme Activations" Stats="@BuildStats()" />
            </ChildContent>
        </StatCard>;

    private IEnumerable<OverviewStat> BuildStats()
    {
        var stats = new List<OverviewStat>
        {
            new(
                $"{Activations}",
                "Activations",
                "Times Deadly Scheme: Active was applied."),
            new(
                $"{ActiveTimeMs / 1000d:0.0}s",
                "Time Active",
                "Total fight time with Deadly Scheme: Active."),
            new(
                $"{HighestStacks}/{MaxStacks}",
                "Peak Stacks",
                "Highest stack count reached."),
            new(
                $"{FinishersDuringActive}",
                "Finishers While Active",
                $"Queen's Fang and Arachnid Assault casts made under Deadly Scheme: Active, alongside {HemorrhagingStrikesDuringActive} Hemorrhaging Strike{(HemorrhagingStrikesDuringActive == 1 ? "" : "s")}."),
        };

        if (Activations > 0)
        {
            stats.Add(new OverviewStat(
                $"{ActivationsUnspent}",
                "Ended Unspent",
                "Activations that ended without a Queen's Fang, Arachnid Assault or Hemorrhaging Strike.",
                UnspentTier()));
        }

        return stats;
    }

    private QualitativePerformance UnspentTier()
    {
        var spentPercent = (double)ActivationsSpent / Activations * 100;
        return PerformanceTiers.FromThresholds(spentPercent, 100, 75, 50);
    }
}
