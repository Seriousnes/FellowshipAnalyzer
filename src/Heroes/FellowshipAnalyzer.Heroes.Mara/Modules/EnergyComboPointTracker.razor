@using FellowshipAnalyzer.Core.Resources
@inherits ResourceTracker

@code {
    public override RenderFragment? Statistic =>
        @<StatCard Title="Energy & Combo Points">
            <ChildContent>
                <CastOverview Title="Energy" Stats="@BuildEnergyStats()" />
                <CastOverview Title="Combo Points" Stats="@BuildComboPointStats()" />
            </ChildContent>
        </StatCard>;

    private IEnumerable<OverviewStat> BuildEnergyStats() =>
    [
        new OverviewStat(
            $"{EnergyGenerated}",
            "Generated",
            "Energy that arrived in the pool over the dungeon, excluding anything lost at cap."),
        new OverviewStat(
            $"{EnergySpent}",
            "Spent",
            "Energy consumed by cast costs."),
        new OverviewStat(
            $"{EnergyWasted}",
            "Wasted",
            $"Energy that regenerated while already at cap ({WastePercent(EnergyGenerated, EnergyWasted)}% of the Energy the dungeon produced).",
            WasteTier(EnergyGenerated, EnergyWasted)),
        new OverviewStat(
            $"{EnergyCurrent}",
            "Ending",
            "Energy still banked when the dungeon ended."),
    ];

    private IEnumerable<OverviewStat> BuildComboPointStats() =>
    [
        new OverviewStat(
            $"{ComboPointsGenerated}",
            "Generated",
            "Combo points that arrived in the pool, excluding anything generated at six."),
        new OverviewStat(
            $"{ComboPointsWasted}",
            "Wasted",
            $"Combo points generated while already at six ({WastePercent(ComboPointsGenerated, ComboPointsWasted)}% of the combo points the dungeon produced).",
            WasteTier(ComboPointsGenerated, ComboPointsWasted)),
    ];

    private static int WastePercent(int generated, int wasted)
    {
        var offered = generated + wasted;
        return offered == 0 ? 0 : (int)Math.Round((double)wasted / offered * 100);
    }

    private static QualitativePerformance? WasteTier(int generated, int wasted) =>
        generated + wasted == 0
            ? null
            : PerformanceTiers.FromThresholds(100 - WastePercent(generated, wasted), 100, 95, 85);
}
