@inherits GuideComponent<MaraCombatLogParser>

<GuideSection Title="Maiden of Death Windows">
    <LeftPanel>
        <p>
            While <SpellLink Spell="Spells.MaidenOfDeath" /> is active, alternate builders and spend with
            <SpellLink Spell="Spells.QueenFang" /> / <SpellLink Spell="Spells.ArachnidAssault" />. Avoid two
            builders back to back, and avoid opening the window on near-full combo points.
        </p>
        <p>
            Aim to pair it with <SpellLink Spell="Spells.MatriarchMacabre" /> when possible, but do not delay
            either to line them up if that costs a cast.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Window Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Burst Windows"
                    Description="Each row is one Maiden of Death window, from the buff being applied to its removal, with everything cast inside it."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.MaidenOfDeathAnalyzers.Count > 0;

    private List<MaidenOfDeathAnalyzer> Analyzers() =>
        [.. Parser.MaidenOfDeathAnalyzers.Select(entry => entry.Analyzer)];

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();

        var windows = analyzers.Sum(analyzer => analyzer.WindowCount);
        var clean = analyzers.Sum(analyzer => analyzer.CleanWindows);
        var generators = analyzers.Sum(analyzer => analyzer.GeneratorsInWindows);
        var spenders = analyzers.Sum(analyzer => analyzer.SpendersInWindows);
        var wasted = analyzers.Sum(analyzer => analyzer.WastedGeneratorCasts);
        var idleMs = analyzers.Sum(analyzer => analyzer.IdleMs);
        var gaps = analyzers.Sum(analyzer => analyzer.GapCount);
        var lostCasts = analyzers.Sum(analyzer => analyzer.LostCasts);

        var recasts = analyzers.Sum(analyzer => analyzer.MaidenOfDeathRecasts.Count);
        var heldMs = analyzers.Sum(analyzer => analyzer.TotalHeldMs);
        var averageHeldSeconds = recasts == 0 ? 0d : heldMs / 1000d / recasts;

        return
        [
            new OverviewStat(
                $"{clean}/{windows}",
                "Clean Cycles",
                windows == 0
                    ? "No Maiden of Death window was observed, so there is nothing to measure."
                    : $"Windows that ran with no doubled builder and no idle time, across {generators} builders and {spenders} spenders.",
                CleanTier(clean, windows)),
            new OverviewStat(
                $"{wasted}",
                "Builders Doubled Up",
                $"Builders cast after another builder with no spender between them, or on a window that opened at {MaidenOfDeathAnalyzer.OpeningComboPointLimit} combo points or more.",
                WasteTier(wasted, generators)),
            new OverviewStat(
                FormatSeconds(idleMs),
                "Idle in Window",
                gaps == 0
                    ? $"No stretch of {MaidenOfDeathAnalyzer.MinimumGapMs / 1000d:0.#}s or longer passed without a cast."
                    : $"{Count(gaps, "idle stretch", "idle stretches")} of at least {MaidenOfDeathAnalyzer.MinimumGapMs / 1000d:0.#}s, room for about {Count(lostCasts, "more cast")} at one global cooldown each.",
                IdleTier(lostCasts, windows)),
            new OverviewStat(
                FormatSeconds(heldMs),
                "Maiden of Death Held",
                recasts == 0
                    ? "Maiden of Death was cast at most once per pull, so no recast could be measured against its recharge."
                    : $"Time a ready charge went unspent across {Count(recasts, "recast")}, {averageHeldSeconds:0.#}s per recast on average, measured against a {MaidenOfDeathAnalyzer.RechargeMs / 1000}-second recharge.",
                HeldTier(averageHeldSeconds, recasts)),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.MaidenOfDeathAnalyzers.ToItemRows(
            Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(MaidenOfDeathWindow window)
    {
        var stats = new[]
        {
            new PerCastStat(
                FormatSeconds(window.DurationMs),
                "Window",
                "How long the Maiden of Death buff was active."),
            new PerCastStat(
                $"{window.GeneratorCasts}/{window.SpenderCasts}",
                "Builders / Spenders",
                "Combo point builders and spenders cast inside the window."),
            new PerCastStat(
                window.ComboPointsAtOpen is { } atOpen ? $"{atOpen}" : "-",
                "Combo Points at Open",
                window.ComboPointsAtOpen is null
                    ? "The combo point tracker recorded nothing at or before this window opened."
                    : "Combo points held as the window opened."),
            new PerCastStat(
                $"{window.WastedGeneratorCasts}",
                "Builders Doubled Up",
                $"Builders cast after another builder with no spender between them, or on a window that opened at {MaidenOfDeathAnalyzer.OpeningComboPointLimit} combo points or more.",
                Performance: WasteTier(window.WastedGeneratorCasts, window.GeneratorCasts)),
            new PerCastStat(
                FormatSeconds(window.IdleMs),
                "Idle",
                window.GapCount == 0
                    ? "No stretch inside the window passed without a cast."
                    : $"{Count(window.GapCount, "idle stretch", "idle stretches")}, longest {FormatSeconds(window.LongestGapMs)}, room for about {Count(window.LostCasts, "more cast")}.",
                Performance: IdleTier(window.LostCasts, 1)),
            new PerCastStat(
                $"{window.ComboPointsSpent}",
                "Combo Points Spent",
                "Combo points held going into the spenders cast inside the window."),
            new PerCastStat(
                window.EnergyAtClose is { } energy ? $"{energy}" : "-",
                "Energy Into Last Cast",
                window.EnergyAtClose is null
                    ? "No cast inside the window reported an Energy snapshot."
                    : "Energy available going into the last cast made inside the window."),
        };

        return new PerCastRow
        {
            Performance = WindowTier(window),
            Stats = stats,
            Timestamp = window.OpenedAt,
            Sequence = [.. window.Casts.Select(cast => new SpellCastEntry(cast.AbilityId))],
            Details = @<div>@BuildWindowNote(window)</div>,
        };
    }

    private static string BuildWindowNote(MaidenOfDeathWindow window)
    {
        if (window.Casts.Count == 0)
            return "Nothing was cast inside this window.";

        var notes = new List<string>
        {
            $"{Count(window.GeneratorCasts, "builder")} and {Count(window.SpenderCasts, "spender")} went out",
        };

        if (window.WastedGeneratorCasts > 0)
            notes.Add($"{Count(window.WastedGeneratorCasts, "builder")} went out on an unspent pool");

        if (window.ComboPointsAtOpen is { } atOpen && atOpen >= MaidenOfDeathAnalyzer.OpeningComboPointLimit)
            notes.Add($"the window opened on {Count(atOpen, "combo point")}");

        if (window.GapCount > 0)
            notes.Add($"{FormatSeconds(window.IdleMs)} passed with nothing going out, the longest stretch {FormatSeconds(window.LongestGapMs)}");

        if (window.SpenderCasts == 0 && window.GeneratorCasts > 0)
            notes.Add("no spender went out after the builders");

        if (window.CleanCycle)
            notes.Add("the cycle ran clean");

        return Sentence(notes);
    }

    private static string Sentence(List<string> notes)
    {
        if (notes.Count == 0)
            return "This window recorded no casts to measure.";

        var joined = string.Join("; ", notes);
        return $"{char.ToUpperInvariant(joined[0])}{joined[1..]}.";
    }

    private static string Count(int value, string noun) =>
        value == 1 ? $"1 {noun}" : $"{value} {noun}s";

    private static string Count(int value, string singular, string plural) =>
        value == 1 ? $"1 {singular}" : $"{value} {plural}";

    private static string FormatSeconds(int milliseconds) =>
        $"{milliseconds / 1000d:0.#}s";

    private static int Percent(int part, int total) =>
        total == 0 ? 0 : (int)Math.Round((double)part / total * 100);

    private static QualitativePerformance? CleanTier(int clean, int windows) =>
        windows == 0 ? null : PerformanceTiers.FromThresholds(Percent(clean, windows), 100, 75, 50);

    private static QualitativePerformance? WasteTier(int wasted, int generators) =>
        generators == 0 ? null
        : wasted == 0 ? QualitativePerformance.Perfect
        : PerformanceTiers.FromThresholds(100 - Percent(wasted, generators), 90, 75, 50);

    private static QualitativePerformance? IdleTier(int lostCasts, int windows) =>
        windows == 0 ? null
        : lostCasts == 0 ? QualitativePerformance.Perfect
        : lostCasts <= windows ? QualitativePerformance.Good
        : lostCasts <= windows * 2 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;

    private static QualitativePerformance? HeldTier(double averageHeldSeconds, int recasts) =>
        recasts == 0 ? null
        : averageHeldSeconds < 3 ? QualitativePerformance.Perfect
        : averageHeldSeconds < 8 ? QualitativePerformance.Good
        : averageHeldSeconds < 15 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;

    private static QualitativePerformance WindowTier(MaidenOfDeathWindow window)
    {
        if (window.Casts.Count == 0)
            return QualitativePerformance.Fail;

        var waste = WasteTier(window.WastedGeneratorCasts, window.GeneratorCasts) ?? QualitativePerformance.Ok;
        var idle = IdleTier(window.LostCasts, 1) ?? QualitativePerformance.Ok;

        return waste < idle ? waste : idle;
    }
}
