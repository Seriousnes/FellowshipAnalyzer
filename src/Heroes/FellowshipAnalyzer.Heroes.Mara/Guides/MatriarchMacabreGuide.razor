@inherits GuideComponent<MaraCombatLogParser>

<GuideSection Title="Matriarch Macabre">
    <LeftPanel>
        <p>
            Attempt to cast as many finishers as possible during the <SpellLink Spell="Spells.MatriarchMacabre" /> window.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Matriarch Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Matriarch Windows"
                    Description="Each row is one Matriarch Macabre window, with the finishers cast inside it."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.MatriarchMacabreAnalyzers.Count > 0;

    private List<MatriarchMacabreAnalyzer> Analyzers() =>
        [.. Parser.MatriarchMacabreAnalyzers.Select(entry => entry.Analyzer)];

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();

        var windows = analyzers.Sum(analyzer => analyzer.WindowCount);
        var converted = analyzers.Sum(analyzer => analyzer.ConvertedWindows);
        var finishers = analyzers.Sum(analyzer => analyzer.FinisherCasts);
        var average = windows == 0 ? 0d : (double)finishers / windows;

        return
        [
            new OverviewStat(
                $"{finishers}",
                "Finishers in Window",
                "Queen's Fang and Arachnid Assault casts inside a window.",
                FinisherTier(average, windows)),
            new OverviewStat(
                $"{converted}/{windows}",
                "Windows Used",
                "Windows with at least one finisher cast.",
                ConversionTier(converted, windows)),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.MatriarchMacabreAnalyzers.ToItemRows(
            Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(MatriarchMacabreWindow window)
    {
        var stats = new[]
        {
            new PerCastStat(
                FormatSeconds(window.DurationMs),
                "Window",
                "How long the Matriarch Macabre buff was active."),
            new PerCastStat(
                $"{window.FinisherCasts}",
                "Finishers in Window",
                "Queen's Fang and Arachnid Assault casts inside the window.",
                Performance: FinisherTier(window.FinisherCasts, 1)),
            new PerCastStat(
                $"{window.QueensFangCasts}",
                "Queen's Fang",
                "Queen's Fang casts inside the window."),
            new PerCastStat(
                $"{window.ArachnidAssaultCasts}",
                "Arachnid Assault",
                "Arachnid Assault casts inside the window."),
        };

        return new PerCastRow
        {
            Performance = FinisherTier(window.FinisherCasts, 1) ?? QualitativePerformance.Ok,
            Stats = stats,
            Timestamp = window.OpenedAt,
            Details = @<div>@BuildWindowNote(window)</div>,
        };
    }

    private static string BuildWindowNote(MatriarchMacabreWindow window) =>
        window.FinisherCasts == 0
            ? $"This {FormatSeconds(window.DurationMs)} window expired with no Queen's Fang or Arachnid Assault in it."
            : $"{Count(window.FinisherCasts, "finisher")} cast in this {FormatSeconds(window.DurationMs)} window.";

    private static string Count(int value, string noun) =>
        value == 1 ? $"1 {noun}" : $"{value} {noun}s";

    private static string FormatSeconds(int milliseconds) =>
        $"{milliseconds / 1000d:0.#}s";

    private static QualitativePerformance? FinisherTier(double finishers, int windows) =>
        windows == 0 ? null : PerformanceTiers.FromThresholds(finishers, 4, 3, 2);

    private static QualitativePerformance? ConversionTier(int converted, int total) =>
        total == 0 ? null
        : converted >= total ? QualitativePerformance.Perfect
        : converted > 0 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;
}
