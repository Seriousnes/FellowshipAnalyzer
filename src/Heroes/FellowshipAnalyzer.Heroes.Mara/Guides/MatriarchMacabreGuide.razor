@inherits ReportComponent<MaraCombatLogParser>

<GuideSection Title="Matriarch Macabre Windows">
    <LeftPanel>
        <p>
            <SpellLink Spell="Spells.MatriarchMacabre" /> sends out two clones that imitate every
            <SpellLink Spell="Spells.QueenFang" /> and <SpellLink Spell="Spells.ArachnidAssault" /> you cast. 
            Attempt to cast as many finishers as possible during the <SpellLink Spell="Spells.MatriarchMacabre" /> window.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Matriarch Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Matriarch Windows"
                    Description="Each row is one Matriarch Macabre window, from the buff landing to its removal, with the finishers the clones imitated."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    private List<MatriarchMacabreAnalyzer> Analyzers() =>
        [.. Parser.MatriarchMacabreAnalyzers.Select(entry => entry.Analyzer)];

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();

        var windows = analyzers.Sum(analyzer => analyzer.WindowCount);
        var converted = analyzers.Sum(analyzer => analyzer.ConvertedWindows);
        var imitated = analyzers.Sum(analyzer => analyzer.ImitatedCasts);
        var queensFang = analyzers.Sum(analyzer => analyzer.QueensFangCasts);
        var arachnid = analyzers.Sum(analyzer => analyzer.ArachnidAssaultCasts);
        var casts = analyzers.Sum(analyzer => analyzer.MatriarchMacabreCasts);
        var average = windows == 0 ? 0d : (double)imitated / windows;

        return
        [
            new OverviewStat(
                $"{imitated}",
                "Finishers Imitated",
                windows == 0
                    ? $"No Matriarch Macabre window was observed across {Count(casts, "cast")}, so there is nothing to measure."
                    : $"{queensFang} Queen's Fang and {arachnid} Arachnid Assault casts landed inside a window, {average:0.0} per window.",
                ImitatedTier(average, windows)),
            new OverviewStat(
                $"{converted}/{windows}",
                "Windows Used",
                windows == 0
                    ? "No Matriarch Macabre window was observed."
                    : $"Windows that carried at least one finisher for the clones to imitate, out of {Count(windows, "window")}.",
                ConversionTier(converted, windows)),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.MatriarchMacabreAnalyzers.ToItemRows(
            Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(MatriarchMacabreWindow window)
    {
        var stats = new[]
        {
            new PerCastStat(
                FormatSeconds(window.DurationMs),
                "Window",
                $"How long the Matriarch Macabre buff was active, against its {MatriarchMacabreAnalyzer.WindowMs / 1000}-second duration."),
            new PerCastStat(
                $"{window.ImitatedCasts}",
                "Finishers Imitated",
                "Queen's Fang and Arachnid Assault casts the clones copied.",
                Performance: ImitatedTier(window.ImitatedCasts, 1)),
            new PerCastStat(
                $"{window.QueensFangCasts}",
                "Queen's Fang",
                "Queen's Fang casts made inside the window."),
            new PerCastStat(
                $"{window.ArachnidAssaultCasts}",
                "Arachnid Assault",
                "Arachnid Assault casts made inside the window."),
        };

        return new PerCastRow
        {
            Performance = ImitatedTier(window.ImitatedCasts, 1) ?? QualitativePerformance.Ok,
            Stats = stats,
            Timestamp = window.OpenedAt,
            Details = @<div>@BuildWindowNote(window)</div>,
        };
    }

    private static string BuildWindowNote(MatriarchMacabreWindow window) =>
        window.ImitatedCasts == 0
            ? $"This {FormatSeconds(window.DurationMs)} window expired with no Queen's Fang or Arachnid Assault in it, so the clones had nothing to copy."
            : $"The clones copied {Count(window.ImitatedCasts, "finisher")} over {FormatSeconds(window.DurationMs)}.";

    private static string Count(int value, string noun) =>
        value == 1 ? $"1 {noun}" : $"{value} {noun}s";

    private static string FormatSeconds(int milliseconds) =>
        $"{milliseconds / 1000d:0.#}s";

    private static QualitativePerformance? ImitatedTier(double imitated, int windows) =>
        windows == 0 ? null : PerformanceTiers.FromThresholds(imitated, 4, 3, 2);

    private static QualitativePerformance? ConversionTier(int converted, int total) =>
        total == 0 ? null
        : converted >= total ? QualitativePerformance.Perfect
        : converted > 0 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;
}
