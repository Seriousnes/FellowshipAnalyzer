@inherits GuideComponent<MaraCombatLogParser>
@using FellowshipAnalyzer.Core.Common.Spells;

<GuideSection Title="Energy & Combo Points">
    <LeftPanel>
        <p>
            Cast <SpellLink Spell="Spells.QueenFang" /> at 5+ Combo Points when fighting 
            @(_hasFeedTheQueen ? @<text>5</text> : @<text>2</text>) or fewer targets.
        </p>
        <p>
            Cast <SpellLink Spell="Spells.ArachnidAssault" /> at 4+ Combo Points when fighting
            @(_hasFeedTheQueen ?@<text>6</text> : @<text>3</text>) or more targets.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Resource Overview" Stats="@BuildOverviewStats()" />
        <StackedBar Segments="@BuildComboPointDistribution()" />
        @if (Parser.EnergyComboPointTracker is not null)
        {
            <ResourceGraph Tracker="Parser.EnergyComboPointTracker" Resource="ResourceTypes.Primary" />
        }
        <CastDetail Title="Resources by Pull"
                    Description="Each row is one pull."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.MaraResourceDisciplineAnalyzers.Count > 0;

    private List<MaraResourceDisciplineAnalyzer> Analyzers() =>
        [.. Parser.MaraResourceDisciplineAnalyzers.Select(entry => entry.Analyzer)];

    private bool _hasFeedTheQueen => Owner.SelectedCombatant.HasTalent(MaraTalents.FeedTheQueen);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();

        var finishers = analyzers.Sum(analyzer => analyzer.Finishers.Count);
        var atThreshold = analyzers.Sum(analyzer => analyzer.FinishersAtThreshold);
        var thresholdRate = Percent(atThreshold, finishers);

        var energySampled = analyzers.Sum(analyzer => analyzer.EnergyCastsSampled);
        var energyCapped = analyzers.Sum(analyzer => analyzer.EnergyCappedCasts);
        var energyCapRate = Percent(energyCapped, energySampled);

        var generatorCasts = analyzers.Sum(analyzer => analyzer.GeneratorCasts);
        var generatorOvercap = analyzers.Sum(analyzer => analyzer.GeneratorOvercapCasts);
        var overcapRate = Percent(generatorOvercap, generatorCasts);

        var withTargetCount = analyzers.Sum(analyzer => analyzer.FinishersWithTargetCount);
        var matchingTargetCount = analyzers.Sum(analyzer => analyzer.FinishersMatchingTargetCount);
        var targetCountRate = Percent(matchingTargetCount, withTargetCount);

        return
        [
            new OverviewStat(
                $"{thresholdRate}%",
                "Finishers on Threshold",
                $"{atThreshold} of {finishers} Queen's Fang and Arachnid Assault casts met their combo-point threshold.",
                ThresholdTier(thresholdRate, finishers)),
            new OverviewStat(
                $"{targetCountRate}%",
                "Finishers on Target Count",
                $"{matchingTargetCount} of {withTargetCount} finishers matched the enemies alive at the cast.",
                ThresholdTier(targetCountRate, withTargetCount)),
            new OverviewStat(
                $"{finishers}",
                "Finishers Cast",
                "Queen's Fang and Arachnid Assault casts."),
            new OverviewStat(
                $"{energyCapped}/{energySampled}",
                "Casts at Capped Energy",
                $"{energyCapRate}% of casts were at full Energy.",
                EnergyCapTier(energyCapRate, energySampled)),
            new OverviewStat(
                $"{generatorOvercap}",
                "Generators at 6 CP",
                $"{generatorOvercap} of {generatorCasts} generators ({overcapRate}%) were cast at six combo points.",
                OvercapTier(overcapRate, generatorCasts)),
        ];
    }

    private IEnumerable<StackedBarSegment> BuildComboPointDistribution()
    {
        var finishers = Analyzers().SelectMany(analyzer => analyzer.Finishers).ToList();
        var six = finishers.Count(finisher => finisher.ComboPoints >= 6);
        var five = finishers.Count(finisher => finisher.ComboPoints == 5);
        var four = finishers.Count(finisher => finisher.ComboPoints == 4);
        var low = finishers.Count(finisher => finisher.ComboPoints <= 3);

        return
        [
            new StackedBarSegment("6 CP", six, PerformanceColors.Perfect,
                $"{six} finishers spent 6 combo points."),
            new StackedBarSegment("5 CP", five, PerformanceColors.Perfect,
                $"{five} finishers spent 5 combo points."),
            new StackedBarSegment("4 CP", four, PerformanceColors.Neutral,
                $"{four} finishers spent 4 combo points, which meets the Arachnid Assault threshold and misses the Queen's Fang threshold."),
            new StackedBarSegment("3 CP or fewer", low, PerformanceColors.Fail,
                $"{low} finishers spent 3 or fewer combo points."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.MaraResourceDisciplineAnalyzers.ToPullRows(Parser, (analyzer, pull) => BuildPullRow(analyzer));

    private PerCastRow BuildPullRow(MaraResourceDisciplineAnalyzer analyzer)
    {
        var thresholdRate = Percent(analyzer.FinishersAtThreshold, analyzer.Finishers.Count);
        var queenFangRate = Percent(analyzer.QueenFangAtThreshold, analyzer.QueenFangCasts);
        var arachnidRate = Percent(analyzer.ArachnidAssaultAtThreshold, analyzer.ArachnidAssaultCasts);
        var energyCapRate = Percent(analyzer.EnergyCappedCasts, analyzer.EnergyCastsSampled);
        var overcapRate = Percent(analyzer.GeneratorOvercapCasts, analyzer.GeneratorCasts);
        var targetCountRate = Percent(analyzer.FinishersMatchingTargetCount, analyzer.FinishersWithTargetCount);
        var belowThreshold = analyzer.Finishers.Where(finisher => !finisher.MeetsThreshold).Take(5).ToList();

        var stats = new[]
        {
            new PerCastStat(
                $"{analyzer.QueenFangAtThreshold}/{analyzer.QueenFangCasts}",
                $"Queen's Fang at {MaraResourceDisciplineAnalyzer.QueenFangThreshold}+ CP",
                $"Queen's Fang casts that met their combo-point threshold ({queenFangRate}%).",
                Performance: ThresholdTier(queenFangRate, analyzer.QueenFangCasts)),
            new PerCastStat(
                $"{analyzer.ArachnidAssaultAtThreshold}/{analyzer.ArachnidAssaultCasts}",
                $"Arachnid Assault at {MaraResourceDisciplineAnalyzer.ArachnidAssaultThreshold}+ CP",
                $"Arachnid Assault casts that met their combo-point threshold ({arachnidRate}%).",
                Performance: ThresholdTier(arachnidRate, analyzer.ArachnidAssaultCasts)),
            new PerCastStat(
                $"{analyzer.FinishersMatchingTargetCount}/{analyzer.FinishersWithTargetCount}",
                "Finishers on Target Count",
                $"Finishers matching the enemies alive at the cast ({targetCountRate}%), with Arachnid Assault from {analyzer.ArachnidAssaultTargetThreshold} enemies.",
                Performance: ThresholdTier(targetCountRate, analyzer.FinishersWithTargetCount)),
            new PerCastStat(
                $"{analyzer.EnergyCappedCasts}/{analyzer.EnergyCastsSampled}",
                "Casts at Capped Energy",
                $"Casts at full Energy ({energyCapRate}%).",
                Performance: EnergyCapTier(energyCapRate, analyzer.EnergyCastsSampled)),
            new PerCastStat(
                $"{analyzer.GeneratorOvercapCasts}/{analyzer.GeneratorCasts}",
                "Generators at 6 CP",
                $"Generators cast at maximum combo points ({overcapRate}%).",
                Performance: OvercapTier(overcapRate, analyzer.GeneratorCasts)),
            new PerCastStat(
                $"{analyzer.MaintenanceFinisherCasts}",
                "Hemorrhaging Strike",
                "Hemorrhaging Strike casts."),
        };

        return new PerCastRow
        {
            Performance = PullTier(analyzer, thresholdRate, energyCapRate, targetCountRate),
            Stats = stats,
            AdditionalContent = new AdditionalContent("Notes", @<div>
                <p>@BuildPullNote(analyzer, energyCapRate)</p>
                @if (belowThreshold.Count > 0)
                {
                    <ul>
                        @foreach (var finisher in belowThreshold)
                        {
                            <li>
                                @FinisherName(finisher.AbilityId) at @finisher.ComboPoints combo points
                                (@Parser.FormatTimestamp(finisher.Timestamp)).
                            </li>
                        }
                    </ul>
                }
            </div>),
        };
    }

    private static string BuildPullNote(MaraResourceDisciplineAnalyzer analyzer, int energyCapRate)
    {
        if (analyzer.Finishers.Count == 0 && analyzer.EnergyCastsSampled == 0)
            return "No resource snapshot was observed.";

        var notes = new List<string>();

        var below = analyzer.Finishers.Count - analyzer.FinishersAtThreshold;
        if (below > 0)
            notes.Add($"{Count(below, "finisher")} went out under their combo-point threshold");

        if (analyzer.QueenFangAboveTargetThreshold > 0)
            notes.Add($"{Count(analyzer.QueenFangAboveTargetThreshold, "Queen's Fang cast")} went out with {analyzer.ArachnidAssaultTargetThreshold} or more enemies alive");

        if (analyzer.ArachnidAssaultBelowTargetThreshold > 0)
            notes.Add($"{Count(analyzer.ArachnidAssaultBelowTargetThreshold, "Arachnid Assault cast")} went out with fewer than {analyzer.ArachnidAssaultTargetThreshold} enemies alive");

        if (analyzer.GeneratorOvercapCasts > 0)
            notes.Add($"{Count(analyzer.GeneratorOvercapCasts, "generator cast")} went out at six combo points");

        if (analyzer.EnergyCappedCasts > 0)
            notes.Add($"{Count(analyzer.EnergyCappedCasts, "cast")} went out at full Energy ({energyCapRate}%)");

        if (notes.Count > 0)
            return $"{string.Join("; ", notes)}.";

        if (analyzer.Finishers.Count == 0)
            return "No spending finisher was cast on this pull, but nothing overcapped either.";

        return analyzer.FinishersWithTargetCount > 0
            ? "Every finisher met its combo-point threshold and matched the enemies alive, with no Energy or combo-point overcap."
            : "Every finisher met its combo-point threshold with no Energy or combo-point overcap.";
    }

    private static string Count(int value, string noun) =>
        value == 1 ? $"1 {noun}" : $"{value} {noun}s";

    private static string FinisherName(int abilityId) =>
        abilityId == Spells.QueenFang.Id ? Spells.QueenFang.Name
        : abilityId == Spells.ArachnidAssault.Id ? Spells.ArachnidAssault.Name
        : "Finisher";

    private static int Percent(int part, int total) =>
        total == 0 ? 0 : (int)Math.Round((double)part / total * 100);

    private static QualitativePerformance? ThresholdTier(int thresholdRate, int finishers) =>
        finishers == 0 ? null : PerformanceTiers.FromThresholds(thresholdRate, 90, 75, 50);

    private static QualitativePerformance? EnergyCapTier(int cappedRate, int sampledCasts) =>
        sampledCasts == 0 ? null : PerformanceTiers.FromThresholds(100 - cappedRate, 97, 92, 85);

    private static QualitativePerformance? OvercapTier(int overcapRate, int generatorCasts) =>
        generatorCasts == 0 ? null : PerformanceTiers.FromThresholds(100 - overcapRate, 99, 95, 90);

    private static QualitativePerformance PullTier(
        MaraResourceDisciplineAnalyzer analyzer, int thresholdRate, int energyCapRate, int targetCountRate)
    {
        QualitativePerformance?[] tiers =
        [
            ThresholdTier(thresholdRate, analyzer.Finishers.Count),
            ThresholdTier(targetCountRate, analyzer.FinishersWithTargetCount),
            EnergyCapTier(energyCapRate, analyzer.EnergyCastsSampled),
        ];

        var scored = tiers.Where(tier => tier is not null).Select(tier => tier!.Value).ToList();
        return scored.Count == 0 ? QualitativePerformance.Ok : scored.Min();
    }
}
