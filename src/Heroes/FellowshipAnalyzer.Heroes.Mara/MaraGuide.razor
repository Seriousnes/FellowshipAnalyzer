@using FellowshipAnalyzer.Core.Common.Spells.Mara
@using FellowshipAnalyzer.Heroes.Mara.Analysis
@using FellowshipAnalyzer.Heroes.Mara.Guides
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Mara.Spells
@inject MaraCombatLogParser Parser

<GuideContainer>
    <Section Title="Overview">
        <Explanation>
            <p>
                Mara is a melee DPS who combines energy management with combo-point generation and
                spending. Strong play means keeping poisons and bleeds active, building and spending
                combo points at the right thresholds, avoiding resource overcap, and timing cooldowns
                around damage windows.
            </p>
        </Explanation>
    </Section>

    @if (Parser.MaraResourceReports.Count > 0)
    {
        <MaraResourceDisciplineGuide />
    }

    <Section Title="Core Mechanic — Energy & Combo Points">
        <Explanation>
            <p>
                Two resources drive the rotation. <strong>Energy</strong> (cap 200) is consumed by
                every damaging ability. <strong>Combo Points</strong> (cap 6) are built by generators
                and spent by finishers.
            </p>
            <p>
                Generators build combo points: <SpellLink Spell="Spells.Backstab" />,
                <SpellLink Spell="Spells.WidowBite" />, and <SpellLink Spell="Spells.SkitteringBlades" />.
                Finishers spend combo points: <SpellLink Spell="Spells.QueenFang" />,
                <SpellLink Spell="Spells.HemorrhagingStrike" />, and <SpellLink Spell="Spells.ArachnidAssault" />.
            </p>
        </Explanation>
        <TipBox Variant="TipBoxVariant.Note" Title="Don't overcap">
            Spend before hitting the 6 combo-point cap and keep Energy flowing — capping either
            resource wastes generation.
        </TipBox>
    </Section>

    <Section Title="Rotation">
        <SubSection Title="Early Opener">
            <ol>
                <li><SpellLink Spell="Spells.BroodingShadows" /> → <SpellLink Spell="Spells.WidowBite" /> to apply <strong>Seething Poison</strong>.</li>
                <li><SpellLink Spell="Spells.HemorrhagingStrike" />.</li>
                <li><SpellLink Spell="Spells.MaidenOfDeath" />.</li>
                <li><strong>Weapon Ability</strong>.</li>
                <li>Generate and spend combo points per the priority below.</li>
                <li><SpellLink Spell="Spells.FinalStratagem" /> if <SpellLink Spell="Spells.MacabreStrategem" /> is talented.</li>
                <li>Reset cooldowns with <SpellLink Spell="Spells.FinalStratagem" /> when depleted.</li>
            </ol>
        </SubSection>
        <SubSection Title="Single-Target Opener (Malevolence + Assassin's Guile)">
            <ol>
                <li><SpellLink Spell="Spells.BroodingShadows" /> → <SpellLink Spell="Spells.WidowBite" />.</li>
                <li><SpellLink Spell="Spells.HemorrhagingStrike" />.</li>
                <li><SpellLink Spell="Spells.Backstab" /> → <SpellLink Spell="Spells.ArachnidAssault" /> to build two <SpellLink Spell="Spells.QueenFang" /> buffs.</li>
                <li><SpellLink Spell="Spells.MaidenOfDeath" />.</li>
                <li><strong>Weapon Ability</strong>.</li>
                <li><SpellLink Spell="Spells.BroodingShadows" /> → <SpellLink Spell="Spells.Backstab" />.</li>
                <li><SpellLink Spell="Spells.FinalStratagem" /> if applicable.</li>
                <li><SpellLink Spell="Spells.QueenFang" />.</li>
                <li><SpellLink Spell="Spells.WidowBite" />.</li>
                <li><SpellLink Spell="Spells.QueenFang" />.</li>
                <li>Continue per the single-target priority.</li>
            </ol>
        </SubSection>
        <SubSection Title="AoE Opener (Malevolence + Assassin's Guile)">
            <ol>
                <li><SpellLink Spell="Spells.BroodingShadows" /> → <SpellLink Spell="Spells.WidowBite" />.</li>
                <li><SpellLink Spell="Spells.QueenFang" />.</li>
                <li><SpellLink Spell="Spells.SkitteringBlades" /> → <SpellLink Spell="Spells.QueenFang" /> for the second <SpellLink Spell="Spells.ArachnidAssault" /> buff.</li>
                <li><SpellLink Spell="Spells.MaidenOfDeath" />.</li>
                <li><strong>Weapon Ability</strong>.</li>
                <li><SpellLink Spell="Spells.BroodingShadows" /> → <SpellLink Spell="Spells.SkitteringBlades" />.</li>
                <li><SpellLink Spell="Spells.FinalStratagem" /> if applicable.</li>
                <li><SpellLink Spell="Spells.ArachnidAssault" />.</li>
                <li><SpellLink Spell="Spells.SkitteringBlades" /> or <SpellLink Spell="Spells.WidowBite" /> per target count.</li>
                <li><SpellLink Spell="Spells.ArachnidAssault" />.</li>
                <li>Continue per the AoE priority.</li>
            </ol>
        </SubSection>
        <SubSection Title="Single-Target Priority">
            <ol>
                <li>Maintain debuffs: keep <strong>Seething Poison</strong> active with <SpellLink Spell="Spells.WidowBite" />, and apply <SpellLink Spell="Spells.HemorrhagingStrike" />.</li>
                <li>Build combo points (0–3/4): <SpellLink Spell="Spells.WidowBite" /> at 4 or fewer targets; <SpellLink Spell="Spells.Backstab" /> at 1–2 targets.</li>
                <li>Spend combo points (5+): <SpellLink Spell="Spells.HemorrhagingStrike" /> for bleeds and <strong>Hemotoxin</strong>; <SpellLink Spell="Spells.QueenFang" /> at 2 or fewer targets.</li>
                <li>Poisons: apply <strong>Seething Poison</strong> first; <strong>Caustic Poison</strong> at 3 or fewer targets.</li>
            </ol>
        </SubSection>
        <SubSection Title="AoE Priority (3+ targets)">
            <ol>
                <li>Maintain debuffs: keep <strong>Seething Poison</strong> active with <SpellLink Spell="Spells.WidowBite" />, and apply <SpellLink Spell="Spells.HemorrhagingStrike" />.</li>
                <li>Build combo points (0–3/4): <SpellLink Spell="Spells.SkitteringBlades" /> at 8+ targets; <SpellLink Spell="Spells.WidowBite" /> at 4 or fewer; <SpellLink Spell="Spells.SkitteringBlades" /> at 3+.</li>
                <li>Spend combo points (4+): <SpellLink Spell="Spells.HemorrhagingStrike" /> for bleeds and <strong>Hemotoxin</strong>; <SpellLink Spell="Spells.ArachnidAssault" /> at 3+ targets.</li>
                <li>Poisons: apply <strong>Seething Poison</strong> first; <strong>Volatile Poison</strong> at 4+ targets.</li>
            </ol>
        </SubSection>
    </Section>

    <Section Title="Cooldowns & Utility">
        <ul>
            <li><SpellLink Spell="Spells.BroodingShadows" /> — applies poisons; open with it and refresh on cooldown.</li>
            <li><SpellLink Spell="Spells.MaidenOfDeath" /> — damage multiplier; align it with combo-point spending.</li>
            <li><SpellLink Spell="Spells.MatriarchMacabre" /> — burst window.</li>
            <li><SpellLink Spell="Spells.FinalStratagem" /> — resets abilities; use it to recover cooldowns when depleted.</li>
            <li><SpellLink Spell="Spells.StalkerStep" /> — teleport behind the target with +50% movement speed for 4s.</li>
            <li><SpellLink Spell="Spells.ShadowWard" /> — 40% damage reduction for 4s (30s cooldown).</li>
            <li><SpellLink Spell="Spells.WebCrack" /> — 4s stun (30s cooldown).</li>
        </ul>
    </Section>

    <Section Title="Talents & Builds">
        <Explanation>
            <ul>
                <li><strong>Assassin's Guile</strong> — +40% finisher damage for 5s after poison-empowered generators; chain finishers inside these windows.</li>
                <li><strong>Malevolence</strong> — <SpellLink Spell="Spells.QueenFang" /> and <SpellLink Spell="Spells.ArachnidAssault" /> buff each other by +100% (stacks to 2); prepare two stacks before an Assassin's Guile window.</li>
                <li><strong>Deadly Scheme</strong> — after spending 200 Energy the next finisher crits; combine with Assassin's Guile and Malevolence.</li>
                <li><strong>Sinner's Pride</strong> — shifts toward combo-point efficiency outside <SpellLink Spell="Spells.MaidenOfDeath" /> in single-target.</li>
            </ul>
        </Explanation>
        <HelperText>Track your buffs and debuffs, and reposition them toward the center of the screen via HUD editing.</HelperText>
    </Section>

    <TipBox Variant="TipBoxVariant.Info" Title="Source">
        Adapted from the community
        <a href="https://www.method.gg/fellowship/heroes/mara/playstyle-and-rotation"
           target="_blank" rel="noopener noreferrer">method.gg Mara guide</a>.
    </TipBox>
</GuideContainer>
