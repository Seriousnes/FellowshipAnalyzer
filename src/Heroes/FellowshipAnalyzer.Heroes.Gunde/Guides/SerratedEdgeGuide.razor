@using FellowshipAnalyzer.Core.Common.Items
@using Items = FellowshipAnalyzer.Core.Common.Items.Items
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inherits GuideComponent<GundeCombatLogParser>

<GuideSection Title="Serrated Edge">
    <LeftPanel>
        <p>
            Avoid consuming <SpellLink Spell="Spells.SerratedEdge" /> on filler abilities.           

            @if (this.Owner.SelectedCombatant.Legendary is { } legendary)
            {
                <text>With <ItemLink Item="legendary" /> equipped, spend it in this order:</text>
            }
            else
            {
                <text>Spend it in this order:</text>
            }
        </p>
        @foreach (var order in Orders())
        {
            <p>@order.Lead:</p>
            <ol>
                @foreach (var id in order.Abilities)
                {
                    <li><SpellLink Spell="id" /></li>
                }
            </ol>
        }
        <p>
            A sub-optimal consumer is better than a missed cast opportunity,
            so avoid holding <SpellLink Spell="Spells.BloodArc" /> for too long.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (TotalGrants == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                No Serrated Edge buff was recorded on any pull.
            </TipBox>
        }
        else
        {
            <CastOverview Title="Serrated Edge Overview" Stats="@BuildOverviewStats()" />
            <StackedBar Segments="@BuildStackedBar()" />
            <CastDetail Title="Grants"
                        Description="Each card is one Serrated Edge buff, rated on the ability that consumed it and on what the pull had available at the time."
                        Casts="@BuildPerCastData()" />
        }
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.SerratedEdgeAnalyzers.Count > 0;

    private static readonly int ConversionPercent =
        (int)Math.Round(SerratedEdgeAnalyzer.AdditionalRendConversion * 100);

    private List<SerratedEdgeAnalyzer> Analyzers =>
        [.. Parser.SerratedEdgeAnalyzers.Select(entry => entry.Analyzer)];

    private int TotalGrants => Analyzers.Sum(analyzer => analyzer.JudgedGrants);

    private long TotalRendConverted => Analyzers.Sum(analyzer => analyzer.TotalRendConverted);

    private IEnumerable<(string Lead, List<int> Abilities)> Orders() =>
        new[] { GundePullShape.Boss, GundePullShape.Aoe }
            .Select(shape => (Lead: ShapeLead(shape), Analyzer: Analyzers.FirstOrDefault(analyzer => analyzer.Shape == shape)))
            .Where(entry => entry.Analyzer is not null)
            .Select(entry => (entry.Lead, entry.Analyzer!.ConsumerPriority));

    private static string ShapeLead(GundePullShape shape) =>
        shape == GundePullShape.Aoe ? "On a pack" : "On a boss";

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var grants = TotalGrants;
        var priority = Analyzers.Sum(analyzer => analyzer.PriorityConsumed);
        var alternate = Analyzers.Sum(analyzer => analyzer.AlternateConsumed);
        var avoidable = Analyzers.Sum(analyzer => analyzer.AvoidableFiller);
        var forced = Analyzers.Sum(analyzer => analyzer.ForcedFiller);
        var unspent = Analyzers.Sum(analyzer => analyzer.Unspent);
        var priorityRate = grants > 0 ? (int)Math.Round((double)priority / grants * 100) : 0;

        var stats = new List<OverviewStat>
        {
            new(
                $"{grants}",
                "Grants",
                $"Serrated Edge buffs granted and removed inside a pull. Consumed by {ConsumerSplit()}."),
            new(
                $"{priorityRate}%",
                "On Priority",
                $"{priority} of {grants} grants went on the first ability in their pull's order. A further {alternate} went on a lower one, which is not counted as a miss. Reported as context rather than scored, because it cannot reach 100%."),
            new(
                $"{avoidable}",
                "Avoidable Filler",
                "Grants consumed by a filler ability while an ability in the pull's order was off cooldown. Hold Blood Arc a beat so one of them follows it.",
                avoidable == 0 ? QualitativePerformance.Perfect : AvoidableTier(grants, avoidable)),
            new(
                $"{forced}",
                "Forced Filler",
                "Grants consumed by a filler ability with every ability in the pull's order on cooldown. This is context, not a verdict."),
            new(
                $"{TotalRendConverted:N0}",
                "Rend Converted",
                $"{ConversionPercent}% of the damage each consuming cast dealt, across all of its hits{ConvertedClause()}. Exsanguinate damage is not counted. This is context, not a verdict."),
        };

        if (unspent > 0)
        {
            stats.Add(new OverviewStat(
                $"{unspent}",
                "Unspent",
                "Grants removed with no cast to account for them.",
                QualitativePerformance.Fail));
        }

        return stats;
    }

    private string ConsumerSplit()
    {
        var split = Analyzers
            .SelectMany(analyzer => analyzer.Grants)
            .GroupBy(grant => grant.ConsumerAbilityId)
            .OrderByDescending(group => group.Count())
            .Select(group => $"{ConsumerName(group.Key)} {group.Count()}");

        return string.Join(", ", split);
    }

    private string ConvertedClause()
    {
        var split = ConvertedSplit();
        return split.Length == 0 ? string.Empty : $": {split}";
    }

    private string ConvertedSplit()
    {
        var split = Analyzers
            .SelectMany(analyzer => analyzer.Grants)
            .Where(grant => grant.RendConverted > 0)
            .GroupBy(grant => grant.ConsumerAbilityId)
            .Select(group => (Name: ConsumerName(group.Key), Converted: group.Sum(grant => grant.RendConverted)))
            .OrderByDescending(entry => entry.Converted)
            .Select(entry => $"{entry.Name} {entry.Converted:N0}");

        return string.Join(", ", split);
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar()
    {
        var buckets = new (SerratedEdgeOutcome Outcome, string Label, string Color, string Description)[]
        {
            (SerratedEdgeOutcome.Priority, "On priority", PerformanceColors.Perfect, "went on the first ability in the pull's order"),
            (SerratedEdgeOutcome.Alternate, "Lower in the order", PerformanceColors.Good, "went on an ability further down the pull's order"),
            (SerratedEdgeOutcome.ForcedFiller, "Forced filler", PerformanceColors.Ok, "went on filler with every ability in the order on cooldown"),
            (SerratedEdgeOutcome.AvoidableFiller, "Avoidable filler", PerformanceColors.Fail, "went on filler with an ability in the order off cooldown"),
            (SerratedEdgeOutcome.Unspent, "Unspent", PerformanceColors.Fail, "were removed with nothing to account for them"),
        };

        var grants = Analyzers.SelectMany(analyzer => analyzer.Grants).ToList();

        return
        [
            .. buckets
                .Select(bucket => (bucket, Count: grants.Count(grant => grant.Outcome == bucket.Outcome)))
                .Where(entry => entry.Count > 0)
                .Select(entry => new StackedBarSegment(
                    entry.bucket.Label,
                    entry.Count,
                    entry.bucket.Color,
                    $"{entry.bucket.Label}: {entry.Count} grants {entry.bucket.Description}"))
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.SerratedEdgeAnalyzers.ToItemRows(
            Parser, ProjectGrants, (row, pull) => BuildGrantRow(row));

    private static IEnumerable<GrantRow> ProjectGrants(SerratedEdgeAnalyzer analyzer) =>
        analyzer.Grants.Select(grant => new GrantRow(grant, analyzer.Shape, analyzer.PriorityAbilityId));

    private PerCastRow BuildGrantRow(GrantRow row)
    {
        var grant = row.Grant;
        var perf = Tier(grant.Outcome, row.Shape);

        var stats = new List<PerCastStat>
        {
            new(
                ConsumerName(grant.ConsumerAbilityId),
                "Consumed By",
                $"The ability that took the buff. This pull wanted it on {ConsumerName(row.PriorityAbilityId)}.",
                perf),
        };

        if (grant.ConsumerAbilityId is not null)
        {
            stats.Add(new PerCastStat(
                $"{grant.RendConverted:N0}",
                "Rend Converted",
                ConvertedTooltip(grant)));
        }

        if (IsFiller(grant.Outcome))
        {
            stats.AddRange(grant.Readiness.Select(entry =>
                AvailabilityStat(ConsumerName(entry.AbilityId), entry.Ready, entry.RemainingMs)));
        }
        else
        {
            stats.Add(new PerCastStat(
                ConsumerName(row.PriorityAbilityId),
                "Pull Priority",
                "The first ability in this pull's order."));
        }

        return new PerCastRow
        {
            Performance = perf,
            Stats = [.. stats],
            Timestamp = grant.Timestamp,
            Sequence = BuildSequence(grant, perf),
            AdditionalContent = new AdditionalContent("Usage Notes", @<div>@BuildNote(row)</div>),
        };
    }

    private static string ConvertedTooltip(SerratedEdgeGrant grant) =>
        $"{ConversionPercent}% of the {grant.ConsumerDamage:N0} damage {ConsumerName(grant.ConsumerAbilityId)} dealt."
        + (grant.ExsanguinateDamage > 0
            ? $" A further {grant.ExsanguinateDamage:N0} of Exsanguinate damage is not counted."
            : string.Empty);

    private static PerCastStat AvailabilityStat(string name, bool ready, int remainingMs) =>
        new(
            ready ? "Ready" : $"{remainingMs / 1000d:0.#}s",
            name,
            ready
                ? $"{name} was off cooldown and could have taken this buff instead."
                : $"{name} had {remainingMs / 1000d:0.#}s of cooldown left, so it could not have taken this buff.",
            ready ? QualitativePerformance.Fail : QualitativePerformance.Ok);

    private static SpellCastEntry[] BuildSequence(SerratedEdgeGrant grant, QualitativePerformance perf) =>
        grant.ConsumerAbilityId is { } consumer
            ? [new SpellCastEntry(Spells.BloodArc.FSLID.Value, null), new SpellCastEntry(consumer, perf)]
            : [new SpellCastEntry(Spells.BloodArc.FSLID.Value, null)];

    private static string BuildNote(GrantRow row)
    {
        var grant = row.Grant;
        var consumer = ConsumerName(grant.ConsumerAbilityId);
        var priority = ConsumerName(row.PriorityAbilityId);

        return grant.Outcome switch
        {
            SerratedEdgeOutcome.Priority =>
                $"{consumer} consumed the buff, which is exactly what this pull wanted Blood Arc to set up.",
            SerratedEdgeOutcome.Alternate =>
                $"{consumer} consumed the buff, this pull's {Ordinal(grant.ConsumerRank)} choice. Spend it on {priority} first.",
            SerratedEdgeOutcome.AvoidableFiller =>
                $"{consumer} consumed the buff while {ReadyClause(grant)}. Hold Blood Arc a beat so one of them follows it.",
            SerratedEdgeOutcome.ForcedFiller =>
                $"{consumer} consumed the buff with {RemainingClause(grant)} from coming back, so there was nothing better to put it on.",
            _ =>
                "The buff was removed with no cast to account for it.",
        };
    }

    private static string Ordinal(int? rank) => rank switch
    {
        1 => "second",
        2 => "third",
        _ => "next",
    };

    private static string ReadyClause(SerratedEdgeGrant grant)
    {
        var ready = grant.Readiness
            .Where(entry => entry.Ready)
            .Select(entry => ConsumerName(entry.AbilityId))
            .ToList();

        return ready.Count == 1 ? $"{ready[0]} was off cooldown" : $"{Join(ready)} were off cooldown";
    }

    private static string RemainingClause(SerratedEdgeGrant grant) =>
        Join([.. grant.Readiness.Select(entry => $"{ConsumerName(entry.AbilityId)} {Remaining(entry.RemainingMs)}")]);

    private static string Join(List<string> parts) =>
        parts.Count <= 1
            ? string.Concat(parts)
            : $"{string.Join(", ", parts.Take(parts.Count - 1))} and {parts[^1]}";

    private static string Remaining(int milliseconds) => $"{milliseconds / 1000d:0.#}s";

    private static bool IsFiller(SerratedEdgeOutcome outcome) =>
        outcome is SerratedEdgeOutcome.AvoidableFiller or SerratedEdgeOutcome.ForcedFiller;

    private static QualitativePerformance Tier(SerratedEdgeOutcome outcome, GundePullShape shape) => outcome switch
    {
        SerratedEdgeOutcome.Priority => QualitativePerformance.Perfect,
        SerratedEdgeOutcome.Alternate => shape == GundePullShape.Aoe
            ? QualitativePerformance.Good
            : QualitativePerformance.Ok,
        SerratedEdgeOutcome.ForcedFiller => QualitativePerformance.Ok,
        _ => QualitativePerformance.Fail,
    };

    private static QualitativePerformance AvoidableTier(int grants, int avoidable) =>
        PerformanceTiers.FromThresholds(100 - (int)Math.Round((double)avoidable / grants * 100), 90, 75, 50);

    private static string ConsumerName(int? abilityId) =>
        abilityId is not { } consumer ? "Nothing"
        : consumer == Spells.HeartSplitter.FSLID.Value ? "Heart Splitter"
        : consumer == Spells.GrimCarve.FSLID.Value ? "Grim Carve"
        : consumer == Spells.Rupture.FSLID.Value ? "Rupture"
        : consumer == Spells.BloodArc.FSLID.Value ? "Blood Arc"
        : consumer == Spells.ReaverEdge.FSLID.Value ? "Reaver's Edge"
        : consumer == Spells.DoubleStrike.FSLID.Value ? "Double Strike"
        : "Other";

    private sealed record GrantRow(SerratedEdgeGrant Grant, GundePullShape Shape, int PriorityAbilityId);
}
