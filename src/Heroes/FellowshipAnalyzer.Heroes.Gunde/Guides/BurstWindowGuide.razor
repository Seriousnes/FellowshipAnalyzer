@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inject GundeCombatLogParser Parser

<GuideSection Title="Burst Windows">
    <Explanation>
        <p>
            <SpellLink Spell="Spells.ReignInBlood" /> converts an extra 30% of ability damage into
            Rend for @(BurstWindowAnalyzer.BuffDurationMs / 1000) seconds and only comes back every
            @(ReignInBloodCooldownSeconds) seconds - it is the amplifier the rest of the burst is
            built around. <SpellLink Spell="Spells.Rupture" />, the biggest single hit in the kit, and
            <SpellLink Spell="Spells.BloodboundSpirit" />, worth 15% on Heart Splitter and Grim
            Carve, are both worth far less outside it, and saved Blood Feather stacks should be
            cashed in through <SpellLink Spell="Spells.OwedInBlood" /> while the conversion is up.
        </p>
        <p>
            Each window below is scored on how many of those three landed inside it. A cast up to
            @(BurstWindowAnalyzer.LeadInMs / 1000) seconds before the buff appears still counts,
            because Bloodbound Spirit is normally pressed just ahead of Reign in Blood. Ruptures and
            Bloodbound Spirits spent outside every window are counted separately; Owed in Blood
            outside a window is ordinary filler conversion, not a mistake.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Burst Overview" Stats="@BuildOverviewStats()" />
        @if (TotalWindows == 0)
        {
            <p>Reign in Blood was never used, so none of Gunde's burst damage was amplified.</p>
        }
        else
        {
            <CastDetail Title="Reign in Blood Windows"
                        Description="Each card is one Reign in Blood window, rated on how much of the burst was stacked into it."
                        Casts="@BuildPerCastData()" />
        }
    </ChildContent>
</GuideSection>

@code {
    private int TotalWindows => Parser.BurstWindowAnalyzers.Sum(entry => entry.Analyzer.WindowCount);

    private static int ReignInBloodCooldownSeconds => BurstWindowAnalyzer.ReignInBloodCooldownMs / 1000;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.BurstWindowAnalyzers.Select(entry => entry.Analyzer).ToList();
        var used = analyzers.Sum(analyzer => analyzer.WindowCount);
        var possible = Parser.BurstWindowAnalyzers.Where(IsJudged).Sum(entry => entry.Analyzer.PossibleWindows);
        var full = analyzers.Sum(analyzer => analyzer.FullWindows);
        var strayRuptures = analyzers.Sum(analyzer => analyzer.OutOfWindowRuptures);
        var straySpirits = analyzers.Sum(analyzer => analyzer.OutOfWindowBloodboundSpirits);

        var usedRate = possible > 0 ? (int)Math.Round((double)used / possible * 100) : 0;
        var fullRate = used > 0 ? (int)Math.Round((double)full / used * 100) : 0;

        return
        [
            new OverviewStat(
                $"{used}/{possible}",
                "Windows Used",
                $"Reign in Blood windows opened against the {possible} its {ReignInBloodCooldownSeconds} second cooldown allowed. Bosses, long pulls, and any pull it was actually used on are counted; short trash packs are not held against it.",
                PercentTier(usedRate)),
            new OverviewStat(
                $"{full}",
                "Full Windows",
                used > 0
                    ? $"{full} of {used} windows held Rupture, Bloodbound Spirit and Owed in Blood together."
                    : "No Reign in Blood window was opened, so none could be judged.",
                used > 0 ? PercentTier(fullRate) : null),
            new OverviewStat(
                $"{strayRuptures}",
                "Rupture Outside",
                "Ruptures cast outside every Reign in Blood window, converting at the base rate instead of the boosted one.",
                StrayTier(strayRuptures)),
            new OverviewStat(
                $"{straySpirits}",
                "Spirit Outside",
                "Bloodbound Spirits cast outside every Reign in Blood window, so the two amplifiers never overlapped.",
                StrayTier(straySpirits)),
        ];
    }

    /// <summary>
    /// Whether a pull belongs in the windows-used denominator. Every pull gets an analyzer, but a
    /// short trash pack could never be expected to host a 90 second cooldown, so counting one
    /// theoretical window against each of them would invent a failure on any dungeon run. A pull is
    /// judged when it is a boss, when it ran long enough for a second window, or when Reign in Blood
    /// was used on it.
    /// </summary>
    private static bool IsJudged(PullAnalyzer<BurstWindowAnalyzer> entry) =>
        entry.Pull.IsBoss || entry.Analyzer.WindowCount > 0 || entry.Analyzer.PossibleWindows > 1;

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.BurstWindowAnalyzers.ToItemRows(Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(BurstWindowAnalyzer.BurstWindow window)
    {
        var perf = window.PresentCount switch
        {
            3 => QualitativePerformance.Perfect,
            2 => QualitativePerformance.Good,
            1 => QualitativePerformance.Ok,
            _ => QualitativePerformance.Fail,
        };

        var stats = new[]
        {
            new PerCastStat(
                window.RuptureIn ? "Yes" : "No",
                "Rupture",
                "Whether Rupture landed inside this window, so its hit converted at the boosted rate.",
                window.RuptureIn ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new PerCastStat(
                window.BloodboundSpiritIn ? "Yes" : "No",
                "Bloodbound Spirit",
                "Whether Bloodbound Spirit overlapped this window, stacking its damage buff on top of the conversion.",
                window.BloodboundSpiritIn ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new PerCastStat(
                window.OwedInBloodIn ? "Yes" : "No",
                "Owed in Blood",
                "Whether saved Blood Feather stacks were cashed into Rend inside this window.",
                window.OwedInBloodIn ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new PerCastStat(
                FormatSeconds(window.End - window.Start),
                "Window",
                "How long the Reign in Blood buff was up for this window."),
        };

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = window.Start,
            AdditionalContent = new AdditionalContent("Alignment Notes", @<div>@BuildNote(window)</div>),
        };
    }

    private static string BuildNote(BurstWindowAnalyzer.BurstWindow window)
    {
        var missing = new List<string>();
        if (!window.RuptureIn) missing.Add("Rupture");
        if (!window.BloodboundSpiritIn) missing.Add("Bloodbound Spirit");
        if (!window.OwedInBloodIn) missing.Add("Owed in Blood");

        if (missing.Count == 0)
            return "Rupture, Bloodbound Spirit and Owed in Blood all landed inside this window, so the whole burst converted at the boosted rate.";

        if (missing.Count == BurstWindowAnalyzer.BurstWindow.CooldownCount)
            return "None of the burst cooldowns landed inside this window, so the extra 30% conversion had nothing worth amplifying.";

        var held = missing.Count == 1 ? "it" : "them";
        return $"{JoinNames(missing)} landed outside this window - hold {held} for the next Reign in Blood instead of spending on cooldown.";
    }

    private static string JoinNames(List<string> names) =>
        names.Count switch
        {
            1 => names[0],
            2 => $"{names[0]} and {names[1]}",
            _ => $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]}",
        };

    private static string FormatSeconds(int milliseconds) => $"{milliseconds / 1000d:0.#}s";

    private static QualitativePerformance StrayTier(int count) =>
        count == 0 ? QualitativePerformance.Perfect
        : count == 1 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;

    private static QualitativePerformance PercentTier(int percent) => PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
