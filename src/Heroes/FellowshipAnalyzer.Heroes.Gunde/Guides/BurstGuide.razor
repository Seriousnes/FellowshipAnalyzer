@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inherits ReportComponent<GundeCombatLogParser>

<GuideSection Title="Burst Windows">
    <LeftPanel>
        <p>
            <SpellLink Spell="Spells.ReignInBlood" /> enables a windows for a big <SpellLink Spell="Spells.Rend" /> setup
            to be exanguinated via <SpellLink Spell="Spells.HeartSplitter" /> or consumed with <SpellLink Spell="Spells.Slaughter" />.
            Aim to pair with <SpellLink Spell="Spells.Rupture" /> and <SpellLink Spell="Spells.BloodboundSpirit" /> for maximum damage.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Burst Overview" Stats="@BuildOverviewStats()" />
        @if (TotalWindows == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                Reign in Blood was never used, so none of Gunde's burst damage was amplified.
            </TipBox>
        }
        else
        {
            <CastDetail Title="Reign in Blood Windows"
                        Description="Each card is one Reign in Blood window, rated on how much of the burst was stacked into it."
                        Casts="@BuildPerCastData()" />
        }
    </RightPanel>
</GuideSection>

@code {
    private int TotalWindows => Parser.BurstAnalyzers.Sum(entry => entry.Analyzer.WindowCount);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.BurstAnalyzers.Select(entry => entry.Analyzer).ToList();
        var opened = analyzers.Sum(analyzer => analyzer.WindowCount);
        var full = analyzers.Sum(analyzer => analyzer.FullWindows);
        var strayRuptures = analyzers.Sum(analyzer => analyzer.OutOfWindowRuptures);
        var straySpirits = analyzers.Sum(analyzer => analyzer.OutOfWindowBloodboundSpirits);

        var fullRate = opened > 0 ? (int)Math.Round((double)full / opened * 100) : 0;

        return
        [
            new OverviewStat(
                $"{opened}",
                "Windows Opened",
                "Reign in Blood windows opened across the run. Cooldown acceleration decides how many a run can hold, so this is reported as presence rather than against a budget."),
            new OverviewStat(
                $"{full}",
                "Full Windows",
                opened > 0
                    ? $"{full} of {opened} windows held Rupture, Bloodbound Spirit and Owed in Blood together. A cast up to {BurstAnalyzer.LeadInMs / 1000} seconds before the buff appears still counts, because Bloodbound Spirit is normally pressed just ahead of Reign in Blood."
                    : "No Reign in Blood window was opened, so none could be judged.",
                opened > 0 ? PercentTier(fullRate) : null),
            new OverviewStat(
                $"{strayRuptures}",
                "Rupture Outside",
                "Ruptures cast outside every Reign in Blood window. Rupture comes back faster than the windows do, so some of these are unavoidable - this is context, not a verdict."),
            new OverviewStat(
                $"{straySpirits}",
                "Spirit Outside",
                "Bloodbound Spirits cast outside every Reign in Blood window. The windows do not always open when it is available, so some of these are unavoidable - this is context, not a verdict."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.BurstAnalyzers.ToItemRows(Parser, analyzer => analyzer.Windows, (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(BurstAnalyzer.BurstWindow window)
    {
        var perf = window.PresentCount switch
        {
            3 => QualitativePerformance.Perfect,
            2 => QualitativePerformance.Good,
            1 => QualitativePerformance.Ok,
            _ => QualitativePerformance.Fail,
        };

        var stats = new[]
        {
            new PerCastStat(
                window.RuptureIn ? "Yes" : "No",
                "Rupture",
                "Whether Rupture landed inside this window, so its damage was amplified.",
                window.RuptureIn ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new PerCastStat(
                window.BloodboundSpiritIn ? "Yes" : "No",
                "Bloodbound Spirit",
                "Whether Bloodbound Spirit overlapped this window, stacking its damage buff on top of the amplifier.",
                window.BloodboundSpiritIn ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new PerCastStat(
                window.OwedInBloodIn ? "Yes" : "No",
                "Owed in Blood",
                "Whether saved Blood Feather stacks were cashed into Rend inside this window. Owed in Blood outside a window is ordinary filler conversion, not a mistake.",
                window.OwedInBloodIn ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new PerCastStat(
                FormatSeconds(window.End - window.Start),
                "Window",
                $"How long the Reign in Blood buff was active for this window. A cast up to {BurstAnalyzer.LeadInMs / 1000} seconds before it appeared counts as inside."),
        };

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = window.Start,
            AdditionalContent = new AdditionalContent("Alignment Notes", @<div>@BuildNote(window)</div>),
        };
    }

    private static string BuildNote(BurstAnalyzer.BurstWindow window)
    {
        var missing = new List<string>();
        if (!window.RuptureIn) missing.Add("Rupture");
        if (!window.BloodboundSpiritIn) missing.Add("Bloodbound Spirit");
        if (!window.OwedInBloodIn) missing.Add("Owed in Blood");

        if (missing.Count == 0)
            return "Rupture, Bloodbound Spirit and Owed in Blood all landed inside this window, so the whole burst was amplified.";

        if (missing.Count == BurstAnalyzer.BurstWindow.CooldownCount)
            return "None of the burst cooldowns landed inside this window, so the extra 30% flowing into Rend had nothing worth amplifying.";

        var held = missing.Count == 1 ? "it" : "them";
        return $"{JoinNames(missing)} landed outside this window - hold {held} for the next Reign in Blood instead of spending on cooldown.";
    }

    private static string JoinNames(List<string> names) =>
        names.Count switch
        {
            1 => names[0],
            2 => $"{names[0]} and {names[1]}",
            _ => $"{string.Join(", ", names.Take(names.Count - 1))} and {names[^1]}",
        };

    private static string FormatSeconds(int milliseconds) => $"{milliseconds / 1000d:0.#}s";

    private static QualitativePerformance PercentTier(int percent) => PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
