@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inject GundeCombatLogParser Parser

<GuideSection Title="Owed in Blood">
    <Explanation>
        <p>
            Every Blood Feather picked up is one stack of Rend waiting to be placed, and
            <SpellLink Spell="Spells.OwedInBlood" /> converts the whole bank one-for-one onto its
            target. A conversion is worth exactly the pile standing behind it, so the button rewards
            patience - but only up to a point. The buff falls off with the stacks still on it, and the
            pool stops accepting feathers at @OwedInBloodEconomyAnalyzer.MaxStacks, so hoarding leaks
            just as reflex-spending does.
        </p>
        <p>
            Each conversion below is measured against the biggest one of the same pull, because the
            bank a pull can build depends on its length and on how much was bleeding. Stacks still held
            when a pull ends are not counted against you; only stacks the buff shed with no cast to
            account for them are.
        </p>
    </Explanation>
    <ChildContent>
        @if (!HasActivity)
        {
            <p>No Blood Feather stacks were observed on any pull, so there was nothing for Owed in Blood to convert.</p>
        }
        else
        {
            <CastOverview Title="Conversion Overview" Stats="@BuildOverviewStats()" />
            @if (AccountedStacks > 0)
            {
                <StackedBar Segments="@BuildStackedBar()" />
            }
            @if (TotalConversions == 0)
            {
                <p>@EmptySummary</p>
            }
            else
            {
                @if (UnmeasuredConversions > 0)
                {
                    <p>@UnmeasuredSummary</p>
                }
                <CastDetail Title="Conversions"
                            Description="Each card is one Owed in Blood cast, rated on the bank it cashed in relative to the best conversion of that pull."
                            Casts="@BuildPerCastData()" />
            }
        }
    </ChildContent>
</GuideSection>

@code {
    private const int RelativePerfect = 80;
    private const int RelativeGood = 55;
    private const int RelativeOk = 30;

    private const int RetentionPerfect = 90;
    private const int RetentionGood = 75;
    private const int RetentionOk = 50;

    private List<OwedInBloodEconomyAnalyzer> Analyzers =>
        [.. Parser.OwedInBloodEconomyAnalyzers.Select(entry => entry.Analyzer)];

    private int TotalConversions => Analyzers.Sum(analyzer => analyzer.Conversions.Count);

    /// <summary>
    /// Conversions whose bank the pull actually saw being built. A conversion of a bank carried in
    /// from the previous pull reads zero stacks with nothing measured behind it, so it is left out of
    /// every average and every verdict.
    /// </summary>
    private int MeasuredConversions =>
        Analyzers.Sum(analyzer => analyzer.Conversions.Count(conversion => conversion.BankObserved));

    private int UnmeasuredConversions => TotalConversions - MeasuredConversions;

    private string UnmeasuredSummary => UnmeasuredConversions == 1
        ? "One conversion cashed in a bank built before its pull started. Its size could not be measured, so it is shown without a verdict."
        : $"{UnmeasuredConversions} conversions cashed in banks built before their pull started. Their sizes could not be measured, so they are shown without a verdict.";

    private int TotalConverted => Analyzers.Sum(analyzer => analyzer.TotalStacksConverted);

    private int TotalDecayed => Analyzers.Sum(analyzer => analyzer.DecayedStacks);

    private int AccountedStacks => TotalConverted + TotalDecayed;

    private int TotalCappedMs => Analyzers.Sum(analyzer => analyzer.CappedMs);

    /// <summary>
    /// Whether the run gave the section anything to judge. A Gunde log with no feather stacks at all
    /// gets a sentence rather than a wall of zeroes, matching the other Gunde guide sections.
    /// </summary>
    private bool HasActivity => TotalConversions > 0 || TotalDecayed > 0 || TotalCappedMs > 0;

    private string EmptySummary => TotalDecayed > 0
        ? $"Owed in Blood was never cast, so all {TotalDecayed} banked Blood Feathers expired without becoming Rend."
        : "Owed in Blood was never cast, and no Blood Feather stacks were observed to bank.";

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var conversions = TotalConversions;
        var measured = MeasuredConversions;
        var unmeasured = UnmeasuredConversions;
        var converted = TotalConverted;
        var decayed = TotalDecayed;
        var accounted = AccountedStacks;
        var cappedMs = TotalCappedMs;
        var average = measured > 0 ? (double)converted / measured : 0d;

        return
        [
            new OverviewStat(
                $"{converted}",
                "Stacks Converted",
                "Blood Feather stacks turned into Rend across every Owed in Blood cast."),
            new OverviewStat(
                $"{conversions}",
                "Conversions",
                unmeasured > 0
                    ? $"Owed in Blood casts across every pull. {unmeasured} of them cashed in a bank built before their pull started, so only {measured} could be measured."
                    : "Owed in Blood casts evaluated across every pull."),
            new OverviewStat(
                measured > 0 ? $"{average:0.#}" : "-",
                "Avg Bank",
                measured > 0
                    ? "Average stacks held per measured conversion. Bigger piles place more Rend per cast, so the cast is worth saving for."
                    : "No Owed in Blood cast had a measurable bank behind it, so there is no bank size to average."),
            new OverviewStat(
                $"{decayed}",
                "Stacks Decayed",
                accounted > 0
                    ? $"{decayed} of {accounted} banked stacks fell off before Owed in Blood could place them."
                    : "No Blood Feather stacks were observed to fall off unspent.",
                accounted > 0 ? RetentionTier(RetentionRate(converted, accounted)) : null),
            new OverviewStat(
                FormatSeconds(cappedMs),
                "Time at Cap",
                $"Time the bank sat at {OwedInBloodEconomyAnalyzer.MaxStacks} stacks, during which further feathers added nothing.",
                CapTier(cappedMs)),
        ];
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar() =>
    [
        new StackedBarSegment("Converted", TotalConverted, PerformanceColors.Good,
            $"Converted: {TotalConverted} stacks placed as Rend"),
        new StackedBarSegment("Decayed", TotalDecayed, PerformanceColors.Fail,
            $"Decayed: {TotalDecayed} stacks lost when the buff fell off"),
    ];

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.OwedInBloodEconomyAnalyzers.ToItemRows(Parser, ProjectConversions, (row, pull) => BuildConversionRow(row));

    private static IEnumerable<ConversionRow> ProjectConversions(OwedInBloodEconomyAnalyzer analyzer)
    {
        var conversions = analyzer.Conversions;
        var best = analyzer.BestConversion;
        var measured = conversions.Count(conversion => conversion.BankObserved);
        return conversions.Select(conversion => new ConversionRow(conversion, best, measured));
    }

    private PerCastRow BuildConversionRow(ConversionRow row)
    {
        var measured = row.Conversion.BankObserved;
        var relative = row.RelativeSize;
        var sizeTier = relative is int percent ? RelativeTier(percent) : (QualitativePerformance?)null;
        var perf = !measured ? QualitativePerformance.Ok
            : row.Conversion.StacksConverted == 0 ? QualitativePerformance.Fail
            : sizeTier ?? QualitativePerformance.Good;

        var stats = new[]
        {
            new PerCastStat(
                measured ? $"{row.Conversion.StacksConverted}" : "-",
                "Stacks Converted",
                !measured
                    ? "The bank this cast converted was built before the pull started, so its size could not be measured."
                    : relative is int share
                        ? $"Blood Feather stacks this cast placed as Rend - {share}% of the best conversion on this pull."
                        : "Blood Feather stacks this cast placed as Rend.",
                measured ? sizeTier : null),
        };

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = row.Conversion.Timestamp,
            Sequence = [new SpellCastEntry(row.Conversion.AbilityId, measured ? perf : null)],
            AdditionalContent = new AdditionalContent("Conversion Notes", @<div>@BuildNote(row)</div>),
        };
    }

    private static string BuildNote(ConversionRow row)
    {
        if (!row.Conversion.BankObserved)
            return "The bank this cast converted was built before the pull started, so its size could not be measured. It is shown here without a verdict.";

        var stacks = row.Conversion.StacksConverted;
        if (stacks == 0)
            return "No Blood Feather stacks were banked when this was pressed, so the conversion placed no Rend at all.";

        if (row.RelativeSize is not int percent)
            return $"Converted {stacks} stacks; with a single measured conversion on this pull there is nothing to compare it against.";

        if (percent >= RelativePerfect)
            return $"Converted {stacks} stacks, {percent}% of this pull's biggest bank - a full-sized deployment.";

        return $"Converted only {stacks} stacks, {percent}% of this pull's biggest bank - let the feathers accumulate further, ideally into a Reign in Blood window, before pressing it.";
    }

    private static int RetentionRate(int converted, int accounted) =>
        (int)Math.Round((double)converted / accounted * 100);

    private static string FormatSeconds(int milliseconds) => $"{milliseconds / 1000d:0.#}s";

    private static QualitativePerformance RetentionTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, RetentionPerfect, RetentionGood, RetentionOk);

    private static QualitativePerformance RelativeTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, RelativePerfect, RelativeGood, RelativeOk);

    /// <summary>
    /// Grades time spent pinned at the stack cap. Any time at the cap is feathers thrown away, but a
    /// brief touch on the way into a conversion is unavoidable, so only sustained capping fails.
    /// </summary>
    private static QualitativePerformance CapTier(int cappedMs) =>
        cappedMs == 0 ? QualitativePerformance.Perfect
        : cappedMs < 10_000 ? QualitativePerformance.Good
        : cappedMs < 30_000 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;

    private sealed record ConversionRow(
        OwedInBloodEconomyAnalyzer.OwedInBloodConversion Conversion,
        int BestConversion,
        int MeasuredConversions)
    {
        /// <summary>
        /// This conversion's bank as a percentage of the pull's biggest, or null when the comparison
        /// would be meaningless: this conversion's bank was never measured, the pull held a single
        /// measured conversion, or none of them banked anything.
        /// </summary>
        public int? RelativeSize =>
            Conversion.BankObserved && BestConversion > 0 && MeasuredConversions > 1
                ? (int)Math.Round((double)Conversion.StacksConverted / BestConversion * 100)
                : null;
    }
}
