@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inherits GuideComponent<GundeCombatLogParser>

<GuideSection Title="Owed in Blood">
    <LeftPanel>
        <p>
            <SpellLink Spell="Spells.OwedInBlood" /> is key to maximising single target damage. 
            Save Blood Feather stacks to combine with <SpellLink Spell="Spells.Rupture" /> and 
            <SpellLink Spell="Spells.Slaughter" /> every time, and save as many as possible for overlapping
            with <SpellLink Spell="Spells.BloodboundSpirit" />.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (!HasActivity)
        {
            <TipBox Variant="TipBoxVariant.Info">
                No Blood Feather stacks were observed on any pull.
            </TipBox>
        }
        else
        {
            <CastOverview Title="Conversion Overview" Stats="@BuildOverviewStats()" />
            @if (AccountedStacks > 0)
            {
                <StackedBar Segments="@BuildStackedBar()" />
            }
            @if (TotalConversions == 0)
            {
                <TipBox Variant="TipBoxVariant.Info">@EmptySummary</TipBox>
            }
            else
            {
                @if (UnmeasuredConversions > 0)
                {
                    <TipBox Variant="TipBoxVariant.Info">@UnmeasuredSummary</TipBox>
                }
                <CastDetail Title="Conversions"
                            Description="Each card is one Owed in Blood cast, rated on the Rupture and Slaughter chained to it and on the stacks it converted against the cap."
                            Casts="@BuildPerCastData()" />
            }
        }
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.OwedInBloodEconomyAnalyzers.Count > 0;

    private const int BankPerfect = 80;
    private const int BankGood = 55;
    private const int BankOk = 30;

    private const int RetentionPerfect = 90;
    private const int RetentionGood = 75;
    private const int RetentionOk = 50;

    private List<OwedInBloodEconomyAnalyzer> Analyzers =>
        [.. Parser.OwedInBloodEconomyAnalyzers.Select(entry => entry.Analyzer)];

    private int TotalConversions => Analyzers.Sum(analyzer => analyzer.Conversions.Count);

    private int MeasuredConversions =>
        Analyzers.Sum(analyzer => analyzer.Conversions.Count(conversion => conversion.BankObserved));

    private int UnmeasuredConversions => TotalConversions - MeasuredConversions;

    private string UnmeasuredSummary => UnmeasuredConversions == 1
        ? "One conversion drew on a bank built before its pull started. Its size could not be measured, so it is rated on its chain alone."
        : $"{UnmeasuredConversions} conversions drew on banks built before their pull started. Their sizes could not be measured, so they are rated on their chains alone.";

    private int TotalConverted => Analyzers.Sum(analyzer => analyzer.TotalStacksConverted);

    private int TotalDecayed => Analyzers.Sum(analyzer => analyzer.DecayedStacks);

    private int AccountedStacks => TotalConverted + TotalDecayed;

    private int TotalCappedMs => Analyzers.Sum(analyzer => analyzer.CappedMs);

    private bool HasActivity => TotalConversions > 0 || TotalDecayed > 0 || TotalCappedMs > 0;

    private string EmptySummary => TotalDecayed > 0
        ? $"Owed in Blood was never cast, so all {TotalDecayed} banked Blood Feathers expired unused."
        : "Owed in Blood was never cast, and no Blood Feather stacks were observed.";

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var conversions = TotalConversions;
        var measured = MeasuredConversions;
        var unmeasured = UnmeasuredConversions;
        var converted = TotalConverted;
        var decayed = TotalDecayed;
        var accounted = AccountedStacks;
        var cappedMs = TotalCappedMs;
        var followed = Analyzers.Sum(analyzer => analyzer.FollowedBySlaughter);
        var paired = Analyzers.Sum(analyzer => analyzer.PairedWithRupture);
        var spirit = Analyzers.Sum(analyzer => analyzer.OverlappedSpirit);
        var average = measured > 0 ? (double)converted / measured : 0d;
        var chainRate = conversions > 0 ? (int)Math.Round((double)paired / conversions * 100) : 0;

        return
        [
            new OverviewStat(
                $"{conversions}",
                "Conversions",
                unmeasured > 0
                    ? $"Owed in Blood casts across every pull. {unmeasured} of them drew on a bank built before their pull started, so only {measured} have a measured stack count."
                    : "Owed in Blood casts evaluated across every pull."),
            new OverviewStat(
                $"{chainRate}%",
                "Full Chain",
                $"{paired} of {conversions} conversions were followed by a Slaughter cast inside a Rupture Open Wounds window. {followed} were followed by a Slaughter at all.",
                PercentTier(chainRate)),
            new OverviewStat(
                measured > 0 ? $"{average:0.#}" : "-",
                "Avg Converted",
                measured > 0
                    ? $"Average Blood Feather stacks converted per measured cast, against a cap of {OwedInBloodEconomyAnalyzer.MaxStacks}."
                    : "No Owed in Blood cast had a measurable bank behind it.",
                measured > 0 ? BankTier(ShareOfCap(average)) : null),
            new OverviewStat(
                $"{spirit}",
                "Spirit Overlap",
                "Damage converted to Rend while Bloodbound Spirit was active."),
            new OverviewStat(
                $"{decayed}",
                "Stacks Decayed",
                accounted > 0
                    ? $"{decayed} of {accounted} banked stacks expired unused."
                    : "No Blood Feather stacks were observed to expire unused.",
                accounted > 0 ? RetentionTier(RetentionRate(converted, accounted)) : null),
            new OverviewStat(
                FormatSeconds(cappedMs),
                "Time at Cap",
                $"Time at {OwedInBloodEconomyAnalyzer.MaxStacks} stacks.",
                CapTier(cappedMs)),
        ];
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar() =>
    [
        new StackedBarSegment("Converted", TotalConverted, PerformanceColors.Good,
            $"Converted: {TotalConverted} stacks"),
        new StackedBarSegment("Decayed", TotalDecayed, PerformanceColors.Fail,
            $"Decayed: {TotalDecayed} stacks expired unused"),
    ];

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.OwedInBloodEconomyAnalyzers.ToItemRows(
            Parser, analyzer => analyzer.Conversions, (conversion, pull) => BuildConversionRow(conversion));

    private PerCastRow BuildConversionRow(OwedInBloodEconomyAnalyzer.OwedInBloodConversion conversion)
    {
        var measured = conversion.BankObserved;
        var bankTier = measured ? BankTier(conversion.ShareOfCap * 100) : (QualitativePerformance?)null;
        var chainTier = ChainTier(conversion);
        var perf = bankTier is { } bank && bank < chainTier ? bank : chainTier;

        var stats = new List<PerCastStat>
        {
            new(
                measured ? $"{conversion.StacksConverted}" : "-",
                "Stacks Converted",
                measured
                    ? $"Blood Feather stacks this cast converted, out of a cap of {OwedInBloodEconomyAnalyzer.MaxStacks}."
                    : "The bank this cast converted was built before the pull started, so its size could not be measured.",
                bankTier),
            new(
                conversion.PairedWithRupture ? "Yes" : "No",
                "Rupture Chain",
                "Whether the Slaughter that followed this conversion was cast inside a Rupture Open Wounds window.",
                conversion.PairedWithRupture ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new(
                conversion.FollowedBySlaughter ? "Yes" : "No",
                "Slaughter Followed",
                $"Whether a Slaughter was cast within {OwedInBloodEconomyAnalyzer.CashWindowMs / 1000}s of this conversion.",
                conversion.FollowedBySlaughter ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new(
                conversion.SpiritActive ? "Yes" : "No",
                "Spirit Active",
                "Whether Bloodbound Spirit was active when this conversion was cast."),
        };

        return new PerCastRow
        {
            Performance = perf,
            Stats = [.. stats],
            Timestamp = conversion.Timestamp,
            Sequence = [new SpellCastEntry(conversion.AbilityId, perf)],
            AdditionalContent = new AdditionalContent("Conversion Notes", @<div>@BuildNote(conversion)</div>),
        };
    }

    private static string BuildNote(OwedInBloodEconomyAnalyzer.OwedInBloodConversion conversion)
    {
        var chain = DescribeChain(conversion);
        var bank = DescribeBank(conversion);
        return $"{chain} {bank}";
    }

    private static string DescribeChain(OwedInBloodEconomyAnalyzer.OwedInBloodConversion conversion)
    {
        if (conversion.PairedWithRupture)
            return "A Slaughter followed inside a Rupture Open Wounds window.";

        if (conversion.FollowedBySlaughter)
            return "A Slaughter followed, but outside any Open Wounds window - cast Rupture first so the Slaughter is cast inside one.";

        return $"No Slaughter followed within {OwedInBloodEconomyAnalyzer.CashWindowMs / 1000}s - hold the conversion until Rupture and Slaughter are ready to follow it.";
    }

    private static string DescribeBank(OwedInBloodEconomyAnalyzer.OwedInBloodConversion conversion)
    {
        if (!conversion.BankObserved)
            return "The bank it converted was built before the pull started, so its size could not be measured.";

        var stacks = conversion.StacksConverted;
        if (stacks == 0)
            return "No Blood Feather stacks were banked when it was cast.";

        var share = (int)Math.Round(conversion.ShareOfCap * 100);
        return share >= BankPerfect
            ? $"It converted {stacks} stacks, {share}% of the {OwedInBloodEconomyAnalyzer.MaxStacks} cap."
            : $"It converted only {stacks} stacks, {share}% of the {OwedInBloodEconomyAnalyzer.MaxStacks} cap - let the feathers accumulate further before casting it.";
    }

    private static QualitativePerformance ChainTier(OwedInBloodEconomyAnalyzer.OwedInBloodConversion conversion) =>
        conversion.PairedWithRupture ? QualitativePerformance.Perfect
        : conversion.FollowedBySlaughter ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;

    private static double ShareOfCap(double stacks) => stacks / OwedInBloodEconomyAnalyzer.MaxStacks * 100;

    private static int RetentionRate(int converted, int accounted) =>
        (int)Math.Round((double)converted / accounted * 100);

    private static string FormatSeconds(int milliseconds) => $"{milliseconds / 1000d:0.#}s";

    private static QualitativePerformance RetentionTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, RetentionPerfect, RetentionGood, RetentionOk);

    private static QualitativePerformance PercentTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, 75, 50, 25);

    private static QualitativePerformance BankTier(double shareOfCapPercent) =>
        PerformanceTiers.FromThresholds(shareOfCapPercent, BankPerfect, BankGood, BankOk);

    private static QualitativePerformance CapTier(int cappedMs) =>
        cappedMs == 0 ? QualitativePerformance.Perfect
        : cappedMs < 10_000 ? QualitativePerformance.Good
        : cappedMs < 30_000 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;
}
