@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inherits ReportComponent<GundeCombatLogParser>

<GuideSection Title="Slaughter">
    <Explanation>
        <p>
            <SpellLink Spell="Spells.Slaughter" /> consumes every point of
            <SpellLink Spell="Spells.Rend" /> standing on the
            enemies it hits and pays it back as a 160% bleed, so a Slaughter is worth exactly what was
            built before it was pressed. Each cast is scored on the bleed damage it went on to deal,
            measured against the best Slaughter of the same pull, because damage scales with gear but
            a pull's own casts do not.
        </p>
        <p>
            <SpellLink Spell="Spells.Rupture" /> leaves <SpellLink Spell="Spells.OpenWounds" /> on the
            enemies it hits for 18s, and the next Slaughter on that enemy consumes the window to hit 20%
            harder, so every cast is also scored on whether it landed inside a window, and every
            window is checked for the Slaughter that should have cashed it in.
        </p>
        <p>
            Boss casts are scored in addition on whether <SpellLink Spell="Spells.HeartSplitter" />
            rebuilt Rend since the previous Slaughter; casts on packs are scored on how many enemies
            the bleed reached.
        </p>
    </Explanation>
    <ChildContent>
        @if (TotalCasts == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                No Slaughter was cast on any pull, so every point of Rend expired unspent.
            </TipBox>
        }
        else
        {
            <CastOverview Title="Slaughter Overview" Stats="@BuildOverviewStats()" />
            <CastDetail Title="Slaughters"
                        Description="Each card is one Slaughter, rated on the bleed it cashed out relative to the best Slaughter of that pull."
                        Casts="@BuildPerCastData()" />
        }
    </ChildContent>
</GuideSection>

@code {
    private const int RelativePerfect = 80;
    private const int RelativeGood = 55;
    private const int RelativeOk = 30;

    private int TotalCasts => Parser.SlaughterUsageAnalyzers.Sum(entry => entry.Analyzer.SlaughterCasts);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.SlaughterUsageAnalyzers.Select(entry => entry.Analyzer).ToList();
        var casts = analyzers.Sum(analyzer => analyzer.SlaughterCasts);
        var well = analyzers.Sum(analyzer => analyzer.WellExecuted);
        var wellRate = casts > 0 ? (int)Math.Round((double)well / casts * 100) : 0;
        var windows = analyzers.Sum(analyzer => analyzer.TotalOpenWoundsWindows);
        var wasted = analyzers.Sum(analyzer => analyzer.WastedOpenWoundsWindows);
        var payoff = analyzers.Sum(analyzer => analyzer.TotalPayoffDamage);

        var stats = new List<OverviewStat>
        {
            new(
                $"{casts}",
                "Slaughters",
                "Total Slaughter casts evaluated across every pull."),
            new(
                $"{wellRate}%",
                "Well Set Up",
                $"{well} of {casts} Slaughters met the priority for their pull shape.",
                PercentTier(wellRate)),
            new(
                $"{wasted}",
                "Wasted Windows",
                windows > 0
                    ? $"{wasted} of {windows} Open Wounds windows, counted per enemy, closed without a Slaughter cashing the bonus in."
                    : "No Open Wounds window ran long enough to be judged.",
                windows > 0 ? PercentTier(UsedWindowRate(windows, wasted)) : null),
        };

        if (payoff > 0)
        {
            stats.Add(new OverviewStat(
                FormatDamage(payoff / casts),
                "Avg Payoff",
                $"Average Slaughter bleed damage per cast, {FormatDamage(payoff)} in total. Absolute damage scales with gear, so each cast is rated against its own pull instead."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.SlaughterUsageAnalyzers.ToItemRows(Parser, ProjectCasts, (row, pull) => BuildCastRow(row));

    private static IEnumerable<SlaughterRow> ProjectCasts(SlaughterUsageAnalyzer analyzer)
    {
        var slaughters = analyzer.Slaughters;
        var best = analyzer.BestPayoff;
        return slaughters.Select(slaughter => new SlaughterRow(slaughter, analyzer.Shape, best, slaughters.Count));
    }

    private PerCastRow BuildCastRow(SlaughterRow row)
    {
        var slaughter = row.Cast;
        var isAoe = row.Shape == GundePullShape.Aoe;
        var relative = row.RelativePayoff;
        var payoffTier = relative is int percent ? RelativeTier(percent) : (QualitativePerformance?)null;
        var setupTier = SetupTier(slaughter, isAoe);
        var perf = payoffTier is { } tier && tier < setupTier ? tier : setupTier;

        var stats = new List<PerCastStat>
        {
            new(
                FormatDamage(slaughter.PayoffDamage),
                "Bleed Payoff",
                relative is int share
                    ? $"Slaughter bleed damage this cast cashed out - {share}% of the best Slaughter on this pull."
                    : "Slaughter bleed damage this cast cashed out.",
                payoffTier),
            new(
                slaughter.OpenWoundsActive ? "Yes" : "No",
                "Open Wounds",
                "Whether a Rupture Open Wounds window was active when this Slaughter was cast.",
                slaughter.OpenWoundsActive ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
        };

        if (isAoe)
        {
            stats.Add(new PerCastStat(
                $"{slaughter.TargetsHit}",
                "Targets",
                "Enemies the Slaughter bleed spread to.",
                slaughter.TargetsHit >= TrashSlaughterUsage.PackThreshold ? QualitativePerformance.Perfect : QualitativePerformance.Fail));
        }
        else
        {
            stats.Add(new PerCastStat(
                slaughter.HeartSplitterPrimed ? "Yes" : "No",
                "Rend Rebuilt",
                "Whether Heart Splitter was used to rebuild Rend since the previous Slaughter.",
                slaughter.HeartSplitterPrimed ? QualitativePerformance.Perfect : QualitativePerformance.Fail));
        }

        var note = BuildNote(row, isAoe);

        return new PerCastRow
        {
            Performance = perf,
            Stats = [.. stats],
            Timestamp = slaughter.Timestamp,
            Sequence = [new SpellCastEntry(Spells.Slaughter.FSLID.Value, perf)],
            AdditionalContent = new AdditionalContent("Usage Notes", @<div>@note</div>),
        };
    }

    private static string BuildNote(SlaughterRow row, bool isAoe)
    {
        var slaughter = row.Cast;
        var setup = DescribeSetup(slaughter, isAoe);
        var payoff = DescribePayoff(row);
        return $"{setup} {payoff}";
    }

    private static string DescribeSetup(SlaughterEvaluation slaughter, bool isAoe)
    {
        if (slaughter.WellExecuted)
        {
            return isAoe
                ? $"Cast inside Open Wounds, spreading the bleed to {slaughter.TargetsHit} enemies."
                : "Cast inside Open Wounds with Rend rebuilt by Heart Splitter.";
        }

        var reasons = new List<string>();
        if (!slaughter.OpenWoundsActive)
            reasons.Add("no Open Wounds window was active, so it missed Rupture's bonus");

        if (isAoe)
        {
            if (slaughter.TargetsHit < TrashSlaughterUsage.PackThreshold)
                reasons.Add(slaughter.TargetsHit <= 1
                    ? "it hit a single target, wasting the AoE bleed"
                    : $"it only reached {slaughter.TargetsHit} enemies");
        }
        else if (!slaughter.HeartSplitterPrimed)
        {
            reasons.Add("Heart Splitter was not used since the previous Slaughter, so Rend was not rebuilt");
        }

        return JoinReasons(reasons);
    }

    private static string DescribePayoff(SlaughterRow row)
    {
        if (row.Cast.PayoffDamage == 0)
            return "No Slaughter bleed damage followed this cast, so there was no Rend to cash out.";

        var damage = FormatDamage(row.Cast.PayoffDamage);
        if (row.RelativePayoff is not int percent)
            return $"It cashed out {damage} of bleed; with a single Slaughter on this pull there is nothing to compare it against.";

        if (percent >= RelativePerfect)
            return $"It cashed out {damage} of bleed, {percent}% of this pull's best Slaughter.";

        return $"It cashed out {damage} of bleed, only {percent}% of this pull's best Slaughter - build more Rend before pressing it.";
    }

    private static string JoinReasons(List<string> reasons) =>
        reasons.Count == 0
            ? "Only partially set up."
            : char.ToUpperInvariant(reasons[0][0]) + reasons[0][1..] +
                (reasons.Count > 1 ? ", and " + reasons[1] : string.Empty) + ".";

    /// <summary>
    /// Grades the setup half of a cast: both shape criteria met is the success bar the analyzer
    /// scores, one of the two still beats nothing. Grading it rather than passing or failing it lets
    /// a weak payoff pull the row's overall rating down from any starting point.
    /// </summary>
    private static QualitativePerformance SetupTier(SlaughterEvaluation slaughter, bool isAoe)
    {
        var spread = isAoe
            ? slaughter.TargetsHit >= TrashSlaughterUsage.PackThreshold
            : slaughter.HeartSplitterPrimed;

        return slaughter.OpenWoundsActive && spread ? QualitativePerformance.Perfect
            : slaughter.OpenWoundsActive || spread ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;
    }

    private static int UsedWindowRate(int windows, int wasted) =>
        (int)Math.Round((double)(windows - wasted) / windows * 100);

    private static string FormatDamage(long damage) =>
        damage >= 1_000_000 ? $"{damage / 1_000_000d:0.0}M"
        : damage >= 10_000 ? $"{damage / 1_000d:0}k"
        : damage >= 1_000 ? $"{damage / 1_000d:0.0}k"
        : $"{damage}";

    private static QualitativePerformance RelativeTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, RelativePerfect, RelativeGood, RelativeOk);

    private static QualitativePerformance PercentTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, 75, 50, 25);

    private sealed record SlaughterRow(SlaughterEvaluation Cast, GundePullShape Shape, long BestPayoff, int PullCasts)
    {
        /// <summary>
        /// This cast's payoff as a percentage of the pull's best Slaughter, or null when the
        /// comparison would be meaningless: no bleed damage was logged, or the pull held one cast.
        /// </summary>
        public int? RelativePayoff =>
            BestPayoff > 0 && PullCasts > 1 ? (int)Math.Round((double)Cast.PayoffDamage / BestPayoff * 100) : null;
    }
}
