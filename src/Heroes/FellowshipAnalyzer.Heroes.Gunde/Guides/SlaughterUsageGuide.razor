@using FellowshipAnalyzer.Core.Common.Spells.Gunde
@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inherits ReportComponent<GundeCombatLogParser>

<GuideSection Title="Slaughter">
    <LeftPanel>
        <p>
            Plan your <SpellLink Spell="Spells.Slaughter" /> usage to maximise
            <SpellLink Spell="Spells.Rend" /> stacks consumed. Every <SpellLink Spell="Spells.Slaughter" />
            should be paired with <SpellLink Spell="Spells.OwedInBlood" />.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (TotalCasts == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                No Slaughter was cast on any pull.
            </TipBox>
        }
        else
        {
            <CastOverview Title="Slaughter Overview" Stats="@BuildOverviewStats()" />
            <CastDetail Title="Slaughters"
                        Description="Each card is one Slaughter, rated on its setup: an Open Wounds window, plus the bleed spread on a pack."
                        Casts="@BuildPerCastData()" />
        }
    </RightPanel>
</GuideSection>

@code {
    private int TotalCasts => Parser.SlaughterUsageAnalyzers.Sum(entry => entry.Analyzer.SlaughterCasts);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.SlaughterUsageAnalyzers.Select(entry => entry.Analyzer).ToList();
        var casts = analyzers.Sum(analyzer => analyzer.SlaughterCasts);
        var well = analyzers.Sum(analyzer => analyzer.WellExecuted);
        var wellRate = casts > 0 ? (int)Math.Round((double)well / casts * 100) : 0;
        var windows = analyzers.Sum(analyzer => analyzer.TotalOpenWoundsWindows);
        var wasted = analyzers.Sum(analyzer => analyzer.WastedOpenWoundsWindows);
        var rend = analyzers.Sum(analyzer => analyzer.TotalRendConsumed);
        var bleed = analyzers.Sum(analyzer => analyzer.TotalBleedDamage);

        var stats = new List<OverviewStat>
        {
            new(
                $"{casts}",
                "Slaughters",
                "Total Slaughter casts evaluated across every pull."),
            new(
                $"{wellRate}%",
                "Well Set Up",
                $"{well} of {casts} Slaughters met the priority for their pull shape.",
                PercentTier(wellRate)),
            new(
                $"{wasted}",
                "Wasted Windows",
                windows > 0
                    ? $"{wasted} of {windows} Open Wounds windows, counted per enemy, closed with no Slaughter cast inside them."
                    : "No Open Wounds window ran long enough to be judged.",
                windows > 0 ? PercentTier(UsedWindowRate(windows, wasted)) : null),
        };

        if (rend > 0)
        {
            stats.Add(new OverviewStat(
                $"{rend / casts}",
                "Avg Rend Consumed",
                $"Average Rend stacks consumed per Slaughter, {rend} in total across every enemy reached."));
        }

        if (bleed > 0)
        {
            stats.Add(new OverviewStat(
                FormatDamage(bleed / casts),
                "Avg Bleed Damage",
                $"Average Slaughter bleed damage per cast, {FormatDamage(bleed)} in total. This is context, not a verdict."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.SlaughterUsageAnalyzers.ToItemRows(Parser, ProjectCasts, (row, pull) => BuildCastRow(row));

    private static IEnumerable<SlaughterRow> ProjectCasts(SlaughterUsageAnalyzer analyzer) =>
        analyzer.Slaughters.Select(slaughter => new SlaughterRow(slaughter, analyzer.Shape));

    private PerCastRow BuildCastRow(SlaughterRow row)
    {
        var slaughter = row.Cast;
        var isAoe = row.Shape == GundePullShape.Aoe;
        var perf = SetupTier(slaughter, isAoe);

        var stats = new List<PerCastStat>
        {
            new(
                slaughter.OpenWoundsActive ? "Yes" : "No",
                "Open Wounds",
                "Whether a Rupture Open Wounds window was active when this Slaughter was cast.",
                slaughter.OpenWoundsActive ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
        };

        if (isAoe)
        {
            stats.Add(new PerCastStat(
                $"{slaughter.TargetsHit}",
                "Targets",
                "Enemies the Slaughter bleed spread to.",
                slaughter.TargetsHit >= TrashSlaughterUsage.PackThreshold ? QualitativePerformance.Perfect : QualitativePerformance.Fail));
        }

        stats.Add(new PerCastStat(
            $"{slaughter.RendConsumed}",
            "Rend Consumed",
            "Rend stacks this cast consumed across every enemy it reached. Reported as context, not scored."));

        stats.Add(new PerCastStat(
            FormatDamage(slaughter.BleedDamage),
            "Bleed Damage",
            "Slaughter bleed damage this cast dealt. This is context, not a verdict."));

        var note = BuildNote(row, isAoe);

        return new PerCastRow
        {
            Performance = perf,
            Stats = [.. stats],
            Timestamp = slaughter.Timestamp,
            Sequence = [new SpellCastEntry(Spells.Slaughter.FSLID.Value, perf)],
            AdditionalContent = new AdditionalContent("Usage Notes", @<div>@note</div>),
        };
    }

    private static string BuildNote(SlaughterRow row, bool isAoe)
    {
        var slaughter = row.Cast;
        var setup = DescribeSetup(slaughter, isAoe);
        var consumed = DescribeConsumed(slaughter);
        return $"{setup} {consumed}";
    }

    private static string DescribeSetup(SlaughterEvaluation slaughter, bool isAoe)
    {
        if (slaughter.WellExecuted)
        {
            return isAoe
                ? $"Cast inside Open Wounds, spreading the bleed to {slaughter.TargetsHit} enemies."
                : "Cast inside Open Wounds.";
        }

        var reasons = new List<string>();
        if (!slaughter.OpenWoundsActive)
            reasons.Add("no Open Wounds window was active");

        if (isAoe && slaughter.TargetsHit < TrashSlaughterUsage.PackThreshold)
            reasons.Add(slaughter.TargetsHit <= 1
                ? "it hit a single target"
                : $"it only reached {slaughter.TargetsHit} enemies");

        return JoinReasons(reasons);
    }

    private static string DescribeConsumed(SlaughterEvaluation slaughter)
    {
        if (slaughter.RendConsumed == 0)
            return "No Rend was consumed.";

        var damage = slaughter.BleedDamage > 0 ? $", which bled for {FormatDamage(slaughter.BleedDamage)}" : string.Empty;
        return $"It consumed {slaughter.RendConsumed} Rend{damage}.";
    }

    private static string JoinReasons(List<string> reasons) =>
        reasons.Count == 0
            ? "Only partially set up."
            : char.ToUpperInvariant(reasons[0][0]) + reasons[0][1..] +
                (reasons.Count > 1 ? ", and " + reasons[1] : string.Empty) + ".";

    private static QualitativePerformance SetupTier(SlaughterEvaluation slaughter, bool isAoe)
    {
        if (!isAoe)
            return slaughter.OpenWoundsActive ? QualitativePerformance.Perfect : QualitativePerformance.Fail;

        var spread = slaughter.TargetsHit >= TrashSlaughterUsage.PackThreshold;

        return slaughter.OpenWoundsActive && spread ? QualitativePerformance.Perfect
            : slaughter.OpenWoundsActive || spread ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;
    }

    private static int UsedWindowRate(int windows, int wasted) =>
        (int)Math.Round((double)(windows - wasted) / windows * 100);

    private static string FormatDamage(long damage) =>
        damage >= 1_000_000 ? $"{damage / 1_000_000d:0.0}M"
        : damage >= 10_000 ? $"{damage / 1_000d:0}k"
        : damage >= 1_000 ? $"{damage / 1_000d:0.0}k"
        : $"{damage}";

    private static QualitativePerformance PercentTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, 75, 50, 25);

    private sealed record SlaughterRow(SlaughterEvaluation Cast, GundePullShape Shape);
}
