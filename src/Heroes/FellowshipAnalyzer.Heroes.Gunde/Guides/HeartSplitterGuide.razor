@using Spells = FellowshipAnalyzer.Core.Common.Spells.Gunde.Spells
@inherits GuideComponent<GundeCombatLogParser>

<GuideSection Title="Heart Splitter">
    <LeftPanel>
        <p>
            <SpellLink Spell="Spells.HeartSplitter" /> benefits from large <SpellLink Spell="Spells.Rend" />,
            just like <SpellLink Spell="Spells.Slaughter" />, so aim to cast <SpellLink Spell="Spells.HeartSplitter" />
            before consuming <SpellLink Spell="Spells.Rend" /> stacks with <SpellLink Spell="Spells.Slaughter" />.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (TotalCasts == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                Heart Splitter was never cast.
            </TipBox>
        }
        else
        {
            <CastOverview Title="Heart Splitter Overview" Stats="@BuildOverviewStats()" />
            <CastDetail Title="Heart Splitters"
                        Description="Each card is one Heart Splitter, rated on whether a Slaughter was cast just before it."
                        Casts="@BuildPerCastData()" />
        }
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.HeartSplitterAnalyzers.Count > 0;

    private List<HeartSplitterAnalyzer> Analyzers =>
        [.. Parser.HeartSplitterAnalyzers.Select(entry => entry.Analyzer)];

    private int TotalCasts => Analyzers.Sum(analyzer => analyzer.Casts.Count);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var casts = TotalCasts;
        var clipped = Analyzers.Sum(analyzer => analyzer.ClippedBySlaughter);
        var measured = Analyzers.Sum(analyzer => analyzer.MeasuredCasts);
        var rend = Analyzers.Sum(analyzer => analyzer.TotalRendExsanguinated);
        var damage = Analyzers.Sum(analyzer => analyzer.TotalExsanguinateDamage);
        var cleanRate = casts > 0 ? (int)Math.Round((double)(casts - clipped) / casts * 100) : 0;

        var stats = new List<OverviewStat>
        {
            new(
                $"{casts}",
                "Heart Splitters",
                "Heart Splitter casts across every pull."),
            new(
                $"{cleanRate}%",
                "Clear of Slaughter",
                $"{casts - clipped} of {casts} Heart Splitters were cast with no Slaughter in the {HeartSplitterAnalyzer.SlaughterClipMs / 1000d:0.#}s before them.",
                PercentTier(cleanRate)),
            new(
                measured > 0 ? $"{rend / measured}" : "-",
                "Avg Rend on Target",
                "Average Rend stacks active on the target when Exsanguinate hit."),
        };

        if (damage > 0)
        {
            stats.Add(new OverviewStat(
                FormatDamage(damage),
                "Exsanguinate",
                "Total Exsanguinate damage."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.HeartSplitterAnalyzers.ToItemRows(
            Parser, analyzer => analyzer.Casts, (cast, pull) => BuildCastRow(cast));

    private PerCastRow BuildCastRow(HeartSplitterCast cast)
    {
        var perf = cast.ClippedBySlaughter ? QualitativePerformance.Fail : QualitativePerformance.Perfect;

        var stats = new[]
        {
            new PerCastStat(
                cast.ClippedBySlaughter ? "No" : "Yes",
                "Clear of Slaughter",
                $"Yes when no Slaughter was cast in the {HeartSplitterAnalyzer.SlaughterClipMs / 1000d:0.#}s before this one.",
                perf),
            new PerCastStat(
                cast.RendOnTarget is { } rend ? $"{rend}" : "-",
                "Rend on Target",
                cast.RendOnTarget is not null
                    ? "Rend stacks active on the target when Exsanguinate hit."
                    : "No Exsanguinate damage followed this cast."),
            new PerCastStat(
                FormatDamage(cast.ExsanguinateDamage),
                "Exsanguinate",
                "Exsanguinate damage from this cast."),
        };

        return new PerCastRow
        {
            Performance = perf,
            Stats = stats,
            Timestamp = cast.Timestamp,
            Sequence = [new SpellCastEntry(Spells.HeartSplitter.FSLID.Value, perf)],
            AdditionalContent = new AdditionalContent("Usage Notes", @<div>@BuildNote(cast)</div>),
        };
    }

    private static string BuildNote(HeartSplitterCast cast)
    {
        if (cast.RendOnTarget is not { } rend)
            return "No Exsanguinate damage followed this cast.";

        if (!cast.ClippedBySlaughter)
        {
            return cast.MillisecondsSinceSlaughter is { } gap
                ? $"Exsanguinated {rend} Rend, {gap / 1000d:0.#}s after the last Slaughter."
                : $"Exsanguinated {rend} Rend, with no Slaughter cast earlier in the pull.";
        }

        var since = cast.MillisecondsSinceSlaughter ?? 0;
        return $"A Slaughter was cast {since / 1000d:0.#}s earlier, and Exsanguinate hit {rend} Rend. Cast Heart Splitter before Slaughter, not after it.";
    }

    private static string FormatDamage(long damage) =>
        damage >= 1_000_000 ? $"{damage / 1_000_000d:0.0}M"
        : damage >= 10_000 ? $"{damage / 1_000d:0}k"
        : damage >= 1_000 ? $"{damage / 1_000d:0.0}k"
        : $"{damage}";

    private static QualitativePerformance PercentTier(int percent) =>
        PerformanceTiers.FromThresholds(percent, 75, 50, 25);
}
