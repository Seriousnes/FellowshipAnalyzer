@using CoreItems = FellowshipAnalyzer.Core.Common.Items.Items
@using AeonaTalentList = FellowshipAnalyzer.Core.Common.Spells.Aeona.Talents
@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Time Shard">
    <LeftPanel>
        <p>
            <strong><SpellLink Spell="Spells.TimeShard" /></strong> is your Basic filler, and with
            <SpellLink Spell="AeonaTalentList.ContinuumShift" /> your hardest-hitting cast.
        </p>
        <p>
            Cast it into a target with <SpellLink Spell="Spells.UnfoldingDoom" /> active.
        </p>
        @if (ContinuumShiftTalented)
        {
            <p>
                Spend every <SpellLink Spell="AeonaTalentList.ContinuumShift" /> on Time Shard.
            </p>
            <p>
                Cast <SpellLink Spell="CoreItems.TwilightSkybolt" /> before the empowered Time Shard,
                so <SpellLink Spell="CoreItems.MartialInitiative" /> is active at the cast.
            </p>
            @if (VehementEquipped)
            {
                <p>
                    Line <SpellLink Spell="CoreItems.TheVehement" /> up so the empowered Time Shard is the
                    Basic ability that erupts.
                </p>
            }
            @if (SynchronicityTalented)
            {
                <p>
                    Enter the empowered cast above @ChronaThreshold Chrona.
                </p>
            }
        }
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Time Shard Overview" Stats="@BuildOverviewStats()" />

        @if (EmpoweredCasts > 0)
        {
            @if (VehementEquipped)
            {
                <SubSection Title="The Vehement">
                    <PassFailBar Pass="@VehementPairings"
                                 Total="@EmpoweredCasts"
                                 PassTooltip="@($"{VehementPairings} empowered casts erupted The Vehement")"
                                 FailTooltip="@($"{EmpoweredCasts - VehementPairings} empowered casts did not erupt The Vehement")" />
                </SubSection>
            }

            @if (SynchronicityTalented && EmpoweredCastsWithChrona > 0)
            {
                <SubSection Title="@($"Above {ChronaThreshold} Chrona")">
                    <PassFailBar Pass="@SynchronicityPairings"
                                 Total="@EmpoweredCastsWithChrona"
                                 PassTooltip="@($"{SynchronicityPairings} empowered casts above {ChronaThreshold} Chrona")"
                                 FailTooltip="@($"{EmpoweredCastsWithChrona - SynchronicityPairings} empowered casts at or below {ChronaThreshold} Chrona")" />
                </SubSection>
            }

            @if (MartialInitiativeTaken)
            {
                <SubSection Title="Martial Initiative">
                    <PassFailBar Pass="@MartialInitiativePairings"
                                 Total="@EmpoweredCasts"
                                 PassTooltip="@($"{MartialInitiativePairings} empowered casts with Martial Initiative active")"
                                 FailTooltip="@($"{EmpoweredCasts - MartialInitiativePairings} empowered casts without Martial Initiative active")" />
                </SubSection>
            }
        }

        <CastDetail Title="Time Shard Casts" Casts="@BuildCastRows()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Analyzers.Any(analyzer => analyzer.CastCount > 0);

    private List<TimeShardAnalyzer> Analyzers => [.. Parser.TimeShardAnalyzers.Select(entry => entry.Analyzer)];

    private int TotalCasts => Analyzers.Sum(analyzer => analyzer.CastCount);

    private int CastsWithoutUnfoldingDoom => Analyzers.Sum(analyzer => analyzer.CastsWithoutUnfoldingDoom);

    private int EmpoweredCasts => Analyzers.Sum(analyzer => analyzer.EmpoweredCasts);

    private long EmpoweredDamage => Analyzers.Sum(analyzer => analyzer.EmpoweredDamage);

    private int ContinuumShiftLost => Analyzers.Sum(analyzer => analyzer.ContinuumShiftLost);

    private int ContinuumShiftClosedWindows => Analyzers.Sum(analyzer => analyzer.ContinuumShiftClosedWindows);

    private int VehementPairings => Analyzers.Sum(analyzer => analyzer.VehementPairings);

    private long VehementDisdainDamage => Analyzers.Sum(analyzer => analyzer.TotalVehementDisdainDamage);

    private int VehementStacksConsumed => Analyzers.Sum(analyzer => analyzer.VehementStacksConsumed);

    private int SynchronicityPairings => Analyzers.Sum(analyzer => analyzer.SynchronicityPairings);

    private int EmpoweredCastsWithChrona => Analyzers.Sum(analyzer => analyzer.EmpoweredCastsWithChrona);

    private int MartialInitiativePairings => Analyzers.Sum(analyzer => analyzer.MartialInitiativePairings);

    private int ChronaGenerated => Analyzers.Sum(analyzer => analyzer.ChronaGenerated);

    private int ChronaOvercapped => Analyzers.Sum(analyzer => analyzer.ChronaOvercapped);

    private bool ContinuumShiftTalented => Analyzers.Any(analyzer => analyzer.ContinuumShiftTalented);

    private bool SynchronicityTalented => Analyzers.Any(analyzer => analyzer.SynchronicityTalented);

    private bool VehementEquipped => Analyzers.Any(analyzer => analyzer.VehementEquipped);

    private bool MartialInitiativeTaken => Analyzers.Any(analyzer => analyzer.MartialInitiativeTaken);

    private int ChronaThreshold => Analyzers.Count == 0 ? 0 : Analyzers[0].ChronaThreshold;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var stats = new List<OverviewStat>();

        if (EmpoweredCasts > 0)
        {
            stats.Add(new OverviewStat(
                FormatDamage(EmpoweredDamage / (double)EmpoweredCasts),
                "Damage per Empowered Cast",
                VehementEquipped
                    ? "Time Shard damage plus The Vehement's Disdain damage, averaged over every empowered cast."
                    : "Time Shard damage, averaged over every empowered cast."));
        }

        stats.Add(new OverviewStat(
            FormatDamage(AverageDamagePerCast()),
            "Damage per Cast",
            VehementEquipped
                ? "Time Shard damage plus The Vehement's Disdain damage, averaged over every cast."
                : "Time Shard damage, averaged over every cast."));

        stats.Add(new OverviewStat(
            $"{CastsWithoutUnfoldingDoom} ({FormatShare(CastsWithoutUnfoldingDoom, TotalCasts)})",
            "Casts without Unfolding Doom",
            "Time Shard casts whose target did not have your Unfolding Doom active."));

        if (ContinuumShiftTalented)
        {
            stats.Add(new OverviewStat(
                $"{ContinuumShiftLost} ({FormatShare(ContinuumShiftLost, ContinuumShiftClosedWindows)})",
                "Continuum Shift Lost",
                "Continuum Shift windows removed with no Time Shard cast consuming them."));
        }

        stats.Add(new OverviewStat(
            $"{ChronaGenerated:N0}",
            "Chrona Generated",
            "Chrona Time Shard generated."));

        stats.Add(new OverviewStat(
            $"{ChronaOvercapped:N0} ({FormatShare(ChronaOvercapped, ChronaGenerated + ChronaOvercapped)})",
            "Chrona Overcapped",
            "Chrona Time Shard generated above the maximum, and its share of everything Time Shard generated."));

        if (VehementEquipped && VehementStacksConsumed > 0)
        {
            stats.Add(new OverviewStat(
                FormatDamage(VehementDisdainDamage / (double)VehementStacksConsumed),
                "Vehement Damage per Stack",
                "The Vehement's Disdain damage per stack consumed."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildCastRows() =>
        Parser.TimeShardAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer.Casts,
            (cast, pull) => BuildCastRow(cast));

    private PerCastRow BuildCastRow(TimeShardCast cast)
    {
        var items = BuildPairingItems(cast);

        var stats = new List<PerCastStat>
        {
            new(
                FormatDamage(cast.TotalDamage),
                cast.Empowered ? "Empowered Damage" : "Damage",
                VehementEquipped
                    ? $"Time Shard damage plus The Vehement's Disdain damage inside the cast window, over {cast.Hits} hits of which {cast.CriticalHits} crit."
                    : $"Time Shard damage inside the cast window, over {cast.Hits} hits of which {cast.CriticalHits} crit."),
            new(
                $"{cast.TargetsHit}",
                "Targets Hit",
                "Enemies struck inside the cast window."),
            new(
                $"{cast.ChronaGenerated:N0}",
                "Chrona Generated",
                "Chrona this cast generated."),
            new(
                $"{cast.ChronaOvercap:N0}",
                "Chrona Overcapped",
                "Chrona this cast generated above the maximum."),
        };

        if (VehementEquipped && cast.VehementErupted)
        {
            stats.Add(new PerCastStat(
                FormatDamage(cast.VehementDisdainDamage),
                "Vehement Damage",
                "The Vehement's Disdain damage inside the cast window."));
        }

        return new PerCastRow
        {
            Performance = Rate(cast, items),
            Timestamp = cast.Timestamp,
            Stats = [.. stats],
            AdditionalContent = new AdditionalContent("Pairing", @<Checklist Items="@items" DimFailed="false" />),
            Details = BuildTargetBreakdown(cast),
        };
    }

    private List<CheckItem> BuildPairingItems(TimeShardCast cast)
    {
        var items = new List<CheckItem>
        {
            new()
            {
                Label = Spells.UnfoldingDoom,
                Pass = cast.TargetDebuffed,
                Title = "Active on the target at the cast",
            },
        };

        if (!cast.Empowered) return items;

        if (VehementEquipped)
        {
            items.Add(new CheckItem
            {
                Label = CoreItems.TheVehement,
                Pass = cast.VehementErupted,
                Count = cast.VehementStacksConsumed,
                CountTooltip = "Stacks consumed at the cast.",
                Title = "Erupted at the cast",
            });
        }

        if (SynchronicityTalented && cast.AboveChronaThreshold is { } above)
        {
            items.Add(new CheckItem
            {
                Label = AeonaTalentList.Synchronicity,
                Pass = above,
                Note = cast.ChronaAtCast is { } chrona ? $"{chrona} Chrona" : null,
                Title = $"Above {ChronaThreshold} Chrona at the cast",
            });
        }

        if (MartialInitiativeTaken)
        {
            items.Add(new CheckItem
            {
                Label = CoreItems.MartialInitiative,
                Pass = cast.MartialInitiativeActive,
                Note = cast.SkyboltLeadMs is { } lead ? $"Twilight Skybolt {lead / 1000d:0.#}s earlier" : null,
                Title = "Active at the cast",
            });
        }

        return items;
    }

    private RenderFragment? BuildTargetBreakdown(TimeShardCast cast)
    {
        if (cast.TargetHits.Count == 0) return null;

        var columns = new[] { "Hits", "Damage" };
        var rows = cast.TargetHits
            .Select(hit => new TargetBreakdownRow(
                TargetName(hit.Target),
                new[] { $"{hit.Hits}", FormatDamage(hit.Damage) }))
            .ToList();

        return @<TargetBreakdown Columns="@columns" Rows="@rows" />;
    }

    private string TargetName(UnitKey target) =>
        Parser.ActorNames.GetValueOrDefault(target.ActorId) ?? $"Enemy {target.ActorId}";

    private static QualitativePerformance Rate(TimeShardCast cast, List<CheckItem> items)
    {
        if (!cast.TargetDebuffed) return QualitativePerformance.Fail;

        return items.TrueForAll(item => item.Pass)
            ? QualitativePerformance.Perfect
            : QualitativePerformance.Good;
    }

    private double AverageDamagePerCast()
    {
        if (TotalCasts == 0) return 0;

        var damage = Analyzers.Sum(analyzer => (double)(analyzer.TotalDamage + analyzer.TotalVehementDisdainDamage));
        return damage / TotalCasts;
    }

    private static string FormatShare(int part, int whole) => whole > 0 ? $"{part * 100d / whole:0.#}%" : "0%";

    private static string FormatDamage(double amount) =>
        amount >= 1_000_000 ? $"{amount / 1_000_000:0.##}M"
        : amount >= 1_000 ? $"{amount / 1_000:0.#}k"
        : $"{amount:0}";
}
