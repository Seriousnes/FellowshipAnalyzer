@using FellowshipAnalyzer.Core.Events

@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Fleeting Hour">
    <LeftPanel>
        <p>
            <strong><SpellLink Spell="Spells.FleetingHour" /></strong> is at its best while
            <SpellLink Spell="Spells.UnfoldingDoom" /> is on cooldown.
        </p>
        <p>
            Cast it after each <SpellLink Spell="Spells.UnfoldingDoom" />, so the whole window is active
            while Unfolding Doom is on cooldown.
        </p>
        @if (Analyzer is { SurgingChronaTaken: true } surging)
        {
            <p>
                With <SpellLink Spell="Talents.SurgingChrona" />, Fleeting Hour grants
                @surging.SurgingChronaGrant Chrona, so leave room under the cap before you cast it.
            </p>
        }
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Fleeting Hour Overview" Stats="@BuildOverviewStats()" />

        <CastDetail Title="Casts"
                    Description="Each row is one cast."
                    Casts="@BuildCastRows()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() =>
        Parser.FleetingHour is { Casts.Count: > 0 } or { Windows.Count: > 0 };

    private FleetingHourAnalyzer? Analyzer => Parser.FleetingHour;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        if (Analyzer is not { } analyzer) return [];

        var stats = new List<OverviewStat>
        {
            new(
                $"{analyzer.ActiveOnUnfoldingDoomCooldownShare:P0}",
                "Active, Unfolding Doom on Cooldown",
                $"Fleeting Hour active time with Unfolding Doom on cooldown, {FormatSeconds(analyzer.ActiveOnUnfoldingDoomCooldownMs)} of {FormatSeconds(analyzer.TotalUptimeMs)}.",
                Rate(analyzer.ActiveOnUnfoldingDoomCooldownShare)),
            new(
                FormatSeconds(analyzer.AvailableOnUnfoldingDoomCooldownMs),
                "Available, Unfolding Doom on Cooldown",
                "Time Fleeting Hour was available and not cast with Unfolding Doom on cooldown."),
            new(
                $"{FormatSeconds(analyzer.ActiveWithUnfoldingDoomAvailableMs)} ({analyzer.ActiveWithUnfoldingDoomAvailableShare:P0})",
                "Active, Unfolding Doom Available",
                "Fleeting Hour active time with Unfolding Doom available."),
            new(
                $"{analyzer.CombatUptime:P0}",
                "Combat Uptime",
                $"Share of combat time Fleeting Hour was active, {FormatSeconds(analyzer.CombatUptimeMs)} of {FormatSeconds(analyzer.CombatMs)}."),
            new(
                $"{FormatSeconds(analyzer.OutsideCombatMs)} ({analyzer.OutsideCombatShare:P0})",
                "Active Between Pulls",
                "Fleeting Hour time that fell outside every pull, and its share of everything the window was active for."),
            new(
                FormatSeconds(analyzer.AvailableInCombatMs),
                "Available in Combat",
                "Combat time Fleeting Hour was off cooldown and not cast."),
            new(
                FormatSeconds((int)Math.Round(analyzer.AverageDelayMs)),
                "Delay After Available",
                "Combat time from Fleeting Hour coming off cooldown to the cast that spent it, averaged over every cast."),
        };

        if (analyzer.SurgingChronaTaken)
        {
            stats.Add(new OverviewStat(
                $"{analyzer.SurgingChronaOvercapped} ({analyzer.SurgingChronaOvercapShare:P0})",
                "Surging Chrona Overcapped",
                $"Chrona the Surging Chrona grants lost at the cap, of the {analyzer.SurgingChronaGranted} granted across the run."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildCastRows()
    {
        if (Analyzer is not { } analyzer) yield break;

        foreach (var cast in analyzer.Casts)
        {
            QualitativePerformance? performance =
                cast.Window is null ? null : Rate(cast.ActiveOnUnfoldingDoomCooldownShare);

            var stats = BuildCastStats(analyzer, cast, performance);

            yield return PullAt(cast.Timestamp) is { } pull
                ? PullRow(cast, pull, stats, performance)
                : BetweenPullsRow(cast, stats, performance);
        }
    }

    private PerCastData PullRow(
        FleetingHourCast cast,
        PullStartEvent pull,
        PerCastStat[] stats,
        QualitativePerformance? performance)
    {
        return new PerCastData
        {
            Performance = performance,
            Stats = stats,
            Timestamp = Parser.FormatTimestamp(cast.Timestamp),
            Sequence = [new SpellCastEntry(Spells.FleetingHour.FSLID, performance)],
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="pull" />,
        };
    }

    private PerCastData BetweenPullsRow(
        FleetingHourCast cast,
        PerCastStat[] stats,
        QualitativePerformance? performance)
    {
        return new PerCastData
        {
            Performance = performance,
            Stats = stats,
            Timestamp = Parser.FormatTimestamp(cast.Timestamp),
            Sequence = [new SpellCastEntry(Spells.FleetingHour.FSLID, performance)],
            Group = "Between Pulls",
        };
    }

    private PullStartEvent? PullAt(int timestamp)
    {
        foreach (var pull in Parser.Pulls)
        {
            if (timestamp >= pull.StartTime && timestamp <= pull.EndTime) return pull;
        }

        return null;
    }

    private static PerCastStat[] BuildCastStats(
        FleetingHourAnalyzer analyzer,
        FleetingHourCast cast,
        QualitativePerformance? performance)
    {
        var stats = new List<PerCastStat>
        {
            new(
                $"{FormatSeconds(cast.ActiveOnUnfoldingDoomCooldownMs)} ({cast.ActiveOnUnfoldingDoomCooldownShare:P0})",
                "Active, Unfolding Doom on Cooldown",
                "Time this window was active with Unfolding Doom on cooldown, and its share of the window.",
                performance),
            new(
                FormatSeconds(cast.ActiveWithUnfoldingDoomAvailableMs),
                "Active, Unfolding Doom Available",
                "Time this window was active with Unfolding Doom available."),
            new(
                FormatSeconds(cast.AvailableOnUnfoldingDoomCooldownMs),
                "Available, Unfolding Doom on Cooldown",
                "Time before this cast with Fleeting Hour available and Unfolding Doom on cooldown."),
            new(
                FormatSeconds(cast.ActiveInPullMs),
                "Active in Pull",
                "Time this cast's window was active inside the pull it was cast in."),
            new(
                FormatSeconds(cast.OutsideCombatMs),
                "Active After Pull End",
                "Time this cast's window ran outside every pull."),
            new(
                FormatSeconds(cast.DelayMs),
                "Delay After Available",
                "Combat time Fleeting Hour was off cooldown before this cast."),
        };

        if (analyzer.SurgingChronaTaken && cast.SurgingChronaOvercapped is { } overcapped)
        {
            stats.Add(new PerCastStat(
                $"{overcapped}",
                "Surging Chrona Overcapped",
                $"Chrona this cast's {cast.SurgingChronaGranted} grant lost at the cap."));
        }

        return [.. stats];
    }

    private static QualitativePerformance Rate(double share) =>
        PerformanceTiers.FromThresholds(share * 100, 95, 80, 50);

    private static string FormatSeconds(int milliseconds) => $"{milliseconds / 1000d:0.#}s";
}
