@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Amend Fate and Restore Continuity">
    <LeftPanel>
        <p>
            Cast <strong><SpellLink Spell="Spells.AmendFate" /></strong> or
            <strong><SpellLink Spell="Spells.RestoreContinuity" /></strong> when the target holds more than the
            Stagger removed. Always cast one of them when the tank passes 40% of its maximum health in Stagger.
        </p>
        <p>
            Below that, cast <SpellLink Spell="Spells.Oblivion" /> instead.
        </p>
        @if (Build?.MassEntropy == true)
        {
            <p>
                When <SpellLink Spell="Spells.EntropyClaim" /> is on cooldown, cleanse only if the tank will pass 55%
                before the next charge. If it will not, continue to cast Oblivion and roll <SpellLink Spell="Spells.EntropicBurst" /> over.
            </p>
        }
        @if (EchoesTaken)
        {
            <p>
                Spend Uchronia on Restore Continuity to apply <SpellLink Spell="Talents.EchoesOfDivinity" /> to the
                tank. Let Echoes of Divinity run its full duration before the next cleanse.
            </p>
        }
        <p>
            On each cast card, <strong>Ally Stagger</strong> is the Stagger on the ally with the most before the
            cast. The tile is rated Bad when that ally had less Stagger than one cast cleanses from an ally.
            <strong>Stagger Cleansed</strong> is the total across the allies the cast cleansed. A card is flagged only while
            the tank is under @FormatPercent(OblivionAnalyzer.CleansePriorityStaggerFraction) of its maximum health in Stagger.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Cleanse Overview"
                      Stats="@BuildOverviewStats()"
                      AdditionalContentTitle="@(FreeCastsInPull > 0 ? "Free Casts on Restore Continuity" : null)"
                      AdditionalContent="@FreeCastBar()" />
        <CastDetail Title="Cleanses by Pull"
                    Description="Each row is one cast."
                    Casts="@BuildCastRows()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Analyzers.Any(analyzer => analyzer.Casts.Count > 0);

    private AeonaBuild? Build => Parser.AeonaBuild;

    private List<StaggerCleanseAnalyzer> Analyzers =>
        [.. Parser.StaggerCleanseAnalyzers.Select(entry => entry.Analyzer)];

    private bool EchoesTaken => Parser.SelectedCombatant.HasTalent(AeonaTalents.EchoesOfDivinity);

    private List<EchoesOfDivinityUse> Echoes =>
        [.. Analyzers.Select(analyzer => analyzer.EchoesOfDivinity).OfType<EchoesOfDivinityUse>()];

    private int FreeCastsInPull => Analyzers.Sum(analyzer => analyzer.FreeCastsInPull);

    private RenderFragment? FreeCastBar()
    {
        var total = FreeCastsInPull;
        if (total == 0) return null;

        var restore = Analyzers.Sum(analyzer => analyzer.FreeCastsOnRestoreContinuity);

        return @<PassFailBar Pass="@restore" Total="@total"
                             PassTooltip="@($"Free casts spent on Restore Continuity: {restore}")"
                             FailTooltip="@($"Free casts spent elsewhere: {total - restore}")" />;
    }

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers;
        var stats = new List<OverviewStat>();

        var rated = analyzers.Sum(analyzer => analyzer.CastsRated);
        if (rated > 0)
        {
            var flagged = analyzers.Sum(analyzer => analyzer.FlaggedCasts);
            stats.Add(new OverviewStat(
                $"{flagged} ({FormatShare(flagged, rated)})",
                "Flagged Casts",
                $"Casts on an ally with less Stagger than one cast cleanses, or with effective healing below an Oblivion, out of {rated} casts. The count includes a cast only if the tank held less than {FormatPercent(OblivionAnalyzer.CleansePriorityStaggerFraction)} of its maximum health in Stagger.",
                FlagTier(flagged, rated)));
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.LowStaggerCasts)}",
                "Low-Stagger Casts",
                "Casts on an ally with less Stagger than one cast cleanses."));
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.BelowOblivionValueCasts)}",
                "Below an Oblivion",
                "Casts with effective healing below an Oblivion cast's effective healing plus shielding."));
        }

        var onCooldown = analyzers.Sum(analyzer => analyzer.CastsWithEntropyClaimOnCooldown);
        if (onCooldown > 0)
        {
            var waited = analyzers.Sum(analyzer => analyzer.CastsCouldHaveWaited);
            stats.Add(new OverviewStat(
                $"{waited} of {onCooldown}",
                "Could Have Waited for Entropy's Claim",
                "Casts where the tank's Stagger at the next charge was below 55% of its maximum health, out of every cast with Entropy's Claim on cooldown. The count includes a cast only if the tank held less than 40% of its maximum health in Stagger.",
                onCooldown > 0 ? WaitTier(waited, onCooldown) : null));
        }

        AddCleansedStat(stats, analyzers, Spells.AmendFate.FSLID, "Stagger Cleansed by Amend Fate");
        AddCleansedStat(stats, analyzers, Spells.RestoreContinuity.FSLID, "Stagger Cleansed by Restore Continuity");

        stats.Add(new OverviewStat(
            $"{analyzers.Sum(analyzer => analyzer.EffectiveHealing):N0}",
            "Effective Healing",
            $"Effective healing of every cast. All of these casts together had {analyzers.Sum(analyzer => analyzer.Overheal):N0} overheal."));

        var echoes = Echoes;
        if (echoes.Count > 0)
        {
            var combatMs = analyzers.Sum(analyzer => (long)analyzer.Pull.Duration);
            stats.Add(new OverviewStat(
                FormatShare(echoes.Sum(use => (long)use.ActiveMs), combatMs),
                "Echoes of Divinity Uptime",
                "Share of combat with Echoes of Divinity active on the tank."));
            stats.Add(new OverviewStat(
                FormatSeconds(echoes.Sum(use => use.OverwrittenMs)),
                "Echoes of Divinity Overwritten",
                "Remaining Echoes of Divinity time on the tank when a cleanse refreshed it."));
        }

        return stats;
    }

    private static void AddCleansedStat(List<OverviewStat> stats, List<StaggerCleanseAnalyzer> analyzers, int ability, string label)
    {
        var bracketed = analyzers.Sum(analyzer => analyzer.BracketedCastsOf(ability));
        if (bracketed == 0) return;

        var cleansed = analyzers.Sum(analyzer => analyzer.StaggerCleansedBy(ability));
        stats.Add(new OverviewStat(
            $"{cleansed:N0}",
            label,
            $"Stagger cleansed across {bracketed} cast{(bracketed == 1 ? "" : "s")}, {(double)cleansed / bracketed:N0} per cast."));
    }

    private IEnumerable<PerCastData> BuildCastRows() =>
        Parser.StaggerCleanseAnalyzers.ToItemRows(Parser, analyzer => analyzer.Casts, (cast, pull) => BuildRow(cast));

    private PerCastRow BuildRow(CleanseCastEntry cast)
    {
        var performance = cast.Flagged ? QualitativePerformance.Fail
            : cast.Rated ? QualitativePerformance.Perfect
            : (QualitativePerformance?)null;

        var stats = new List<PerCastStat>();

        if (cast.TankStaggerFraction is { } fraction)
        {
            stats.Add(new PerCastStat(
                $"{fraction:P0}",
                "Tank Stagger",
                "The tank's Stagger at the cast, as a percentage of the tank's maximum health."));
        }

        var amendFate = cast.Ability == Spells.AmendFate.FSLID;

        if (cast.StaggerBefore is { } before && cast.StaggerRemoved is { } amount)
        {
            stats.Add(new PerCastStat(
                $"{before:N0}",
                "Ally Stagger",
                amendFate
                    ? $"Stagger on the target before the cast. One Amend Fate cleanses up to {amount:N0}."
                    : $"Stagger before the cast on the ally with the most. One Restore Continuity cleanses up to {amount:N0} from each ally.",
                cast.BelowStaggerRemoved == true ? QualitativePerformance.Fail : QualitativePerformance.Perfect));
        }

        stats.Add(new PerCastStat(
            $"{cast.EffectiveHealing:N0}",
            "Effective Healing",
            cast.OblivionValue is { } value
                ? $"Effective healing of this cast, compared with {value:N0} per Oblivion cast. It also had {cast.Overheal:N0} overheal."
                : $"Effective healing of this cast. It also had {cast.Overheal:N0} overheal.",
            cast.BelowOblivionValue switch
            {
                true => QualitativePerformance.Fail,
                false => QualitativePerformance.Perfect,
                _ => null,
            }));

        if (cast.StaggerCleansed is { } cleansed)
        {
            stats.Add(new PerCastStat(
                $"{cleansed:N0}",
                "Stagger Cleansed",
                amendFate ? null : $"Total Stagger cleansed from {Count(AlliesCleansed(cast), "ally", "allies")}."));
        }

        if (cast.EntropyClaimReadyInMs > 0)
        {
            stats.Add(new PerCastStat(
                FormatSeconds(cast.EntropyClaimReadyInMs),
                "Entropy's Claim Ready In"));

            if (cast.ProjectedStaggerFraction is { } projected)
            {
                stats.Add(new PerCastStat(
                    $"{projected:P0}",
                    "Tank Stagger at Next Charge",
                    $"The tank's Stagger when the next Entropy's Claim charge is ready, as a percentage of its maximum health. " +
                    $"With the tank under {FormatPercent(OblivionAnalyzer.CleansePriorityStaggerFraction)} at the cast and under " +
                    $"{FormatPercent(StaggerCleanseAnalyzer.EntropicBurstHoldStaggerFraction)} at the next charge, this cast could have waited for that charge.",
                    cast.CouldHaveWaited ? QualitativePerformance.Fail : QualitativePerformance.Perfect));
            }
        }

        if (cast.WasFree)
        {
            stats.Add(new PerCastStat(
                cast.FreeCastSource == FreeCastSource.EpochBreak ? "Epoch Break" : "Uchronia",
                "Free Cast",
                "A free cast is rated Bad when it refreshes Echoes of Divinity already on the tank.",
                cast.OverwroteEchoes ? QualitativePerformance.Fail : QualitativePerformance.Perfect));
        }

        if (cast.AppliedEchoes)
        {
            stats.Add(new PerCastStat("Applied", "Echoes of Divinity"));
        }

        if (cast.EchoesOverwrittenMs is { } overwritten)
        {
            stats.Add(new PerCastStat(
                FormatSeconds(overwritten),
                "Echoes of Divinity Overwritten",
                "Remaining Echoes of Divinity time on the tank when this cast refreshed it.",
                QualitativePerformance.Fail));
        }

        return new PerCastRow
        {
            Performance = performance,
            Stats = [.. stats],
            Timestamp = cast.Timestamp,
            Details = @<div><SpellLink Spell="@(amendFate ? Spells.AmendFate : Spells.RestoreContinuity)" /> @BuildNote(cast, amendFate)</div>,
        };
    }

    private static string BuildNote(CleanseCastEntry cast, bool amendFate)
    {
        var sentences = new List<string>
        {
            (amendFate, cast.StaggerCleansed, cast.StaggerBefore) switch
            {
                (true, { } cleansed, { } before) => $"cleansed {cleansed:N0} Stagger from a target with {before:N0} Stagger.",
                (true, { } cleansed, null) => $"cleansed {cleansed:N0} Stagger from its target.",
                (false, { } cleansed, _) => $"cleansed {cleansed:N0} Stagger across {Count(AlliesCleansed(cast), "ally", "allies")}.",
                _ => "cast.",
            },
        };

        if (Verdict(cast, amendFate) is { } verdict)
            sentences.Add(verdict);

        return string.Join(" ", sentences);
    }

    private static string? Verdict(CleanseCastEntry cast, bool amendFate)
    {
        if (!cast.Rated || cast.TankStaggerFraction is not { } fraction)
            return null;

        var priority = FormatPercent(OblivionAnalyzer.CleansePriorityStaggerFraction);

        if (cast.Flagged)
        {
            var reasons = new List<string>();

            if (cast.BelowStaggerRemoved == true)
            {
                reasons.Add(amendFate
                    ? $"the target had less Stagger than the {cast.StaggerRemoved:N0} one Amend Fate cleanses"
                    : $"the ally with the most Stagger had less than the {cast.StaggerRemoved:N0} one Restore Continuity cleanses from each ally");
            }

            if (cast.BelowOblivionValue == true)
                reasons.Add($"the cast's {cast.EffectiveHealing:N0} effective healing was below the {cast.OblivionValue:N0} healing and shielding of one Oblivion");

            return $"Flagged: the tank had {FormatPercent(fraction)} of its maximum health in Stagger, under {priority}, and {string.Join(" and ", reasons)}.";
        }

        if (cast.BelowStaggerRemoved != true && cast.BelowOblivionValue != true)
            return null;

        return fraction >= OblivionAnalyzer.CleansePriorityStaggerFraction
            ? $"The tank had {FormatPercent(fraction)} of its maximum health in Stagger, at or over the {priority} cleanse priority."
            : "A cast that costs no Chrona is flagged only when it refreshes Echoes of Divinity on the tank.";
    }

    private static int AlliesCleansed(CleanseCastEntry cast) => cast.Heals.Count(heal => heal.StaggerCleansed is not null);

    private static string Count(int count, string singular, string plural) => $"{count} {(count == 1 ? singular : plural)}";

    private static string FormatPercent(double fraction) => $"{fraction * 100:0.#}%";

    private static QualitativePerformance FlagTier(int flagged, int rated) =>
        PerformanceTiers.FromThresholds(1 - (double)flagged / rated, 0.95, 0.85, 0.7);

    private static QualitativePerformance WaitTier(int waited, int onCooldown) =>
        PerformanceTiers.FromThresholds(1 - (double)waited / onCooldown, 0.9, 0.75, 0.5);

    private static string FormatShare(long part, long whole) => whole > 0 ? $"{part * 100d / whole:0.#}%" : "0%";

    private static string FormatSeconds(long milliseconds) => $"{milliseconds / 1000d:0.#}s";
}
