@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Oblivion">
    <LeftPanel>
        <p>
            Cast <strong><SpellLink Spell="Spells.Oblivion" /></strong> while the tank holds under 40% of its maximum
            health in Stagger. Above that, cast <SpellLink Spell="Spells.AmendFate" /> or
            <SpellLink Spell="Spells.RestoreContinuity" /> instead.
        </p>
        @if (Build?.ChronoTrigger == true && OblivionsEmbrace)
        {
            <p>
                Spend Chrona on Oblivion immediately after the enhanced <SpellLink Spell="Spells.TimeShard" />, while
                the party is at full health. The overheal then becomes <SpellLink Spell="Talents.OblivionsEmbrace" /> shielding.
            </p>
        }
        @if (Build?.MassEntropy == true)
        {
            <p>
                Cast Oblivion between <SpellLink Spell="Spells.EntropyClaim" /> casts, so Converging Timelines makes
                the next charge available before <SpellLink Spell="Spells.EntropicBurst" /> lapses.
            </p>
        }
        @if (UchroniaTaken)
        {
            <p>
                Spend Uchronia on <SpellLink Spell="Spells.RestoreContinuity" /> if the cast will apply
                <SpellLink Spell="Talents.EchoesOfDivinity" /> to the tank. Otherwise, spend it on Oblivion.
            </p>
        }
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Oblivion Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Oblivion by Pull"
                    Description="Each row shows one pull and the enemies you cast Oblivion into."
                    Casts="@BuildPullRows()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Analyzers.Any(analyzer => analyzer.CastCount > 0);

    private AeonaBuild? Build => Parser.AeonaBuild;

    private List<OblivionAnalyzer> Analyzers =>
        [.. Parser.OblivionAnalyzers.Select(entry => entry.Analyzer).OfType<OblivionAnalyzer>()];

    private bool OblivionsEmbrace => Analyzers.Any(analyzer => analyzer.OblivionsEmbraceTalented);

    private bool UchroniaTaken => Parser.SelectedCombatant.HasTalent(AeonaTalents.Uchronia);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers;
        var stats = new List<OverviewStat>();
        var casts = analyzers.Sum(analyzer => analyzer.CastCount);
        var rated = analyzers.Sum(analyzer => analyzer.CastsRated);
        var flagged = analyzers.Sum(analyzer => analyzer.CastsAtCleansePriority);

        if (rated > 0)
        {
            stats.Add(new OverviewStat(
                $"{flagged} ({FormatShare(flagged, rated)})",
                "Casts at Cleanse Priority",
                $"Oblivion casts while the tank held more than 40% of its maximum health in Stagger and a cleanse was available, out of {rated} casts.",
                PriorityTier(flagged, rated)));
        }

        if (casts > 0)
        {
            stats.Add(new OverviewStat(
                FormatAmount(analyzers.Sum(analyzer => analyzer.EffectiveHealing) / (double)casts),
                "Effective Healing per Cast",
                "Average effective healing per Oblivion cast, for all allies together."));

            if (OblivionsEmbrace)
            {
                stats.Add(new OverviewStat(
                    FormatAmount(analyzers.Sum(analyzer => analyzer.ShieldApplied ?? 0) / (double)casts),
                    "Shielding per Cast",
                    "Average shielding per Oblivion cast, for all allies together."));
            }

            stats.Add(new OverviewStat(
                FormatAmount(analyzers.Sum(analyzer => analyzer.Damage) / (double)casts),
                "Damage per Cast"));
        }

        var opportunities = analyzers.Sum(analyzer => analyzer.FreeCastOpportunities);
        if (opportunities > 0)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.FreeCasts)} of {opportunities}",
                "Free Casts",
                "Free Oblivion casts, out of every Uchronia and Epoch Break window."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPullRows() =>
        Parser.OblivionAnalyzers.ToPullRows(Parser, (analyzer, pull) => BuildPullRow((OblivionAnalyzer)analyzer));

    private PerCastRow BuildPullRow(OblivionAnalyzer analyzer)
    {
        var performance = analyzer.CastsRated > 0
            ? PriorityTier(analyzer.CastsAtCleansePriority, analyzer.CastsRated)
            : (QualitativePerformance?)null;

        var stats = new List<PerCastStat>
        {
            new($"{analyzer.CastCount}", "Casts"),
            new(
                $"{analyzer.CastsAtCleansePriority} of {analyzer.CastsRated}",
                "Casts at Cleanse Priority",
                "Oblivion casts while the tank held more than 40% of its maximum health in Stagger and a cleanse was available, out of the rated casts.",
                performance),
            new(
                FormatAmount(analyzer.EffectiveHealingPerCast),
                "Effective Healing per Cast",
                "Average effective healing per Oblivion cast in this pull, for all allies together."),
        };

        if (analyzer.ShieldAppliedPerCast is { } shield)
        {
            stats.Add(new PerCastStat(
                FormatAmount(shield),
                "Shielding per Cast",
                "Average shielding per Oblivion cast in this pull, for all allies together."));
        }

        stats.Add(new PerCastStat(
            $"{analyzer.FreeCasts} of {analyzer.FreeCastOpportunities}",
            "Free Casts",
            "Free Oblivion casts, out of every Uchronia and Epoch Break window in this pull."));

        return new PerCastRow
        {
            Performance = performance,
            Stats = [.. stats],
            AdditionalContent = analyzer.Targets.Count > 1
                ? new AdditionalContent("Targets", @<Checklist Items="@BuildTargetItems(analyzer)" DimFailed="false" />)
                : null,
        };
    }

    private List<CheckItem> BuildTargetItems(OblivionAnalyzer analyzer) =>
    [
        .. analyzer.Targets.Select(target => new CheckItem
        {
            Label = EnemyName(target.Unit),
            Pass = target.CastsAtCleansePriority == 0,
            Count = target.Casts,
            CountTooltip = "Oblivion casts into this enemy.",
            Note = target.CastsAtCleansePriority > 0 ? $"{target.CastsAtCleansePriority} at cleanse priority" : null,
            Title = "No cast at cleanse priority",
        }),
    ];

    private string EnemyName(UnitKey unit) =>
        Parser.ActorNames.GetValueOrDefault(unit.ActorId) is { } name
            ? unit.Instance is { } instance and > 0 ? $"{name} {instance}" : name
            : $"Enemy {unit.ActorId}";

    private static QualitativePerformance PriorityTier(int flagged, int rated) =>
        PerformanceTiers.FromThresholds(1 - (double)flagged / rated, 0.98, 0.90, 0.75);

    private static string FormatShare(int part, int whole) => whole > 0 ? $"{part * 100d / whole:0.#}%" : "0%";

    private static string FormatAmount(double amount) =>
        amount >= 1_000_000 ? $"{amount / 1_000_000:0.##}M"
        : amount >= 1_000 ? $"{amount / 1_000:0.#}k"
        : $"{amount:0}";
}
