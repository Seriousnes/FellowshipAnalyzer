@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Oblivion">
    <LeftPanel>
        <p>
            <strong><SpellLink Spell="Spells.Oblivion" /></strong> is your highest priority Chrona spender.
        </p>
        <p>
            Cast <SpellLink Spell="Spells.AmendFate" /> or <SpellLink Spell="Spells.RestoreContinuity" /> instead
            once the tank holds at least twice the Stagger removed.
        </p>
        <p>
            Spend a free cast on Oblivion only while the tank holds less than the Stagger removed.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Oblivion Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Oblivion Casts by Pull" Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Analyzers.Any(analyzer => analyzer.CastCount > 0);

    private List<OblivionAnalyzer> Analyzers =>
        [.. Parser.OblivionAnalyzers.Select(entry => entry.Analyzer).OfType<OblivionAnalyzer>()];

    private bool OblivionsEmbrace => Analyzers.Any(analyzer => analyzer.OblivionsEmbraceTalented);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers;
        var stats = new List<OverviewStat>();
        var casts = analyzers.Sum(analyzer => analyzer.CastCount);

        var ticks = analyzers.Sum(analyzer => analyzer.ErasureTicks);

        if (casts > 0)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.DirectDamage):N0}",
                "Direct Damage",
                "Damage Oblivion's direct casts dealt."));
        }

        if (ticks > 0)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.ErasureDamage):N0}",
                "Erasure Damage",
                "Damage Erasure's ticks dealt."));

            stats.Add(new OverviewStat(
                $"{ticks:N0}",
                "Erasure Ticks"));
        }

        if (casts > 0)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.Healing) / (double)casts:N0}",
                "Healing per Cast",
                "Healing the direct casts put on the party, averaged over Oblivion casts."));
        }

        if (ticks > 0)
        {
            var erasureHealing = analyzers.Sum(analyzer => analyzer.ErasureHealing);
            if (erasureHealing > 0)
            {
                stats.Add(new OverviewStat(
                    $"{erasureHealing:N0}",
                    "Erasure Healing",
                    "Healing Erasure's ticks put on the party."));
            }
        }

        if (OblivionsEmbrace && casts > 0)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.ShieldApplied ?? 0) / (double)casts:N0}",
                "Shielding per Cast",
                "Shield absorb applied, averaged over Oblivion casts."));
        }

        var freeCastsMade = analyzers.Sum(analyzer => analyzer.FreeCastsMade);
        if (freeCastsMade > 0)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Sum(analyzer => analyzer.FreeCasts)}/{freeCastsMade}",
                "Free Casts on Oblivion",
                $"Free casts spent on Oblivion, of {freeCastsMade} free casts."));
        }

        var rated = analyzers.Sum(analyzer => analyzer.CastsRated);
        if (rated > 0)
        {
            var flagged = analyzers.Sum(analyzer => analyzer.CastsAtCleansePriority);

            stats.Add(new OverviewStat(
                $"{flagged}/{rated}",
                "Casts at Cleanse Priority",
                "Oblivion casts while the tank held at least twice the Stagger removed and a cleanse was ready."));
        }

        if (OblivionsEmbrace)
        {
            stats.Add(new OverviewStat(
                $"{analyzers.Max(analyzer => analyzer.LargestSingleAbsorb ?? 0):N0}",
                "Largest Absorb",
                "The most an Oblivion's Embrace shield absorbed from one hit."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.OblivionAnalyzers.ToItemRows(Parser, analyzer => ((OblivionAnalyzer)analyzer).Casts, (cast, pull) => BuildRow(cast));

    private PerCastRow BuildRow(OblivionCast cast)
    {
        var performance = Rating(cast);
        var stats = new List<PerCastStat>();

        if (cast.TankStagger is { } stagger)
        {
            stats.Add(new PerCastStat(
                $"{stagger:N0}",
                "Tank Stagger",
                "The tank's pending Stagger at the cast.",
                performance));
        }

        stats.Add(new PerCastStat(
            $"{cast.Damage:N0}",
            "Damage"));

        if (OblivionsEmbrace)
        {
            stats.Add(new PerCastStat(
                $"{cast.LargestSingleAbsorb:N0}",
                "Largest Absorb"));
        }

        if (cast.FreeCastSource is { } source)
        {
            stats.Add(new PerCastStat(
                source switch
                {
                    FreeCastSource.Uchronia => "Uchronia",
                    FreeCastSource.EpochBreak => "Epoch Break",
                    _ => "Free",
                },
                "Free Cast",
                cast.FreeCastAboveStaggerRemoved
                    ? "The tank held at least the Stagger removed at this cast."
                    : null,
                cast.FreeCastAboveStaggerRemoved ? QualitativePerformance.Ok : null));
        }

        return new PerCastRow
        {
            Performance = performance,
            Stats = [.. stats],
            Timestamp = cast.Timestamp,
            Sequence = [new SpellCastEntry(Spells.Oblivion.FSLID, performance)],
            AdditionalContent = TargetRows(cast),
        };
    }

    private static QualitativePerformance? Rating(OblivionCast cast) =>
        !cast.Rated ? null
            : cast.AtCleansePriority ? QualitativePerformance.Fail
            : cast.FreeCastAboveStaggerRemoved ? QualitativePerformance.Ok
            : QualitativePerformance.Perfect;

    private AdditionalContent? TargetRows(OblivionCast cast)
    {
        if (cast.Targets.Count == 0) return null;

        var columns = new List<string> { "Healing" };
        if (OblivionsEmbrace) columns.Add("Shielding");

        var rows = new List<TargetBreakdownRow>();
        foreach (var target in cast.Targets)
        {
            var values = new List<string> { $"{target.Healing:N0}" };
            if (OblivionsEmbrace) values.Add($"{target.Shielding:N0}");

            rows.Add(new TargetBreakdownRow(AllyName(target.UnitId), values));
        }

        return new AdditionalContent("Per Ally", @<TargetBreakdown TargetColumn="Ally" Columns="@columns" Rows="@rows" />);
    }

    private string AllyName(int unitId) =>
        Parser.ActorNames.GetValueOrDefault(unitId) ?? $"Ally {unitId}";
}
