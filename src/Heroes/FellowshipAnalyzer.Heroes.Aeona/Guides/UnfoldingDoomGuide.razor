@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Unfolding Doom">
    <LeftPanel>
        <p>
            <strong><SpellLink Spell="Spells.UnfoldingDoom" /></strong> is your primary damage increase.
        </p>
        <p>
            Cast it the moment it becomes available, on the enemy you will damage most over the next
            @WindowSeconds seconds.
        </p>
        <p>
            Recast it as soon as it comes off cooldown, so no time passes with no enemy debuffed.
        </p>
        @if (Analyzers.Any(analyzer => analyzer.HasteningDoomTaken))
        {
            <p>
                With <SpellLink Spell="Spells.UnfoldingDoom" /> talented into Hastening Doom the window also
                grants Haste, so open it before your <SpellLink Spell="Spells.TimeShard" />s.
            </p>
        }
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Unfolding Doom Overview" Stats="@BuildOverviewStats()" />
        <StackedBar Segments="@BuildStackedBar()" />
        <CastDetail Title="Applications by Pull"
                    Description="Each row is one cast."
                    Casts="@BuildPerCastData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Analyzers.Any(analyzer => analyzer.Casts > 0);

    private static readonly int WindowSeconds = UnfoldingDoomAnalyzer.DebuffDurationMs / 1000;

    private List<UnfoldingDoomAnalyzer> Analyzers =>
        [.. Parser.UnfoldingDoomAnalyzers.Select(entry => entry.Analyzer).OfType<UnfoldingDoomAnalyzer>()];

    private List<UnfoldingDoomApplication> Applications =>
        [.. Analyzers.SelectMany(analyzer => analyzer.Applications)];

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers;
        var active = analyzers.Sum(analyzer => analyzer.ActiveMs);
        var combat = analyzers.Sum(analyzer => analyzer.Pull.Duration);
        var rated = analyzers.Sum(analyzer => analyzer.RatedApplications);
        var priority = analyzers.Sum(analyzer => analyzer.PriorityApplications);

        var stats = new List<OverviewStat>
        {
            new(
                combat > 0 ? $"{(double)active / combat:P1}" : "0.0%",
                "Uptime",
                "Share of combat with the debuff active on at least one enemy."),

            new(
                FormatDamage(analyzers.Sum(analyzer => analyzer.DamageGained)),
                "Damage Gained",
                "Damage the debuff's increase accounts for."),
        };

        if (rated > 0)
        {
            var share = (int)Math.Round((double)priority / rated * 100);

            stats.Add(new OverviewStat(
                $"{share}%",
                "On Priority",
                $"{priority} of {rated} casts on the enemy that took the most of your damage over the next {WindowSeconds} seconds.",
                PerformanceTiers.FromThresholds(share, 90, 75, 50)));

            AddDamageSplit(
                stats,
                analyzers.Sum(analyzer => analyzer.PriorityDamageGained),
                "Gained on Priority",
                "Damage the debuff's increase accounts for on casts on the priority target.");

            AddDamageSplit(
                stats,
                analyzers.Sum(analyzer => analyzer.AlternateDamageGained),
                "Gained Lower in the Order",
                "Damage the debuff's increase accounts for on casts on an enemy further down the order.");

            AddDamageSplit(
                stats,
                analyzers.Sum(analyzer => analyzer.SoleTargetDamageGained),
                "Gained on Sole Target",
                "Damage the debuff's increase accounts for on casts with no other enemy damaged.");
        }

        stats.Add(new OverviewStat(
            FormatSeconds(analyzers.Sum(analyzer => analyzer.IdleAvailableMs)),
            "Available, No Enemy Debuffed",
            "Time Unfolding Doom was available with no enemy debuffed."));

        return stats;
    }

    private static void AddDamageSplit(List<OverviewStat> stats, long gained, string label, string tooltip)
    {
        if (gained <= 0) return;

        stats.Add(new OverviewStat(FormatDamage(gained), label, tooltip));
    }

    private IEnumerable<StackedBarSegment> BuildStackedBar()
    {
        var applications = Applications;

        var buckets = new (UnfoldingDoomTargetOutcome Outcome, string Label, string Color, string Description)[]
        {
            (UnfoldingDoomTargetOutcome.Priority, "On Priority", PerformanceColors.Perfect,
                $"on the enemy that took the most of your damage over the next {WindowSeconds} seconds"),
            (UnfoldingDoomTargetOutcome.Alternate, "Lower in the Order", PerformanceColors.Ok,
                "on an enemy further down that order"),
            (UnfoldingDoomTargetOutcome.SoleTarget, "Sole Target", PerformanceColors.Neutral,
                $"with no other enemy damaged over the next {WindowSeconds} seconds"),
        };

        return
        [
            .. buckets
                .Select(bucket => (bucket, Count: applications.Count(application => application.Outcome == bucket.Outcome)))
                .Where(entry => entry.Count > 0)
                .Select(entry => new StackedBarSegment(
                    entry.bucket.Label,
                    entry.Count,
                    entry.bucket.Color,
                    $"{entry.bucket.Label}: {entry.Count} casts {entry.bucket.Description}"))
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData() =>
        Parser.UnfoldingDoomAnalyzers.ToItemRows(
            Parser,
            analyzer => ((UnfoldingDoomAnalyzer)analyzer).Applications,
            (application, pull) => BuildRow(application));

    private PerCastRow BuildRow(UnfoldingDoomApplication application)
    {
        var performance = Tier(application);

        var stats = new List<PerCastStat>
        {
            new(
                TargetName(application.Unit),
                "Target",
                TargetTooltip(application),
                performance),

            new(
                FormatSeconds(application.ActiveMs),
                "Active"),

            new(
                FormatDamage(application.DamageGained),
                "Damage Gained",
                "Damage the debuff's increase accounts for."),

            new(
                FormatSeconds(application.DelayAfterReadyMs),
                "Delay After Ready",
                "Time from Unfolding Doom being available with no enemy debuffed to this application."),
        };

        if (application.DiedAfterMs is { } died)
        {
            stats.Add(new PerCastStat(
                FormatSeconds(died),
                "Target Died After",
                "Time from this cast to the target's death."));
        }

        return new PerCastRow
        {
            Performance = performance,
            Timestamp = application.Start,
            Stats = [.. stats],
        };
    }

    private static QualitativePerformance? Tier(UnfoldingDoomApplication application) =>
        !application.Rated ? null
        : application.OnPriority ? QualitativePerformance.Perfect
        : PerformanceTiers.FromThresholds(application.PriorityShare * 100, 90, 70, 40);

    private string TargetTooltip(UnfoldingDoomApplication application) => application.Outcome switch
    {
        UnfoldingDoomTargetOutcome.Priority =>
            $"Took the most of your damage over the next {WindowSeconds} seconds, ahead of {Others(application)}.",
        UnfoldingDoomTargetOutcome.Alternate =>
            $"Took {application.PriorityShare:P0} of the damage {TargetName(application.BestUnit)} took over the next {WindowSeconds} seconds.",
        _ =>
            $"No other enemy took your damage over the next {WindowSeconds} seconds.",
    };

    private static string Others(UnfoldingDoomApplication application) =>
        application.Candidates == 2 ? "1 other enemy" : $"{application.Candidates - 1} other enemies";

    private string TargetName(UnitKey unit) =>
        Parser.ActorNames.GetValueOrDefault(unit.ActorId) ?? $"Enemy {unit.ActorId}";

    private static string FormatDamage(double amount) =>
        amount >= 1_000_000 ? $"{amount / 1_000_000:0.##}M"
        : amount >= 1_000 ? $"{amount / 1_000:0.#}k"
        : $"{amount:0}";

    private static string FormatSeconds(long milliseconds) => $"{milliseconds / 1000d:0.#}s";
}
