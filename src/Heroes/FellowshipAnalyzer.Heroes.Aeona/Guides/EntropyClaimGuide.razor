@inherits GuideComponent<AeonaCombatLogParser>

<GuideSection Title="Entropy's Claim and Entropic Burst">
    <LeftPanel>
        <p>
            Cast the next <strong><SpellLink Spell="Spells.EntropyClaim" /></strong> 2 to 4 seconds before the active
            one expires. The next Entropy's Claim then expires while <SpellLink Spell="Spells.EntropicBurst" /> is
            still active, and the stack rolls over.
        </p>
        <p>
            Keep both charges cycling. If you hold a charge while Entropic Burst lapses, you lose a stack on every
            enemy in the pack.
        </p>
        <p>
            Cast <SpellLink Spell="Spells.Oblivion" /> between Entropy's Claim casts instead of a cleanse.
            Converging Timelines then makes the next charge available in time.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Entropy's Claim Overview" Stats="@BuildOverviewStats()" />

        <CastDetail Title="Entropic Burst by Pull"
                    Description="Each row shows the peak stacks, rollovers, and lapses of one pull."
                    Casts="@BuildPullRows()" />

        <CastDetail Title="Casts by Pull"
                    Description="Each row shows one cast, its lead before the active Entropy's Claim expires, and what its own expiry did to Entropic Burst."
                    Casts="@BuildCastRows()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Analyzers.Any(analyzer => analyzer.CastCount > 0);

    private List<EntropyClaimAnalyzer> Analyzers =>
        [.. Parser.EntropyClaimAnalyzers.Select(entry => entry.Analyzer).OfType<EntropyClaimAnalyzer>()];

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers;
        if (analyzers.Count == 0) return [];

        var casts = analyzers.Sum(analyzer => analyzer.CastCount);
        var delays = analyzers.SelectMany(analyzer => analyzer.DelaysAfterReady).ToList();
        var rollovers = analyzers.Sum(analyzer => analyzer.Rollovers);
        var lapsesWithCharge = analyzers.Sum(analyzer => analyzer.LapsesWithChargeAvailable);
        var lapses = analyzers.Sum(analyzer => analyzer.Lapses.Count);
        var rated = rollovers + lapsesWithCharge;
        var share = rated > 0 ? (double)rollovers / rated : (double?)null;
        var peakStacks = analyzers.Max(analyzer => analyzer.PeakStacks);

        var stats = new List<OverviewStat>
        {
            new(
                share is { } value ? $"{value:P0}" : "-",
                "Rollover Share",
                "Entropic Burst rollovers, out of all rollovers plus all lapses with a charge available.",
                share is { } tiered ? RolloverTier(tiered) : null),
            new(
                $"{lapsesWithCharge} of {lapses}",
                "Lapses With a Charge Available",
                "Entropic Burst lapses with an Entropy's Claim charge available in time, out of every lapse."),
            new(
                $"{peakStacks}",
                "Peak Stacks",
                Performance: StackTier(peakStacks)),
            new(
                $"{WeightedAverageStacks(analyzers):0.#}",
                "Average Stacks",
                "Average Entropic Burst stacks on an enemy, weighted by the time Entropic Burst was active on each enemy."),
            new(
                $"{analyzers.Sum(analyzer => analyzer.CastsRolledOver)} of {casts}",
                "Casts Rolled Over"),
        };

        stats.Add(new OverviewStat(
            TimeFormat.Seconds(AverageLead(analyzers), 1),
            "Lead Before Expiry",
            "Average time from a cast to the expiry of the active Entropy's Claim, for casts with one already active."));
        stats.Add(new OverviewStat(
            TimeFormat.Seconds(delays.Count == 0 ? 0 : (long)delays.Average(), 1),
            "Delay After Ready",
            "Average time from when a charge became available to the cast that spent it, over every wait."));
        stats.Add(new OverviewStat(
            NumberFormat.Share(analyzers.Sum(analyzer => (long)analyzer.ActiveMs), analyzers.Sum(analyzer => (long)analyzer.Pull.Duration), 1),
            "Uptime",
            "Share of combat with Entropy's Claim active on at least one enemy."));

        return stats;
    }

    private IEnumerable<PerCastData> BuildPullRows() =>
        Parser.EntropyClaimAnalyzers.ToPullRows(Parser, (analyzer, pull) => BuildPullRow((EntropyClaimAnalyzer)analyzer));

    private PerCastRow BuildPullRow(EntropyClaimAnalyzer analyzer)
    {
        var performance = analyzer.RolloverShare is { } share ? RolloverTier(share) : (QualitativePerformance?)null;

        return new PerCastRow
        {
            Performance = performance,
            Stats =
            [
                new PerCastStat(
                    $"{analyzer.PeakStacks}",
                    "Peak Stacks"),
                new PerCastStat(
                    $"{analyzer.Rollovers}",
                    "Rollovers",
                    "Expiries that incremented an Entropic Burst stack."),
                new PerCastStat(
                    $"{analyzer.LapsesWithChargeAvailable} of {analyzer.Lapses.Count}",
                    "Lapses With a Charge Available",
                    "Entropic Burst lapses with an Entropy's Claim charge available in time, out of every lapse.",
                    performance),
                new PerCastStat(
                    $"{analyzer.CastCount}",
                    "Casts"),
                new PerCastStat(
                    TimeFormat.Seconds((long)analyzer.AverageDelayAfterReadyMs, 1),
                    "Delay After Ready",
                    "Average time from when a charge became available to the cast that spent it, over every wait in the pull."),
            ],
        };
    }

    private IEnumerable<PerCastData> BuildCastRows() =>
        Parser.EntropyClaimAnalyzers.ToItemRows(
            Parser,
            analyzer => ((EntropyClaimAnalyzer)analyzer).Casts,
            (cast, pull) => BuildCastRow(cast));

    private PerCastRow BuildCastRow(EntropyClaimCast cast)
    {
        var performance = cast.RolledOver ? QualitativePerformance.Perfect
            : cast.BurstApplications > 0 ? QualitativePerformance.Ok
            : (QualitativePerformance?)null;

        return new PerCastRow
        {
            Performance = performance,
            Timestamp = cast.Timestamp,
            Stats =
            [
                new PerCastStat(
                    cast.LeadBeforeExpiryMs is { } lead ? TimeFormat.Seconds(lead, 1) : "-",
                    "Lead Before Expiry",
                    "Time from this cast to the expiry of the active Entropy's Claim."),
                new PerCastStat(
                    TimeFormat.Seconds(cast.DelayAfterReadyMs, 1),
                    "Delay After Ready"),
                new PerCastStat(
                    $"{cast.BurstRollovers}",
                    "Stacks Rolled Over",
                    Performance: performance),
                new PerCastStat(
                    $"{cast.BurstApplications}",
                    "Stacks Applied",
                    "Entropic Burst applications when the Entropy's Claim from this cast expired."),
            ],
        };
    }

    private static double WeightedAverageStacks(List<EntropyClaimAnalyzer> analyzers)
    {
        var stackMs = analyzers.Sum(analyzer => analyzer.EntropicBurstStackMs);
        var unitActiveMs = analyzers.Sum(analyzer => analyzer.EntropicBurstUnitActiveMs);
        return unitActiveMs > 0 ? stackMs / (double)unitActiveMs : 0;
    }

    private static long AverageLead(List<EntropyClaimAnalyzer> analyzers)
    {
        var leads = analyzers.SelectMany(analyzer => analyzer.Casts).Where(cast => cast.LeadBeforeExpiryMs is not null).Select(cast => (long)cast.LeadBeforeExpiryMs!.Value).ToList();
        return leads.Count == 0 ? 0 : (long)leads.Average();
    }

    private static QualitativePerformance RolloverTier(double share) => PerformanceTiers.FromThresholds(share, 0.9, 0.75, 0.5);

    private static QualitativePerformance StackTier(int stacks) => PerformanceTiers.FromThresholds(stacks, 8, 5, 3);
}
