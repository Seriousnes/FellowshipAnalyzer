@inherits Analyzer

@code {
    public override RenderFragment? Statistic => EnemyChannels + AllyChannels > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Spells.TemporalBarrage" />
            </Header>
            <ChildContent>
                @if (EnemyChannels > 0)
                {
                    <StatRow Value="@($"{AverageDamage:N0}")"
                             Tooltip="@($"{TotalDamage:N0} across {Casts(EnemyChannels)} at an enemy.")">
                        damage per cast
                    </StatRow>
                    <StatRow Value="@($"{AverageRelayHealEffective:N0}")" Tooltip="@RelayTooltip">
                        relay healing per cast
                    </StatRow>
                }
                @if (AllyChannels > 0)
                {
                    <StatRow Value="@($"{AverageDirectHealEffective:N0}")"
                             Tooltip="@($"{DirectHealEffective:N0} across {Casts(AllyChannels)} at an ally. {DirectOverheal:N0} overhealed.")">
                        direct healing per cast
                    </StatRow>
                }
                @if (StaggerCleared > 0)
                {
                    <StatRow Value="@($"{StaggerCleared:N0}")">
                        Stagger cleared
                    </StatRow>
                }
                @if (ParadoxicalTwistTaken && EnemyChannelsUnderFleetingHour > 0)
                {
                    <StatRow Value="@($"{AverageDamageUnderFleetingHour:N0}")"
                             Tooltip="@($"{DamageUnderFleetingHour:N0} across {Casts(EnemyChannelsUnderFleetingHour)} at an enemy started while Fleeting Hour was active.")">
                        damage per cast under Fleeting Hour
                    </StatRow>
                }
                @if (TemporalShiftTaken)
                {
                    <StatRow Value="@TimeFormat.Seconds(FleetingHourDurationExtendedMs, 1)"
                             Tooltip="@($"From {BoltsWhileFleetingHourActive} bolts.")">
                        Fleeting Hour duration extended
                    </StatRow>
                    <StatRow Value="@TimeFormat.Seconds(FleetingHourCooldownReducedMs, 1)"
                             Tooltip="@($"From {BoltsWhileFleetingHourInactive} bolts.")">
                        Fleeting Hour cooldown reduced
                    </StatRow>
                }
            </ChildContent>
        </StatCard>;

    private string RelayTooltip =>
        $"{RelayHealEffective:N0} across {Casts(EnemyChannels)} at an enemy. {RelayOverheal:N0} overhealed. " +
        "Deferred Fate: Relay heals an ally for 100% of the damage Temporal Barrage deals.";

    private static string Casts(int count) => count == 1 ? "1 cast" : $"{count} casts";
}
