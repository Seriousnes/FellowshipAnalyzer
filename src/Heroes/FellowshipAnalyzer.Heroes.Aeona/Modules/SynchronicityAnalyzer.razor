@inherits Analyzer

@code {
    public override RenderFragment? Statistic =>
        ChronaGeneratedBelowThreshold > 0 || DamageAboveThreshold > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Talents.Synchronicity" />
            </Header>
            <ChildContent>
                <StatRow Value="@($"{EstimatedChrona:N0}")" Tooltip="@ChronaTooltip">
                    additional Chrona generated
                </StatRow>
                <StatRow Value="@($"{EstimatedDamage:N0}")" Tooltip="@DamageTooltip">
                    additional damage dealt
                </StatRow>
            </ChildContent>
        </StatCard>;

    private string ChronaTooltip =>
        $"Of {ChronaGeneratedBelowThreshold:N0} Chrona that arrived below {Threshold} Chrona.";

    private string DamageTooltip =>
        $"Of {DamageAboveThreshold:N0} damage dealt above {Threshold} Chrona.";
}
