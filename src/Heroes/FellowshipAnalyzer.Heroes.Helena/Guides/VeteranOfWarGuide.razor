@inherits ReportComponent<HelenaCombatLogParser>

<GuideSection Title="Veteran of War">
    <LeftPanel>
        <p>
            Playing Helena well relies heavily on proper Veteran of War management. The table shows how
            effectively you lowered cooldowns and where you wasted the most opportunities. If you find
            yourself frequently pressing <SpellLink Spell="Spells.MeasuredStrike" /> because nothing else
            is available, check the table for where the most waste occurred.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastOverview Title="Waste By Source" Stats="@BuildSourceStats()" />
        <CastDetail Title="Cooldown Reduction By Pull"
                    Description="What each pull generated, and how much of it shortened something still recharging."
                    Casts="@BuildPerPullData()" />
    </RightPanel>
</GuideSection>

@code {
    private int PunishingStrikesCasts =>
        Parser.VeteranOfWarAnalyzers.Sum(entry => entry.Analyzer.PunishingStrikesCasts);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var reduction = Parser.VeteranOfWarAnalyzers.Aggregate(
            new CooldownReductionResult(), (total, entry) => total + entry.Analyzer.CooldownReduction);
        if (reduction.Total == 0) return [];

        var generated = reduction.Total;
        var applied = reduction.Effective;
        var wasted = reduction.Wasted;
        var efficiency = reduction.Efficiency * 100;

        var stats = new List<OverviewStat>
        {
            new(
                $"{efficiency:F1}%",
                "Effective",
                $"{applied / 1000d:N0}s of the {generated / 1000d:N0}s generated shortened something that was " +
                "still recharging.",
                PerformanceTiers.FromThresholds(efficiency, 85, 70, 50)),
            new(
                $"{wasted / 1000d:N0}s",
                "Wasted",
                "Reduction generated against an ability that was already available."),
            new(
                $"{generated / 1000d:N0}s",
                "Generated",
                "Total reduction every combo produced across the fight."),
        };

        if (PunishingStrikesCasts > 0)
        {
            stats.Add(new OverviewStat(
                $"{PunishingStrikesCasts}",
                "Under Punishing Strikes",
                "Combo casts made with a Punishing Strikes stack active. The figures above already " +
                "account for them."));
        }

        return stats;
    }

    private IEnumerable<OverviewStat> BuildSourceStats()
    {
        var totals = new Dictionary<int, CooldownReductionResult>();
        foreach (var entry in Parser.VeteranOfWarAnalyzers)
        {
            foreach (var contribution in entry.Analyzer.BySource)
            {
                totals[contribution.SourceSpellId] =
                    totals.GetValueOrDefault(contribution.SourceSpellId) + contribution.CooldownReduction;
            }
        }

        return totals
            .OrderByDescending(entry => entry.Value.Wasted)
            .Select(entry =>
            {
                var reduction = entry.Value;
                var efficiency = reduction.Efficiency * 100;

                return new OverviewStat(
                    $"{reduction.Wasted / 1000d:N0}s",
                    SpellName(entry.Key),
                    $"{efficiency:F0}% of the {reduction.Total / 1000d:N0}s this ability generated shortened a running cooldown.",
                    PerformanceTiers.FromThresholds(efficiency, 85, 70, 50));
            })
            .ToList();
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.VeteranOfWarAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = PerformanceTiers.FromThresholds(analyzer.CooldownReduction.Efficiency * 100, 85, 70, 50),
            Stats = BuildPullStats(analyzer),
            Details = analyzer.SawActiveUltimate
                ? @<div>Siegebreaker was active for part of this pull.</div>
                : null,
        });

    private static PerCastStat[] BuildPullStats(VeteranOfWarAnalyzer analyzer)
    {
        var stats = new List<PerCastStat>
        {
            new(
                $"{analyzer.CooldownReduction.Efficiency * 100:F0}%",
                "Effective",
                "Share of this pull's generated reduction that shortened a running cooldown.",
                PerformanceTiers.FromThresholds(analyzer.CooldownReduction.Efficiency * 100, 85, 70, 50)),
            new(
                $"{analyzer.CooldownReduction.Wasted / 1000d:F0}s",
                "Wasted",
                "Reduction generated against an ability that was already available."),
        };

        foreach (var contribution in analyzer.BySource.Take(3))
        {
            stats.Add(new PerCastStat(
                $"{contribution.CooldownReduction.Wasted / 1000d:F0}s",
                SpellName(contribution.SourceSpellId),
                $"{contribution.Events} casts generated {contribution.CooldownReduction.Total / 1000d:F0}s, of which {contribution.CooldownReduction.Effective / 1000d:F0}s shortened a running cooldown."));
        }

        return [.. stats];
    }

    private static string SpellName(int spellId) =>
        SpellRegistry.MaybeGet(spellId)?.Name ?? $"Spell {spellId}";
}
