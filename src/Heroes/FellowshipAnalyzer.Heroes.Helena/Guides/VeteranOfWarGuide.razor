@inherits ReportComponent<HelenaCombatLogParser>

<GuideSection Title="Veteran of War">
    <Explanation>
        <p>
            Almost everything Helena presses shortens something else. <SpellLink Spell="Spells.MeasuredStrike" />
            and <SpellLink Spell="Spells.PowerStrike" /> take 2s off
            <SpellLink Spell="Spells.ShieldSlam" /> and <SpellLink Spell="Spells.ShieldThrow" />; those
            two take 3s off <SpellLink Spell="Spells.Shockwave" />;
            <SpellLink Spell="Spells.Shockwave" /> takes 6s off <SpellLink Spell="Spells.ShieldsUp" />;
            and <SpellLink Spell="Spells.HoldTheLine" /> takes 10s off all four.
            <SpellLink Spell="Spells.Siegebreaker" /> doubles every one of them while it is up.
        </p>
        <p>
            A reduction aimed at something already off cooldown does nothing at all, and that is the
            only thing measured here. The seconds below are what the cooldown model says was generated
            against an ability that was already available, so they follow the spellbook's cooldowns
            rather than being read straight off the log.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastOverview Title="Waste By Source" Stats="@BuildSourceStats()" />
        <CastDetail Title="Cooldown Reduction By Pull"
                    Description="What each pull generated, and how much of it landed on something still recharging."
                    Casts="@BuildPerPullData()" />
    </ChildContent>
</GuideSection>

@code {
    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.VeteranOfWarAnalyzers.Select(entry => entry.Analyzer).ToList();
        var generated = analyzers.Sum(analyzer => (long)analyzer.GeneratedMs);
        if (generated == 0) return [];

        var applied = analyzers.Sum(analyzer => (long)analyzer.AppliedMs);
        var wasted = generated - applied;
        var efficiency = applied / (double)generated * 100;

        return
        [
            new OverviewStat(
                $"{efficiency:F1}%",
                "Landed",
                $"{applied / 1000d:N0}s of the {generated / 1000d:N0}s generated shortened something that was still recharging.",
                PerformanceTiers.FromThresholds(efficiency, 85, 70, 50)),
            new OverviewStat(
                $"{wasted / 1000d:N0}s",
                "Thrown Away",
                "Reduction generated against an ability that was already available."),
            new OverviewStat(
                $"{generated / 1000d:N0}s",
                "Generated",
                "Total reduction every combo produced across the fight."),
            new OverviewStat(
                $"{Agreement() * 100:F0}%",
                "Model Agreement",
                $"{Disagreements()} of {TargetCasts()} casts of a shortened ability happened while the cooldown " +
                "model believed it had no charge. Each of those is the model being wrong, and each one pushes " +
                "the landed figure above what really landed.",
                PerformanceTiers.FromThresholds(Agreement() * 100, 95, 85, 70)),
        ];
    }

    private double Agreement()
    {
        var casts = TargetCasts();
        return casts > 0 ? 1 - ((double)Disagreements() / casts) : 1;
    }

    private int Disagreements() =>
        Parser.VeteranOfWarAnalyzers.Sum(entry => entry.Analyzer.ModelDisagreements);

    private int TargetCasts() =>
        Parser.VeteranOfWarAnalyzers.Sum(entry => entry.Analyzer.TargetCasts);

    private IEnumerable<OverviewStat> BuildSourceStats()
    {
        var totals = new Dictionary<int, (int Generated, int Applied)>();
        foreach (var entry in Parser.VeteranOfWarAnalyzers)
        {
            foreach (var contribution in entry.Analyzer.BySource)
            {
                var current = totals.GetValueOrDefault(contribution.SourceSpellId);
                totals[contribution.SourceSpellId] =
                    (current.Generated + contribution.GeneratedMs, current.Applied + contribution.AppliedMs);
            }
        }

        return totals
            .OrderByDescending(entry => entry.Value.Generated - entry.Value.Applied)
            .Select(entry =>
            {
                var (generated, applied) = entry.Value;
                var efficiency = generated > 0 ? applied / (double)generated * 100 : 0;

                return new OverviewStat(
                    $"{(generated - applied) / 1000d:N0}s",
                    SpellName(entry.Key),
                    $"{efficiency:F0}% of the {generated / 1000d:N0}s this ability generated landed on a running cooldown.",
                    PerformanceTiers.FromThresholds(efficiency, 85, 70, 50));
            })
            .ToList();
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.VeteranOfWarAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = PerformanceTiers.FromThresholds(analyzer.Efficiency * 100, 85, 70, 50),
            Stats = BuildPullStats(analyzer),
            Details = analyzer.SawActiveUltimate
                ? @<div>Siegebreaker was up for part of this pull, doubling every reduction made under it.</div>
                : null,
        });

    private static PerCastStat[] BuildPullStats(VeteranOfWarAnalyzer analyzer)
    {
        var stats = new List<PerCastStat>
        {
            new(
                $"{analyzer.Efficiency * 100:F0}%",
                "Landed",
                "Share of this pull's generated reduction that shortened a running cooldown.",
                PerformanceTiers.FromThresholds(analyzer.Efficiency * 100, 85, 70, 50)),
            new(
                $"{analyzer.WastedMs / 1000d:F0}s",
                "Thrown Away",
                "Reduction generated against an ability that was already available."),
        };

        foreach (var contribution in analyzer.BySource.Take(3))
        {
            stats.Add(new PerCastStat(
                $"{contribution.WastedMs / 1000d:F0}s",
                SpellName(contribution.SourceSpellId),
                $"{contribution.Events} casts generated {contribution.GeneratedMs / 1000d:F0}s, of which {contribution.AppliedMs / 1000d:F0}s landed.",
                PerformanceTiers.FromThresholds(contribution.Efficiency * 100, 85, 70, 50)));
        }

        return [.. stats];
    }

    private static string SpellName(int spellId) =>
        SpellRegistry.MaybeGet(spellId)?.Name ?? $"Spell {spellId}";
}
