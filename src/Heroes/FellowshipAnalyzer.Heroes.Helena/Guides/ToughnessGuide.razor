@inherits ReportComponent<HelenaCombatLogParser>

<GuideSection Title="Toughness">
    <Explanation>
        <p>
            How high you held Toughness is how much physical damage you turned away, so everything below
            is weighted by time and read against your own build's ceiling. Generation restored on top of
            maximum Toughness is counted separately, because it is worth nothing and costs you a cast.
        </p>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Time At Each Reduction" Stats="@BuildBandStats()" />
        @if (Parser.ToughnessTracker is { } tracker && tracker.GeneratorCasts > 0)
        {
            <CastOverview Title="Generation Thrown Away" Stats="@BuildOvercapStats(tracker)" />
        }
        <CastDetail Title="Toughness By Pull"
                    Description="How high Toughness was held through each pull, weighted by time."
                    Casts="@BuildPerPullData()" />
    </ChildContent>
</GuideSection>

@code {
    private bool HasFrontLineDefender => Parser.SelectedCombatant.HasTalent(Talents.FrontLineDefender.Id);

    private double Ceiling => ToughnessBands.Ceiling(HasFrontLineDefender);

    private string CeilingLabel => $"{Ceiling * 100:F0}%";

    private IEnumerable<OverviewStat> BuildBandStats()
    {
        var analyzers = Parser.ToughnessBandAnalyzers.Select(entry => entry.Analyzer).ToList();
        var measured = analyzers.Sum(analyzer => (long)analyzer.MeasuredMs);
        if (measured == 0) return [];

        var topBand = analyzers.Sum(analyzer => (long)analyzer.MsIn(ToughnessBand.Level4)) / (double)measured;
        var atMaximum = analyzers.Sum(analyzer => (long)analyzer.AtMaximumMs) / (double)measured;
        var averageReduction = analyzers.Sum(analyzer => analyzer.AverageDamageReduction * analyzer.MeasuredMs) / measured;
        var lowBands = analyzers.Sum(analyzer =>
            (long)analyzer.MsIn(ToughnessBand.Depleted) + analyzer.MsIn(ToughnessBand.Level1)) / (double)measured;
        var lowest = ToughnessBands.DamageReduction(ToughnessBand.Level1, HasFrontLineDefender);

        return
        [
            new OverviewStat(
                $"{topBand * 100:F1}%",
                $"At {CeilingLabel} Reduction",
                $"Share of pull time spent with Toughness granting its full {CeilingLabel} physical damage reduction.",
                PerformanceTiers.FromThresholds(topBand * 100, 90, 75, 55)),
            new OverviewStat(
                $"{averageReduction * 100:F1}%",
                "Average Reduction",
                $"The physical damage reduction Toughness averaged across every pull, against the {CeilingLabel} this build allows.",
                PerformanceTiers.FromThresholds(averageReduction / Ceiling * 100, 90, 75, 55)),
            new OverviewStat(
                $"{lowBands * 100:F1}%",
                "Below 25% Toughness",
                $"Share of pull time spent with Toughness worth {lowest * 100:F0}% or nothing at all.",
                PerformanceTiers.FromThresholds(100 - (lowBands * 100), 98, 95, 90)),
            new OverviewStat(
                $"{atMaximum * 100:F1}%",
                "At Maximum",
                "Share of pull time spent at maximum Toughness. Time here is safe, but every generator pressed during it restored nothing."),
        ];
    }

    private IEnumerable<OverviewStat> BuildOvercapStats(ToughnessTracker tracker)
    {
        var stats = new List<OverviewStat>();

        foreach (var generator in ToughnessTracker.Generators)
        {
            var casts = tracker.GeneratorCastsFor(generator.SpellId);
            if (casts == 0) continue;

            var overcapped = tracker.OvercappedCastsFor(generator.SpellId);
            var share = (double)overcapped / casts;
            var restored = tracker.NominalGenerationFor(generator.SpellId);

            stats.Add(new OverviewStat(
                $"{overcapped}/{casts}",
                SpellName(generator.SpellId),
                $"Casts made at full Toughness, each losing the {restored * 100:F0}% it would have restored.",
                PerformanceTiers.FromThresholds(100 - (share * 100), 85, 70, 50)));
        }

        if (tracker.ObservedBlocks > 0)
        {
            stats.Add(new OverviewStat(
                $"{tracker.OvercappedBlocks}/{tracker.ObservedBlocks}",
                "Blocks",
                $"Blocks landed at full Toughness, each losing the {ToughnessTracker.BlockGeneration * 100:F1}% " +
                "it would have restored. This is a sample of your blocks rather than all of them, and unlike " +
                "the casts their timing is not yours to choose."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.ToughnessBandAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = PerformanceTiers.FromThresholds(analyzer.TopBandShare * 100, 90, 75, 55),
            Stats = BuildPullStats(analyzer),
            AdditionalContent = BuildPullGraph(pull),
        });

    private AdditionalContent? BuildPullGraph(Pull pull)
    {
        if (Parser.ToughnessTracker is not { Toughness: not null } tracker) return null;

        var hasEvents = tracker.GetResourceEvents(ResourceTypes.Secondary)
            .Any(e => e.Timestamp >= pull.StartTime && e.Timestamp <= pull.EndTime);
        if (!hasEvents) return null;

        var overlay = BuildDamageTakenOverlay(pull);

        return new AdditionalContent("Toughness Through The Pull",
            @<ResourceGraph @key="pull" Tracker="tracker" Resource="ResourceTypes.Secondary" Pull="pull" ShareOfMaximum="true" Overlay="overlay" />);
    }

    private ResourceGraphOverlay? BuildDamageTakenOverlay(Pull pull)
    {
        if (Parser.DamageTakenTracker is not { } damage) return null;

        var seconds = (pull.EndTime - pull.StartTime) / 1000;
        if (seconds < 1) return null;

        var perSecond = new double[seconds];
        var any = false;
        foreach (var hit in damage.Hits)
        {
            if (hit.Timestamp < pull.StartTime || hit.Timestamp >= pull.EndTime) continue;

            var index = Math.Min((hit.Timestamp - pull.StartTime) / 1000, seconds - 1);
            perSecond[index] += hit.Amount;
            any = true;
        }

        if (!any) return null;

        var points = new List<ResourceGraphOverlayPoint>(seconds);
        for (var i = 0; i < seconds; i++)
        {
            var from = Math.Max(0, i - 2);
            var to = Math.Min(seconds - 1, i + 2);
            var sum = 0d;
            for (var j = from; j <= to; j++) sum += perSecond[j];

            points.Add(new ResourceGraphOverlayPoint(
                pull.StartTime + (i * 1000) + 500,
                sum / (to - from + 1)));
        }

        return new ResourceGraphOverlay("Damage Taken", points);
    }

    private static PerCastStat[] BuildPullStats(ToughnessBandAnalyzer analyzer)
    {
        var ceiling = analyzer.DamageReductionCeiling;

        var stats = new List<PerCastStat>
        {
            new(
                $"{analyzer.AverageDamageReduction * 100:F1}%",
                "Average Reduction",
                $"Time-weighted physical damage reduction from Toughness over this pull, against a {ceiling * 100:F0}% ceiling.",
                PerformanceTiers.FromThresholds(analyzer.AverageDamageReduction / ceiling * 100, 90, 75, 55)),
        };

        foreach (var band in ToughnessBands.All)
        {
            var share = analyzer.ShareIn(band);
            if (share <= 0) continue;

            stats.Add(new PerCastStat(
                $"{share * 100:F1}%",
                BandLabel(analyzer, band),
                $"Time spent holding at least {ToughnessBands.LowerThreshold(band) * 100:F1}% Toughness, granting {analyzer.DamageReductionIn(band) * 100:F0}% physical damage reduction."));
        }

        return [.. stats];
    }

    private static string BandLabel(ToughnessBandAnalyzer analyzer, ToughnessBand band) =>
        band == ToughnessBand.Depleted ? "No Reduction" : $"{analyzer.DamageReductionIn(band) * 100:F0}% Reduction";

    private static string SpellName(int spellId) =>
        SpellRegistry.MaybeGet(spellId)?.Name ?? $"Spell {spellId}";
}
