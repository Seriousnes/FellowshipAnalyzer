@inherits GuideComponent<HelenaCombatLogParser>

<GuideSection Title="Toughness">
    <LeftPanel>
        <p>
            Managing Toughness is key to Helena's survival. You should aim to reach @CeilingLabel DR as soon as possible.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildBandStats()" />
        @if (Parser.ToughnessTracker is { } tracker && tracker.GeneratorCasts > 0)
        {
            <CastOverview Title="Toughness Management" Stats="@BuildOvercapStats(tracker)" />
        }
        <CastDetail Title="Toughness By Pull"
                    Description="What Toughness mitigated in each pull, and the bands it was in."
                    Casts="@BuildPerPullData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.ToughnessAnalyzers.Count > 0;

    private bool HasFrontLineDefender => Parser.SelectedCombatant.HasTalent(Talents.FrontLineDefender.Id);

    private double Ceiling => ToughnessBands.Ceiling(HasFrontLineDefender);

    private string CeilingLabel => $"{Ceiling * 100:F0}%";

    private IEnumerable<OverviewStat> BuildBandStats()
    {
        var analyzers = Parser.ToughnessAnalyzers.Select(entry => entry.Analyzer).ToList();
        var measured = analyzers.Sum(analyzer => (long)analyzer.MeasuredMs);
        if (measured == 0) return [];

        var topBand = analyzers.Sum(analyzer => (long)analyzer.MsIn(ToughnessBand.Level4)) / (double)measured;
        var atMaximum = analyzers.Sum(analyzer => (long)analyzer.AtMaximumMs) / (double)measured;
        var averageReduction = analyzers.Sum(analyzer => analyzer.AverageDamageReduction * analyzer.MeasuredMs) / measured;
        var lowBands = analyzers.Sum(analyzer =>
            (long)analyzer.MsIn(ToughnessBand.Depleted) + analyzer.MsIn(ToughnessBand.Level1)) / (double)measured;
        var lowest = ToughnessBands.DamageReduction(ToughnessBand.Level1, HasFrontLineDefender);
        var mitigated = analyzers.Sum(analyzer => analyzer.ToughnessMitigated);
        var atCeiling = analyzers.Sum(analyzer => analyzer.MitigationAtCeiling);
        var hits = analyzers.Sum(analyzer => analyzer.MitigatedHits);
        var ticks = analyzers.Sum(analyzer => analyzer.MitigatedTicks);

        var stats = new List<OverviewStat>();

        if (atCeiling > 0)
        {
            stats.Add(new OverviewStat(
                $"{mitigated / atCeiling * 100:F1}%",
                "Mitigation",
                $"Toughness mitigated {mitigated:N0} of the {atCeiling:N0} it would have mitigated held at " +
                $"{CeilingLabel} throughout, across {hits:N0} physical hits ({ticks:N0} of them periodic ticks). " +
                "Weighted by damage rather than by time."));
        }

        stats.Add(new OverviewStat(
            $"{topBand * 100:F1}%",
            $"At {CeilingLabel} Reduction",
            $"Share of time at the full {CeilingLabel} physical damage reduction.",
            PerformanceTiers.FromThresholds(topBand * 100, 90, 75, 55)));

        if (BuildTimeToTopBand(analyzers) is { } timeToTop) stats.Add(timeToTop);

        stats.Add(new OverviewStat(
            $"{averageReduction * 100:F1}%",
            "Average Reduction",
            $"The physical damage reduction Toughness averaged across every pull, against the {CeilingLabel} this " +
            "build allows. Weighted by time."));

        stats.Add(new OverviewStat(
            $"{lowBands * 100:F1}%",
            "Below 25% Toughness",
            $"Share of time at {lowest * 100:F0}% reduction or none at all.",
            PerformanceTiers.FromThresholds(100 - (lowBands * 100), 98, 95, 90)));

        stats.Add(new OverviewStat(
            $"{atMaximum * 100:F1}%",
            "At Maximum",
            "Share of time at maximum Toughness."));

        return stats;
    }

    private OverviewStat? BuildTimeToTopBand(List<ToughnessAnalyzer> analyzers)
    {
        var climbed = analyzers.Where(analyzer => !analyzer.StartedAtTopBand && analyzer.MsToTopBand is not null).ToList();
        var alreadyThere = analyzers.Count(analyzer => analyzer.StartedAtTopBand);
        var neverReached = analyzers.Count(analyzer => !analyzer.StartedAtTopBand && analyzer.MsToTopBand is null);

        if (climbed.Count == 0 && alreadyThere == 0) return null;

        var context = $"{alreadyThere} of {analyzers.Count} pulls opened already at {CeilingLabel}. " +
            $"{neverReached} never reached it.";

        if (climbed.Count == 0)
        {
            return new OverviewStat("already there", $"Time To {CeilingLabel}", context);
        }

        var average = climbed.Average(analyzer => (double)analyzer.MsToTopBand!.Value);

        return new OverviewStat(
            $"{average / 1000d:F1}s",
            $"Time To {CeilingLabel}",
            $"Average time from the pull opening to reaching {CeilingLabel} reduction, over the {climbed.Count} " +
            $"pulls that had to climb to it. {context}");
    }

    private IEnumerable<OverviewStat> BuildOvercapStats(ToughnessTracker tracker)
    {
        var stats = new List<OverviewStat>();

        foreach (var generator in ToughnessTracker.Generators)
        {
            var casts = tracker.GeneratorCastsFor(generator.SpellId);
            if (casts == 0) continue;

            var overcapped = tracker.OvercappedCastsFor(generator.SpellId);
            var share = (double)overcapped / casts;

            stats.Add(new OverviewStat(
                $"{overcapped}/{casts}",
                SpellName(generator.SpellId),
                "Casts at maximum Toughness.",
                PerformanceTiers.FromThresholds(100 - (share * 100), 85, 70, 50)));
        }

        if (tracker.ObservedBlocks > 0)
        {
            stats.Add(new OverviewStat(
                $"{tracker.OvercappedBlocks}/{tracker.ObservedBlocks}",
                "Blocks",
                "Blocks taken at maximum Toughness."));
        }

        return stats;
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.ToughnessAnalyzers.ToPullRows(Parser, (analyzer, pull) => new PerCastRow
        {
            Performance = PerformanceTiers.FromThresholds(analyzer.TopBandShare * 100, 90, 75, 55),
            Stats = BuildPullStats(analyzer),
            Details = BuildBandBar(analyzer),
            AdditionalContent = BuildPullGraph(pull),
        });

    private RenderFragment? BuildBandBar(ToughnessAnalyzer analyzer)
    {
        if (analyzer.MeasuredMs <= 0) return null;

        var segments = BuildBandSegments(analyzer);

        return @<div>
            <StackedBar Segments="@segments" />
            <HelperText>Share of time at each level of physical damage reduction</HelperText>
        </div>;
    }

    private static IEnumerable<StackedBarSegment> BuildBandSegments(ToughnessAnalyzer analyzer)
    {
        var segments = new List<StackedBarSegment>(ToughnessBands.All.Count);

        foreach (var band in ToughnessBands.All)
        {
            var ms = analyzer.MsIn(band);
            if (ms <= 0) continue;

            segments.Add(new StackedBarSegment(
                BandLabel(analyzer, band),
                Math.Round(analyzer.ShareIn(band) * 100, 1),
                BandColor(band),
                $"{BandLabel(analyzer, band)}: {ms:N0} ms of the pull"));
        }

        return segments;
    }

    private static string BandColor(ToughnessBand band) => band switch
    {
        ToughnessBand.Level4 => FaVar.PerfPerfect,
        ToughnessBand.Level3 => FaVar.PerfGood,
        ToughnessBand.Level2 => FaVar.PerfOk,
        ToughnessBand.Level1 => FaVar.PerfFail,
        _ => FaVar.Stone,
    };

    private AdditionalContent? BuildPullGraph(PullStartEvent pull)
    {
        if (Parser.ToughnessTracker is not { Toughness: not null } tracker) return null;

        var hasEvents = tracker.GetResourceEvents(ResourceTypes.Secondary)
            .Any(e => e.Timestamp >= pull.StartTime && e.Timestamp <= pull.EndTime);
        if (!hasEvents) return null;

        var overlay = BuildDamageTakenOverlay(pull);

        return new AdditionalContent("Toughness Through The Pull",
            @<ResourceGraph @key="pull" Tracker="tracker" Resource="ResourceTypes.Secondary" Pull="pull" ShareOfMaximum="true" Overlay="overlay" />);
    }

    private ResourceGraphOverlay? BuildDamageTakenOverlay(PullStartEvent pull)
    {
        if (Parser.DamageTakenTracker is not { } damage) return null;

        var seconds = (pull.EndTime - pull.StartTime) / 1000;
        if (seconds < 1) return null;

        var perSecond = new double[seconds];
        var any = false;
        foreach (var hit in damage.Hits)
        {
            if (hit.Timestamp < pull.StartTime || hit.Timestamp >= pull.EndTime) continue;

            var index = Math.Min((hit.Timestamp - pull.StartTime) / 1000, seconds - 1);
            perSecond[index] += hit.Amount;
            any = true;
        }

        if (!any) return null;

        var points = new List<ResourceGraphOverlayPoint>(seconds);
        for (var i = 0; i < seconds; i++)
        {
            var from = Math.Max(0, i - 2);
            var to = Math.Min(seconds - 1, i + 2);
            var sum = 0d;
            for (var j = from; j <= to; j++) sum += perSecond[j];

            points.Add(new ResourceGraphOverlayPoint(
                pull.StartTime + (i * 1000) + 500,
                sum / (to - from + 1)));
        }

        return new ResourceGraphOverlay("Damage Taken", points);
    }

    private static PerCastStat[] BuildPullStats(ToughnessAnalyzer analyzer)
    {
        var ceiling = analyzer.DamageReductionCeiling;

        var stats = new List<PerCastStat>();

        if (analyzer.MitigationAtCeiling > 0)
        {
            stats.Add(new PerCastStat(
                $"{analyzer.MitigationEfficiency * 100:F1}%",
                "Mitigation",
                $"Toughness mitigated {analyzer.ToughnessMitigated:N0} of the {analyzer.MitigationAtCeiling:N0} a " +
                $"held {ceiling * 100:F0}% would have mitigated, across {analyzer.MitigatedHits:N0} physical hits."));
        }

        stats.Add(new PerCastStat(
            $"{analyzer.AverageDamageReduction * 100:F1}%",
            "Average Reduction",
            $"Time-weighted physical damage reduction from Toughness over this pull, against a {ceiling * 100:F0}% ceiling."));

        stats.Add(new PerCastStat(
            TimeToTopBandValue(analyzer),
            $"Time To {ceiling * 100:F0}%",
            analyzer.StartedAtTopBand
                ? $"This pull opened with Toughness already granting {ceiling * 100:F0}% reduction."
                : analyzer.MsToTopBand is null
                    ? $"Toughness never reached {ceiling * 100:F0}% reduction in this pull."
                    : $"Time from the pull opening to reaching {ceiling * 100:F0}% reduction."));

        return [.. stats];
    }

    private static string TimeToTopBandValue(ToughnessAnalyzer analyzer) => analyzer switch
    {
        { StartedAtTopBand: true } => "already there",
        { MsToTopBand: { } ms } => $"{ms / 1000d:F1}s",
        _ => "never",
    };

    private static string BandLabel(ToughnessAnalyzer analyzer, ToughnessBand band) =>
        band == ToughnessBand.Depleted ? "No Reduction" : $"{analyzer.DamageReductionIn(band) * 100:F0}% Reduction";

    private static string SpellName(int spellId) =>
        SpellRegistry.MaybeGet(spellId)?.Name ?? $"Spell {spellId}";
}
