@inherits GuideComponent<HelenaCombatLogParser>

<GuideSection Title="Shields Up and Iron Wall">
    <LeftPanel>
        <p>
            Use <SpellLink Spell="Spells.ShieldsUp" /> when you have less than 40% toughness, your block buff 
            is about to expire, or you're about to overcap charges. Almost all your abilities reduce each other's
            cooldowns, so try to minimise the cooldown reduction wasted on <SpellLink Spell="Spells.Shockwave" /> and <SpellLink Spell="Spells.ShieldsUp" />.
        </p>
        <p>
            Use <SpellLink Spell="Spells.IronWall" /> to prevent your Toughness from reducing while active, 
            allowing you time to regenerate <SpellLink Spell="Spells.ShieldsUp" /> charges when you run out.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (Parser.ShieldsUpAnalyzers.Count > 0)
        {
            <CastOverview Title="Shields Up" Stats="@BuildShieldsUpStats()" />
        }
        @if (Parser.IronWallAnalyzers.Count > 0)
        {
            <CastOverview Title="Iron Wall" Stats="@BuildIronWallStats()" />
            <CastDetail Title="Iron Wall Uses"
                        Description="Each Iron Wall, and the state it was used in."
                        Casts="@BuildIronWallUses()" />
        }
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.ShieldsUpAnalyzers.Count > 0 || Parser.IronWallAnalyzers.Count > 0;

    private IEnumerable<OverviewStat> BuildShieldsUpStats()
    {
        var entries = Parser.ShieldsUpAnalyzers.ToList();
        var pullMs = entries.Sum(entry => (long)(entry.Pull.EndTime - entry.Pull.StartTime));
        if (pullMs == 0) return [];

        var analyzers = entries.Select(entry => entry.Analyzer).OfType<ShieldsUpAnalyzer>().ToList();
        var casts = analyzers.Sum(analyzer => analyzer.Casts);
        var activeMs = analyzers.Sum(analyzer => (long)analyzer.ActiveMs);
        var cappedMs = analyzers.Sum(analyzer => (long)analyzer.ChargeCappedMs);
        var mitigation = analyzers.Sum(analyzer => analyzer.MitigationInWindow);
        var uptime = activeMs / (double)pullMs * 100;
        var cappedShare = cappedMs / (double)pullMs * 100;

        var stats = new List<OverviewStat>
        {
            new(
                $"{uptime:F1}%",
                "Uptime",
                $"Share of pull time Shields Up was active across {casts} casts.",
                PerformanceTiers.FromThresholds(uptime, 80, 65, 45)),
            new(
                $"{cappedShare:F1}%",
                "At Maximum Charges",
                $"{cappedMs / 1000d:N0}s of the pull spent holding every charge.",
                PerformanceTiers.FromThresholds(100 - cappedShare, 90, 75, 55)),
            new(
                $"{mitigation:N0}",
                "Mitigation In Window",
                "All mitigation and absorbs on hits taken inside a Shields Up window."),
        };

        if (Parser.ToughnessTracker is { } tracker)
        {
            var overcapped = tracker.OvercappedCastsFor(Spells.ShieldsUp.FSLID);
            var total = tracker.GeneratorCastsFor(Spells.ShieldsUp.FSLID);
            if (total > 0)
            {
                stats.Add(new OverviewStat(
                    $"{overcapped}/{total}",
                    "Cast At Maximum Toughness",
                    "Casts at maximum Toughness.",
                    PerformanceTiers.FromThresholds(100 - ((double)overcapped / total * 100), 85, 70, 50)));
            }
        }

        return stats;
    }

    private IEnumerable<OverviewStat> BuildIronWallStats()
    {
        var analyzers = Parser.IronWallAnalyzers.Select(entry => entry.Analyzer).OfType<IronWallAnalyzer>().ToList();
        var uses = analyzers.Sum(analyzer => analyzer.Uses.Count);
        if (uses == 0) return [];

        var fromHigh = analyzers.Sum(analyzer => analyzer.UsesFromHighToughness);
        var shieldsUpSpent = analyzers.Sum(analyzer => analyzer.UsesWithShieldsUpSpent);
        var mitigation = analyzers.Sum(analyzer => analyzer.MitigationInWindow);

        return
        [
            new OverviewStat(
                $"{uses}",
                "Uses",
                "Iron Wall windows across every pull."),
            new OverviewStat(
                $"{fromHigh}/{uses}",
                "Used Above Half",
                "Uses at or above 50% Toughness.",
                PerformanceTiers.FromThresholds((double)fromHigh / uses * 100, 90, 75, 50)),
            new OverviewStat(
                $"{shieldsUpSpent}/{uses}",
                "With Shields Up Spent",
                "Uses with no Shields Up charge left."),
            new OverviewStat(
                $"{mitigation:N0}",
                "Mitigation In Window",
                "All mitigation and absorbs on hits taken inside an Iron Wall window."),
        ];
    }

    private IEnumerable<PerCastData> BuildIronWallUses() =>
        Parser.IronWallAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer is IronWallAnalyzer ironWall ? ironWall.Uses : [],
            (use, pull) => new PerCastRow
            {
                Performance = UsePerformance(use),
                Timestamp = use.Window.Start,
                Stats = BuildUseStats(use),
            });

    private static QualitativePerformance UsePerformance(IronWallUse use) => use switch
    {
        { ToughnessShare: null } => QualitativePerformance.Ok,
        { OpenedAboveHalfToughness: true, ShieldsUpCharges: 0 } => QualitativePerformance.Perfect,
        { OpenedAboveHalfToughness: true } => QualitativePerformance.Good,
        _ => QualitativePerformance.Fail,
    };

    private static PerCastStat[] BuildUseStats(IronWallUse use)
    {
        var stats = new List<PerCastStat>
        {
            new(
                use.ToughnessShare is { } share ? $"{share * 100:F0}%" : "n/a",
                "Toughness At Use",
                Performance: use.ToughnessShare is null ? null
                    : use.OpenedAboveHalfToughness ? QualitativePerformance.Perfect : QualitativePerformance.Fail),
            new(
                $"{use.Window.DurationMs / 1000d:F1}s",
                "Duration",
                use.Window.Truncated ? "The pull ended before the window did." : "How long the window was open."),
            new(
                $"{use.Window.Mitigation:N0}",
                "Mitigation In Window",
                $"All mitigation and absorbs across the {use.Window.Hits} hits taken inside the window."),
        };

        if (use.ShieldsUpCharges is { } charges)
        {
            stats.Add(new PerCastStat(
                $"{charges}",
                "Shields Up Charges",
                charges == 0
                    ? "No Shields Up charge was left."
                    : "Shields Up charges available when Iron Wall was used.",
                charges == 0 ? QualitativePerformance.Perfect : QualitativePerformance.Ok));
        }

        return [.. stats];
    }
}
