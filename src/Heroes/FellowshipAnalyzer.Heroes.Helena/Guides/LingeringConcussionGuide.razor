@inherits GuideComponent<HelenaCombatLogParser>

<GuideSection Title="Lingering Concussion">
    <LeftPanel>
        <p>
            Try to maintain 5 stacks of <SpellLink Spell="Spells.ShieldSlamReducedIncomingDamageFromTargetDebuff" /> on the
            most dangerous target on trash pulls, and aim for 100% uptime on bosses.
        </p>
    </LeftPanel>
    <RightPanel>
        <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Lingering Concussion By Pull"
                    Description="Uptime, stack time and gaps against each pull's primary target."
                    Casts="@BuildPerPullData()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.LingeringConcussionAnalyzers.Count > 0;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Parser.LingeringConcussionAnalyzers
            .Where(entry => entry.Analyzer is LingeringConcussionAnalyzer)
            .Select(entry => (entry.Pull, Analyzer: (LingeringConcussionAnalyzer)entry.Analyzer))
            .ToList();
        if (analyzers.Count == 0) return [];

        var pullMs = analyzers.Sum(entry => (long)(entry.Pull.EndTime - entry.Pull.StartTime));
        if (pullMs == 0) return [];

        var covered = analyzers.Sum(entry => (long)entry.Analyzer.CoveredMs);
        var atCap = analyzers.Sum(entry => (long)entry.Analyzer.AtCapMs);
        var gaps = analyzers.Sum(entry => entry.Analyzer.GapCount);
        var reduction = analyzers.Sum(entry =>
            entry.Analyzer.AverageReduction * (entry.Pull.EndTime - entry.Pull.StartTime)) / pullMs;

        var uptime = covered / (double)pullMs * 100;
        var capUptime = atCap / (double)pullMs * 100;

        return
        [
            new OverviewStat(
                $"{uptime:F1}%",
                "Uptime",
                "Share of pull time the debuff was active on the primary target at any stack count. Each pull " +
                "is read against whichever enemy had it active longest, so adds passing through never dilute " +
                "the figure.",
                PerformanceTiers.FromThresholds(uptime, 90, 75, 55)),
            new OverviewStat(
                $"{capUptime:F1}%",
                "At Five Stacks",
                "Share of pull time the primary target was at the five-stack cap.",
                PerformanceTiers.FromThresholds(capUptime, 70, 50, 30)),
            new OverviewStat(
                $"{reduction * 100:F1}%",
                "Average Reduction",
                "The damage reduction the debuff averaged across every pull, counting time with it off the " +
                "target as zero.",
                PerformanceTiers.FromThresholds(reduction / (LingeringConcussionAnalyzer.MaxStacks * LingeringConcussionAnalyzer.ReductionPerStack) * 100, 70, 50, 30)),
            new OverviewStat(
                $"{gaps}",
                "Gaps",
                "Gaps with the debuff off the primary target."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerPullData() =>
        Parser.LingeringConcussionAnalyzers.ToPullRows(Parser, (surface, pull) =>
        {
            var analyzer = (LingeringConcussionAnalyzer)surface;
            return new PerCastRow
            {
                Performance = PerformanceTiers.FromThresholds(analyzer.Uptime * 100, 90, 75, 55),
                Stats = BuildPullStats(analyzer),
                Details = analyzer.PrimaryTarget is null
                    ? @<div>The debuff was never applied in this pull.</div>
                    : null,
            };
        });

    private static PerCastStat[] BuildPullStats(LingeringConcussionAnalyzer analyzer)
    {
        var stats = new List<PerCastStat>
        {
            new(
                $"{analyzer.Uptime * 100:F1}%",
                "Uptime",
                "Share of the pull the debuff was active on the primary target.",
                PerformanceTiers.FromThresholds(analyzer.Uptime * 100, 90, 75, 55)),
            new(
                $"{analyzer.AtCapUptime * 100:F1}%",
                "At Five Stacks",
                "Share of the pull the primary target was at the cap.",
                PerformanceTiers.FromThresholds(analyzer.AtCapUptime * 100, 70, 50, 30)),
            new(
                $"{analyzer.PeakStacks}/{LingeringConcussionAnalyzer.MaxStacks}",
                "Peak Stacks",
                "The highest stack count the primary target reached.",
                analyzer.PeakStacks >= LingeringConcussionAnalyzer.MaxStacks
                    ? QualitativePerformance.Perfect
                    : QualitativePerformance.Ok),
        };

        if (analyzer.BelowCapMs > 0)
        {
            stats.Add(new PerCastStat(
                $"{analyzer.BelowCapMs / 1000d:F1}s",
                "Under The Cap",
                "Time the debuff was active on the primary target below five stacks."));
        }

        if (analyzer.GapCount > 0)
        {
            stats.Add(new PerCastStat(
                $"{analyzer.GapCount}",
                "Gaps",
                $"Gaps with the debuff off the target, totalling {analyzer.TotalGapMs / 1000d:F1}s.",
                PerformanceTiers.FromThresholds(-analyzer.GapCount, 0, -2, -5)));
        }

        return [.. stats];
    }
}
