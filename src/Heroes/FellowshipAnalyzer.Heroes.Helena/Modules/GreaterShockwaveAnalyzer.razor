@inherits Analyzer

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic => MeasuredCasts > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Talents.GreaterShockwave" />
            </Header>
            <Info>
                <p>
                    Both halves are sized from how much Toughness was held when
                    <SpellLink Spell="Spells.Shockwave" /> went out, and they want opposite things from it. The
                    amplification below is the average across @MeasuredCasts casts; the wasted share is
                    how much of the returned Toughness there was no room to hold.
                </p>
            </Info>
            <ChildContent>
                <StatRow Value="@Percent(ToughnessWastedShare)" Tooltip="@WastedTooltip">
                    Toughness returned that was wasted
                </StatRow>
                <StatRow Value="@Percent(AverageAmplification)" Tooltip="@AmplificationTooltip">
                    average damage amplification
                </StatRow>
                @if (UnmeasuredCasts > 0)
                {
                    <HelperText>
                        @UnmeasuredCasts further casts carried no Toughness reading and are absent from both figures.
                    </HelperText>
                }
            </ChildContent>
        </StatCard>;

    private static string Percent(double share) => $"{share * 100:F1}%";

    private string WastedTooltip =>
        $"Each cast returns {AdditionalToughnessShare * 100:F0}% of maximum Toughness, " +
        "so one made within that much of maximum loses the difference and one made at maximum loses all " +
        "of it.";

    private string AmplificationTooltip =>
        $"Shockwave damage scales with Toughness up to {AmplificationAtFullToughness * 100:F0}% " +
        $"at full Toughness, and these casts reached {Percent(AmplificationShare)} of that.";
}
