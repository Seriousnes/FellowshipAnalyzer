@inherits Analyzer

@code {
    public override RenderFragment? Statistic => MeasuredCasts > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Talents.GreaterShockwave" />
            </Header>
            <ChildContent>
                <StatRow Value="@NumberFormat.Percent(ToughnessWastedShare, 1)">
                    Toughness returned wasted
                </StatRow>
                <StatRow Value="@NumberFormat.Percent(AverageAmplification, 1)">
                    average damage amplification
                </StatRow>
            </ChildContent>
        </StatCard>;
}
