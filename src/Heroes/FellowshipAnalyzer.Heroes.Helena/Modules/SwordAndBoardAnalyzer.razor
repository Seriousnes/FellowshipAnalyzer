@inherits Analyzer

@code {
    public override RenderFragment? Statistic => Procs > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Talents.SwordAndBoard" />
            </Header>
            <Info>
                <p>
                    The damage below is what @FreeCasts free
                    <SpellLink Spell="Spells.ShieldSlam" /> casts dealt, cleave included.
                </p>
            </Info>
            <ChildContent>
                <StatRow Value="@($"{ExtraDamage:N0}")" Tooltip="@DamageTooltip">
                    extra damage from free casts
                </StatRow>
                @if (ProcsExpired > 0)
                {
                    <HelperText>
                        @ProcsExpired of @Procs procs were replaced or expired with no Shield Slam pressed under them.
                    </HelperText>
                }
            </ChildContent>
        </StatCard>;

    private string DamageTooltip =>
        $"Every Shield Slam hit dealt between a free cast and the next Shield Slam, across {FreeCasts} " +
        $"free casts from {Procs} procs.";
}
