@inherits Analyzer

@code {
    public override RenderFragment? Statistic => Procs > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Talents.SwordAndBoard" />
            </Header>
            <ChildContent>
                <StatRow Value="@($"{ExtraDamage:N0}")" Tooltip="@DamageTooltip">
                    extra damage from free casts
                </StatRow>
                @if (ProcsExpired > 0)
                {
                    <HelperText>
                        @ProcsExpired of @Procs procs were replaced or expired unused.
                    </HelperText>
                }
            </ChildContent>
        </StatCard>;

    private string DamageTooltip =>
        $"Every Shield Slam hit, cleave included, dealt between a free cast and the next Shield Slam, " +
        $"across {FreeCasts} free casts from {Procs} procs.";
}
