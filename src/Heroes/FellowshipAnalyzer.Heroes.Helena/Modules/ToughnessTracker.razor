@using FellowshipAnalyzer.Core.Resources
@inherits ResourceTracker

@code {
    public override RenderFragment? Statistic => Toughness is null ? null : Card;

    private RenderFragment Card =>
        @<StatCard Title="Toughness Generation">
            <ChildContent>
                @foreach (var generator in Generators)
                {
                    var casts = GeneratorCastsFor(generator.SpellId);
                    if (casts > 0)
                    {
                        <StatRow Value="@Ratio(OvercappedCastsFor(generator.SpellId), casts)"
                                 Tooltip="@GeneratorTooltip(generator, casts)">
                            <SpellLink Spell="generator.SpellId" /> cast at maximum
                        </StatRow>
                    }
                }
                @if (ObservedBlocks > 0)
                {
                    <StatRow Value="@Ratio(OvercappedBlocks, ObservedBlocks)"
                             Tooltip="@BlockTooltip">
                        blocks taken at maximum
                    </StatRow>
                }
            </ChildContent>
        </StatCard>;

    private static string Ratio(int part, int whole) =>
        whole > 0 ? $"{(double)part / whole * 100:F0}%" : "0%";

    private string GeneratorTooltip(ToughnessGenerator generator, int casts) =>
        $"{OvercappedCastsFor(generator.SpellId)} of {casts} casts were made at maximum Toughness.";

    private string BlockTooltip =>
        $"{OvercappedBlocks} of {ObservedBlocks} blocks were taken at maximum Toughness.";
}
