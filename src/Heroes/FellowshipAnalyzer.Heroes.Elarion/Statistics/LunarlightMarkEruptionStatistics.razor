@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<LunarlightMarkEruptionAnalyzer>

<Statistic TooltipTitle="Heartseeker Barrage erupts active Lunarlight Marks. A barrage that lands without any active marks wastes the eruption mechanic.">
    <SpellValueText Spell="Spells.HeartseekerBarrage">
        @{
            var totalBarrages = Analyzer.BarrageWithEruption + Analyzer.BarrageWithoutEruption;
            var rate = totalBarrages == 0 ? 0 : Analyzer.BarrageWithEruption * 100.0 / totalBarrages;
        }
        @if (totalBarrages == 0)
        {
            <span>—</span> <small>no barrages</small>
        }
        else
        {
            <span class="@RateClass(rate)">@($"{rate:F0}%")</span> <small>eruption rate · @Analyzer.BarrageWithEruption/@totalBarrages</small>
            <div class="stat-sub">
                <span class="@ExpiredClass">@Analyzer.MarksExpired</span> <small>marks expired · @Analyzer.TotalMarksApplied applied</small>
            </div>
        }
    </SpellValueText>
</Statistic>

@code {
    private string RateClass(double rate) => rate >= 90 ? "perfect"
        : rate >= 75 ? "good"
        : rate >= 50 ? "ok"
        : "fail";

    private string ExpiredClass => Analyzer.MarksExpired == 0 ? "perfect"
        : Analyzer.MarksExpired < 3 ? "good"
        : Analyzer.MarksExpired < 6 ? "ok"
        : "fail";
}
