@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<PreUltimateChecklistAnalyzer>

<Statistic TooltipTitle="Each ultimate is scored against five pre-conditions: Supremacy, Voidbringer, Grace, Event Horizon, Barrage availability.">
    <SpellValueText Spell="Spells.SpiritOfHeroism">
        @{
            var ults = Analyzer.Windows.Count;
        }
        @if (ults == 0)
        {
            <span>—</span> <small>no ultimates</small>
        }
        else
        {
            <span class="@ScoreClass">@($"{Analyzer.Score}%")</span> <small>setup score</small>
            <div class="stat-sub">
                @ults <small>ultimate@(ults == 1 ? "" : "s") · 5 pre-checks</small>
            </div>
        }
    </SpellValueText>
</Statistic>

@code {
    private string ScoreClass => Analyzer.Score >= 90 ? "perfect"
        : Analyzer.Score >= 75 ? "good"
        : Analyzer.Score >= 50 ? "ok"
        : "fail";
}
