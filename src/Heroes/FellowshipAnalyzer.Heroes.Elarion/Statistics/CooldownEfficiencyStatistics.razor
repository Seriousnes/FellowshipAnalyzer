@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<CooldownEfficiencyAnalyzer>

<Statistic TooltipTitle="Held time and effective buff uptime for major cooldowns.">
    <SpellValueText Spell="Spells.SkystridersGrace">
        <span class="@HeldClass(Analyzer.SkystridersGrace.TotalHeldMs)">@FormatSeconds(Analyzer.SkystridersGrace.TotalHeldMs)</span> <small>held off cooldown</small>
        <div class="stat-sub">
            @($"{UptimePct(Analyzer.SkystridersGrace.TotalBuffUptimeMs):F0}%") <small>buff uptime · @Analyzer.SkystridersGrace.Casts casts</small>
        </div>
    </SpellValueText>
    <SpellValueText Spell="Spells.EventHorizon">
        <span class="@HeldClass(Analyzer.EventHorizon.TotalHeldMs)">@FormatSeconds(Analyzer.EventHorizon.TotalHeldMs)</span> <small>held off cooldown</small>
        <div class="stat-sub">
            @($"{UptimePct(Analyzer.EventHorizon.TotalBuffUptimeMs):F0}%") <small>buff uptime · @Analyzer.EventHorizon.Casts casts</small>
        </div>
    </SpellValueText>
</Statistic>

@code {
    private string FormatSeconds(int ms) => $"{ms / 1000.0:F1}s";

    private double UptimePct(int buffMs) => Analyzer.FightLengthMs > 0
        ? buffMs * 100.0 / Analyzer.FightLengthMs
        : 0;

    private string HeldClass(int heldMs)
    {
        if (Analyzer.FightLengthMs <= 0) return "";
        var ratio = (double)heldMs / Analyzer.FightLengthMs;
        return ratio < 0.05 ? "perfect"
            : ratio < 0.15 ? "good"
            : ratio < 0.25 ? "ok"
            : "fail";
    }
}
