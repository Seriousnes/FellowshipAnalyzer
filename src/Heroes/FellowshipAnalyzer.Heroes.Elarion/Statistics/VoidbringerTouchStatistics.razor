@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<VoidbringerTouchAnalyzer>

<Statistic TooltipTitle="First cast ASAP, then save for void → ult → void. Re-marking an unconsumed target wastes spirit generation.">
    <SpellValueText Spell="Spells.VoidbringerTouch">
        @Analyzer.TotalCasts <small>casts</small>
        <div class="stat-sub">
            <span class="@DoubleClass">@Analyzer.DoubleMarks</span> <small>double-marks</small>
        </div>
    </SpellValueText>
</Statistic>

@code {
    private string DoubleClass => Analyzer.DoubleMarks == 0 ? "perfect"
        : Analyzer.DoubleMarks < 2 ? "good"
        : Analyzer.DoubleMarks < 4 ? "ok"
        : "fail";
}
