@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<ImpendingHeartseekerAnalyzer>

<Statistic TooltipTitle="Impending Heartseeker procs from Focused Shot and lasts 15 seconds. Procs that expire unused are wasted.">
    <SpellValueText Spell="Spells.ImpendingHeartseeker">
        @{
            var settled = Analyzer.Consumed + Analyzer.Expired;
            var rate = settled == 0 ? 0 : Analyzer.Consumed * 100.0 / settled;
        }
        @if (settled == 0)
        {
            <span>—</span> <small>no procs</small>
        }
        else
        {
            <span class="@RateClass(rate)">@($"{rate:F0}%")</span> <small>consume rate · @Analyzer.Consumed/@settled</small>
            <div class="stat-sub">
                <span class="@ExpiredClass">@Analyzer.Expired</span> <small>expired · @Analyzer.Gains gained</small>
            </div>
        }
    </SpellValueText>
</Statistic>

@code {
    private string RateClass(double rate) => rate >= 95 ? "perfect"
        : rate >= 80 ? "good"
        : rate >= 60 ? "ok"
        : "fail";

    private string ExpiredClass => Analyzer.Expired == 0 ? "perfect"
        : Analyzer.Expired < 2 ? "good"
        : Analyzer.Expired < 4 ? "ok"
        : "fail";
}
