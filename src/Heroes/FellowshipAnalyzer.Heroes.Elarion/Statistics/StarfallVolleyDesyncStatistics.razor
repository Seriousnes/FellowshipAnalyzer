@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<StarfallVolleyDesyncAnalyzer>

<Statistic TooltipTitle="Average time between the previous Lunarlight Mark and each Starfall Volley. Target spacing is 10–15 seconds.">
    <SpellValueText Spell="Spells.StarfallVolley">
        @if (Analyzer.VolleyCount == 0)
        {
            <span>—</span> <small>no volleys</small>
        }
        else
        {
            <span class="@AvgClass">@($"{Analyzer.AverageGapMs / 1000.0:F1}s")</span> <small>average gap from mark</small>
            <div class="stat-sub">
                <span class="@CloseClass">@Analyzer.CloseGapCount</span> <small>close-spaced · @Analyzer.VolleyCount volleys</small>
            </div>
        }
    </SpellValueText>
</Statistic>

@code {
    private string AvgClass
    {
        get
        {
            var avg = Analyzer.AverageGapMs / 1000.0;
            return avg >= 10 && avg <= 15 ? "perfect"
                : avg >= 7 && avg < 20 ? "good"
                : avg >= 5 ? "ok"
                : "fail";
        }
    }

    private string CloseClass => Analyzer.CloseGapCount == 0 ? "perfect"
        : Analyzer.CloseGapCount < 2 ? "good"
        : Analyzer.CloseGapCount < 4 ? "ok"
        : "fail";
}
