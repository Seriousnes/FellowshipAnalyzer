@inherits AnalyzerStatistic<ResurgentWindsTracker>
@using FellowshipAnalyzer.Core.UI

<StatCard>
    <Header>
        <SpellLink Spell="Talents.ResurgentWinds" />
    </Header>
    <Info>
        <p>
            Resurgent Winds procs off any ability and turns the next
            <SpellLink Spell="Spells.HighwindArrow" /> into an instant free cast. A proc that expires
            before that cast goes out is a Highwind Arrow lost.
        </p>
    </Info>
    <ChildContent>
        <StatRow Value="@Analyzer.ProcsGained.ToString("N0")"
                 Tooltip="Resurgent Winds procs granted over the fight, one per apply or stack gain.">
            procs gained
        </StatRow>
        <StatRow Value="@Analyzer.ProcsConsumed.ToString("N0")"
                 Color="@PerformanceColors.ToColor(ConsumedTier)"
                 Tooltip="@($"{Analyzer.ProcsConsumed} of {Analyzer.ProcsGained} procs were spent on an instant Highwind Arrow.")">
            procs spent on a free <SpellLink Spell="Spells.HighwindArrow" />
        </StatRow>
        <StatRow Value="@Analyzer.ProcsExpired.ToString("N0")"
                 Color="@PerformanceColors.ToColor(ExpiredTier)"
                 Tooltip="Procs that fell off before a Highwind Arrow was fired, each one a free cast lost.">
            procs expired unspent
        </StatRow>
    </ChildContent>
</StatCard>

@code {
    private QualitativePerformance ConsumedTier =>
        Analyzer.ConsumedShare >= 0.9 ? QualitativePerformance.Perfect
            : Analyzer.ConsumedShare >= 0.75 ? QualitativePerformance.Good
            : Analyzer.ConsumedShare >= 0.5 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

    private QualitativePerformance ExpiredTier =>
        Analyzer.ProcsExpired == 0 ? QualitativePerformance.Perfect
            : Analyzer.ExpiredShare < 0.1 ? QualitativePerformance.Good
            : Analyzer.ExpiredShare < 0.2 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;
}
