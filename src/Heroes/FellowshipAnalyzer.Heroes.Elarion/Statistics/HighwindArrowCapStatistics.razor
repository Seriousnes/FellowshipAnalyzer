@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<HighwindArrowCapAnalyzer>

<Statistic TooltipTitle="Time at the Highwind Arrow charge cap wastes recharge time.">
    <SpellValueText Spell="Spells.HighwindArrow">
        <span class="@CapClass">@($"{Analyzer.CapPercentage * 100:F0}%")</span> <small>time at cap</small>
        <div class="stat-sub">
            <span class="@CastClass">@Analyzer.CastsWhileCapped</span> <small>casts at cap · @Analyzer.TotalCasts total</small>
        </div>
    </SpellValueText>
</Statistic>

@code {
    private string CapClass
    {
        get
        {
            var capPct = Analyzer.CapPercentage * 100;
            return capPct < 5 ? "perfect"
                : capPct < 15 ? "good"
                : capPct < 25 ? "ok"
                : "fail";
        }
    }

    private string CastClass => Analyzer.CastsWhileCapped == 0 ? "perfect"
        : Analyzer.CastsWhileCapped < 3 ? "good"
        : Analyzer.CastsWhileCapped < 6 ? "ok"
        : "fail";
}
