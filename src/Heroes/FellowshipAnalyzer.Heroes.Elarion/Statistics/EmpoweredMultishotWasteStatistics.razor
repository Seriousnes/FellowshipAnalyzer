@namespace FellowshipAnalyzer.Heroes.Elarion.Statistics
@using FellowshipAnalyzer.Components
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Heroes.Elarion.Modules
@inherits AnalyzerStatistic<EmpoweredMultishotWasteAnalyzer>

<Statistic TooltipTitle="Empowered Multishot buffs should be consumed before they expire. Detection uses the buff name; spell ID may not be wired yet.">
    <SpellValueText Spell="Spells.Multishot">
        @Analyzer.EmpoweredConsumed <small>empowered consumed</small>
        <div class="stat-sub">
            <span class="@WasteClass">@Analyzer.WastedExpirations</span> <small>wasted · @Analyzer.RegularCasts regular casts</small>
        </div>
    </SpellValueText>
</Statistic>

@code {
    private string WasteClass => Analyzer.WastedExpirations == 0 ? "perfect"
        : Analyzer.WastedExpirations < 2 ? "good"
        : Analyzer.WastedExpirations < 4 ? "ok"
        : "fail";
}
