@using FellowshipAnalyzer.Heroes.Elarion.Analysis
@using FellowshipAnalyzer.Core.Game
@inject ElarionCombatLogParser Parser

@if (Parser.FocusTracker is not null)
{
    <ResourceGraph
        Tracker="Parser.FocusTracker"
        Resource="ResourceTypes.Primary"
    />
}

@if (Parser.LunarlightMarkEruptionReports.Count > 0)
{
    <LunarlightMarkEruptionGuide />
}

@if (Parser.EmpoweredMultishotWasteReports.Any(e => e.Result.BuildActive))
{
    <EmpoweredMultishotWasteGuide />
}

@if (Parser.HighwindArrowCapReports.Count > 0)
{
    <HighwindArrowCapGuide />
}

@if (Parser.CooldownEfficiencyReports.Count > 0)
{
    <CooldownEfficiencyGuide />
}

@if (Parser.PreUltimateChecklistReports.Count > 0)
{
    <PreUltimateChecklistGuide />
}

@if (Parser.ImpendingHeartseekerReports.Count > 0)
{
    <ImpendingHeartseekerGuide />
}

@if (Parser.StarfallVolleyDesyncReports.Count > 0)
{
    <StarfallVolleyDesyncGuide />
}

@if (Parser.VoidbringerTouchReports.Any(e => e.Result.TotalCasts > 0))
{
    <VoidbringerTouchGuide />
}
