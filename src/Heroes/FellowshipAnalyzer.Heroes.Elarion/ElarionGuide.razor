@using FellowshipAnalyzer.Heroes.Elarion.Analysis
@using FellowshipAnalyzer.Core.Game
@inject ElarionCombatLogParser Parser

@if (Parser.FocusTracker is not null)
{
    <ResourceGraph
        Tracker="Parser.FocusTracker"
        Resource="ResourceTypes.Primary"
    />
}

@if (Parser.LunarlightMarkEruptionAnalyzers.Count > 0)
{
    <LunarlightMarkEruptionGuide />
}

@if (Parser.EmpoweredMultishotWasteAnalyzers.Any(e => e.Analyzer.BuildActive))
{
    <EmpoweredMultishotWasteGuide />
}

@if (Parser.HighwindArrowCapAnalyzers.Count > 0)
{
    <HighwindArrowCapGuide />
}

@if (Parser.CooldownEfficiencyAnalyzers.Count > 0)
{
    <CooldownEfficiencyGuide />
}

@if (Parser.PreUltimateChecklistAnalyzers.Count > 0)
{
    <PreUltimateChecklistGuide />
}

@if (Parser.ImpendingHeartseekerAnalyzers.Count > 0)
{
    <ImpendingHeartseekerGuide />
}

@if (Parser.StarfallVolleyDesyncAnalyzers.Count > 0)
{
    <StarfallVolleyDesyncGuide />
}

@if (Parser.VoidbringerTouchAnalyzers.Any(e => e.Analyzer.TotalCasts > 0))
{
    <VoidbringerTouchGuide />
}
