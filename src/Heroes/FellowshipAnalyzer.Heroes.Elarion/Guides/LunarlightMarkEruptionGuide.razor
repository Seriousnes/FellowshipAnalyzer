@inject ElarionCombatLogParser Parser

<GuideSection Title="Lunarlight Mark Eruptions">
    <Explanation>
        <p>
            <SpellLink Spell="Spells.HeartseekerBarrage" /> is the top AoE priority because it
            erupts active <SpellLink Spell="Spells.LunarlightMark" /> debuffs. A Barrage cast with
            no marks on targets wastes the eruption mechanic entirely.
        </p>
        <ol>
            <li>Maintain marks on as many targets as possible before each Barrage.</li>
            <li>Avoid letting marks expire - they're wasted potential damage.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Eruption Efficiency" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Barrage Casts"
                    Description="Active mark count erupted by each Heartseeker Barrage, grouped by pull."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IReadOnlyList<PullAnalyzer<LunarlightMarkEruptionAnalyzer>> Analyzers => Parser.LunarlightMarkEruptionAnalyzers;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var withEruption = Analyzers.Sum(entry => entry.Analyzer.BarrageWithEruption);
        var withoutEruption = Analyzers.Sum(entry => entry.Analyzer.BarrageWithoutEruption);
        var marksExpired = Analyzers.Sum(entry => entry.Analyzer.MarksExpired);
        var totalApplied = Analyzers.Sum(entry => entry.Analyzer.TotalMarksApplied);
        var totalBarrages = withEruption + withoutEruption;
        var eruptionRate = totalBarrages == 0 ? 0 : withEruption * 100.0 / totalBarrages;

        var rateTier = eruptionRate >= 90 ? PerformanceTier.Perfect
            : eruptionRate >= 75 ? PerformanceTier.Good
            : eruptionRate >= 50 ? PerformanceTier.Ok
            : PerformanceTier.Fail;

        var expiredTier = marksExpired == 0 ? PerformanceTier.Perfect
            : marksExpired < 3 ? PerformanceTier.Good
            : marksExpired < 6 ? PerformanceTier.Ok
            : PerformanceTier.Fail;

        return
        [
            new OverviewStat(totalBarrages == 0 ? "-" : $"{eruptionRate:F0}%", "Eruption Rate",
                "Barrages that erupted at least one mark.",
                totalBarrages == 0 ? null : rateTier),
            new OverviewStat($"{marksExpired}", "Expired Marks",
                "Marks that fell off targets unerupted.", expiredTier),
            new OverviewStat($"{totalApplied}", "Total Applied",
                "All Lunarlight Mark applications."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData()
    {
        return Analyzers.SelectMany(entry =>
            entry.Analyzer.Barrages.Select(b => BuildBarrageData(b, entry.Pull)));
    }

    private PerCastData BuildBarrageData(LunarlightMarkEruptionAnalyzer.BarrageEvent b, Pull pull)
    {
        var tier = b.ErupedMarks >= 3 ? PerformanceTier.Perfect
            : b.ErupedMarks >= 1 ? PerformanceTier.Good
            : PerformanceTier.Fail;

        return new PerCastData
        {
            Performance = tier,
            Timestamp = Parser.FormatTimestamp(b.Timestamp),
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="@pull" />,
            Stats =
            [
                new PerCastStat($"{b.ErupedMarks}", "Marks Erupted",
                    "Active Lunarlight Marks at the moment of the cast.",
                    tier),
            ],
        };
    }
}
