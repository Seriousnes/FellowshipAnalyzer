@inject ElarionCombatLogParser Parser

<GuideSection Title="Highwind Arrow Charges">
    <Explanation>
        <p>
            <SpellLink Spell="Spells.HighwindArrow" /> has 3 charges. Sitting at 3 charges wastes
            cooldown recovery time - every second at cap is a second the next charge could have been
            recharging. This is scored on single-target pulls, where Highwind Arrow is your builder.
        </p>
        <ol>
            <li>Cast Highwind Arrow before reaching the cap on single-target.</li>
            <li>Pool charges briefly only when prepping for a burst window.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Charge Discipline" Stats="@BuildOverviewStats()" />
        @if (TotalCasts == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                No Highwind Arrow casts were detected on single-target pulls.
            </TipBox>
        }
        else if (CastsWhileCapped == 0 && CapPercentage < 0.05)
        {
            <TipBox Variant="TipBoxVariant.Success">
                Charge management was clean - minimal time at cap.
            </TipBox>
        }
        else if (CastsWhileCapped > 0)
        {
            <TipBox Variant="TipBoxVariant.Warning">
                @CastsWhileCapped @(CastsWhileCapped == 1 ? "cast" : "casts") fired with charges capped - that recharge time was wasted.
            </TipBox>
        }
    </ChildContent>
</GuideSection>

@code {
    private IReadOnlyList<PullAnalyzer<HighwindArrowCapAnalyzer>> Analyzers => Parser.HighwindArrowCapAnalyzers;

    private int TotalTimeAtCapMs => Analyzers.Sum(entry => entry.Analyzer.TotalTimeAtCapMs);
    private int TotalPullDurationMs => Analyzers.Sum(entry => entry.Analyzer.PullDurationMs);
    private int CastsWhileCapped => Analyzers.Sum(entry => entry.Analyzer.CastsWhileCapped);
    private int TotalCasts => Analyzers.Sum(entry => entry.Analyzer.TotalCasts);
    private double CapPercentage => TotalPullDurationMs > 0 ? (double)TotalTimeAtCapMs / TotalPullDurationMs : 0;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var capPct = CapPercentage * 100;
        var capTier = capPct < 5 ? QualitativePerformance.Perfect
            : capPct < 15 ? QualitativePerformance.Good
            : capPct < 25 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var castsTier = CastsWhileCapped == 0 ? QualitativePerformance.Perfect
            : CastsWhileCapped < 3 ? QualitativePerformance.Good
            : CastsWhileCapped < 6 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        return
        [
            new OverviewStat($"{capPct:F0}%", "Time at Cap",
                "Percentage of single-target pull time at 3/3 charges.", capTier),
            new OverviewStat($"{CastsWhileCapped}", "Casts at Cap",
                "Casts that fired with charges already capped.", castsTier),
            new OverviewStat($"{TotalCasts}", "Total Casts",
                "All Highwind Arrow casts on single-target pulls."),
        ];
    }
}
