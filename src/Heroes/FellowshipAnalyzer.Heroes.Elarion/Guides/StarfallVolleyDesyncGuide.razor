@inject ElarionCombatLogParser Parser

<GuideSection Title="Starfall Volley Desync">
    <Explanation>
        <p>
            Stagger <SpellLink Spell="Spells.LunarlightMark" /> and <SpellLink Spell="Spells.StarfallVolley" />
            by 10-15 seconds. Casting them together wastes the window where marks could be reapplied and
            erupted between Volley casts.
        </p>
        <ol>
            <li>Average gap below 5 seconds means the two cooldowns are stacked too tightly.</li>
            <li>Each Volley row shows the gap from the previous Lunarlight Mark cast, grouped per pull.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Spacing Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Volley Casts"
                    Description="Each Volley's gap from the previous Lunarlight Mark, grouped by pull."
                    Casts="@BuildPerCastData()" />
    </ChildContent>
</GuideSection>

@code {
    private IReadOnlyList<PullAnalyzer<StarfallVolleyDesyncAnalyzer>> Analyzers => Parser.StarfallVolleyDesyncAnalyzers;

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var volleys = Analyzers.SelectMany(entry => entry.Analyzer.Volleys).ToList();
        var volleyCount = volleys.Count;
        var closeGapCount = Analyzers.Sum(entry => entry.Analyzer.CloseGapCount);
        var measuredGaps = volleys.Where(e => e.GapMs != int.MaxValue).Select(e => e.GapMs).ToList();
        var avg = measuredGaps.Count == 0 ? 0 : measuredGaps.Average() / 1000.0;

        var avgTier = avg >= 10 && avg <= 15 ? QualitativePerformance.Perfect
            : avg >= 7 && avg < 20 ? QualitativePerformance.Good
            : avg >= 5 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        var closeTier = closeGapCount == 0 ? QualitativePerformance.Perfect
            : closeGapCount < 2 ? QualitativePerformance.Good
            : closeGapCount < 4 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        return
        [
            new OverviewStat(
                measuredGaps.Count == 0 ? "-" : $"{avg:F1}s",
                "Average Gap",
                "Mean time between previous Mark and each Volley across all pulls.",
                measuredGaps.Count == 0 ? null : avgTier),
            new OverviewStat($"{closeGapCount}", "Close Casts",
                "Volleys cast within 5s of a Mark.", closeTier),
            new OverviewStat($"{volleyCount}", "Volleys", "Total Volley casts."),
        ];
    }

    private IEnumerable<PerCastData> BuildPerCastData()
    {
        return Analyzers.SelectMany(entry =>
            entry.Analyzer.Volleys.Select(ev => BuildVolleyData(ev, entry.Pull)));
    }

    private PerCastData BuildVolleyData(StarfallVolleyDesyncAnalyzer.DesyncEvent ev, Pull pull)
    {
        var gapSeconds = ev.GapMs == int.MaxValue ? -1 : ev.GapMs / 1000.0;

        var tier = ev.GapMs == int.MaxValue
            ? QualitativePerformance.Ok
            : gapSeconds >= 10 && gapSeconds <= 15 ? QualitativePerformance.Perfect
            : gapSeconds >= 7 ? QualitativePerformance.Good
            : gapSeconds >= 5 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        return new PerCastData
        {
            Performance = tier,
            Timestamp = Parser.FormatTimestamp(ev.VolleyTimestamp),
            Group = pull.Name,
            GroupContent = @<PullBanner Pull="@pull" />,
            Stats =
            [
                new PerCastStat(
                    ev.GapMs == int.MaxValue ? "-" : $"{gapSeconds:F1}s",
                    "Gap from Mark",
                    "Time since the previous Lunarlight Mark cast.",
                    ev.GapMs == int.MaxValue ? null : tier),
            ],
        };
    }
}
