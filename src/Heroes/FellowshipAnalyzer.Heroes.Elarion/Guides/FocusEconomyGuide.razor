@using FellowshipAnalyzer.Core.Game
@inherits GuideComponent<ElarionCombatLogParser>

<GuideSection Title="Focus Economy">
    <LeftPanel>
        <p>
            Cast <SpellLink Spell="Spells.CelestialShot" /> to avoid overcapping Focus.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (Parser.FocusTracker is not null)
        {
            <ResourceGraph
                Tracker="Parser.FocusTracker"
                Resource="ResourceTypes.Primary"
            />
        }
        <CastOverview Title="Focus Overview" Stats="@BuildOverviewStats()" />
        <CastDetail Title="Event Horizon Windows"
                    Description="Each card is one Event Horizon cast, rated on the Focus banked going in, with the spenders and Focus spent alongside."
                    Casts="@BuildWindowRows()" />
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.FocusEconomyAnalyzers.Count > 0;

    private List<FocusEconomyAnalyzer> Analyzers() =>
        Parser.FocusEconomyAnalyzers.Select(entry => entry.Analyzer).ToList();

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var analyzers = Analyzers();

        var focusedShots = analyzers.Sum(analyzer => analyzer.FocusedShotCasts);
        var nearCap = analyzers.Sum(analyzer => analyzer.FocusedShotCastsNearCap);
        var nearCapPercent = focusedShots == 0 ? 0 : (double)nearCap / focusedShots * 100;

        var sampled = analyzers.Sum(analyzer => analyzer.SampledEvents);
        var atCap = analyzers.Sum(analyzer => analyzer.SampledAtCap);
        var atCapPercent = sampled == 0 ? 0 : (double)atCap / sampled * 100;

        var windows = analyzers.Sum(analyzer => analyzer.EventHorizonCasts.Count);

        return
        [
            new OverviewStat(
                $"{nearCapPercent:0.#}%",
                "Focused Shot Near Cap",
                $"{nearCap} of {focusedShots} Focused Shot casts started at {FocusEconomyAnalyzer.NearCapFocus} Focus or more.",
                PerformanceTiers.FromThresholds(100 - nearCapPercent, 95, 85, 70)),
            new OverviewStat(
                $"{atCapPercent:0.#}%",
                "Casts at Full Focus",
                $"{atCap} of {sampled} casts were already at the cap."),
            new OverviewStat(
                $"{windows}",
                "Event Horizon Casts",
                "Event Horizon casts across every pull."),
        ];
    }

    private IEnumerable<PerCastData> BuildWindowRows() =>
        Parser.FocusEconomyAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer.EventHorizonCasts,
            (window, pull) => BuildWindowRow(window));

    private PerCastRow BuildWindowRow(FocusEconomyAnalyzer.EventHorizonWindow window)
    {
        var performance = window.FocusAtCast is { } focus
            ? PerformanceTiers.FromThresholds(focus, 90, 70, 50)
            : QualitativePerformance.Ok;

        var stats = new[]
        {
            new PerCastStat(
                window.FocusAtCast is { } banked ? $"{banked}" : "-",
                "Focus Banked",
                "Focus held when Event Horizon was cast.",
                Performance: window.FocusAtCast is null ? null : performance),
            new PerCastStat(
                $"{window.SpendersInWindow}",
                "Spenders",
                "Focus spenders cast while the Event Horizon buff was active."),
            new PerCastStat(
                $"{window.FocusSpentInWindow}",
                "Focus Spent",
                "Focus spent inside the window."),
        };

        return new PerCastRow
        {
            Performance = performance,
            Stats = stats,
            Timestamp = window.Timestamp,
            AdditionalContent = new AdditionalContent(
                "Usage Notes",
                @<div>@BuildNote(window)</div>),
        };
    }

    private static string BuildNote(FocusEconomyAnalyzer.EventHorizonWindow window)
    {
        if (window.FocusAtCast is not { } focus)
            return "No resource snapshot was observed.";

        if (focus >= 90)
            return "Banked to near full before casting Event Horizon.";

        if (focus >= 70)
            return "A healthy bank going in. Pool a little longer before casting it.";

        if (focus >= 50)
            return "Entered on a half bank. Hold Event Horizon until Focus is high.";

        return "Entered Event Horizon on a low bank. Pool Focus before casting it.";
    }
}
