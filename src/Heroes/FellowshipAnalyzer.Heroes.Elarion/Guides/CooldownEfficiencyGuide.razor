@inject ElarionCombatLogParser Parser

<GuideSection Title="Skystrider's Grace + Event Horizon">
    <Explanation>
        <p>
            Use <SpellLink Spell="Spells.SkystridersGrace" /> and <SpellLink Spell="Spells.EventHorizon" />
            on cooldown as long as you'll get close to the full duration of the buff. Holding them
            unnecessarily is a DPS loss.
        </p>
        <ol>
            <li>Track the time each cooldown sat available after coming off cooldown.</li>
            <li>Compare effective buff uptime against the combined pull duration.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Skystrider's Grace" Stats="@BuildStats(a => a.Grace, Spells.SkystridersGrace.Name)" />
        <CastOverview Title="Event Horizon" Stats="@BuildStats(a => a.EventHorizon, Spells.EventHorizon.Name)" />
    </ChildContent>
</GuideSection>

@code {
    private IReadOnlyList<PullAnalyzer<CooldownEfficiencyAnalyzer>> Analyzers => Parser.CooldownEfficiencyAnalyzers;

    private int TotalPullDurationMs => Analyzers.Sum(entry => entry.Analyzer.PullDurationMs);

    private IEnumerable<OverviewStat> BuildStats(Func<CooldownEfficiencyAnalyzer, CooldownSnapshot> select, string displayName)
    {
        var casts = Analyzers.Sum(entry => select(entry.Analyzer).Casts);
        var heldMs = Analyzers.Sum(entry => select(entry.Analyzer).HeldMs);
        var uptimeMs = Analyzers.Sum(entry => select(entry.Analyzer).BuffUptimeMs);
        var fightLen = TotalPullDurationMs;

        var uptimePct = fightLen > 0 ? uptimeMs * 100.0 / fightLen : 0;

        var heldRatio = fightLen > 0 ? (double)heldMs / fightLen : 0;
        var heldTier = fightLen <= 0 ? QualitativePerformance.Ok
            : heldRatio < 0.05 ? QualitativePerformance.Perfect
            : heldRatio < 0.15 ? QualitativePerformance.Good
            : heldRatio < 0.25 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

        return
        [
            new OverviewStat($"{casts}", "Casts",
                $"Total {displayName} casts."),
            new OverviewStat($"{heldMs / 1000.0:F1}s", "Held",
                $"Time {displayName} sat off cooldown before being used.",
                heldTier),
            new OverviewStat($"{uptimePct:F0}%", "Buff Uptime",
                $"Percentage of pull time the {displayName} buff was active."),
        ];
    }
}
