@inject ElarionCombatLogParser Parser

<GuideSection Title="Skystrider's Grace + Event Horizon">
    <Explanation>
        <p>
            Use <SpellLink Spell="Spells.SkystridersGrace" /> and <SpellLink Spell="Spells.EventHorizon" />
            on cooldown as long as you'll get close to the full duration of the buff. Holding them
            unnecessarily is a DPS loss.
        </p>
        <ol>
            <li>Track the time each cooldown sat available after coming off cooldown.</li>
            <li>Compare effective buff uptime against the combined pull duration.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Skystrider's Grace" Stats="@BuildStats(r => r.Grace, Spells.SkystridersGrace.Name)" />
        <CastOverview Title="Event Horizon" Stats="@BuildStats(r => r.EventHorizon, Spells.EventHorizon.Name)" />
    </ChildContent>
</GuideSection>

@code {
    private IReadOnlyList<PullResult<CooldownEfficiencyReport>> Reports => Parser.CooldownEfficiencyReports;

    private int TotalPullDurationMs => Reports.Sum(r => r.Result.PullDurationMs);

    private IEnumerable<OverviewStat> BuildStats(Func<CooldownEfficiencyReport, CooldownSnapshot> select, string displayName)
    {
        var casts = Reports.Sum(r => select(r.Result).Casts);
        var heldMs = Reports.Sum(r => select(r.Result).HeldMs);
        var uptimeMs = Reports.Sum(r => select(r.Result).BuffUptimeMs);
        var fightLen = TotalPullDurationMs;

        var uptimePct = fightLen > 0 ? uptimeMs * 100.0 / fightLen : 0;

        var heldTier = fightLen <= 0
            ? PerformanceTier.Ok
            : ((double)heldMs / fightLen) switch
            {
                < 0.05 => PerformanceTier.Perfect,
                < 0.15 => PerformanceTier.Good,
                < 0.25 => PerformanceTier.Ok,
                _ => PerformanceTier.Fail,
            };

        return
        [
            new OverviewStat($"{casts}", "Casts",
                $"Total {displayName} casts."),
            new OverviewStat($"{heldMs / 1000.0:F1}s", "Held",
                $"Time {displayName} sat off cooldown before being used.",
                heldTier),
            new OverviewStat($"{uptimePct:F0}%", "Buff Uptime",
                $"Percentage of pull time the {displayName} buff was active."),
        ];
    }
}
