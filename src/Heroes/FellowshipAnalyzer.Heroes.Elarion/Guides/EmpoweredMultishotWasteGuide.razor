@inject ElarionCombatLogParser Parser

<GuideSection Title="Empowered Multishot">
    <Explanation>
        <p>
            Empowered <SpellLink Spell="Spells.Multishot" /> charges replace your next regular
            Multishot. Don't let them expire, and don't cast a regular Multishot while empowered is
            available, that wastes the proc.
        </p>
        <ol>
            <li>Track empowered Multishot consumption versus regular casts across AoE pulls.</li>
            <li>Expired empowered buffs are a clear-cut waste.</li>
        </ol>
    </Explanation>
    <ChildContent>
        <CastOverview Title="Empowered Usage" Stats="@BuildOverviewStats()" />
        @if (EmpoweredConsumed == 0 && WastedExpirations == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                No Empowered Multishot buffs were detected on AoE pulls.
            </TipBox>
        }
        else if (WastedExpirations == 0)
        {
            <TipBox Variant="TipBoxVariant.Success">
                All Empowered Multishot procs were consumed.
            </TipBox>
        }
        else
        {
            <TipBox Variant="TipBoxVariant.Warning">
                @WastedExpirations Empowered Multishot @(WastedExpirations == 1 ? "proc" : "procs") expired unused.
            </TipBox>
        }
    </ChildContent>
</GuideSection>

@code {
    private IReadOnlyList<PullAnalyzer<EmpoweredMultishotWasteAnalyzer>> Analyzers => Parser.EmpoweredMultishotWasteAnalyzers;

    private int EmpoweredConsumed => Analyzers.Sum(entry => entry.Analyzer.EmpoweredConsumed);
    private int WastedExpirations => Analyzers.Sum(entry => entry.Analyzer.WastedExpirations);
    private int RegularCasts => Analyzers.Sum(entry => entry.Analyzer.RegularCasts);

    private IEnumerable<OverviewStat> BuildOverviewStats()
    {
        var wasteTier = WastedExpirations == 0 ? PerformanceTier.Perfect
            : WastedExpirations < 2 ? PerformanceTier.Good
            : WastedExpirations < 4 ? PerformanceTier.Ok
            : PerformanceTier.Fail;

        return
        [
            new OverviewStat($"{EmpoweredConsumed}", "Empowered",
                "Multishot casts that consumed an Empowered Multishot buff.",
                EmpoweredConsumed > 0 ? PerformanceTier.Good : PerformanceTier.Ok),
            new OverviewStat($"{WastedExpirations}", "Wasted",
                "Empowered buffs that expired without being consumed.", wasteTier),
            new OverviewStat($"{RegularCasts}", "Regular",
                "Multishot casts with no Empowered Multishot buff active."),
        ];
    }
}
