@inherits GuideComponent<ElarionCombatLogParser>

@{
    var windows = Parser.SupremacyAnalyzers.SelectMany(entry => entry.Analyzer.Windows).ToList();
    var fervent = Parser.SelectedCombatant.HasTalent(Talents.FerventSupremacy.Id);
}

<GuideSection Title="Skystrider's Supremacy">
    <LeftPanel>
        <p>
            <strong><SpellLink Spell="Spells.SkystridersSupremacy" /></strong> makes
            <SpellLink Spell="Spells.Multishot" /> your strongest Focus spender while it is active.
            Try to cast four <SpellLink Spell="Spells.Multishot" /> in every window, and enter it
            with <SpellLink Spell="Spells.Multishot" /> charges available so you can begin
            immediately.
        </p>
    </LeftPanel>
    <RightPanel>
        @if (windows.Count == 0)
        {
            <TipBox Variant="TipBoxVariant.Info">
                Skystrider&#39;s Supremacy was not active on any pull.
            </TipBox>
        }
        else
        {
            <CastOverview Title="Supremacy Overview" Stats="@BuildOverviewStats(windows, fervent)" />
            <CastDetail Title="Supremacy Windows"
                        Description="One card per Skystrider's Supremacy window, rated on the Multishot casts inside it."
                        Casts="@BuildWindowRows(fervent)" />            
        }
    </RightPanel>
</GuideSection>

@code {
    protected override bool IsActive() => Parser.SupremacyAnalyzers.Count > 0;

    private const int TargetMultishots = 4;
    private const int SlowOpeningMs = 1_000;

    private static IEnumerable<OverviewStat> BuildOverviewStats(
        List<SupremacyAnalyzer.SupremacyWindow> windows,
        bool fervent)
    {
        var casts = windows.Sum(window => window.MultishotCasts);
        var average = (double)casts / windows.Count;
        var atTarget = windows.Count(window => window.MultishotCasts >= TargetMultishots);

        return
        [
            new OverviewStat(
                $"{casts}",
                "Multishots in Windows",
                "Multishot casts while a Skystrider's Supremacy window was open."),
            new OverviewStat(
                $"{average:0.#}",
                "Multishots per Window",
                "Multishot casts inside a window, averaged across every window."),
            new OverviewStat(
                $"{atTarget}/{windows.Count}",
                "Windows at Four",
                "Windows with four or more Multishot casts.",
                WindowShareTier((double)atTarget / windows.Count * 100, fervent)),
        ];
    }

    private IEnumerable<PerCastData> BuildWindowRows(bool fervent) =>
        Parser.SupremacyAnalyzers.ToItemRows(
            Parser,
            analyzer => analyzer.Windows,
            (window, pull) => BuildWindowRow(window, fervent));

    private static PerCastRow BuildWindowRow(SupremacyAnalyzer.SupremacyWindow window, bool fervent)
    {
        var performance = Tier(window.MultishotCasts, fervent);

        var stats = new[]
        {
            new PerCastStat(
                $"{window.MultishotCasts}",
                "Multishots",
                "Multishot casts while this window was open.",
                Performance: performance),
            new PerCastStat(
                window.FirstMultishotDelayMs is { } delay ? $"{delay / 1000d:0.##}s" : "-",
                "Opening Delay",
                "Time from the window opening to the first Multishot cast."),
        };

        return new PerCastRow
        {
            Performance = performance,
            Stats = stats,
            Timestamp = window.StartMs,
            AdditionalContent = BuildNote(window, fervent) is { } note
                ? new AdditionalContent("Usage Notes", @<div>@note</div>)
                : null,
        };
    }

    private static string? BuildNote(SupremacyAnalyzer.SupremacyWindow window, bool fervent)
    {
        if (window.MultishotCasts >= TargetMultishots)
            return null;

        if (window.FirstMultishotDelayMs is not { } delay)
            return "No Multishot was cast inside this window. Cast Multishot as soon as the window opens.";

        return !fervent && delay >= SlowOpeningMs
            ? $"The first Multishot came {delay / 1000d:0.##}s after the window opened. Cast Multishot as soon as the window opens."
            : "Enter the window with Multishot charges available.";
    }

    private static QualitativePerformance Tier(int casts, bool fervent) =>
        casts >= TargetMultishots ? QualitativePerformance.Perfect
        : fervent ? QualitativePerformance.Fail
        : casts >= 3 ? QualitativePerformance.Ok
        : QualitativePerformance.Fail;

    private static QualitativePerformance WindowShareTier(double share, bool fervent) =>
        fervent
            ? PerformanceTiers.FromThresholds(share, 100, 90, 75)
            : PerformanceTiers.FromThresholds(share, 100, 75, 50);
}
