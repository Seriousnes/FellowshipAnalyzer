@inherits EventSubscriber
@using FellowshipAnalyzer.Core.UI

@code {
    public override RenderFragment? Statistic => ProcsGained > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Talents.ResurgentWinds" />
            </Header>
            <ChildContent>
                <StatRow Value="@ProcsGained.ToString("N0")"
                         Tooltip="Resurgent Winds procs granted over the fight.">
                    procs gained
                </StatRow>
                <StatRow Value="@ProcsConsumed.ToString("N0")"
                         Color="@PerformanceColors.ToColor(ConsumedTier)"
                         Tooltip="@($"{ProcsConsumed} of {ProcsGained} procs spent.")">
                    procs spent
                </StatRow>
                <StatRow Value="@ProcsExpired.ToString("N0")"
                         Color="@PerformanceColors.ToColor(ExpiredTier)"
                         Tooltip="Procs that expired unused.">
                    procs expired unused
                </StatRow>
            </ChildContent>
        </StatCard>;

    private QualitativePerformance ConsumedTier =>
        ConsumedShare >= 0.9 ? QualitativePerformance.Perfect
            : ConsumedShare >= 0.75 ? QualitativePerformance.Good
            : ConsumedShare >= 0.5 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;

    private QualitativePerformance ExpiredTier =>
        ProcsExpired == 0 ? QualitativePerformance.Perfect
            : ExpiredShare < 0.1 ? QualitativePerformance.Good
            : ExpiredShare < 0.2 ? QualitativePerformance.Ok
            : QualitativePerformance.Fail;
}
