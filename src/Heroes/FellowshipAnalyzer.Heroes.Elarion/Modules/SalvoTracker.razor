@inherits Analyzer

@code {
    public override RenderFragment? Statistic => TotalHits > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Spells.LunarlightMarkDamage" />
            </Header>
            <ChildContent>
                <StatRow Value="@SalvoHits.ToString("N0")">
                    <SpellLink Spell="Spells.LunarlightMarkDamage" /> hits
                </StatRow>
                <StatRow Value="@EruptHits.ToString("N0")">
                    <SpellLink Spell="Spells.LunarlightMarkAoeDamage" /> hits
                </StatRow>
                <StatRow Value="@NumberFormat.Compact(TotalMarkDamage)"
                         Tooltip="Salvo and Erupt damage.">
                    damage from the mark
                </StatRow>
                <StatRow Value="@($"{DamageShare * 100:0.#}%")"
                         Tooltip="@($"{NumberFormat.Compact(TotalMarkDamage)} of {NumberFormat.Compact(TotalPlayerDamage)} total damage dealt.")">
                    of all damage dealt
                </StatRow>
            </ChildContent>
        </StatCard>;
}
