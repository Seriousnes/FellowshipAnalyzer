@using FellowshipAnalyzer.Core.Common.Spells

@if (Spell is not null)
{
    <div class="spell-icon @SizeClass" title="@TooltipTitle" data-tooltip-spell-id="@TooltipSpellId">
        <img src="@IconUrl" />
    </div>
}

@code {
    /// <summary>Pass a <see cref="Core.Common.Spells.Spell"/> object directly.</summary>
    [Parameter]
    public Spell? Spell { get; set; }

    /// <summary>Pass a spell ID to resolve via <see cref="SpellRegistry"/>.</summary>
    [Parameter]
    public int? SpellId { get; set; }

    /// <summary>Pass a <see cref="SpellbookAbility"/> — its <see cref="SpellbookAbility.PrimarySpell"/>
    /// is used directly.
    /// </summary>
    [Parameter]
    public SpellbookAbility? Ability { get; set; }

    /// <summary>Icon size. Defaults to <see cref="SpellIconSize.Medium"/>.</summary>
    [Parameter]
    public SpellIconSize Size { get; set; } = SpellIconSize.Medium;

    /// <summary>Suppress the API tooltip (e.g. when nested inside a <see cref="SpellLink"/>).</summary>
    [Parameter]
    public bool NoTooltip { get; set; }

    private string IconUrl => $"https://assets.rpglogs.com/img/fellowship/abilities/{Spell!.Icon}";

    private string SizeClass => Size switch
    {
        SpellIconSize.Small => "spell-icon--sm",
        SpellIconSize.Large => "spell-icon--lg",
        _ => ""
    };

    private string? TooltipTitle => NoTooltip ? null : Spell?.Name;
    private string? TooltipSpellId => NoTooltip ? null : Spell is Effect effect
        ? $"effect/{effect.Id}"
        : Spell is not null ? $"ability/{Spell.Id}" : null;

    protected override void OnParametersSet()
    {
        Spell ??= ResolveById(SpellId) ?? Ability?.PrimarySpell;
    }

    private static Spell? ResolveById(int? id) =>
        id.HasValue ? SpellRegistry.MaybeGet(id.Value) : null;
}