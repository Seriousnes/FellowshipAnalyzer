@using FellowshipAnalyzer.Core.Common.Spells
@using OneOf

@if (_icon is not { Length: 0 })
{
    <div class="spell-icon @SizeClass" data-tooltip-spell-id="@TooltipSpellId">
        <img src="@IconUrl" />
    </div>
}

@code {
    [Parameter, EditorRequired]
    public OneOf<Spell, int, SpellbookAbility, Ability> Spell { get; set; }

    /// <summary>Icon size. Defaults to <see cref="SpellIconSize.Medium"/>.</summary>
    [Parameter]
    public SpellIconSize Size { get; set; } = SpellIconSize.Medium;

    /// <summary>Suppress the API tooltip (e.g. when nested inside a <see cref="SpellLink"/>).</summary>
    [Parameter]
    public bool NoTooltip { get; set; }

    private string _name = "";
    private string _icon = "";
    private int _id;
    private bool _isEffect;

    private string IconUrl => $"https://assets.rpglogs.com/img/fellowship/abilities/{_icon}";

    private string SizeClass => Size switch
    {
        SpellIconSize.Small => "spell-icon--sm",
        SpellIconSize.Large => "spell-icon--lg",
        _ => ""
    };

    private string? TooltipSpellId => NoTooltip ? null : _isEffect
        ? $"effect/{_id}"
        : _id > 0 ? $"ability/{_id}" : null;

    protected override void OnParametersSet()
    {
        Spell.Switch(
            s => { _id = s.Id; _name = s.Name; _icon = s.Icon; _isEffect = s is Effect; },
            id => { var s = SpellRegistry.MaybeGet(id); _id = s?.Id ?? id; _name = s?.Name ?? ""; _icon = s?.Icon ?? ""; _isEffect = false; },
            a => { var s = a.PrimarySpell; _id = s.Id; _name = a.Name ?? s.Name; _icon = s.Icon; _isEffect = s is Effect; },
            a => { _id = a.Id; _name = a.Name; _icon = a.Icon; _isEffect = a.Guid >= 1_000_000; }
        );
    }
}