<div class="report-loading-screen">
    <h2 class="loading-title">LOADING...</h2>

    <div class="loading-bar" role="progressbar" aria-label="Loading progress"
         aria-valuenow="@((int)(Progress * 100))" aria-valuemin="0" aria-valuemax="100">
        @for (int i = 0; i < ChunkCount; i++)
        {
            var fill = ChunkFill(i);
            <div class="loading-bar-chunk">
                <div class="loading-bar-fill" style="opacity: @fill.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
            </div>
        }
    </div>

    <div class="loading-steps">
        @foreach (var step in Steps)
        {
            <div class="loading-row">
                <span class="loading-label">@step.Label</span>
                <span class="loading-status @StatusClass(step.Status)">@StatusText(step.Status)</span>
            </div>
        }
    </div>
</div>

@code {
    private const int ChunkCount = 12;

    public enum LoadingStepStatus { Waiting, Loading, Ok }

    public record LoadingStep(string Label, LoadingStepStatus Status);

    [Parameter, EditorRequired]
    public IReadOnlyList<LoadingStep> Steps { get; set; } = [];

    private double Progress =>
        Steps.Count == 0 ? 0 : (double)Steps.Count(s => s.Status == LoadingStepStatus.Ok) / Steps.Count;

    private double ChunkFill(int chunkIndex)
    {
        var chunkWidth = 1.0 / ChunkCount;
        var chunkStart = chunkIndex * chunkWidth;
        var chunkEnd = chunkStart + chunkWidth;
        if (Progress <= chunkStart) return 0;
        if (Progress >= chunkEnd) return 1;
        return (Progress - chunkStart) / chunkWidth;
    }

    private static string StatusClass(LoadingStepStatus status) => status switch
    {
        LoadingStepStatus.Ok => "ok",
        LoadingStepStatus.Loading => "loading",
        _ => "waiting",
    };

    private static string StatusText(LoadingStepStatus status) => status switch
    {
        LoadingStepStatus.Ok => "OK",
        LoadingStepStatus.Loading => "Loading...",
        _ => "Waiting",
    };
}
