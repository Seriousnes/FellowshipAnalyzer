@using FellowshipAnalyzer.Core.Analysis
@implements IDisposable

<div class="report-loading-screen">
    <h2 class="loading-title">LOADING...</h2>

    <div class="loading-bar" role="progressbar" aria-label="Loading progress"
         aria-valuenow="@((int)(Tracker.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
        @for (int i = 0; i < ChunkCount; i++)
        {
            var fill = ChunkFill(i);
            <div class="loading-bar-chunk">
                <div class="loading-bar-fill" style="opacity: @fill.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
            </div>
        }
    </div>

    <div class="loading-steps">
        <div class="loading-row">
            <span class="loading-label">Fetching combat events</span>
            <span class="loading-status @StatusClass(Tracker.FetchEventsState)">@StatusText(Tracker.FetchEventsState)</span>
        </div>
        <div class="loading-row">
            <span class="loading-label">Deserializing events</span>
            <span class="loading-status @StatusClass(Tracker.DeserializeState)">@StatusText(Tracker.DeserializeState)</span>
        </div>
        <div class="loading-row loading-row--has-sub">
            <div class="loading-row-header">
                <span class="loading-label">Normalizing events</span>
                <span class="loading-status @StatusClass(Tracker.NormalizeState)">@StatusText(Tracker.NormalizeState)</span>
            </div>
            @if (Tracker.NormalizeState == ReportLoadingTracker.StepState.Loading)
            {
                <div class="loading-sub-bar" role="progressbar"
                     aria-valuenow="@((int)(Tracker.NormalizeSubProgress * 100))" aria-valuemin="0" aria-valuemax="100">
                    @for (int i = 0; i < SubBarChunkCount; i++)
                    {
                        var fill = SubChunkFill(i, Tracker.NormalizeSubProgress);
                        <div class="loading-bar-chunk">
                            <div class="loading-bar-fill" style="opacity: @fill.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="loading-row loading-row--has-sub">
            <div class="loading-row-header">
                <span class="loading-label">@AnalyzeLabel</span>
                <span class="loading-status @StatusClass(Tracker.AnalyzeState)">@StatusText(Tracker.AnalyzeState)</span>
            </div>
            @if (Tracker.AnalyzeState == ReportLoadingTracker.StepState.Loading)
            {
                <div class="loading-sub-bar" role="progressbar"
                     aria-valuenow="@((int)(Tracker.AnalyzeSubProgress * 100))" aria-valuemin="0" aria-valuemax="100">
                    @for (int i = 0; i < SubBarChunkCount; i++)
                    {
                        var fill = SubChunkFill(i, Tracker.AnalyzeSubProgress);
                        <div class="loading-bar-chunk">
                            <div class="loading-bar-fill" style="opacity: @fill.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"></div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="loading-row">
            <span class="loading-label">Preparing display</span>
            <span class="loading-status @StatusClass(Tracker.PrepareDisplayState)">@StatusText(Tracker.PrepareDisplayState)</span>
        </div>
    </div>
</div>

@code {
    private const int ChunkCount = 12;
    private const int SubBarChunkCount = 8;
    private ReportLoadingTracker? _subscribedTracker;

    [Parameter, EditorRequired]
    public ReportLoadingTracker Tracker { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (_subscribedTracker == Tracker) return;

        if (_subscribedTracker is not null)
            _subscribedTracker.OnChanged -= StateHasChanged;

        _subscribedTracker = Tracker;
        Tracker.OnChanged += StateHasChanged;
    }

    public void Dispose()
    {
        if (_subscribedTracker is not null)
            _subscribedTracker.OnChanged -= StateHasChanged;
    }

    private string AnalyzeLabel => "Analyzing combat log";

    private double ChunkFill(int chunkIndex)
    {
        var chunkWidth = 1.0 / ChunkCount;
        var chunkStart = chunkIndex * chunkWidth;
        var chunkEnd = chunkStart + chunkWidth;
        var progress = Tracker.Progress;
        if (progress <= chunkStart) return 0;
        if (progress >= chunkEnd) return 1;
        return (progress - chunkStart) / chunkWidth;
    }

    private static double SubChunkFill(int chunkIndex, double subProgress)
    {
        var chunkWidth = 1.0 / SubBarChunkCount;
        var chunkStart = chunkIndex * chunkWidth;
        var chunkEnd = chunkStart + chunkWidth;
        if (subProgress <= chunkStart) return 0;
        if (subProgress >= chunkEnd) return 1;
        return (subProgress - chunkStart) / chunkWidth;
    }

    private static string StatusClass(ReportLoadingTracker.StepState state) => state switch
    {
        ReportLoadingTracker.StepState.Ok => "ok",
        ReportLoadingTracker.StepState.Loading => "loading",
        _ => "waiting",
    };

    private static string StatusText(ReportLoadingTracker.StepState state) => state switch
    {
        ReportLoadingTracker.StepState.Ok => "OK",
        ReportLoadingTracker.StepState.Loading => "Loading...",
        _ => "Waiting",
    };
}
