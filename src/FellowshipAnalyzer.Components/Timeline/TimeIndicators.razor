@using System.Globalization

<div class="time-indicators" style="width: @(TrackWidthPx.ToString("F1", CultureInfo.InvariantCulture))px">
    @{
        var totalSeconds = (int)Math.Ceiling(FightDurationMs / 1000.0);
    }
    @for (var sec = 0; sec < totalSeconds; sec++)
    {
        var leftPx = sec * PixelsPerSecond;
        var widthPx = Math.Min(PixelsPerSecond, TrackWidthPx - leftPx);
        <div class="time-second" style="left: @(leftPx.ToString("F1", CultureInfo.InvariantCulture))px; width: @(widthPx.ToString("F1", CultureInfo.InvariantCulture))px">
            <span class="time-second-label">@FormatSec(sec)</span>
            <div class="time-second-half-tick"></div>
        </div>
    }
</div>

@code {
    /// <summary>Total fight length in milliseconds.</summary>
    [Parameter, EditorRequired] public int FightDurationMs { get; set; }

    /// <summary>Horizontal scale factor — pixels rendered per second of fight time.</summary>
    [Parameter] public double PixelsPerSecond { get; set; } = 60.0;

    private double TrackWidthPx => (FightDurationMs / 1000.0) * PixelsPerSecond;

    private static string FormatSec(int sec)
    {
        var min = sec / 60;
        var s = sec % 60;
        return min > 0 ? $"{min}:{s:D2}" : $"{sec}s";
    }
}
