@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events

<div class="timeline">
    @{
        var abilities = Result.Modules.OfType<Abilities>().FirstOrDefault();
        var combatants = Result.Modules.OfType<Combatants>().FirstOrDefault();
        var allEvents = Result.Events;

        var playerSelfBuffs = combatants?.Selected?.Buffs
            .Where(b => b.TargetId == PlayerId && b.SourceId == PlayerId && !b.IsDebuff)
            .ToList() ?? [];
    }

    @if (allEvents.Count == 0)
    {
        <p class="timeline-empty">No event data available for this fight.</p>
    }
    else
    {
        var fightDurationMs = FightEndTime - FightStartTime;

        @* Cooldown rows — grouped by spell, ordered by TimelineSortIndex then event count *@
        var cooldownRows = allEvents
            .OfType<UpdateSpellUsableEvent>()
            .Where(e => e.SourceId == PlayerId)
            .GroupBy(e => e.Ability.Id)
            .Select(g => (
                Ability: abilities?.GetAbility(g.Key),
                Events: (IReadOnlyList<UpdateSpellUsableEvent>)[.. g.OrderBy(e => e.Timestamp)]
            ))
            .Where(r => r.Ability is not null)
            .Select(r => (r.Ability!, r.Events))
            .OrderBy(r => r.Item1.TimelineSortIndex ?? int.MaxValue)
            .ThenByDescending(r => r.Item2.Count)
            .ToList();

        <div class="timeline-inner">
            @* Consolidated cast bar with aura overlay *@
            <div class="timeline-row">
                <div class="timeline-label">
                    <span class="timeline-label__name">Casts</span>
                </div>
                <div class="timeline-cast-area">
                    @if (playerSelfBuffs.Count > 0)
                    {
                        <AuraBar Auras="@playerSelfBuffs"
                                 FightStartTime="@FightStartTime"
                                 FightEndTime="@FightEndTime"
                                 PixelsPerSecond="@PixelsPerSecond" />
                    }
                    <CastBar Events="@allEvents"
                             PlayerId="@PlayerId"
                             FightStartTime="@FightStartTime"
                             FightEndTime="@FightEndTime"
                             PixelsPerSecond="@PixelsPerSecond"
                             Abilities="@abilities" />
                </div>
            </div>

            @* Cooldowns section — one row per tracked spell *@
            @if (cooldownRows.Count > 0)
            {
                <div class="timeline-section-divider" style="margin-top: 24px;">
                    <div class="timeline-label">
                        <span class="timeline-label__name timeline-label__name--section">Cooldowns</span>
                    </div>
                    <div class="timeline-section-line" style="width: @((fightDurationMs / 1000.0 * PixelsPerSecond).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px;"></div>
                </div>

                @foreach (var (ability, cdEvents) in cooldownRows)
                {
                    <div class="timeline-row">
                        <div class="timeline-label">
                            <SpellLink Spell="@ability" />
                        </div>
                        <CooldownLane Ability="@ability"
                                      CooldownEvents="@cdEvents"
                                      FightStartTime="@FightStartTime"
                                      FightEndTime="@FightEndTime"
                                      PixelsPerSecond="@PixelsPerSecond" />
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>The completed analysis result containing all active modules.</summary>
    [Parameter, EditorRequired] public HeroAnalysisResult Result { get; set; } = null!;

    /// <summary>Absolute fight start timestamp in milliseconds.</summary>
    [Parameter, EditorRequired] public int FightStartTime { get; set; }

    /// <summary>Absolute fight end timestamp in milliseconds.</summary>
    [Parameter, EditorRequired] public int FightEndTime { get; set; }

    /// <summary>Pixels rendered per second of fight time. Default: 30 px/s (1 min = 1800 px).</summary>
    [Parameter] public double PixelsPerSecond { get; set; } = 60.0;

    /// <summary>The source ID of the analyzed player, used to filter events.</summary>
    [Parameter] public int PlayerId { get; set; }
}
