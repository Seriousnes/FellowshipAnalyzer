@using FellowshipAnalyzer.Core.Common.Spells
@using OneOf

<a href="@AbilityUrl" target="_blank" rel="noopener noreferrer"
   data-tooltip-spell-id="@TooltipSpellId" class="spell-link">
    @if (Icon)
    {
        <SpellIcon Spell="@Spell" Size="@IconSize" NoTooltip />
    }
    <span class="spell-link__name">@(_name ?? "Unknown Spell")</span>
</a>

@code {
    [Parameter, EditorRequired]
    public OneOf<Spell, int, SpellbookAbility, Ability> Spell { get; set; }

    /// <summary>Whether to render the spell icon alongside the name. Defaults to <c>true</c>.</summary>
    [Parameter]
    public bool Icon { get; set; } = true;

    /// <summary>Icon size when <see cref="Icon"/> is <c>true</c>. Defaults to <see cref="SpellIconSize.Small"/>.</summary>
    [Parameter]
    public SpellIconSize IconSize { get; set; } = SpellIconSize.Small;

    private int _id;
    private int _spellId;
    private string? _name;
    private string? _icon;

    private string LinkType => _id > 1_000_000
        ? $"effect/{_spellId}"
        : $"ability/{_spellId}";

    private string AbilityUrl => $"https://fellows.gg/{_id}";

    private string? TooltipSpellId => _spellId > 0 ? LinkType : null;

    protected override void OnParametersSet()
    {
        Spell.Switch(
            s => { _id = s.Guid; _spellId = s.Id; _name = s.Name; _icon = s.Icon; },
            id => { var s = SpellRegistry.MaybeGet(id); _id = s?.Guid ?? id; _spellId = s?.Id ?? id; _name = s?.Name; _icon = s?.Icon; },
            a => { var s = a.PrimarySpell; _id = s.Guid; _spellId = s.Id; _name = a.Name ?? s.Name; _icon = s.Icon; },
            a => { _id = a.Guid; _spellId = a.Id; _name = a.Name; _icon = a.Icon; }
        );
    }
}
