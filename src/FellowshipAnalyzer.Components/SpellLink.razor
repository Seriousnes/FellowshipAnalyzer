@using FellowshipAnalyzer.Core.Common.Spells
@using OneOf

<a href="@AbilityUrl" target="_blank" rel="noopener noreferrer"
   data-tooltip-spell-id="@TooltipSpellId" class="spell-link">
    @if (Icon)
    {
        <SpellIcon Spell="@_resolved" Size="@IconSize" NoTooltip />
    }
    <span class="spell-link__name">@(_resolved?.Name ?? "Unknown Spell")</span>
</a>

@code {
    /// <summary>Pass a <see cref="Core.Common.Spells.Spell"/> object directly.</summary>
    [Parameter]
    public OneOf<Spell, int, SpellbookAbility, Ability> Spell { get; set; }

    /// <summary>Whether to render the spell icon alongside the name. Defaults to <c>true</c>.</summary>
    [Parameter]
    public bool Icon { get; set; } = true;

    /// <summary>Icon size when <see cref="Icon"/> is <c>true</c>. Defaults to <see cref="SpellIconSize.Small"/>.</summary>
    [Parameter]
    public SpellIconSize IconSize { get; set; } = SpellIconSize.Small;

    private int id;
    private int spellId;
    private string _name;
    private string icon;

    private string LinkType => id > 1_000_000
        ? $"effect/{spellId}"
        : $"ability/{spellId}";

    private string AbilityUrl => $"https://fellows.gg/{id}";

    protected override void OnParametersSet()
    {
        
    }

    private static Spell? ResolveById(int? id) =>
        id.HasValue ? SpellRegistry.MaybeGet(id.Value) : null;
}
