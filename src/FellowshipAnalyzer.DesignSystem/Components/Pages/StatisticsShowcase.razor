@page "/statistics"
@using FellowshipAnalyzer.Core.Common.Spells.Rime

<PageTitle>Statistics components — Design System</PageTitle>

<h1>Statistic / StatCard / StatTile / StatisticsSectionTitle</h1>
<p class="lede">Containers used on the Statistics tab. <code>Statistic</code> is the outer panel; <code>StatCard</code> is a titled card; <code>StatTile</code> is a colored single-metric cell.</p>

<CodeExample Title="StatisticsSectionTitle" Code="@_titleCode">
    <Demo>
        <StatisticsSectionTitle Title="Damage" />
        <StatisticsSectionTitle Title="Healing">
            <Badge Variant="BadgeVariant.Neutral" Size="BadgeSize.Sm">aside</Badge>
        </StatisticsSectionTitle>
    </Demo>
</CodeExample>

<CodeExample Title="Statistic — outer card with optional tooltip"
             Code="@_statisticCode">
    <Demo>
        <Statistic>
            <ChildContent>
                <SpellValueText Spell="Spells.IceComet">12 casts</SpellValueText>
            </ChildContent>
        </Statistic>
        <Statistic TooltipTitle="Wasted orbs explanation">
            <ChildContent>
                <SpellValueText Spell="Spells.GlacialBlast">8 casts • 4 wasted Orbs</SpellValueText>
            </ChildContent>
            <Tooltip>
                <strong>Wasted Orbs</strong> are generated while you're already at the cap of 5.
            </Tooltip>
        </Statistic>
    </Demo>
</CodeExample>

<CodeExample Title="StatCard — titled section"
             Description="UltraWide spans the full statistics-tab grid; Wide spans half."
             Code="@_statCardCode">
    <Demo>
        <StatCard Title="Total casts">
            <SpellValueText Spell="Spells.FrostBolt">12</SpellValueText>
            <SpellValueText Spell="Spells.GlacialBlast">8</SpellValueText>
            <SpellValueText Spell="Spells.IceComet">3</SpellValueText>
        </StatCard>
        <StatCard Meta="2/2">
            <Header>
                <SpellLink Spell="Spells.GlacialBlast" />
            </Header>
            <Info>
                <p>
                    A spell header keeps its icon and name on one line, so the card reserves the
                    corner the info affordance occupies.
                </p>
            </Info>
            <ChildContent>
                <StatRow Value="8">casts</StatRow>
                <StatRow Value="4">wasted Orbs</StatRow>
            </ChildContent>
        </StatCard>
    </Demo>
</CodeExample>

<CodeExample Title="StatisticsPanel — masonry layout"
             Description="Cards pack vertically: short cards rise under taller neighbours. Wide spans two columns, UltraWide spans the row. Falls back to a plain content-height grid without JS."
             Code="@_panelCode">
    <Demo>
        <StatisticsPanel>
            <StatCard Title="Chronoshift">
                <Info>
                    <p>
                        Channeling Chronoshift grants 800% increased cooldown recovery, so every ability
                        on cooldown recovers 9&#215; faster for the duration of the channel.
                    </p>
                </Info>
                <ChildContent>
                <StatRow Value="270.3s"><SpellLink Spell="Spells.IceComet" /> cooldown recovered</StatRow>
                <StatRow Value="267.2s"><SpellLink Spell="Spells.GlacialBlast" /> cooldown recovered</StatRow>
                <StatRow Value="244.4s"><SpellLink Spell="Spells.FrostBolt" /> cooldown recovered</StatRow>
                <StatRow Value="111.3s"><SpellLink Spell="Spells.IceComet" /> cooldown recovered</StatRow>
                <StatRow Value="34.9s"><SpellLink Spell="Spells.GlacialBlast" /> cooldown recovered</StatRow>
                <StatRow Value="23.5s"><SpellLink Spell="Spells.FrostBolt" /> cooldown recovered</StatRow>
                </ChildContent>
            </StatCard>
            <StatCard Title="Rolling Flames">
                <StatRow Value="1835.4s">Searing Blaze reduction, 83% of 2199.8s generated</StatRow>
                <StatRow Value="417.7s">Infernal Wave reduction, 93% of 451.0s generated</StatRow>
            </StatCard>
            <StatCard Title="Reign of Fire">
                <StatRow Value="74">procs granted by Detonate</StatRow>
                <StatRow Value="0">Fire Ball charges wasted (proc at 2 charges)</StatRow>
                <StatRow Value="4">empowerments wasted (buff expired unused)</StatRow>
            </StatCard>
            <StatCard Title="Ashen Catalyst">
                <Info>
                    <p>
                        A one-row card still lets its detail escape past the card edge and paint over
                        the neighbour below.
                    </p>
                </Info>
                <ChildContent>
                    <StatRow Value="276s">cooldown reduction</StatRow>
                </ChildContent>
            </StatCard>
            <StatCard Title="Elemental Assault" Wide>
                <StatRow Value="43.2%"><SpellLink Spell="Spells.FrostBolt" /> Stormstrike</StatRow>
                <StatRow Value="45.4%"><SpellLink Spell="Spells.GlacialBlast" /> Lava Lash</StatRow>
            </StatCard>
            <StatCard Title="Thorim's Invocation">
                <StatRow Value="22">spells cast</StatRow>
            </StatCard>
            <StatCard Title="Spirit" UltraWide>
                <StatRow Value="3,031">damage per second, 1.1% of total</StatRow>
            </StatCard>
        </StatisticsPanel>
    </Demo>
</CodeExample>

<CodeExample Title="StatTile — colored single metric" Code="@_statTileCode">
    <Demo>
        <div class="showcase-row">
            <StatTile Color="@FaVar.Ice" Value="12" Label="Casts" />
            <StatTile Color="@FaVar.Amber" Value="4.2k" Label="DPS" Tooltip="Damage per second" />
            <StatTile Color="@FaVar.PerfFail" Value="3" Label="Wipes" />
        </div>
    </Demo>
</CodeExample>

