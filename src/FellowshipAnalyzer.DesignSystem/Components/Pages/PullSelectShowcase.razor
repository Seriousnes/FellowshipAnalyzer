@page "/pull-select"

<PageTitle>PullSelect - Design System</PageTitle>

<h1>PullSelect</h1>
<p class="lede">Single-select pull filter with prev/next steppers. A <code>null</code> value maps to "Entire Dungeon" (no clamp). Bind with <code>@@bind-Value</code>. Open the panel and use arrow keys, Home/End, Enter/Space, and Escape.</p>

<CodeExample Title="Default (Entire Dungeon)" Description="@Describe(_selected)" Code="@_basicCode">
    <Demo>
        <PullSelect Pulls="_pulls" DungeonStartTime="_dungeonStart" @bind-Value="_selected" />
    </Demo>
</CodeExample>

<CodeExample Title="Boss pull preselected" Description="@Describe(_bossSelected)" Code="@_presetCode">
    <Demo>
        <PullSelect Pulls="_pulls" DungeonStartTime="_dungeonStart" @bind-Value="_bossSelected" />
    </Demo>
</CodeExample>

<CodeExample Title="Steppers" Description="Prev/next walk the pull list; next from Entire Dungeon jumps to the first pull." Code="@_stepperCode">
    <Demo>
        <PullSelect Pulls="_pulls" DungeonStartTime="_dungeonStart" @bind-Value="_stepped" />
    </Demo>
</CodeExample>

@code {
    private const int _dungeonStart = 600_000;

    private static readonly List<PullStartEvent> _pulls =
    [
        MakePull(0, 101, "Gnarled Sentinels", 630_000, 685_000, PullKind.Multi, isBoss: false, kill: true),
        MakePull(1, 102, "Fungal Brood", 690_000, 742_000, PullKind.Multi, isBoss: false, kill: true),
        MakePull(2, 103, "Rotmaw", 760_000, 845_000, PullKind.Single, isBoss: true, kill: false),
        MakePull(3, 104, "Rotmaw", 860_000, 928_000, PullKind.Single, isBoss: true, kill: true),
        MakePull(4, 105, "Archsentinel of the Withered Vale", 940_000, 1_020_000, PullKind.Single, isBoss: true, kill: true),
    ];

    private static PullStartEvent MakePull(
        int index, int id, string name, int startTime, int endTime, PullKind targets, bool isBoss, bool kill) =>
        new()
        {
            Timestamp = startTime,
            End = new PullEndEvent { Timestamp = endTime },
            Index = index,
            Id = id,
            Name = name,
            Targets = targets,
            IsBoss = isBoss,
            Kill = kill,
        };

    private PullStartEvent? _selected;
    private PullStartEvent? _bossSelected = _pulls[2];
    private PullStartEvent? _stepped;

    private static string Describe(PullStartEvent? pull) =>
        pull is null
            ? "Selected: Entire Dungeon"
            : $"Selected: Pull #{pull.Index + 1}{(string.IsNullOrWhiteSpace(pull.Name) ? "" : $" - {pull.Name}")}";

    private const string _basicCode = """
<PullSelect Pulls="_pulls" DungeonStartTime="_dungeonStart" @bind-Value="_selected" />

@code {
    private const int _dungeonStart = 600_000;

    private static readonly List<PullStartEvent> _pulls =
    [
        new() { Timestamp = 630_000, End = new PullEndEvent { Timestamp = 685_000 }, Index = 0, Id = 101, Name = "Gnarled Sentinels", Targets = PullKind.Multi, IsBoss = false, Kill = true },
        new() { Timestamp = 760_000, End = new PullEndEvent { Timestamp = 845_000 }, Index = 2, Id = 103, Name = "Rotmaw", Targets = PullKind.Single, IsBoss = true, Kill = false },
    ];

    private PullStartEvent? _selected;
}
""";

    private const string _presetCode = """
<PullSelect Pulls="_pulls" DungeonStartTime="_dungeonStart" @bind-Value="_bossSelected" />

@code {
    private PullStartEvent? _bossSelected = _pulls[2];
}
""";

    private const string _stepperCode = """
<PullSelect Pulls="_pulls" DungeonStartTime="_dungeonStart" @bind-Value="_stepped" />

@code {
    private PullStartEvent? _stepped;
}
""";
}
