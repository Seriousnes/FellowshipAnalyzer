@page "/panels"

<PageTitle>Panels — Design System</PageTitle>

<h1>RoundedPanel / PerformanceRoundedPanel</h1>
<p class="lede">Inner data containers. <code>RoundedPanel</code> is the default; <code>PerformanceRoundedPanel</code> tints its inset shadow by performance tier.</p>

<CodeExample Title="RoundedPanel" Code="@_roundedCode">
    <Demo>
        <RoundedPanel>
            <p>Dark rounded data container — drop visualisations here.</p>
        </RoundedPanel>
    </Demo>
</CodeExample>

<CodeExample Title="RoundedPanel — start-aligned"
             Description="StartAligned anchors content to the top instead of stretching."
             Code="@_startAlignedCode">
    <Demo>
        <RoundedPanel StartAligned>
            <p>Content stays at the top.</p>
        </RoundedPanel>
    </Demo>
</CodeExample>

<CodeExample Title="PerformanceRoundedPanel — tier-tinted shadow" Code="@_perfPanelCode">
    <Demo>
        <PerformanceRoundedPanel Performance="QualitativePerformance.Perfect">
            <p>Perfect tier — green tint.</p>
        </PerformanceRoundedPanel>
        <PerformanceRoundedPanel Performance="QualitativePerformance.Good">
            <p>Good tier — blue tint.</p>
        </PerformanceRoundedPanel>
        <PerformanceRoundedPanel Performance="QualitativePerformance.Ok">
            <p>Ok tier — yellow tint.</p>
        </PerformanceRoundedPanel>
        <PerformanceRoundedPanel Performance="QualitativePerformance.Fail">
            <p>Fail tier — red tint.</p>
        </PerformanceRoundedPanel>
    </Demo>
</CodeExample>

@code {
    private const string _roundedCode = """
<RoundedPanel>
    <YourVisualization />
</RoundedPanel>
""";

    private const string _startAlignedCode = """
<RoundedPanel StartAligned>
    ...
</RoundedPanel>
""";

    private const string _perfPanelCode = """
<PerformanceRoundedPanel Performance="QualitativePerformance.Perfect">
    ...
</PerformanceRoundedPanel>
""";
}
