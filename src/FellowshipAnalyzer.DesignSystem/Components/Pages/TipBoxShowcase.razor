@page "/tip-box"

<PageTitle>TipBox - Design System</PageTitle>

<h1>TipBox / PerformanceTipBox</h1>
<p class="lede">Bordered callouts. <code>TipBox</code> takes one of five variants directly; <code>PerformanceTipBox</code> picks the variant from a <code>QualitativePerformance</code>.</p>

<CodeExample Title="Variants" Code="@_variantsCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Info" Title="Heads up">An informational note.</TipBox>
        <TipBox Variant="TipBoxVariant.Note" Title="Author note">A note from the analyzer author.</TipBox>
        <TipBox Variant="TipBoxVariant.Success" Title="Nice work">You did this well.</TipBox>
        <TipBox Variant="TipBoxVariant.Warning" Title="Watch out">Common pitfall ahead.</TipBox>
        <TipBox Variant="TipBoxVariant.Error" Title="Misplay">Avoid doing this.</TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Without title" Code="@_noTitleCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Info">Body-only TipBox without a heading.</TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Fill" Description="How much of the accent colour the background carries." Code="@_fillCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Warning" Fill="TipBoxFill.None">Left edge only, the default.</TipBox>
        <TipBox Variant="TipBoxVariant.Warning" Fill="TipBoxFill.Tint">Background and border tinted in the accent.</TipBox>
        <TipBox Variant="TipBoxVariant.Warning" Fill="TipBoxFill.Solid">Background filled, content set in whichever of black or white contrasts against the accent.</TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Solid across every variant" Code="@_solidCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Info" Fill="TipBoxFill.Solid" Title="Heads up">An informational note.</TipBox>
        <TipBox Variant="TipBoxVariant.Note" Fill="TipBoxFill.Solid" Title="Author note">A note from the analyzer author.</TipBox>
        <TipBox Variant="TipBoxVariant.Success" Fill="TipBoxFill.Solid" Title="Nice work">You did this well.</TipBox>
        <TipBox Variant="TipBoxVariant.Warning" Fill="TipBoxFill.Solid" Title="Watch out">Common pitfall ahead.</TipBox>
        <TipBox Variant="TipBoxVariant.Error" Fill="TipBoxFill.Solid" Title="Misplay">Avoid doing this.</TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Background override" Description="A token reference replaces the variant's accent colour." Code="@_backgroundCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Info" Fill="TipBoxFill.Tint" Background="@FaVar.HeroRime">Tinted in Rime's identity colour.</TipBox>
        <TipBox Variant="TipBoxVariant.Info" Fill="TipBoxFill.Solid" Background="@FaVar.Ice">Filled with the frost accent.</TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Hero guide warning" Description="The shape every hero guide opens with." Code="@_heroWarningCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Warning" Fill="TipBoxFill.Solid">
            <p>
                <HeroText Hero="HeroName.Gunde" Icon /> analysis is a work in progress. The information here is preliminary and may be incomplete or inaccurate. Please provide feedback to help improve the analysis.
            </p>
            <p>
                Analysis is written by <ContributorLink Contributor="@Contributors.Seriousnes" />, feel free to reach out to them with any questions or feedback.
            </p>
        </TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Hide icon" Code="@_noIconCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Success" HideIcon>No icon on this one.</TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="Custom icon"
             Description="Supply your own icon via the Icon slot."
             Code="@_customIconCode">
    <Demo>
        <TipBox Variant="TipBoxVariant.Info" Title="Custom icon">
            <Icon><Glyph Name="bulb" /></Icon>
            <ChildContent>An owl knows things.</ChildContent>
        </TipBox>
    </Demo>
</CodeExample>

<CodeExample Title="PerformanceTipBox" Code="@_perfTipCode">
    <Demo>
        <PerformanceTipBox Performance="QualitativePerformance.Perfect" Title="Perfect cast">
            You hit it at 2 Orbs - maximum value.
        </PerformanceTipBox>
        <PerformanceTipBox Performance="QualitativePerformance.Good" Title="Good cast">
            Solid timing.
        </PerformanceTipBox>
        <PerformanceTipBox Performance="QualitativePerformance.Ok" Title="Okay cast">
            You could have waited a moment longer.
        </PerformanceTipBox>
        <PerformanceTipBox Performance="QualitativePerformance.Fail" Title="Misplay">
            Cast at 0 Orbs - full waste.
        </PerformanceTipBox>
    </Demo>
</CodeExample>

