@page "/cast"
@using FellowshipAnalyzer.Core.Common.Spells.Rime

<PageTitle>CastOverview / CastSummary / CastDetail — Design System</PageTitle>

<h1>CastOverview / CastSummary / CastDetail</h1>
<p class="lede">High-level cast-quality views. Compose these around your analyzer's per-cast output.</p>

<CodeExample Title="CastOverview — 3-column stat grid"
             Description="Aggregate stats with optional tier colouring."
             Code="@_overviewCode">
    <Demo>
        <CastOverview Title="Winter Orb generation" Stats="@_overviewStats" />
    </Demo>
</CodeExample>

<CodeExample Title="CastSummary — distribution view"
             Description="Renders perf-badge counts + gradiated bar. Pass ShowBreakdown to drill into a PerformanceBoxRow."
             Code="@_summaryCode">
    <Demo>
        <CastSummary Title="Glacial Blast cast quality" Casts="@_evaluations" ShowBreakdown />
    </Demo>
</CodeExample>

<CodeExample Title="CastDetail — per-cast inspector"
             Description="Filterable timeline + per-cast stat tiles. Use arrow keys to navigate when focused. The filter row toggles which tiers appear."
             Code="@_detailCode">
    <Demo>
        <CastDetail Title="Glacial Blast"
                    Description="Cast at full Winter Orbs to maximise damage."
                    Casts="@_perCast" />
    </Demo>
</CodeExample>

@code {
    private static readonly IReadOnlyList<OverviewStat> _overviewStats =
    [
        new("47", "Orbs generated"),
        new("12", "Orbs wasted", Performance: QualitativePerformance.Fail),
        new("74%", "Efficiency", Performance: QualitativePerformance.Good),
        new("5.2", "Avg orbs at cast"),
    ];

    private static readonly IReadOnlyList<CastEvaluation> _evaluations = BuildEvaluations();

    private static IReadOnlyList<CastEvaluation> BuildEvaluations()
    {
        var list = new List<CastEvaluation>();
        for (var i = 0; i < 8; i++) list.Add(new(QualitativePerformance.Perfect, "Full Orbs", $"0:{12 + i * 9}"));
        for (var i = 0; i < 3; i++) list.Add(new(QualitativePerformance.Good, "Near-full Orbs", $"1:{5 + i * 7}"));
        for (var i = 0; i < 2; i++) list.Add(new(QualitativePerformance.Ok, "Mid Orbs", $"1:{30 + i * 8}"));
        list.Add(new(QualitativePerformance.Fail, "0 Orbs", "2:02"));
        return list;
    }

    private IReadOnlyList<PerCastData> _perCast = [];

    protected override void OnInitialized() => _perCast = BuildPerCast();

    private IReadOnlyList<PerCastData> BuildPerCast() =>
    [
        new()
        {
            Performance = QualitativePerformance.Perfect,
            Timestamp = "0:12",
            GroupContent = DeceitfulScholarBanner,
            Stats =
            [
                new("23k", "Damage"),
                new("2", "Orbs spent"),
                new("3", "Targets"),
                new("No", "Pyromania"),
                new("No", "Incinerate"),
            ],
            Sequence = _sequence,
            AdditionalContent = new AdditionalContent("Usage Notes", UsageNotes),
        },
        new()
        {
            Performance = QualitativePerformance.Good,
            Timestamp = "0:24",
            Stats =
            [
                new("19k", "Damage"),
                new("2", "Orbs spent"),
                new("2", "Targets"),
            ],
        },
        new()
        {
            Performance = QualitativePerformance.Ok,
            Timestamp = "0:48",
            Stats =
            [
                new("11k", "Damage", Performance: QualitativePerformance.Ok),
                new("1", "Orb spent"),
                new("1", "Target"),
            ],
        },
        new()
        {
            Performance = QualitativePerformance.Fail,
            Timestamp = "1:15",
            Stats =
            [
                new("0", "Damage", Performance: QualitativePerformance.Fail),
                new("0", "Orbs spent"),
                new("0", "Targets"),
            ],
        },
    ];

    private static readonly Pull _pull =
        new(5, 6, "Deceitful Scholar", 0, 0, PullKind.Single, IsBoss: true, Kill: true);

    private RenderFragment DeceitfulScholarBanner => @<PullBanner Pull="_pull" />;

    private RenderFragment UsageNotes =>
        @<div>Engulfing Flames held only 1 instance (the standard window stacks it twice).</div>;

    private static readonly SpellCastEntry[] _sequence =
    [
        new(Spells.FrostBolt.Id), new(Spells.BurstingIce.Id), new(Spells.GlacialBlast.Id),
        new(Spells.IceComet.Id), new(Spells.FrostBolt.Id), new(Spells.BurstingIce.Id),
    ];

    private const string _overviewCode = """
<CastOverview Title="Winter Orb generation" Stats="@_stats" />

@code {
    private static readonly IReadOnlyList<OverviewStat> _stats =
    [
        new("47", "Orbs generated"),
        new("12", "Orbs wasted", Performance: QualitativePerformance.Fail),
        new("74%", "Efficiency", Performance: QualitativePerformance.Good),
    ];
}
""";

    private const string _summaryCode = """
<CastSummary Title="Glacial Blast cast quality"
             Casts="@_evaluations"
             ShowBreakdown />

@code {
    private IEnumerable<CastEvaluation> _evaluations = ...;
}
""";

    private const string _detailCode = """
<CastDetail Title="Glacial Blast"
            Description="Cast at full Winter Orbs to maximise damage."
            Casts="@_perCast" />

@code {
    private IEnumerable<PerCastData> _perCast = ...;
}
""";
}
