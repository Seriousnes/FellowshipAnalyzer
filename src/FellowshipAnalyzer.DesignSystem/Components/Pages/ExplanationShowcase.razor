@page "/explanation"

<PageTitle>Explanation + HelperText - Design System</PageTitle>

<h1>Explanation / HelperText / WipGuide</h1>
<p class="lede">Prose primitives used inside guides.</p>

<CodeExample Title="Explanation"
             Description="Styled prose container - holds a GuideSection's why-it-matters, what-to-aim-for, what-the-table-shows copy."
             Code="@_explanationCode">
    <Demo>
        <Explanation>
            <p>Winter Orbs pay for everything Rime hits hard with, so a full pool is generation you never get back. The pool holds five, and Anima you generate at five is gone.</p>
            <p>Spend down to four before the next gain lands. The table shows the gains that arrived on a full pool, and how long the pool sat there.</p>
        </Explanation>
    </Demo>
</CodeExample>

<CodeExample Title="HelperText"
             Description="Inline italic muted micro-copy. Use under stats or visualisations."
             Code="@_helperCode">
    <Demo>
        <p><HelperText>Click any bar segment to filter the cast list below.</HelperText></p>
    </Demo>
</CodeExample>

<CodeExample Title="WipGuide"
             Description="Placeholder when a hero's analysis isn't implemented yet."
             Code="@_wipCode">
    <Demo>
        <WipGuide Hero="Ardeos" />
    </Demo>
</CodeExample>

@code {
    private const string _explanationCode = """
<LeftPanel>
    <p>Winter Orbs pay for everything Rime hits hard with...</p>
    <p>Spend down to four before the next gain lands. The table shows...</p>
</LeftPanel>
""";

    private const string _helperCode = """
<HelperText>Click any bar segment to filter the cast list below.</HelperText>
""";

    private const string _wipCode = """
<WipGuide Hero="Ardeos" />
""";
}
