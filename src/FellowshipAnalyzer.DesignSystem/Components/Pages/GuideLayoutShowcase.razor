@page "/guide-layout"

<PageTitle>Guide layout - Design System</PageTitle>

<h1>Section / SubSection / GuideSection / SideBySidePanels</h1>
<p class="lede">Top-level layout primitives that organize a hero's Guide tab. Compose these around your analysis data - never restyle them.</p>

<CodeExample Title="Section - top-level region"
             Description="Full-width band on the page background, titled in gold a step larger than a GuideSection title and expanded by default. Pass Expanded=false to start collapsed."
             Code="@_sectionCode">
    <Demo>
        <Section Title="Damage rotation">
            <p>Section body. Click the header to collapse.</p>
        </Section>
        <Section Title="Cooldown usage" Expanded="false">
            <p>This one starts collapsed.</p>
        </Section>
    </Demo>
</CodeExample>

<CodeExample Title="SubSection - grouping inside Section" Code="@_subSectionCode">
    <Demo>
        <Section Title="Damage analysis">
            <SubSection Title="Single-target rotation">
                <p>Body for single-target.</p>
            </SubSection>
            <SubSection Title="AOE rotation">
                <p>Body for AOE.</p>
            </SubSection>
        </Section>
    </Demo>
</CodeExample>

<CodeExample Title="GuideSection - explanation + data 2-column layout"
             Description="Left column explains the why, right column shows the data. LeftPanelPercent controls split."
             Code="@_guideSectionCode">
    <Demo>
        <GuideSection Title="Winter Orb Efficiency">
            <LeftPanel>                
                <p>Winter Orbs pay for everything Rime hits hard with, so a full pool is generation you never get back. Spend at four so the next gain has somewhere to land. The table shows the gains that arrived on a full pool.</p>                
            </LeftPanel>
            <RightPanel>
                <RoundedPanel>
                    <p>Data panel content here.</p>
                </RoundedPanel>
            </RightPanel>
        </GuideSection>
    </Demo>
</CodeExample>

<CodeExample Title="SideBySidePanels - equal horizontal layout" Code="@_sbsCode">
    <Demo>
        <SideBySidePanels>
            <RoundedPanel><p>Left panel</p></RoundedPanel>
            <RoundedPanel><p>Right panel</p></RoundedPanel>
        </SideBySidePanels>
    </Demo>
</CodeExample>

@code {
    private const string _sectionCode = """
<Section Title="Damage rotation">
    ...
</Section>

<Section Title="Cooldown usage" Expanded="false">
    ...
</Section>
""";

    private const string _subSectionCode = """
<Section Title="Damage analysis">
    <SubSection Title="Single-target rotation">...</SubSection>
    <SubSection Title="AOE rotation">...</SubSection>
</Section>
""";

    private const string _guideSectionCode = """
<GuideSection Title="Winter Orb Efficiency" LeftPanelPercent="40">
    <LeftPanel>
        <LeftPanel>
            <p>Winter Orbs pay for everything Rime hits hard with...</p>
        </LeftPanel>
    </LeftPanel>
    <RightPanel>
        <RoundedPanel>...</RoundedPanel>
    </RightPanel>
</GuideSection>
""";

    private const string _sbsCode = """
<SideBySidePanels>
    <RoundedPanel>...left...</RoundedPanel>
    <RoundedPanel>...right...</RoundedPanel>
</SideBySidePanels>
""";
}
