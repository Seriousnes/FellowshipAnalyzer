@page "/hero-icon"
@using FellowshipAnalyzer.Core.Analysis

<PageTitle>HeroIcon — Design System</PageTitle>

<h1>HeroIcon</h1>
<p class="lede">Renders a hero portrait from a strongly-typed <code>Hero</code> instance. Use <code>Avatar</code> instead if you need fallback content or accent rings.</p>

<CodeExample Title="All shipped heroes" Code="@_allHeroesCode">
    <Demo>
        <div class="showcase-row" style="gap: 0.5rem;">
            @foreach (var hero in Hero.All)
            {
                <HeroIcon Hero="hero" style="width: 48px; height: 48px; border-radius: 6px;" />
            }
        </div>
    </Demo>
</CodeExample>

<CodeExample Title="Custom size via splat" Code="@_sizeCode">
    <Demo>
        <div class="showcase-row">
            <HeroIcon Hero="Hero.Rime" style="width: 32px; height: 32px; border-radius: 4px;" />
            <HeroIcon Hero="Hero.Rime" style="width: 64px; height: 64px; border-radius: 8px;" />
            <HeroIcon Hero="Hero.Rime" style="width: 96px; height: 96px; border-radius: 12px;" />
        </div>
    </Demo>
</CodeExample>

@code {
    private const string _allHeroesCode = """
@foreach (var hero in Hero.All)
{
    <HeroIcon Hero="hero" style="width: 48px; height: 48px;" />
}
""";

    private const string _sizeCode = """
<HeroIcon Hero="Hero.Rime" style="width: 64px; height: 64px;" />
""";
}
