@page "/hero-icon"
@using FellowshipAnalyzer.Core.Analysis

<PageTitle>HeroIcon / HeroText - Design System</PageTitle>

<h1>HeroIcon / HeroText</h1>
<p class="lede">Renders a hero portrait from a strongly-typed <code>Hero</code> instance. Use <code>Avatar</code> instead if you need fallback content or accent rings.</p>

<CodeExample Title="All shipped heroes" Code="@_allHeroesCode">
    <Demo>
        <div class="showcase-row" style="gap: 0.5rem;">
            @foreach (var hero in Hero.All)
            {
                <HeroIcon Hero="hero" style="width: 48px; height: 48px; border-radius: 6px;" />
            }
        </div>
    </Demo>
</CodeExample>

<CodeExample Title="Custom size via splat" Code="@_sizeCode">
    <Demo>
        <div class="showcase-row">
            <HeroIcon Hero="Hero.Rime" style="width: 32px; height: 32px; border-radius: 4px;" />
            <HeroIcon Hero="Hero.Rime" style="width: 64px; height: 64px; border-radius: 8px;" />
            <HeroIcon Hero="Hero.Rime" style="width: 96px; height: 96px; border-radius: 12px;" />
        </div>
    </Demo>
</CodeExample>

<CodeExample Title="Inline portrait" Code="@_inlineCode">
    <Demo>
        <p>Sized to the surrounding text, so it sits on the line: <HeroIcon Hero="Hero.Rime" Inline /> Rime.</p>
    </Demo>
</CodeExample>

<h2>HeroText</h2>
<p class="lede">Sets its content in a hero's identity colour, optionally preceded by an inline portrait. Content defaults to the hero's name.</p>

<CodeExample Title="Hero-coloured text" Code="@_heroTextCode">
    <Demo>
        <p>Support was added for <HeroText Hero="HeroName.Helena">Helena</HeroText> and <HeroText Hero="HeroName.Sylvie">Sylvie</HeroText>.</p>
    </Demo>
</CodeExample>

<CodeExample Title="With an inline portrait" Code="@_heroTextIconCode">
    <Demo>
        @foreach (var hero in Hero.All)
        {
            <p><HeroText Hero="hero.Name" Icon /> analysis is a work in progress.</p>
        }
    </Demo>
</CodeExample>

@code {
    private const string _allHeroesCode = """
@foreach (var hero in Hero.All)
{
    <HeroIcon Hero="hero" style="width: 48px; height: 48px;" />
}
""";

    private const string _sizeCode = """
<HeroIcon Hero="Hero.Rime" style="width: 64px; height: 64px;" />
""";

    private const string _inlineCode = """
<p>Sits on the line: <HeroIcon Hero="Hero.Rime" Inline /> Rime.</p>
""";

    private const string _heroTextCode = """
Support was added for <HeroText Hero="HeroName.Helena">Helena</HeroText>.
""";

    private const string _heroTextIconCode = """
<HeroText Hero="HeroName.Ardeos" Icon /> analysis is a work in progress.
""";
}
