<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" />
    <script>
        (function () {
            var root = document.documentElement;
            var theme = null;
            var overrides = null;

            try {
                theme = localStorage.getItem('fa-theme');
                overrides = localStorage.getItem('fa-token-overrides');
            } catch (e) { }

            root.dataset.theme = theme || 'original';

            if (overrides) {
                try {
                    var tokens = JSON.parse(overrides);
                    Object.keys(tokens).forEach(function (name) {
                        root.style.setProperty('--fa-' + name, tokens[name]);
                    });
                } catch (e) { }
            }
        })();
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.45.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="@Assets["FellowshipAnalyzer.DesignSystem.styles.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <title>FellowshipAnalyzer Design System</title>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
