@* CodeExample — live demo + copyable source block, MudBlazor SectionContent-style. *@
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="code-example">
    @if (!string.IsNullOrEmpty(Title))
    {
        <header class="code-example-header">
            <h3>@Title</h3>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p>@Description</p>
            }
        </header>
    }
    else if (!string.IsNullOrEmpty(Description))
    {
        <p class="code-example-lede">@Description</p>
    }

    <div class="code-example-demo">
        @Demo
    </div>

    @if (!string.IsNullOrEmpty(Code))
    {
        <div class="code-example-source">
            <div class="code-example-toolbar">
                <span class="code-example-lang">@Language</span>
                <div class="code-example-actions">
                    <button type="button"
                            class="code-example-btn"
                            @onclick="ToggleAsync">
                        @(_expanded ? "Hide source" : "Show source")
                    </button>
                    <button type="button"
                            class="code-example-btn"
                            @onclick="CopyAsync"
                            disabled="@(!_expanded)">
                        @(_copied ? "Copied!" : "Copy")
                    </button>
                </div>
            </div>
            @if (_expanded)
            {
                <pre class="code-example-pre"><code class="language-@Language">@Code</code></pre>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Demo { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string Language { get; set; } = "razor";
    [Parameter] public bool DefaultExpanded { get; set; }

    private bool _expanded;
    private bool _copied;
    private bool _initialized;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _expanded = DefaultExpanded;
            _initialized = true;
        }
    }

    private void ToggleAsync()
    {
        _expanded = !_expanded;
        _copied = false;
    }

    private async Task CopyAsync()
    {
        if (string.IsNullOrEmpty(Code)) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./clipboard.js");
            var ok = await _module.InvokeAsync<bool>("copyText", Code);
            _copied = ok;
        }
        catch
        {
            _copied = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
