<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1574;CS1587</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="sasscompiler.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\..\data\spelldb.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.SassCompiler" />
		<PackageReference Include="Blazor-ApexCharts" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="OneOf" />
		<PackageReference Include="OneOf.SourceGenerator" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FellowshipAnalyzer.Analyzers\FellowshipAnalyzer.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\FellowshipAnalyzer.Generators\FellowshipAnalyzer.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\FellowshipAnalyzer.Core.Contracts\FellowshipAnalyzer.Core.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PaletteSource Include="$(MSBuildProjectDirectory)\..\FellowshipAnalyzer.Core.Contracts\Design\**\*.cs" />
	</ItemGroup>

	<Target Name="GeneratePaletteScss" BeforeTargets="Compile Sass"
	        Condition="'$(DesignTimeBuild)' != 'true'"
	        Inputs="@(PaletteSource)"
	        Outputs="$(IntermediateOutputPath)palette.stamp">
		<Exec Command="dotnet run --no-cache emit-palette.cs &quot;$(MSBuildProjectDirectory)\Styles\_palette.scss&quot;"
		      WorkingDirectory="$(MSBuildProjectDirectory)\..\FellowshipAnalyzer.Tools" />
		<Touch Files="$(IntermediateOutputPath)palette.stamp" AlwaysCreate="true" />
	</Target>

</Project>
