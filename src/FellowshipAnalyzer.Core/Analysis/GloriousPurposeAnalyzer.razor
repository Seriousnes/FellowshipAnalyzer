@inherits Analyzer

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic => Windows.Count > 0 || Activations > 0 ? Card : null;

    private RenderFragment Card =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Items.GloriousPurpose" />
            </Header>
            <Info>
                <p>
                    Bonus cooldown recovery each ability received from <SpellLink Spell="Items.FatedStrike" />.
                </p>
            </Info>
            <ChildContent>
                <CastOverview Title="Overview" Stats="@BuildOverviewStats()" />
                @if (RecoveryByAbility.Count == 0)
                {
                    <p class="glorious-purpose-empty">No cooldowns were recovered.</p>
                }
                else
                {
                    <table class="glorious-purpose-table">
                        <thead>
                            <tr>
                                <th scope="col">Ability</th>
                                <th scope="col" class="glorious-purpose-recovered">Recovered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ability in RecoveryByAbility)
                            {
                                <tr>
                                    <td><SpellLink Spell="ability.SpellId" /></td>
                                    <td class="glorious-purpose-recovered">@Seconds(ability.RecoveredMs)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </ChildContent>
        </StatCard>;

    private IEnumerable<OverviewStat> BuildOverviewStats() =>
    [
        new OverviewStat(
            $"{Activations}",
            "Casts",
            "Fated Strike casts over the run."),
        new OverviewStat(
            $"{Windows.Count}",
            "Windows",
            "Glorious Purpose windows."),
    ];

    private static string Seconds(int milliseconds) => $"{milliseconds / 1000d:0.0}s";
}
