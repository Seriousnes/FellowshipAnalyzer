@inherits Analyzer

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic =>
        @<StatCard>
            <Header>
                <SpellLink Spell="Spells.Chronoshift" />
            </Header>
            <Info>
                <p>
                    Channeling <SpellLink Spell="Spells.Chronoshift" /> grants 800% increased cooldown recovery,
                    so every ability on cooldown recovers 9&#215; faster for the duration of the channel. These are
                    the bonus reductions each ability received beyond its natural cooldown recovery.
                </p>
            </Info>
            <ChildContent>
                @if (RecoveryByAbility.Count == 0)
                {
                    <p class="chronoshift-empty">No cooldowns were recovered.</p>
                }
                else
                {
                    <table class="chronoshift-table">
                        <thead>
                            <tr>
                                <th scope="col">Ability</th>
                                <th scope="col" class="chronoshift-recovered">Recovered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ability in RecoveryByAbility)
                            {
                                <tr>
                                    <td><SpellLink Spell="ability.SpellId" /></td>
                                    <td class="chronoshift-recovered">@Seconds(ability.RecoveredMs)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </ChildContent>
        </StatCard>;

    private static string Seconds(int milliseconds) => $"{milliseconds / 1000d:0.0}s";
}
