@using static FellowshipAnalyzer.Core.Analysis.Changelog
@using static FellowshipAnalyzer.Core.Analysis.Contributors

@code {
    /// <summary>
    /// Framework-level changes not tied to a single hero. Rendered as the "Core" group in a
    /// contributor's contributions.
    /// </summary>
    public static readonly List<ChangelogEntry> Entries =
    [
        Change(new(2026, 10, 24), @<text>Links show each hero's own item for an item id several heroes share. Legendary links show the item's name. <ItemLink Item="@FellowshipAnalyzer.Core.Common.Items.Items.FragmentsOfFrozenTime" />, <ItemLink Item="@FellowshipAnalyzer.Core.Common.Items.Items.IceshapersBrand" /> and <ItemLink Item="@FellowshipAnalyzer.Core.Common.Items.Items.AncientIceshapersTome" /> show their current icons. <SpellLink Spell="FellowshipAnalyzer.Core.Common.Items.Items.Chronoshift" /> analysis runs for <ItemLink Item="@FellowshipAnalyzer.Core.Common.Items.Items.AshasChronoshiftSpire_Ardeos" />, <ItemLink Item="@FellowshipAnalyzer.Core.Common.Items.Items.AshasChronoshiftSpire_Rime" /> and <ItemLink Item="@FellowshipAnalyzer.Core.Common.Items.Items.AshasChronoshiftBow" /> on the hero they belong to.</text>, Seriousnes),
        Change(new(2026, 10, 23), @<text>Charges a talent or legendary grants now come from the game data, with Haste on their recovery. Maximum casts use your Haste on cast times, and a channel keeps its full duration. A cast with a cast time starts its global cooldown when the cast begins, and keeps it when cancelled. <SpellLink Spell="FellowshipAnalyzer.Core.Common.Items.Items.RepositoryOfFrozenLight" /> takes 0.3 seconds off its cooldown for each <SpellLink Spell="FellowshipAnalyzer.Core.Common.Items.Items.RepositoryOfFrozenLightBuff" /> stack left when the buff expires, and nothing when the buff is removed earlier. Healing per second of execution time counts a cast with a cast time from its start to its completion or the end of its global cooldown, whichever is later.</text>, Seriousnes),
        Change(new(2026, 10, 6), @<text>Reports from players with more than one empty gear slot, or the same item equipped twice, now load instead of failing with a duplicate key error.</text>, Seriousnes),
        Change(new(2026, 10, 3), @<text>Cooldown tracking can now be adjusted per hero, for abilities a hero can cast without starting their cooldown.</text>, Seriousnes),
        Change(new(2026, 10, 3), @<text>Pull requests now deploy to a temporary preview site so changes can be tested before they reach production.</text>, Seriousnes),
        Change(new(2026, 10, 2), @<text>Stat bonuses that never show in the log are now counted: gem traits from your gem power (raised while an Anomalous Residue lasts), set bonuses, The Monarch's cooldown speed for MAJOR abilities, and the Challenge and Ultimatum dungeon modifiers. Essence of the Virtuoso, Rune Rush, Shadow's Defeat, Storm's Fury, and Empowered Minion's Victory Rush are now tracked, and Adrenaline Rush and First Strike now read the right buffs.</text>, Seriousnes),
        Change(new(2026, 10, 2), @<text>The Philosopher now grants its Haste, Expertise, and Critical Strike, sized from your Spirit stat, and a blessing slotted on several items counts their levels together toward its tier.</text>, Seriousnes),
        Change(new(2026, 10, 2), @<text>Resource tracking now reads a change event for every change in a resource, so gains and spends come from one consistent source for every hero.</text>, Seriousnes),
        Change(new(2026, 8, 5), @<text>Add support for <HeroText Hero="HeroName.Helena">Helena</HeroText> and <HeroText Hero="HeroName.Sylvie">Sylvie</HeroText>.</text>, Seriousnes),
        Change(new(2026, 7, 10), @<text>Added hero support-status list and contributor profiles.</text>, Seriousnes),
    ];
}
