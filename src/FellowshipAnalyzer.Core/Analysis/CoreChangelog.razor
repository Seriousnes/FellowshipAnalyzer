@using static FellowshipAnalyzer.Core.Analysis.Changelog
@using static FellowshipAnalyzer.Core.Analysis.Contributors

@code {
    /// <summary>
    /// Framework-level changes not tied to a single hero. Rendered as the "Core" group in a
    /// contributor's contributions.
    /// </summary>
    public static readonly List<ChangelogEntry> Entries =
    [
        Change(new(2026, 10, 3), @<text>Pull requests now deploy to a temporary preview site so changes can be tested before they reach production.</text>, Seriousnes),
        Change(new(2026, 10, 2), @<text>Stat bonuses that never show in the log are now counted: gem traits from your gem power (raised while an Anomalous Residue lasts), set bonuses, The Monarch's cooldown speed for MAJOR abilities, and the Challenge and Ultimatum dungeon modifiers. Essence of the Virtuoso, Rune Rush, Shadow's Defeat, Storm's Fury, and Empowered Minion's Victory Rush are now tracked, and Adrenaline Rush and First Strike now read the right buffs.</text>, Seriousnes),
        Change(new(2026, 10, 2), @<text>The Philosopher now grants its Haste, Expertise, and Critical Strike, sized from your Spirit stat, and a blessing slotted on several items counts their levels together toward its tier.</text>, Seriousnes),
        Change(new(2026, 10, 2), @<text>Resource tracking now reads a change event for every change in a resource, so gains and spends come from one consistent source for every hero.</text>, Seriousnes),
        Change(new(2026, 8, 5), @<text>Add support for <HeroText Hero="HeroName.Helena">Helena</HeroText> and <HeroText Hero="HeroName.Sylvie">Sylvie</HeroText>.</text>, Seriousnes),
        Change(new(2026, 7, 10), @<text>Added hero support-status list and contributor profiles.</text>, Seriousnes),
    ];
}
