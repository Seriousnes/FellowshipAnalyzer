@using System.Globalization

<div class="time-indicators" style="width: @(TrackWidthPx.ToString("F1", CultureInfo.InvariantCulture))px">
    @{
        var totalSeconds = (int)Math.Ceiling(DungeonDurationMs / 1000.0);
    }
    @for (var sec = 0; sec < totalSeconds; sec++)
    {
        var leftPx = sec * PixelsPerSecond;
        var widthPx = Math.Min(PixelsPerSecond, TrackWidthPx - leftPx);
        <div class="time-second" style="left: @(leftPx.ToString("F1", CultureInfo.InvariantCulture))px; width: @(widthPx.ToString("F1", CultureInfo.InvariantCulture))px">
            <span class="time-second-label">@TimeFormat.Timestamp(sec * 1000L)</span>
            <div class="time-second-half-tick"></div>
        </div>
    }
</div>

@code {
    /// <summary>Total dungeon length in milliseconds.</summary>
    [Parameter, EditorRequired] public int DungeonDurationMs { get; set; }

    /// <summary>Horizontal scale factor - pixels rendered per second of dungeon time.</summary>
    [Parameter] public double PixelsPerSecond { get; set; } = 60.0;

    private double TrackWidthPx => (DungeonDurationMs / 1000.0) * PixelsPerSecond;
}
