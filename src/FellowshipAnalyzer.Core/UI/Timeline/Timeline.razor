@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events
@using Microsoft.JSInterop
@inherits ReportComponent
@implements IAsyncDisposable
@inject TimelineConfigService TimelineConfigService
@inject IJSRuntime JS

<div class="timeline">
    @{
        var abilities = Result.Modules.OfType<Abilities>().FirstOrDefault();
        var aurasModule = Result.Modules.OfType<Auras>().FirstOrDefault();
        var allEvents = Result.Events;

        var allPlayerAuras = Parser.SelectedCombatant.Buffs
            .Where(b => b.TargetId == PlayerId && !b.IsDebuff)
            .ToList() ?? [];

        var allCooldownGroups = allEvents
            .OfType<UpdateSpellUsableEvent>()
            .Where(e => e.SourceId == PlayerId)
            .GroupBy(e => e.Ability.Id)
            .Select(g => new
            {
                SpellId = g.Key,
                Ability = abilities?.GetAbility(g.Key),
                Events = (List<UpdateSpellUsableEvent>)[.. g.OrderBy(e => e.Timestamp)],
            })
            .Where(r => r.Ability is not null)
            .ToList();
    }

    @if (allEvents.Count == 0)
    {
        <p class="timeline-empty">No event data available for this dungeon.</p>
    }
    else
    {
        var windowStart = SelectedPull?.StartTime ?? DungeonStartTime;
        var windowEnd = SelectedPull?.EndTime ?? DungeonEndTime;

        var availableAuraOptions = allPlayerAuras
            .GroupBy(b => b.Ability.FSLID)
            .Select(g =>
            {
                var first = g.First();
                return new TimelineSpellOption(g.Key, first.Ability.Name, first.Ability.Icon);
            })
            .OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var availableCooldownOptions = allCooldownGroups
            .Select(r => new TimelineSpellOption(
                r.SpellId,
                r.Ability!.Name ?? r.Ability.PrimarySpell.Name,
                r.Ability.PrimarySpell.Icon))
            .OrderBy(o => o.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var visibleCooldownIds = _effectiveConfig.Cooldowns
            .Where(c => c.Visible)
            .ToDictionary(c => c.SpellId, c => c.SortOrder);

        var cooldownRows = allCooldownGroups
            .Where(r => visibleCooldownIds.ContainsKey(r.SpellId))
            .OrderBy(r => visibleCooldownIds[r.SpellId])
            .ThenByDescending(r => r.Events.Count)
            .Select(r => (r.Ability!, r.Events))
            .ToList();

        var visibleAuraIds = _effectiveConfig.Auras
            .Where(a => a.Visible)
            .Select(a => a.SpellId)
            .ToHashSet();

        var auraPriorities = _effectiveConfig.Auras
            .ToDictionary(a => a.SpellId, a => a.Priority);

        <div class="timeline-toolbar">
            <button type="button"
                    class="timeline-settings-button"
                    @onclick="() => _settingsOpen = true"
                    aria-label="Timeline settings"
                    title="Timeline settings">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
            </button>
        </div>

        <div class="timeline-scroll" @ref="_timelineScrollElement">
            <div class="timeline-inner">
            <div class="timeline-row">
                <div class="timeline-cast-area">
                    @if (allPlayerAuras.Count > 0)
                    {
                        <AuraBar Auras="@allPlayerAuras"
                                 DungeonStartTime="@DungeonStartTime"
                                 WindowStart="@windowStart"
                                 WindowEnd="@windowEnd"
                                 PixelsPerSecond="@PixelsPerSecond"
                                 VisibleAuraIds="@visibleAuraIds"
                                 AuraPriorities="@auraPriorities" />
                    }
                    <CastBar Events="@allEvents"
                             PlayerId="@PlayerId"
                             DungeonStartTime="@DungeonStartTime"
                             WindowStart="@windowStart"
                             WindowEnd="@windowEnd"
                             PixelsPerSecond="@PixelsPerSecond"
                             Abilities="@abilities" />
                </div>
            </div>

            @if (cooldownRows.Count > 0)
            {
                <div class="timeline-section-divider"></div>

                @foreach (var (ability, cdEvents) in cooldownRows)
                {
                    <div class="timeline-row">
                        <div class="timeline-label" style="z-index: 100">
                            <SpellIcon Spell="@ability" Size="SpellIconSize.Small" />
                        </div>
                        <CooldownLane Ability="@ability"
                                      CooldownEvents="@cdEvents"
                                      DungeonStartTime="@DungeonStartTime"
                                      WindowStart="@windowStart"
                                      WindowEnd="@windowEnd"
                                      PixelsPerSecond="@PixelsPerSecond" />
                    </div>
                }
            }
            </div>
        </div>

        var preconfiguredAuraIds = aurasModule?.TimelineHighlightedIds
            ?? [];

        <TimelineSettingsModal IsOpen="@_settingsOpen"
                               OnClose="() => _settingsOpen = false"
                               Config="@_effectiveConfig"
                               OnConfigChanged="OnConfigChangedAsync"
                               AvailableAuras="@availableAuraOptions"
                               AvailableCooldowns="@availableCooldownOptions"
                               PreconfiguredAuraIds="@preconfiguredAuraIds" />
    }
</div>

@code {
    /// <summary>Pixels rendered per second of dungeon time. Default: 30 px/s (1 min = 1800 px).</summary>
    [Parameter] public double PixelsPerSecond { get; set; } = 60.0;

    private TimelineConfig _effectiveConfig = new();
    private bool _settingsOpen;
    private string? _loadedHeroKey;
    private ElementReference _timelineScrollElement;
    private IJSObjectReference? _dragScrollModule;
    private IJSObjectReference? _dragScrollHandle;

    private int PlayerId => Owner.PlayerId;

    protected override async Task OnParametersSetAsync()
    {
        var heroKey = Result.Modules.OfType<Auras>().FirstOrDefault()?.Owner.Hero?.Id
            ?? Result.Modules.FirstOrDefault()?.Owner.Hero?.Id
            ?? "default";

        if (_loadedHeroKey != heroKey)
        {
            _effectiveConfig = BuildMergedConfig(new TimelineConfig());
            var stored = await TimelineConfigService.LoadAsync(heroKey);
            _effectiveConfig = BuildMergedConfig(stored);
            _loadedHeroKey = heroKey;
        }
        else
        {
            _effectiveConfig = BuildMergedConfig(_effectiveConfig);
        }
    }

    private TimelineConfig BuildMergedConfig(TimelineConfig stored)
    {
        var abilities = Result.Modules.OfType<Abilities>().FirstOrDefault();
        var aurasModule = Result.Modules.OfType<Auras>().FirstOrDefault();

        var allCooldownIds = Result.Events
            .OfType<UpdateSpellUsableEvent>()
            .Where(e => e.SourceId == PlayerId)
            .Select(e => e.Ability.Id)
            .Distinct()
            .Where(id => abilities?.GetAbility(id) is not null)
            .ToList();

        var defaultHighlights = aurasModule?.TimelineHighlightedIds
            ?? [];

        var cooldownDefaultSortIndices = allCooldownIds
            .ToDictionary(id => id, id => abilities?.GetAbility(id)?.TimelineSortIndex);

        return TimelineConfigService.MergeWithDefaults(
            stored,
            allCooldownIds,
            defaultHighlights,
            cooldownDefaultSortIndices);
    }

    private async Task OnConfigChangedAsync(TimelineConfig next)
    {
        _effectiveConfig = next;
        if (_loadedHeroKey is { } key)
        {
            await TimelineConfigService.SaveAsync(key, next);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dragScrollHandle is not null || Result.Events.Count == 0)
        {
            return;
        }

        _dragScrollModule = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/FellowshipAnalyzer.Core/timeline-drag-scroll.js");
        _dragScrollHandle = await _dragScrollModule.InvokeAsync<IJSObjectReference>("attach", _timelineScrollElement);
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragScrollHandle is not null)
        {
            await _dragScrollHandle.InvokeVoidAsync("dispose");
        }

        if (_dragScrollModule is not null)
        {
            await _dragScrollModule.DisposeAsync();
        }
    }
}
