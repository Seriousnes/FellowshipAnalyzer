@using System.Globalization
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events

<div class="cooldown-lane" style="position: relative; width: @(TrackWidthPx.ToString("F1", CultureInfo.InvariantCulture))px; height: 24px;">
    @foreach (var seg in _segments)
    {
        @if (seg.ShowIcon)
        {
            <div class="cooldown-lane-icon" style="left: @Px(seg.IconAt);">
                <SpellIcon Spell="@Ability" Size="SpellIconSize.Small" />
            </div>
        }
        @if (seg.End > seg.Start)
        {
            <div class="cooldown-lane-bar-wrap" style="left: @Px(seg.Start);">
                <div class="cooldown-lane-bar"
                     style="width: @DurPx(seg.End - seg.Start);"
                     title="@FormatDuration(seg.End - seg.Start) cooldown"></div>
            </div>
        }
    }
    @foreach (var ts in _chargeRestoreTimestamps)
    {
        <div class="cooldown-lane-restore" style="left: @Px(ts);" title="Charge restored at @FormatTimestamp(ts)"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SpellbookAbility Ability { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<UpdateSpellUsableEvent> CooldownEvents { get; set; } = [];
    [Parameter, EditorRequired] public int FightStartTime { get; set; }
    [Parameter, EditorRequired] public int FightEndTime { get; set; }
    [Parameter] public double PixelsPerSecond { get; set; } = 60.0;

    private sealed record CooldownSegment(int Start, int End, int IconAt, bool ShowIcon);

    private List<CooldownSegment> _segments = [];
    private List<int> _chargeRestoreTimestamps = [];

    private double TrackWidthPx => ((FightEndTime - FightStartTime) / 1000.0) * PixelsPerSecond;

    private string Px(int timestamp) =>
        ((timestamp - FightStartTime) / 1000.0 * PixelsPerSecond).ToString("F1", CultureInfo.InvariantCulture) + "px";

    private string DurPx(int durationMs) =>
        (durationMs / 1000.0 * PixelsPerSecond).ToString("F1", CultureInfo.InvariantCulture) + "px";

    private string FormatTimestamp(int timestamp)
    {
        var totalSec = (timestamp - FightStartTime) / 1000;
        var min = totalSec / 60;
        var sec = totalSec % 60;
        return min > 0 ? $"{min}:{sec:D2}" : $"{sec}s";
    }

    private static string FormatDuration(int durationMs)
    {
        var seconds = durationMs / 1000.0;
        return $"{seconds:F1}s";
    }

    protected override void OnParametersSet()
    {
        _segments = [];
        _chargeRestoreTimestamps = [];

        foreach (var e in CooldownEvents)
        {
            switch (e.UpdateType)
            {
                case UpdateSpellUsableType.BeginCooldown:
                    _segments.Add(new(e.ChargeStartTimestamp, e.ExpectedRechargeTimestamp, e.Timestamp, ShowIcon: true));
                    break;

                case UpdateSpellUsableType.UseCharge:
                    _segments.Add(new(e.Timestamp, e.Timestamp, e.Timestamp, ShowIcon: true));
                    break;

                case UpdateSpellUsableType.RestoreCharge:
                    _chargeRestoreTimestamps.Add(e.Timestamp);
                    if (e.IsOnCooldown)
                        _segments.Add(new(e.Timestamp, e.ExpectedRechargeTimestamp, e.Timestamp, ShowIcon: false));
                    break;

                // EndCooldown has no additional visual segments
            }
        }
    }
}
