@using System.Globalization
@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Core.Events

<div class="aura-bar" style="position: relative; width: @F(TrackWidthPx)px; height: @F(BarHeightPx)px; overflow: visible;">
    @foreach (var aura in _auras)
    {
        var left = OffsetPx(aura.ClippedStart);
        var width = DurPx(aura.ClippedEnd - aura.ClippedStart);

        @* Duration strip — spans the buff's active window *@
        <div class="aura-bar-strip"
             style="left: @left; width: @width; --level: @aura.Level;"
             title="@aura.Name — @FormatDuration(aura.ClippedEnd - aura.ClippedStart)"></div>

        @* Indicator line — sibling of icon, at left edge of the 24px icon *@
        <div class="aura-bar-indicator" style="left: @OffsetPx(aura.IconAt); --level: @aura.Level;"></div>

        @* Icon left-aligned to apply timestamp *@
        <div class="aura-bar-icon" style="left: @OffsetPx(aura.IconAt); --level: @aura.Level;"
             title="@aura.Name applied at @FormatTimestamp(aura.AppliedAt)">
            <SpellIcon Spell="@aura.Spell" Size="SpellIconSize.Small" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TrackedBuffEvent> Auras { get; set; } = [];

    /// <summary>True fight start, used as the origin for tooltip timestamps so they stay fight-relative.</summary>
    [Parameter, EditorRequired] public int FightStartTime { get; set; }

    /// <summary>Render-window start (selected pull start, or fight start). Geometry and clip origin.</summary>
    [Parameter, EditorRequired] public int WindowStart { get; set; }

    /// <summary>Render-window end (selected pull end, or fight end). Geometry and clip extent.</summary>
    [Parameter, EditorRequired] public int WindowEnd { get; set; }

    [Parameter] public double PixelsPerSecond { get; set; } = 60.0;

    /// <summary>
    /// When provided, only auras whose spell ID appears in this set are rendered.
    /// When null, all auras are rendered (backward-compatible default).
    /// </summary>
    [Parameter] public IReadOnlySet<int>? HighlightedSpellIds { get; set; }

    /// <summary>
    /// When provided, only auras whose spell ID appears in this set are rendered.
    /// Takes precedence over <see cref="HighlightedSpellIds"/> when both are set.
    /// </summary>
    [Parameter] public IReadOnlySet<int>? VisibleAuraIds { get; set; }

    /// <summary>
    /// Optional per-spell priority used for vertical level assignment. Lower priority = lower level
    /// (closer to the cast bar). Defaults to 0 for any spell not present in the dictionary.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<int, int>? AuraPriorities { get; set; }

    private sealed record AuraSegment(
        Spell Spell,
        string Name,
        int ClippedStart,
        int ClippedEnd,
        int IconAt,
        int AppliedAt,
        int Level);

    private List<AuraSegment> _auras = [];
    private int _maxLevel;

    private double TrackWidthPx => (WindowEnd - WindowStart) / 1000.0 * PixelsPerSecond;

    // 4px gap + 24px icon + 30px per additional level above 0
    private double BarHeightPx => 4.0 + 24.0 + _maxLevel * 30.0;

    private string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);
    private string OffsetPx(int ts) => F((ts - WindowStart) / 1000.0 * PixelsPerSecond) + "px";
    private string DurPx(int ms) => F(ms / 1000.0 * PixelsPerSecond) + "px";

    private string FormatTimestamp(int ts)
    {
        var totalSec = (ts - FightStartTime) / 1000;
        var min = totalSec / 60;
        var sec = totalSec % 60;
        return min > 0 ? $"{min}:{sec:D2}" : $"{sec}s";
    }

    private static string FormatDuration(int ms)
    {
        var seconds = ms / 1000.0;
        return $"{seconds:F1}s";
    }

    /// <summary>
    /// Returns the auras to render. <see cref="VisibleAuraIds"/> takes precedence over
    /// <see cref="HighlightedSpellIds"/>; when both are null, all auras are returned.
    /// </summary>
    private IEnumerable<TrackedBuffEvent> AurasToRender()
    {
        if (VisibleAuraIds is not null)
        {
            return Auras.Where(b => VisibleAuraIds.Contains(b.Ability.FSLID));
        }
        if (HighlightedSpellIds is not null)
        {
            return Auras.Where(b => HighlightedSpellIds.Contains(b.Ability.FSLID));
        }
        return Auras;
    }

    private int PriorityOf(TrackedBuffEvent buff) =>
        AuraPriorities is not null && AuraPriorities.TryGetValue(buff.Ability.FSLID, out var p) ? p : 0;

    protected override void OnParametersSet()
    {
        _auras = [];
        _maxLevel = 0;

        // Track the end-timestamp of the aura occupying each level, so we can
        // reuse levels that are no longer active (greedy level-assignment).
        var levelEnds = new List<int>();

        var visible = AurasToRender()
            .Where(b => b.Start < WindowEnd && (b.End ?? WindowEnd) > WindowStart)
            .OrderBy(PriorityOf)
            .ThenBy(b => b.Start);

        foreach (var buff in visible)
        {
            var clippedStart = Math.Max(buff.Start, WindowStart);
            var clippedEnd = Math.Min(buff.End ?? WindowEnd, WindowEnd);
            var iconAt = Math.Max(buff.Start, WindowStart);

            // Find the lowest level that is free at this aura's start time
            int level = 0;
            while (level < levelEnds.Count && levelEnds[level] > clippedStart)
                level++;

            // Reserve this level until the aura ends
            if (level < levelEnds.Count)
                levelEnds[level] = clippedEnd;
            else
                levelEnds.Add(clippedEnd);

            _maxLevel = Math.Max(_maxLevel, level);

            _auras.Add(new AuraSegment(
                Spell: Spell.FromFSLID(buff.Ability.FSLID, buff.Ability.Name, buff.Ability.Icon),
                Name: buff.Ability.Name,
                ClippedStart: clippedStart,
                ClippedEnd: clippedEnd,
                IconAt: iconAt,
                AppliedAt: buff.Start,
                Level: level));
        }
    }
}
