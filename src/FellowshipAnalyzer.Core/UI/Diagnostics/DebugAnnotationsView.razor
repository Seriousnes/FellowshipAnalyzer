@using FellowshipAnalyzer.Core.Events
@using System.Text.Json
@inherits ReportComponent

@if (DebugAnnotations is null || !DebugAnnotations.GetAll().Any())
{
    <div class="da-empty">No debug annotations were recorded during this analysis.</div>
}
else
{
    var scopedModules = DebugAnnotations.GetAll()
        .Select(annotations => (Annotations: annotations, Events: FilterToSelectedPull(annotations.AnnotatedEvents)))
        .Where(entry => entry.Events.Count > 0)
        .ToList();

    if (scopedModules.Count == 0)
    {
        <div class="da-empty">
            @(SelectedPull is null
                ? "No debug annotations were recorded during this analysis."
                : "No debug annotations were recorded for the selected pull.")
        </div>
    }
    else
    {
    <div class="da-view">
        @foreach (var (moduleAnnotations, scopedEvents) in scopedModules)
        {
                <div class="da-module">
                    <div class="da-module-header">
                        <h3 class="da-module-title">@moduleAnnotations.Module.GetType().Name</h3>
                        <span class="da-module-count">@scopedEvents.Count events annotated</span>
                    </div>

                    <div class="da-dot-container">
                        @foreach (var row in GroupByMinute(scopedEvents))
                        {
                            <div class="da-row">
                                <span class="da-row-label">@FormatMinute(row.MinuteIndex)</span>
                                <div class="da-row-dots">
                                    @foreach (var annotatedEvent in row.Events)
                                    {
                                        var topAnnotation = GetTopAnnotation(annotatedEvent.Annotations);
                                        var isSelected = _selectedEvent == annotatedEvent;
                                        <button class="da-dot @(isSelected ? "selected" : "")"
                                                style="background-color: @topAnnotation.Color; border-color: @(isSelected ? SelectedRing : topAnnotation.Color)"
                                                title="@(FormatTime(annotatedEvent.Event.Timestamp)) - @topAnnotation.Summary"
                                                @onclick="() => SelectEvent(annotatedEvent)">
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (_selectedEvent is not null && scopedEvents.Contains(_selectedEvent))
                    {
                        <div class="da-detail">
                            <div class="da-detail-header">
                                <h4>Event Details</h4>
                                <button class="da-clear-btn" @onclick="ClearSelection">Clear selection</button>
                            </div>
                            <div class="da-detail-columns">
                                <div class="da-detail-meta">
                                    <dl>
                                        <dt>Time</dt>
                                        <dd>@FormatTime(_selectedEvent.Event.Timestamp)</dd>
                                        <dt>Type</dt>
                                        <dd class="da-type">@GetTypeName(_selectedEvent.Event)</dd>
                                        @if (_selectedEvent.Event is IAbilityEvent ae)
                                        {
                                            <dt>Ability</dt>
                                            <dd>
                                                @ae.Ability?.Name <small>(@ae.Ability?.Id)</small>
                                                @if (ae.Ability is not null)
                                                {
                                                    <CopySpellDefinition Spell="ae.Ability" />
                                                }
                                            </dd>
                                        }
                                        @if (_selectedEvent.Event is IHasSourceEvent src)
                                        {
                                            <dt>Source</dt>
                                            <dd>@src.SourceId</dd>
                                        }
                                        @if (_selectedEvent.Event is IHasTargetEvent tgt)
                                        {
                                            <dt>Target</dt>
                                            <dd>@tgt.TargetId</dd>
                                        }
                                    </dl>

                                    @foreach (var annotation in _selectedEvent.Annotations)
                                    {
                                        <div class="da-annotation" style="border-left-color: @annotation.Color">
                                            <div class="da-annotation-summary" style="color: @annotation.Color">
                                                @annotation.Summary
                                            </div>
                                            @if (annotation.Details is not null)
                                            {
                                                <div class="da-annotation-details">@annotation.Details</div>
                                            }
                                        </div>
                                    }
                                </div>
                                <pre class="da-json">@GetEventJson(_selectedEvent.Event)</pre>
                            </div>
                        </div>
                    }
                </div>
        }
    </div>
    }
}

@code {
    /// <summary>Token reference the selected dot's border wears, so no colour literal reaches markup.</summary>
    private static readonly string SelectedRing = FaVar.White;

    [Parameter, EditorRequired] public DebugAnnotations? DebugAnnotations { get; set; }

    private AnnotatedEvent? _selectedEvent;

    protected override void OnParametersSet()
    {
        if (_selectedEvent is not null && SelectedPull is not null &&
            (_selectedEvent.Event.Timestamp < SelectedPull.StartTime || _selectedEvent.Event.Timestamp > SelectedPull.EndTime))
        {
            _selectedEvent = null;
        }
    }

    private void SelectEvent(AnnotatedEvent annotatedEvent)
    {
        _selectedEvent = _selectedEvent == annotatedEvent ? null : annotatedEvent;
    }

    private void ClearSelection() => _selectedEvent = null;

    private IReadOnlyList<AnnotatedEvent> FilterToSelectedPull(IReadOnlyList<AnnotatedEvent> events)
    {
        var pull = SelectedPull;
        return pull is null
            ? events
            : events.Where(ae => ae.Event.Timestamp >= pull.StartTime && ae.Event.Timestamp <= pull.EndTime).ToList();
    }

    private string FormatTime(int timestamp)
    {
        var ms = timestamp - FightStartTime;
        var totalSec = Math.Abs(ms) / 1000.0;
        var min = (int)(totalSec / 60);
        var sec = (int)(totalSec % 60);
        return $"{(ms < 0 ? "-" : "")}{min}:{sec:D2}";
    }

    private string FormatMinute(int minuteIndex) => $"{minuteIndex}:00";

    private static DebugAnnotation GetTopAnnotation(IReadOnlyList<DebugAnnotation> annotations) =>
        annotations.MaxBy(a => a.Priority) ?? annotations[0];

    private static string GetTypeName(Event e)
    {
        var name = e.GetType().Name;
        return name.EndsWith("Event") ? name[..^5] : name;
    }

    private static readonly JsonSerializerOptions _jsonOptions = new() { WriteIndented = true };

    private static string GetEventJson(Event e)
    {
        try
        {
            return JsonSerializer.Serialize(e, e.GetType(), _jsonOptions);
        }
        catch
        {
            return "{ \"error\": \"Unable to serialize event\" }";
        }
    }

    private sealed record MinuteRow(int MinuteIndex, IReadOnlyList<AnnotatedEvent> Events);

    private IEnumerable<MinuteRow> GroupByMinute(IReadOnlyList<AnnotatedEvent> events)
    {
        if (events.Count == 0) yield break;

        var byMinute = events
            .GroupBy(ae => (ae.Event.Timestamp - FightStartTime) / 60_000)
            .OrderBy(g => g.Key);

        foreach (var group in byMinute)
            yield return new MinuteRow(group.Key, [.. group]);
    }
}
