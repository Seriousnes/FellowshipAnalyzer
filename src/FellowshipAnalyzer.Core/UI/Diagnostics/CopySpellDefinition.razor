@using FellowshipAnalyzer.Core.Common.Spells
@using FellowshipAnalyzer.Core.Events
@using Microsoft.JSInterop
@using OneOf
@inject IJSRuntime JS

<button type="button" class="copy-spell-link" @onclick="Copy">@Label</button>
@if (_status is not null)
{
    <span class="copy-spell-status @(_failed ? "failed" : "ok")">@_status</span>
}

@code {
    [Parameter, EditorRequired]
    public OneOf<Spell, int, SpellbookAbility, Ability> Spell { get; set; }

    [Parameter] public string Label { get; set; } = "(copy definition)";

    private int _id;
    private SpellKind _kind;
    private string _name = "";
    private string _icon = "";

    private string? _status;
    private bool _failed;

    protected override void OnParametersSet()
    {
        Spell.Switch(
            s => { _id = s.Id; _kind = s.FSLID.Kind; _name = s.Name; _icon = s.Icon; },
            id =>
            {
                var s = SpellRegistry.MaybeGet(id);
                if (s is not null)
                {
                    _id = s.Id; _kind = s.FSLID.Kind; _name = s.Name; _icon = s.Icon;
                }
                else
                {
                    FSLID fslid = id;
                    _id = fslid.NativeId; _kind = fslid.Kind; _name = ""; _icon = "";
                }
            },
            a => { var s = a.PrimarySpell; _id = s.Id; _kind = s.FSLID.Kind; _name = a.Name ?? s.Name; _icon = s.Icon; },
            a => { _id = a.FSLID.NativeId; _kind = a.FSLID.Kind; _name = a.Name ?? ""; _icon = a.Icon ?? ""; }
        );

        _status = null;
        _failed = false;
    }

    private async Task Copy()
    {
        var text = BuildText(_id, _kind, _name, _icon);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _status = "copied!";
            _failed = false;
        }
        catch
        {
            _status = "copy failed";
            _failed = true;
        }
    }

    private static string TypeName(SpellKind kind) => kind switch
    {
        SpellKind.Effect => "Effect",
        SpellKind.Talent => "Talent",
        SpellKind.Weapon => "Weapon",
        _ => "Spell",
    };

    internal static string BuildText(int id, SpellKind kind, string name, string icon)
    {
        var typeKeyword = TypeName(kind);
        var identifier = ToPascalIdentifier(name, id);
        return $"public static {typeKeyword} {identifier} {{ get; }} = new({id}, \"{EscapeForString(name)}\", \"{EscapeForString(icon)}\");";
    }

    internal static string ToPascalIdentifier(string name, int fallbackId)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return $"Spell{fallbackId}";
        }

        var sb = new System.Text.StringBuilder(name.Length);
        var capitalizeNext = true;
        foreach (var ch in name)
        {
            if (char.IsLetter(ch))
            {
                sb.Append(capitalizeNext ? char.ToUpperInvariant(ch) : ch);
                capitalizeNext = false;
            }
            else
            {
                capitalizeNext = true;
            }
        }

        var result = sb.ToString();
        return result.Length == 0 ? $"Spell{fallbackId}" : result;
    }

    private static string EscapeForString(string value)
        => value.Replace("\\", "\\\\").Replace("\"", "\\\"");
}
