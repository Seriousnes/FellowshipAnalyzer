@inherits AnalyzerStatistic<ChronoshiftAnalyzer>

<StatCard>
    <Header>
        <SpellLink Spell="Spells.Chronoshift" />
    </Header>
    <Info>
        <p>
            Channeling <SpellLink Spell="Spells.Chronoshift" /> grants 800% increased cooldown recovery,
            so every ability on cooldown recovers 9&#215; faster for the duration of the channel. These are
            the bonus reductions each ability received beyond its natural cooldown recovery.
        </p>
    </Info>
    <ChildContent>
        @if (Analyzer.RecoveryByAbility.Count == 0)
        {
            <StatRow Value="0s">no cooldowns were recovered</StatRow>
        }
        else
        {
            @foreach (var ability in Analyzer.RecoveryByAbility)
            {
                <StatRow Value="@Seconds(ability.RecoveredMs)">
                    <SpellLink Spell="ability.SpellId" /> cooldown recovered
                </StatRow>
            }
        }
    </ChildContent>
</StatCard>

@code {
    private static string Seconds(int milliseconds) => $"{milliseconds / 1000d:0.0}s";
}
