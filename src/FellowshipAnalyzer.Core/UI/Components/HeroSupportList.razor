@using FellowshipAnalyzer.Core.Analysis
@inject IHeroConfigCatalog Catalog

<div class="hero-support">
    @foreach (var role in RoleOrder)
    {
        var heroes = _byRole[role];
        @if (heroes.Count > 0)
        {
            <div class="hero-support-group">
                <h3 class="hero-support-group-title">@RoleLabel(role)</h3>
                <div class="hero-support-grid">
                    @foreach (var hero in heroes)
                    {
                        <HeroSupportCard Entry="hero" />
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private static readonly HeroRole[] RoleOrder = [HeroRole.Tank, HeroRole.Healer, HeroRole.Dps];

    private Dictionary<HeroRole, List<HeroConfigEntry>> _byRole = new();

    protected override void OnInitialized() =>
        _byRole = RoleOrder.ToDictionary(
            role => role,
            role => (List<HeroConfigEntry>)
                [.. Catalog.Heroes
                    .Where(e => Hero.For(e.Hero).Role == role)
                    .OrderByDescending(e => e.Config.Support)
                    .ThenBy(e => e.Hero.ToString(), StringComparer.Ordinal)]);

    private static string RoleLabel(HeroRole role) => role switch
    {
        HeroRole.Tank => "Tanks",
        HeroRole.Healer => "Healers",
        HeroRole.Dps => "DPS",
        _ => "Other",
    };
}
