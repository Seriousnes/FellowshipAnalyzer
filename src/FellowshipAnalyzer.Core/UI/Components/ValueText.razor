<div class="spell-value-text">
    <label class="spell-value-text-label">
        @Label
    </label>
    <div class="spell-value-text-value">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment Label { get; set; } = null!;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
