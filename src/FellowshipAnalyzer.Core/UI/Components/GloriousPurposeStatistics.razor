@inherits AnalyzerStatistic<GloriousPurposeAnalyzer>

<StatCard>
    <Header>
        <SpellLink Spell="Items.GloriousPurpose" />
    </Header>
    <Info>
        <p>
            Casting <SpellLink Spell="Items.FatedStrike" /> grants Glorious Purpose for 6 seconds, taking
            cooldown recovery to 3&#215; for an ability with no haste contribution. These are the bonus
            reductions each ability received beyond its natural cooldown recovery.
        </p>
    </Info>
    <ChildContent>
        @if (Analyzer.RecoveryByAbility.Count == 0)
        {
            <p class="glorious-purpose-empty">No cooldowns were recovered.</p>
        }
        else
        {
            <table class="glorious-purpose-table">
                <thead>
                    <tr>
                        <th scope="col">Ability</th>
                        <th scope="col" class="glorious-purpose-recovered">Recovered</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ability in Analyzer.RecoveryByAbility)
                    {
                        <tr>
                            <td><SpellLink Spell="ability.SpellId" /></td>
                            <td class="glorious-purpose-recovered">@Seconds(ability.RecoveredMs)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</StatCard>

@code {
    private static string Seconds(int milliseconds) => $"{milliseconds / 1000d:0.0}s";
}
