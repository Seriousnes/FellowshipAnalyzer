@using FellowshipAnalyzer.Core.Analysis

<ItemThroughput Icon="heart" Accent="heal" Approximate="Approximate"
                Rate="@($"{ThroughputFormat.Rate(Throughput.PerSecond(Amount))} HPS")"
                Detail="@Detail" />

@code {
    /// <summary>The effective healing attributed to this source over the dungeon.</summary>
    [Parameter, EditorRequired] public long Amount { get; set; }

    /// <summary>The dungeon totals the rate and share are computed against.</summary>
    [CascadingParameter] public ThroughputTracker Throughput { get; set; } = null!;

    /// <summary>Marks the figure as an estimate.</summary>
    [Parameter] public bool Approximate { get; set; }

    /// <summary>Whether to append the share of the player's total healing. Defaults to <c>true</c>.</summary>
    [Parameter] public bool ShowShare { get; set; } = true;

    private string? Detail => ShowShare
        ? $"{ThroughputFormat.Share(Throughput.ShareOfHealing(Amount))} of total"
        : null;
}
