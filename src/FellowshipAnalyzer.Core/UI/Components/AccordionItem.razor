@implements IDisposable

@{
    var isExpanded = Parent?.IsExpanded(Id) == true;
    var hasAccent = BorderAccentColorVar is not null;
    var accentStyle = hasAccent ? $"--fa-supplied-accent: {BorderAccentColorVar};" : null;
}

<div class="accordion-item @(isExpanded ? "expanded" : "")">
    <button type="button"
            class="accordion-item-header @(hasAccent ? "has-accent" : "")"
            style="@accentStyle"
            aria-expanded="@isExpanded"
            @onclick="ToggleAsync">
        @Header
        <span class="accordion-item-chevron" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </span>
    </button>
    @if (isExpanded && ChildContent is not null)
    {
        <div class="accordion-item-body">
            @ChildContent
        </div>
    }
</div>

@code {
    [CascadingParameter] public Accordion? Parent { get; set; }
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>
    /// Design token reference for the left accent edge, for example a hero's <c>Hero.Color</c> or
    /// <c>HeroRoleStyles.GetAccentColorVar</c>. It feeds the design system's <c>--fa-supplied-accent</c>
    /// channel; hero identity has no semantic class, and the caller picks the token either way.
    /// </summary>
    [Parameter] public string? BorderAccentColorVar { get; set; }

    protected override void OnInitialized()
    {
        if (Parent is null)
            throw new InvalidOperationException($"{nameof(AccordionItem)} must be nested inside an {nameof(Accordion)} component.");
        Parent.Register(this);
    }

    private Task ToggleAsync() => Parent!.ToggleAsync(Id);

    public void Dispose() => Parent?.Unregister(this);
}
