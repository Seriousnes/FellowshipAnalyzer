<div class="info-tooltip" tabindex="0" role="button" aria-label="@(string.IsNullOrEmpty(Label) ? "More detail" : Label)">
    <span class="info-tooltip-wedge" aria-hidden="true"></span>
    <span class="info-tooltip-glyph" aria-hidden="true">i</span>
    <div class="info-tooltip-popover" role="tooltip">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Accessible name for the affordance. Defaults to "More detail".</summary>
    [Parameter] public string? Label { get; set; }
}
