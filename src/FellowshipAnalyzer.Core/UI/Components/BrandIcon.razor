<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 64 64"
     width="@Size"
     height="@Size"
     aria-hidden="true">
    <defs>
        <clipPath id="@(Id("bottomCrop"))" clipPathUnits="userSpaceOnUse">
            <rect x="0" y="0" width="64" height="56" />
        </clipPath>
        <clipPath id="@(Id("arcClip"))" clipPathUnits="userSpaceOnUse">
            <circle cx="32" cy="33.1" r="29.1" />
        </clipPath>
        <clipPath id="@(Id("diamondClip"))" clipPathUnits="userSpaceOnUse">
            <polygon points="42.5,0 64,0 64,64 15.1,64" />
        </clipPath>
        <linearGradient id="@(Id("arcGradientLeft"))" gradientUnits="userSpaceOnUse"
                        x1="32" y1="4" x2="8.52" y2="58">
            <stop offset="0" style="stop-color: @FaVar.BrandCream" />
            <stop offset="0.68" style="stop-color: @FaVar.BrandCream" />
            <stop offset="0.82" style="stop-color: @FaVar.BrandGold" />
            <stop offset="1" style="stop-color: @FaVar.BrandGold" />
        </linearGradient>
        <linearGradient id="@(Id("arcGradientRight"))" gradientUnits="userSpaceOnUse"
                        x1="32" y1="4" x2="55.48" y2="58">
            <stop offset="0" style="stop-color: @FaVar.BrandCream" />
            <stop offset="0.68" style="stop-color: @FaVar.BrandCream" />
            <stop offset="0.82" style="stop-color: @FaVar.BrandGold" />
            <stop offset="1" style="stop-color: @FaVar.BrandGold" />
        </linearGradient>
    </defs>
    <g clip-path="url(#@(Id("bottomCrop")))">
        <path d="M 14 54 A 27.6 27.6 0 0 1 32 5.5"
              fill="none"
              stroke="url(#@(Id("arcGradientLeft")))"
              stroke-width="3"
              stroke-linecap="butt" />
        <path d="M 32 5.5 A 27.6 27.6 0 0 1 50 54"
              fill="none"
              stroke="url(#@(Id("arcGradientRight")))"
              stroke-width="3"
              stroke-linecap="butt" />
        <circle cx="32" cy="33.1" r="29"
                fill="none"
                style="stroke: @FaVar.BrandGold"
                stroke-width="0.3" />
        <path d="M 32 4 L 55.48 58 L 47.43 58 L 32 22 L 16.57 58 L 8.52 58 Z"
              style="fill: @FaVar.BrandGold"
              clip-path="url(#@(Id("arcClip")))" />
        <polygon points="34.83,31.17 39.07,41.07 29.17,36.83 24.93,26.93"
                 style="fill: @FaVar.BrandCream"
                 clip-path="url(#@(Id("diamondClip")))" />
    </g>
</svg>

@code {
    /// <summary>Icon size in pixels. Defaults to 20.</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    private readonly string _uid = Guid.NewGuid().ToString("N")[..8];
    private string Id(string name) => $"bi-{_uid}-{name}";
}
