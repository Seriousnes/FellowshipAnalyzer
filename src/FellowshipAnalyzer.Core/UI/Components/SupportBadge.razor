@* SupportBadge — coloured pill showing a hero's support level. *@
@using FellowshipAnalyzer.Core.Analysis

<span class="support-badge support-badge--@_class" title="@_title">
    @_label
</span>

@code {
    [Parameter, EditorRequired] public SupportLevel Support { get; set; }

    private string _class = "unmaintained";
    private string _label = "Unmaintained";
    private string _title = "";

    protected override void OnParametersSet() =>
        (_class, _label, _title) = Support switch
        {
            SupportLevel.Full => ("full", "Full support", "Analysis is largely complete."),
            SupportLevel.Partial => ("partial", "Partial support", "Analysis is still being built out."),
            _ => ("unmaintained", "Unmaintained", "Analysis is absent or incomplete."),
        };
}
