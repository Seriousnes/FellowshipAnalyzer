@{
    var variantClass = Variant.ToString().ToLowerInvariant();
    var typeClass = Type.ToString().ToLowerInvariant();
    var sizeClass = Size.ToString().ToLowerInvariant();
    var classes = $"badge badge--{variantClass} badge--{typeClass} badge--{sizeClass}{(Active ? " active" : "")}";
    var styleAttr = Variant == BadgeVariant.Custom && CustomColorVar is not null
        ? $"--fa-supplied-accent: {CustomColorVar};"
        : null;
}

@if (Href is not null)
{
    <a class="@classes"
       href="@Href"
       style="@styleAttr"
       @attributes="InputAttributes">
        @ChildContent
    </a>
}
else if (OnClick.HasDelegate)
{
    <button type="button"
            class="@classes"
            aria-pressed="@Active"
            style="@styleAttr"
            @onclick="OnClick"
            @attributes="InputAttributes">
        @ChildContent
    </button>
}
else
{
    <span class="@classes"
          style="@styleAttr"
          @attributes="InputAttributes">
        @ChildContent
    </span>
}

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;
    [Parameter] public BadgeType Type { get; set; } = BadgeType.Solid;
    [Parameter] public BadgeSize Size { get; set; } = BadgeSize.Md;
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public bool Active { get; set; }
    /// <summary>
    /// Design token reference for a <see cref="BadgeVariant.Custom"/> badge, for example
    /// <c>FaVar.Ice</c>. It feeds the design system's <c>--fa-supplied-accent</c> channel, which is the one
    /// case a semantic class cannot express because the caller, not a tier, chooses the colour.
    /// </summary>
    [Parameter] public string? CustomColorVar { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> InputAttributes { get; set; } = new();
}
