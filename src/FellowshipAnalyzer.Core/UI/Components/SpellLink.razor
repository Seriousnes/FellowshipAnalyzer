@using Fellowship.SDK
@using Fellowship.SDK.Client
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Common.Spells
@using OneOf

<a href="@AbilityUrl" target="_blank" rel="noopener noreferrer" data-tooltip-path="@TooltipPath" data-tooltip-body="@_request" class="spell-link">
    @if (Icon && _icon is { Length: > 0 })
    {
        <img src="@IconUrl" class="spell-link__icon" alt="" />
    }
    @(_name ?? "Unknown Spell")
</a>

@code {
    [Parameter, EditorRequired]
    public OneOf<Spell, int, SpellbookAbility, Ability> Spell { get; set; }

    [CascadingParameter]
    public HeroName? Hero { get; set; }

    /// <summary>Whether to render the spell icon alongside the name. Defaults to <c>true</c>.</summary>
    [Parameter]
    public bool Icon { get; set; } = true;

    /// <summary>Icon size when <see cref="Icon"/> is <c>true</c>. Defaults to <see cref="SpellIconSize.Small"/>.</summary>
    [Parameter]
    public SpellIconSize IconSize { get; set; } = SpellIconSize.Small;

    private int _spellId;
    private SpellKind _kind;
    private string? _name;
    private string? _icon;
    private string? _request;

    private string AbilityUrl => Codex.PageUrl(CodexAddresses.Page(_kind.ToEntityType(_spellId), _spellId, Hero?.ToString()));

    private string? TooltipPath => _spellId > 0
        ? CodexAddresses.Tooltip(_kind.ToEntityType(_spellId), _spellId)
        : null;
    private string IconUrl => Codex.IconUrl(_icon!);

    protected override void OnParametersSet()
    {
        Spell.Switch(
            s => { _spellId = s.Id; _kind = s.FSLID.Kind; _name = s.Name; _icon = s.Icon; },
            id =>
            {
                var s = SpellRegistry.MaybeGet(id);
                if (s is not null)
                {
                    _spellId = s.Id; _kind = s.FSLID.Kind; _name = s.Name; _icon = s.Icon;
                }
                else
                {
                    FSLID fslid = id;
                    _spellId = fslid.NativeId; _kind = fslid.Kind; _name = null; _icon = null;
                }
            },
            a => { var s = a.PrimarySpell; _spellId = s.Id; _kind = s.FSLID.Kind; _name = a.Name ?? s.Name; _icon = s.Icon; },
            a => { _spellId = a.FSLID.NativeId; _kind = a.FSLID.Kind; _name = a.Name; _icon = a.Icon; }
        );

        _request = _spellId > 0 && Hero?.ToString() is { } hero
            ? _kind.ToEntityType(_spellId) switch
            {
                EntityType.Ability => TooltipBody.Write(new AbilityTooltipRequest { Hero = hero }),
                EntityType.Effect => TooltipBody.Write(new EffectTooltipRequest { Hero = hero }),
                EntityType.Enchant => TooltipBody.Write(new EnchantTooltipRequest { Hero = hero }),
                EntityType.WeaponPower => TooltipBody.Write(new WeaponPowerTooltipRequest { Hero = hero }),
                _ => null,
            }
            : null;
    }
}
