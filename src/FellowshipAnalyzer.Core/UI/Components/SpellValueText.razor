@* SpellValueText — compact stat row: small spell-icon + spell-link label above one or more values. *@
@using FellowshipAnalyzer.Core.Common.Spells
@using OneOf

<div class="spell-value-text">
    <label class="spell-value-text-label">
        <SpellIcon Spell="Spell" Size="SpellIconSize.Small" />
        <SpellLink Spell="Spell" Icon="false" />
    </label>
    <div class="spell-value-text-value">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public OneOf<Spell, int, SpellbookAbility, Ability> Spell { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
