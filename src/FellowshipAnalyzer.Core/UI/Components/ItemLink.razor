@using System.Web
@using FellowshipAnalyzer.Core.Analysis
@using OneOf

<a href="@ItemUrl" target="_blank" rel="noopener noreferrer" data-tooltip-spell-id="@TooltipSpellId" class="item-link">
    @if (Icon && _icon is { Length: > 0 })
    {
        <img src="@IconUrl" class="item-link__icon" alt="" />
    }
    @(_name ?? "Unknown Item")
</a>

@code {
    [Parameter, EditorRequired]
    public OneOf<Core.Events.Item, int> Item { get; set; }

    /// <summary>
    /// The hero whose reading of the item to link to. One item id reads as a different item per hero,
    /// so the codex answers no item without one.
    /// </summary>
    [CascadingParameter]
    public HeroName? Hero { get; set; }

    /// <summary>Whether to render the item icon alongside the name. Defaults to <c>true</c>.</summary>
    [Parameter]
    public bool Icon { get; set; } = true;

    /// <summary>Icon size when <see cref="Icon"/> is <c>true</c>. Defaults to <see cref="SpellIconSize.Small"/>.</summary>
    [Parameter]
    public SpellIconSize IconSize { get; set; } = SpellIconSize.Small;

    private int _itemId;
    private string? _name;
    private string? _icon;
    private Core.Events.Item? _equipped;

    private string LinkUri => $"item/{_itemId}";
    private string ItemUrl => Codex.PageUrl(Hero is { } hero ? $"{LinkUri}?hero={hero}" : LinkUri);
    private string? TooltipSpellId => _itemId > 0 ? Codex.TooltipPath(LinkUri, TooltipQuery()) : null;
    private string IconUrl => _equipped is { } item ? Codex.IconUrl(_icon!, item.Quality) : Codex.IconUrl(_icon!);

    protected override void OnParametersSet()
    {
        _equipped = null;
        Item.Switch(
            item => { _itemId = item.Id; _name = item.Name; _icon = item.Icon; _equipped = item; },
            id =>
            {
                var s = ItemRegistry.MaybeGet(id);
                if (s is not null)
                {
                    _itemId = s.Id; _name = s.Name; _icon = s.Icon;
                }
            }
        );
    }

    private string TooltipQuery()
    {
        var query = HttpUtility.ParseQueryString(string.Empty);

        if (Hero is { } hero)
            query["Hero"] = hero.ToString();

        if (_equipped is not { } item)
            return query.ToString()!;

        query["Rarity"] = item.Quality.ToString();
        query["ItemLevel"] = item.ItemLevel.ToString();
        query["Upgrades"] = item.Upgrades.ToString();
        query["MaxUpgrades"] = item.MaxUpgrades.ToString();

        if (item.Gem is { } gem)
            query["Gem"] = gem.Id.ToString();
        else if (!item.HasGemSocket)
            query["NoSocket"] = "true";

        if (item.Attributes.Count > 0)
            query["RandomStats"] = string.Join(',', item.Attributes.Select(a => a.Name));

        if (item.Traits.Count > 0)
            query["ImbuedTraits"] = string.Join(',', item.Traits.Select(t => $"{t.Id}:{t.Rank}"));

        if (item.Blessings.Count > 0)
            query["Modifiers"] = string.Join(',', item.Blessings.Select(b => $"blessing:{b.Id}:{b.Level}"));

        return query.ToString()!;
    }
}
