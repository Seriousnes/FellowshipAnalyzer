@using Fellowship.SDK
@using Fellowship.SDK.Client
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Common.Spells
@using OneOf

<a href="@ItemUrl" target="_blank" rel="noopener noreferrer" data-tooltip-path="@TooltipPath" data-tooltip-body="@_request" class="item-link">
    @if (Icon && _icon is { Length: > 0 })
    {
        <img src="@IconUrl" class="item-link__icon" alt="" />
    }
    @(_name ?? "Unknown Item")
</a>

@code {
    [Parameter, EditorRequired]
    public OneOf<Core.Events.Item, int> Item { get; set; }

    /// <summary>
    /// The hero the item is read for. One item id reads as a different item per hero,
    /// so the codex answers no item without one.
    /// </summary>
    [CascadingParameter]
    public HeroName? Hero { get; set; }

    /// <summary>Whether to render the item icon alongside the name. Defaults to <c>true</c>.</summary>
    [Parameter]
    public bool Icon { get; set; } = true;

    /// <summary>Icon size when <see cref="Icon"/> is <c>true</c>. Defaults to <see cref="SpellIconSize.Small"/>.</summary>
    [Parameter]
    public SpellIconSize IconSize { get; set; } = SpellIconSize.Small;

    private int _itemId;
    private string? _name;
    private string? _icon;
    private Core.Events.Item? _equipped;
    private string? _request;

    private string ItemUrl => Codex.PageUrl(CodexAddresses.Page(EntityType.Item, _itemId, Hero?.ToString()));
    private string? TooltipPath => _itemId > 0 ? CodexAddresses.Tooltip(EntityType.Item, _itemId) : null;
    private string IconUrl => _equipped is { } item ? Codex.IconUrl(_icon!, item.Quality) : Codex.IconUrl(_icon!);

    protected override void OnParametersSet()
    {
        _equipped = null;
        Item.Switch(
            item => { _itemId = item.Id; _name = item.Name; _icon = item.Icon; _equipped = item; },
            id =>
            {
                var s = ItemRegistry.MaybeGet(id);
                if (s is not null)
                {
                    _itemId = s.Id; _name = s.Name; _icon = s.Icon;
                }
            }
        );

        _request = _itemId > 0
            ? TooltipBody.Write(_equipped is { } worn ? ItemTooltip.For(worn, Hero) : ItemTooltip.For(Hero))
            : null;
    }
}
