<ul class="aura-checklist">
    @foreach (var item in Items)
    {
        <li class="aura-checklist-row @(item.Pass ? "pass" : "fail")">
            <PassFailCheckmark Pass="@item.Pass" Size="15"
                               Title="@(item.Pass ? "Had aura at the cast" : "Missing at the cast")" />
            <span class="aura-checklist-name">
                <SpellLink Spell="@item.Spell" />
            </span>
            @if (item.Count is > 1)
            {
                <span class="aura-checklist-count" title="@item.CountTooltip">&times;@item.Count</span>
            }
            @if (!string.IsNullOrWhiteSpace(item.Note))
            {
                <span class="aura-checklist-note">@item.Note</span>
            }
        </li>
    }
</ul>

@code {
    /// <summary>The lines to render, in the order they are given. Never reorder by pass or fail: a list
    /// whose rows move between casts cannot be read across casts.</summary>
    [Parameter, EditorRequired] public IEnumerable<AuraCheckItem> Items { get; set; } = [];
}
