@{
    var variantClass = Variant.ToString().ToLowerInvariant();
    var fillClass = Fill switch
    {
        TipBoxFill.Tint => " tip-box-tint",
        TipBoxFill.Solid => " tip-box-solid",
        _ => "",
    };
    var titleClass = string.IsNullOrEmpty(Title) ? " tip-box-untitled" : "";
    var classes = $"tip-box {variantClass}{fillClass}{titleClass}";
    var role = Variant is TipBoxVariant.Warning or TipBoxVariant.Error ? "alert" : "note";
    var styleAttr = Background is not null ? $"--fa-supplied-accent: {Background};" : null;
}

<div class="@classes" role="@role" style="@styleAttr">
    @if (!HideIcon)
    {
        <span class="tip-box-icon" aria-hidden="true">
            @if (Icon is not null)
            {
                @Icon
            }
            else
            {
                <Glyph Name="@DefaultGlyph(Variant)" />
            }
        </span>
    }
    <div class="tip-box-body">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="tip-box-title">@Title</div>
        }
        <div class="tip-box-content">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public TipBoxVariant Variant { get; set; } = TipBoxVariant.Info;
    [Parameter] public bool HideIcon { get; set; }

    /// <summary>How much of the accent colour the background shows. Defaults to <see cref="TipBoxFill.None"/>.</summary>
    [Parameter] public TipBoxFill Fill { get; set; }

    /// <summary>
    /// Design token reference that replaces the variant's accent colour, for example <c>FaVar.HeroRime</c>.
    /// It feeds the design system's <c>--fa-supplied-accent</c> channel and colours the left edge, the
    /// tint and the solid fill alike.
    /// </summary>
    [Parameter] public string? Background { get; set; }

    private static string DefaultGlyph(TipBoxVariant v) => v switch
    {
        TipBoxVariant.Info => "info-circle",
        TipBoxVariant.Note => "edit",
        TipBoxVariant.Success => "check",
        TipBoxVariant.Warning => "alert-triangle",
        TipBoxVariant.Error => "alert-circle",
        _ => "info-circle",
    };
}
