<section class="section @(_scope.HasContent ? "" : "inactive")">
    <button type="button" class="section-header" @onclick="Toggle"
            aria-expanded="@CurrentExpanded.ToString().ToLowerInvariant()">
        <span class="section-title">@Title</span>
        <span class="section-chevron @(CurrentExpanded ? "expanded" : "")" aria-hidden="true">▼</span>
    </button>
    <div class="section-body @(CurrentExpanded ? "" : "collapsed")">
        <CascadingValue Value="_scope" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Expanded state, defaulting to true. On its own it seeds the initial state and the section owns
    /// the toggle from then on. Paired with <see cref="ExpandedChanged"/> the caller owns the state and
    /// two-way binding applies.
    /// </summary>
    [Parameter] public bool Expanded { get; set; } = true;

    /// <summary>Raised on toggle. Supplying it puts the caller in control of <see cref="Expanded"/>.</summary>
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    private bool _expanded;
    private bool _initialized;

    private SectionScope _scope = null!;

    private bool CurrentExpanded => ExpandedChanged.HasDelegate ? Expanded : _expanded;

    protected override void OnInitialized() => _scope = new SectionScope(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _expanded = Expanded;
            _initialized = true;
        }
    }

    private Task Toggle()
    {
        if (ExpandedChanged.HasDelegate)
        {
            return ExpandedChanged.InvokeAsync(!Expanded);
        }

        _expanded = !_expanded;
        return Task.CompletedTask;
    }
}
