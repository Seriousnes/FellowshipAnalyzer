@* FilterBadge — clickable performance-distribution badge with active/disabled state. *@

@{
    var color = Disabled ? "#c8c8c8" : PerformanceColors.ToColor(Performance);
    var label = Label ?? PerformanceColors.ToLabel(Performance);
    var borderColor = Disabled ? "rgba(255,255,255,0.1)"
        : Active ? color + "60"
        : "rgba(255,255,255,0.08)";
    var bg = Disabled ? "rgba(255,255,255,0.04)"
        : Active ? color + "08"
        : "rgba(0,0,0,0.2)";
    var opacity = Disabled || !Active ? "0.4" : "1";
}

<button type="button"
        class="filter-badge @(Active ? "active" : "") @(Disabled ? "disabled" : "")"
        style="border-color: @borderColor; background: @bg; opacity: @opacity;"
        disabled="@Disabled"
        @onclick="HandleClick">
    <span class="filter-badge-count" style="color: @color;">@Count</span>
    <span class="filter-badge-divider" style="background: @(color)40;"></span>
    <span class="filter-badge-label">@label</span>
</button>

@code {
    [Parameter, EditorRequired] public QualitativePerformance Performance { get; set; }
    [Parameter, EditorRequired] public int Count { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public EventCallback<QualitativePerformance> OnClick { get; set; }

    private Task HandleClick() => OnClick.InvokeAsync(Performance);
}
