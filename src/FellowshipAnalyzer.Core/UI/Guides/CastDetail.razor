@{
    var filteredCasts = _filteredCasts;
    var filteredCount = filteredCasts.Count;
    var validIndex = Math.Min(_currentIndex, Math.Max(0, filteredCount - 1));
    var currentCast = filteredCount > 0 ? filteredCasts[validIndex] : null;
    var originalIndex = currentCast is not null ? _allCasts.IndexOf(currentCast) : -1;
    var castColor = currentCast is not null
        ? PerformanceColors.ToColor(currentCast.Performance)
        : FaVar.Stone;
    var rectWidthPct = Math.Max(100.0 / Math.Max(filteredCount, 5), 100.0 / 30);
}

<GuideDataWrapper Bare="true" Title="@Title" Subtitle="Cast Details">
    <Stats>
        <PerfBadgeGrid>
            @foreach (var (tier, label) in _perfLevels)
            {
                var count = _perfCounts.GetValueOrDefault(tier);
                var disabled = count == 0;
                var active = !disabled && _performanceFilter.Contains(tier);

                <FilterBadge Performance="@tier" Count="@count" Label="@label"
                             Active="@active" Disabled="@disabled" OnClick="ToggleFilter" />
            }
        </PerfBadgeGrid>
    </Stats>
    <StatsHelperText>
        <span class="helper-text">Click a filter to show only those casts</span>
    </StatsHelperText>
    <HelperText>
        @if (!string.IsNullOrEmpty(Description))
        {
            <span class="helper-text">@Description</span>
        }
    </HelperText>
    <ChildContent>
        @if (filteredCount == 0)
        {
            <div class="no-results">
                <div class="no-results-title">No casts match the current filter</div>
                <div class="no-results-hint">Click the performance badges above to toggle filters</div>
            </div>
        }
        else
        {
            <div class="card-container" tabindex="0" @onkeydown="HandleKeyDown">
                <div class="timeline-row">
                    <div class="timeline-rect-container">
                        @for (var i = 0; i < filteredCount; i++)
                        {
                            @Rect(i, filteredCasts, validIndex, $"width: calc({rectWidthPct.ToString("F1")}% - 3px);")
                        }
                    </div>
                </div>

                <div class="cast-card">
                    <div class="card-header">
                        <button class="nav-btn" disabled="@(validIndex == 0)" @onclick="HandlePrevious">
                            <svg class="nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="15 6 9 12 15 18" />
                            </svg>
                            <span class="nav-divider-v"></span>
                            <span class="nav-label">Prev</span>
                        </button>

                        <div class="cast-meta">
                            @if (currentCast!.GroupContent is not null)
                            {
                                <div class="cast-group">@currentCast.GroupContent</div>
                                <span class="cast-header-divider"></span>
                            }
                            else if (!string.IsNullOrEmpty(currentCast.Group))
                            {
                                <span class="cast-group-banner">@currentCast.Group</span>
                                <span class="cast-header-divider"></span>
                            }
                            <span class="cast-label">Cast @(originalIndex + 1) / @filteredCount · @currentCast.Timestamp</span>
                        </div>

                        <button class="nav-btn" disabled="@(validIndex == filteredCount - 1)" @onclick="HandleNext">
                            <span class="nav-label">Next</span>
                            <span class="nav-divider-v"></span>
                            <svg class="nav-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 6 15 12 9 18" />
                            </svg>
                        </button>
                    </div>

                    <div class="stats-grid" style="margin-bottom: 10px;">
                        @foreach (var stat in currentCast.Stats)
                        {
                            var statColor = stat.Performance.HasValue
                                ? PerformanceColors.ToColor(stat.Performance.Value)
                                : castColor;

                            <StatTile Color="@statColor" Value="@stat.Value" Label="@stat.Label" Tooltip="@stat.Tooltip" />
                        }
                    </div>

                    @if (currentCast.Sequence is { Length: > 0 })
                    {
                        @RenderAdditionalBlock("Cast Sequence", @<SpellSequence Casts="@currentCast.Sequence" />)
                    }

                    @if (currentCast.AdditionalContent is not null)
                    {
                        @RenderAdditionalBlock(currentCast.AdditionalContent.Title, currentCast.AdditionalContent.Content)
                    }

                    @if (currentCast.Details is not null)
                    {
                        <div class="details-box">
                            @currentCast.Details
                        </div>
                    }

                    <div class="accent-bar @TierClass(currentCast.Performance)"></div>
                </div>
            </div>
        }
    </ChildContent>
</GuideDataWrapper>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IEnumerable<PerCastData> Casts { get; set; } = [];
    [Parameter] public string? Description { get; set; }

    private int _currentIndex;
    private List<PerCastData> _allCasts = [];
    private List<PerCastData> _filteredCasts = [];
    private Dictionary<QualitativePerformance, int> _perfCounts = [];
    private readonly HashSet<QualitativePerformance> _performanceFilter =
    [
        QualitativePerformance.Perfect,
        QualitativePerformance.Good,
        QualitativePerformance.Ok,
        QualitativePerformance.Fail,
    ];

    private static string TierClass(QualitativePerformance tier) => tier switch
    {
        QualitativePerformance.Perfect => "perfect",
        QualitativePerformance.Good => "good",
        QualitativePerformance.Ok => "ok",
        QualitativePerformance.Fail => "fail",
        _ => "",
    };

    private static readonly (QualitativePerformance Tier, string Label)[] _perfLevels =
    [
        (QualitativePerformance.Perfect, "Perfect"),
        (QualitativePerformance.Good, "Good"),
        (QualitativePerformance.Ok, "Ok"),
        (QualitativePerformance.Fail, "Bad"),
    ];

    protected override void OnParametersSet()
    {
        _allCasts = Casts.ToList();
        _perfCounts = new Dictionary<QualitativePerformance, int>
        {
            [QualitativePerformance.Perfect] = _allCasts.Count(c => c.Performance == QualitativePerformance.Perfect),
            [QualitativePerformance.Good] = _allCasts.Count(c => c.Performance == QualitativePerformance.Good),
            [QualitativePerformance.Ok] = _allCasts.Count(c => c.Performance == QualitativePerformance.Ok),
            [QualitativePerformance.Fail] = _allCasts.Count(c => c.Performance == QualitativePerformance.Fail),
        };
        RebuildFilteredCasts();
    }

    private void RebuildFilteredCasts()
    {
        _filteredCasts = _allCasts.Where(c => _performanceFilter.Contains(c.Performance)).ToList();
    }

    private void ToggleFilter(QualitativePerformance tier)
    {
        if (!_performanceFilter.Add(tier))
            _performanceFilter.Remove(tier);

        RebuildFilteredCasts();
        _currentIndex = 0;
    }

    private void SetIndex(int index) => _currentIndex = index;

    private void HandlePrevious()
    {
        _currentIndex = _currentIndex > 0 ? _currentIndex - 1 : _filteredCasts.Count - 1;
    }

    private void HandleNext()
    {
        _currentIndex = _currentIndex < _filteredCasts.Count - 1 ? _currentIndex + 1 : 0;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft") HandlePrevious();
        else if (e.Key == "ArrowRight") HandleNext();
    }

    private static RenderFragment? RenderAdditionalBlock(string? title, RenderFragment? content)
    {
        if (content is null)
            return null;

        return @<div class="additional-content-container">
            @if (!string.IsNullOrWhiteSpace(title))
            {
                <div class="additional-content-heading">@title</div>
            }
            @content
        </div>;
    }

    private RenderFragment Rect(int idx, List<PerCastData> casts, int validIndex, string? widthStyle)
    {
        var cast = casts[idx];
        var color = PerformanceColors.ToColor(cast.Performance);
        var isActive = idx == validIndex;
        return @<button class="timeline-rect @(isActive ? "active" : "")"
                        style="@widthStyle
                               background: @(isActive ? color : $"color-mix(in srgb, {color} 55%, transparent)");
                               border-color: @(isActive ? color : "transparent");
                               @(isActive ? "outline: var(--fa-ring-width) solid var(--fa-text); outline-offset: 1px;" : "")"
                        title="Cast #@(_allCasts.IndexOf(cast) + 1) · @cast.Timestamp · @PerformanceColors.ToLabel(cast.Performance)"
                        @onclick="() => SetIndex(idx)">
                </button>;
    }
}
