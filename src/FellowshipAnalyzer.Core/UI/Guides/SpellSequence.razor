@* SpellSequence — horizontal filmstrip of spell-name text badges *@

<div class="spell-sequence">
    @foreach (var cast in Casts)
    {
        var color = cast.Performance.HasValue
            ? PerformanceColors.ToColor(cast.Performance.Value)
            : "var(--fa-border-card)";

        <span class="spell-badge @SizeClass" style="--spell-icon-border: @color;"
              title="@cast.Tooltip">
              <SpellIcon Spell="cast.Id" Size="@IconSize" />
        </span>
    }
</div>

@code {
    [Parameter] public IEnumerable<SpellCastEntry> Casts { get; set; } = [];
    [Parameter] public SpellBadgeSize Size { get; set; } = SpellBadgeSize.Medium;

    private string SizeClass => Size switch
    {
        SpellBadgeSize.Small => "badge-sm",
        SpellBadgeSize.Large => "badge-lg",
        _ => "badge-md",
    };

    private SpellIconSize IconSize => Size switch
    {
        SpellBadgeSize.Small => SpellIconSize.Small,
        SpellBadgeSize.Large => SpellIconSize.Large,
        _ => SpellIconSize.Medium,
    };
}
