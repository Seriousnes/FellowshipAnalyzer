@if (Rows.Count > 0 && Columns.Count > 0)
{
    <div class="target-breakdown">
        <table class="target-breakdown-table">
            <thead>
                <tr>
                    <th class="target-breakdown-name">@TargetColumn</th>
                    @foreach (var column in Columns)
                    {
                        <th class="target-breakdown-value">@column</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td class="target-breakdown-name">@row.Target</td>
                        @for (var i = 0; i < Columns.Count; i++)
                        {
                            <td class="target-breakdown-value">@(i < row.Values.Count ? row.Values[i] : "-")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>
    /// The leading column's header. Set it to "Ally" on a table of party members, and leave it at
    /// "Target" on a table of enemies.
    /// </summary>
    [Parameter] public string TargetColumn { get; set; } = "Target";

    /// <summary>
    /// The value column headers, in order. The leading target column is not one of these and is
    /// always rendered.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Columns { get; set; } = [];

    /// <summary>
    /// One row per target. Each row's values line up with <see cref="Columns"/> by position.
    /// </summary>
    [Parameter] public IReadOnlyList<TargetBreakdownRow> Rows { get; set; } = [];
}
