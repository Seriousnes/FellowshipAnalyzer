@* PerfBadgeCount — static performance-distribution badge (count + label, colored by tier). *@

@{
    var color = PerformanceColors.ToColor(Performance);
    var label = Label ?? PerformanceColors.ToLabel(Performance);
}

<div class="perf-badge" style="border-color: color-mix(in srgb, @color 38%, transparent);">
    <span class="perf-badge-count" style="color: @color;">@Count</span>
    <span class="perf-badge-divider" style="background: color-mix(in srgb, @color 25%, transparent);"></span>
    <span class="perf-badge-label">@label</span>
</div>

@code {
    [Parameter, EditorRequired] public QualitativePerformance Performance { get; set; }
    [Parameter, EditorRequired] public int Count { get; set; }

    /// <summary>Override the label text. Defaults to the tier name.</summary>
    [Parameter] public string? Label { get; set; }
}
