@using FellowshipAnalyzer.Core.Analysis.Gems
@inherits AnalyzerStatistic<AmethystGemAnalyzer>

<GemStatisticCard Gem="Analyzer">
    <Info>
        <p>
            Amethyst's ranks grant critical strike. Blessing of the Deathdealer is a passive multiplier with
            no events of its own, so its contribution is taken from your own crits: the logged amount already
            includes the bonus, making the share it added <em>amount &#215; bonus &#247; (1 + bonus)</em>.
        </p>
    </Info>
    <ChildContent>
        <GemTraitSection Trait="AmethystGemAnalyzer.BlessingOfTheDeathdealer" GemPower="Analyzer.GemPower"
                         Contributed="Analyzer.CriticalDamage > 0 || Analyzer.CriticalHealing > 0">
            @if (Analyzer.CriticalDamage > 0)
            {
                <ItemDamageDone Amount="Analyzer.CriticalPowerDamage" />
            }
            @if (Analyzer.CriticalHealing > 0)
            {
                <ItemHealingDone Amount="Analyzer.CriticalPowerHealing" />
            }
        </GemTraitSection>

        <GemTraitSection Trait="AmethystGemAnalyzer.ReapersReprieve" GemPower="Analyzer.GemPower"
                         Contributed="Analyzer.ReapersReprieveHealing > 0">
            <ItemHealingDone Amount="Analyzer.ReapersReprieveHealing" />
        </GemTraitSection>
    </ChildContent>
</GemStatisticCard>
