@using FellowshipAnalyzer.Core.Analysis.Gems
@inherits AnalyzerStatistic<DiamondGemAnalyzer>

<GemStatisticCard Gem="Analyzer">
    <Info>
        <p>
            Diamond's ranks grant mixed secondary stats, armor, magic damage reduction, and relic cooldown
            reduction. Harmonious Soul stacks once per nearby ally, and the log records no unbuffed
            comparison, so the measure is how long it held and how high it stacked.
        </p>
    </Info>
    <ChildContent>
        <GemTraitSection Trait="DiamondGemAnalyzer.HarmoniousSoul" GemPower="Analyzer.GemPower"
                         Contributed="Analyzer.HarmoniousSoulUptimeMs > 0">
            <span>
                @($"{Analyzer.HarmoniousSoulUptimeMs / 1000d:0.0}s")
                <small>@($"{Analyzer.HarmoniousSoulUptime:P0}") of the fight</small>
            </span>
            <span>
                @($"{Analyzer.HarmoniousSoulAverageStacks:0.0}")
                <small>average stacks</small>
            </span>
        </GemTraitSection>
    </ChildContent>
</GemStatisticCard>
