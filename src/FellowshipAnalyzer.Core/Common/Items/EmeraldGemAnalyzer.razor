@namespace FellowshipAnalyzer.Core.Analysis.Gems
@inherits Analyzer

@code {
    /// <inheritdoc/>
    public override RenderFragment? Statistic => SentinelsBastion.IsUnlocked(GemPower) ? Card : null;

    private RenderFragment Card =>
        @<GemStatisticCard Gem="this">
            <ChildContent>
                <GemTraitSection Trait="SentinelsBastion" GemPower="GemPower"
                                 Contributed="SentinelsBastionAbsorbed > 0">
                    <ItemDamageAbsorbed Amount="SentinelsBastionAbsorbed" />
                </GemTraitSection>
            </ChildContent>
        </GemStatisticCard>;
}
