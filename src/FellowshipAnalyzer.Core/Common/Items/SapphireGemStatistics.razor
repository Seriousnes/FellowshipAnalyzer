@using FellowshipAnalyzer.Core.Analysis.Gems
@inherits AnalyzerStatistic<SapphireGemAnalyzer>

<GemStatisticCard Gem="Analyzer">
    <Info>
        <p>
            Sapphire's ranks grant spirit and strengthen Heroism. Ancestral Surge raises a stat the log
            records only as already applied, so it reads as the time it held. Resonating Soul is a passive
            with no events of its own, so its figure is estimated from the health you were on for each hit
            you took.
        </p>
    </Info>
    <ChildContent>
        <GemTraitSection Trait="SapphireGemAnalyzer.AncestralSurge" GemPower="Analyzer.GemPower"
                         Contributed="Analyzer.AncestralSurgeUptimeMs > 0">
            <span>
                @($"{Analyzer.AncestralSurgeUptimeMs / 1000d:0.0}s")
                <small>@($"{Analyzer.AncestralSurgeUptime:P0}") of the fight</small>
            </span>
        </GemTraitSection>

        <GemTraitSection Trait="SapphireGemAnalyzer.ResonatingSoul" GemPower="Analyzer.GemPower"
                         Contributed="Analyzer.ResonatingSoulDamageReduced > 0">
            <ItemDamageReduced Amount="Analyzer.ResonatingSoulDamageReduced" Approximate="true" />
        </GemTraitSection>
    </ChildContent>
</GemStatisticCard>
