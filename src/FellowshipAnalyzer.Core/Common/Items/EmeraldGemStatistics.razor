@using FellowshipAnalyzer.Core.Analysis.Gems
@inherits AnalyzerStatistic<EmeraldGemAnalyzer>

<GemStatisticCard Gem="Analyzer">
    <Info>
        <p>
            Emerald's ranks grant expertise, an absorb shield, and ability cooldown reduction. The cooldown
            reduction applies to every cooldown rather than producing output of its own, so only the shield
            is measured here.
        </p>
    </Info>
    <ChildContent>
        <GemTraitSection Trait="EmeraldGemAnalyzer.SentinelsBastion" GemPower="Analyzer.GemPower"
                         Contributed="Analyzer.SentinelsBastionAbsorbed > 0">
            <ItemDamageAbsorbed Amount="Analyzer.SentinelsBastionAbsorbed" />
        </GemTraitSection>
    </ChildContent>
</GemStatisticCard>
