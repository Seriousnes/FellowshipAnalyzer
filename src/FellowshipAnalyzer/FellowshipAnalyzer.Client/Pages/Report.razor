@page "/report/{ReportCode}/{FightId:int}/{PlayerId:int}"
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events
@using FellowshipAnalyzer.Components.Timeline
@using FellowshipAnalyzer.Client.Services
@inject ReportAnalysisService AnalysisService
@inject ReportLoadingTracker LoadingTracker
@inject ReportNavigationState NavState

<PageTitle>Analysis Report</PageTitle>

<div class="analysis-page">
    <section class="hero-panel">
        <nav class="breadcrumbs" aria-label="breadcrumb">
            <a href="/report/@ReportCode">@(CurrentReport?.Title ?? ReportCode)</a>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">@Fight?.Name</span>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">@Player?.Name</span>
        </nav>
        <div class="hero-panel-body">
            <div class="encounter-block">
                @if (BossIcon is not null)
                {
                    <img class="encounter-portrait"
                         src="https://assets.rpglogs.com/img/fellowship/abilities/@BossIcon"
                         alt="@Fight?.Name"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="encounter-portrait-placeholder" style="display:none">
                        @(Fight?.Name?.Length > 0 ? Fight.Name[0].ToString() : "?")
                    </div>
                }
                else
                {
                    <div class="encounter-portrait-placeholder">
                        @(Fight?.Name?.Length > 0 ? Fight.Name[0].ToString() : "?")
                    </div>
                }
                <div class="encounter-text">
                    <h1 class="encounter-title">@Fight?.Name</h1>
                    @if (Fight?.Kill == true)
                    {
                        <span class="fight-badge kill">✓ Kill</span>
                    }
                    else if (Fight?.Kill == false)
                    {
                        <span class="fight-badge wipe">✗ Wipe</span>
                    }
                    @if (FightDuration is not null)
                    {
                        <span class="fight-duration">@FightDuration</span>
                    }
                </div>
            </div>
            <div class="player-block">
                @if (Player?.Icon is not null)
                {
                    <img class="player-portrait"
                         src="https://assets.rpglogs.com/img/fellowship/abilities/@Player.Icon"
                         alt="@Player.Name"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="player-portrait-placeholder" style="display:none">
                        @(Player.Name.Length > 0 ? Player.Name[0].ToString() : "?")
                    </div>
                }
                else
                {
                    <div class="player-portrait-placeholder">
                        @(Player?.Name?.Length > 0 ? Player.Name[0].ToString() : "?")
                    </div>
                }
                <div class="player-text">
                    <h2 class="player-title">@Player?.Name</h2>
                    @if (Player?.SubType is not null)
                    {
                        <span class="player-class-label">@Player.SubType</span>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (_isLoading)
    {
        <ReportLoadingScreen Tracker="@LoadingTracker" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="status-panel error">@_error</section>
    }
    else if (_context is not null)
    {
        <CascadingValue Value="@_context.Analyzer" IsFixed="true">
        <nav class="report-tabs">
            <button class="report-tab @(_activeTab == ReportTab.Guide ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.Guide">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
                Guide
            </button>
            <button class="report-tab @(_activeTab == ReportTab.Statistics ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.Statistics">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                Statistics
            </button>
            <button class="report-tab @(_activeTab == ReportTab.Timeline ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.Timeline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="15" y2="12"/><line x1="3" y1="18" x2="18" y2="18"/>
                </svg>
                Timeline
            </button>
            <button class="report-tab @(_activeTab == ReportTab.About ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.About">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                About
            </button>
        </nav>

        @if (_activeTab == ReportTab.Guide)
        {
            @* Guide tab — render the hero's Guide.razor via DynamicComponent *@
            <section class="guide-panel">
                <DynamicComponent Type="@_context.Analysis.GuideComponentType" />
            </section>
        }
        else if (_activeTab == ReportTab.Statistics)
        {
            @* Statistics tab — auto-collected from modules with StatisticsComponentType set *@
            @if (_context.Analysis.Statistics.Count > 0)
            {
                <section class="statistics-panel">
                    @foreach (var (module, componentType) in _context.Analysis.Statistics)
                    {
                        <CascadingValue Value="@module">
                            <DynamicComponent Type="@componentType" />
                        </CascadingValue>
                    }
                </section>
            }
            else
            {
                <section class="status-panel">No statistics available.</section>
            }
        }
        else if (_activeTab == ReportTab.Timeline)
        {
            <section class="timeline-panel">
                <Timeline Result="@_context.Analysis"
                          FightStartTime="@_context.FightStartTime"
                          FightEndTime="@_context.FightEndTime"
                          PlayerId="@PlayerId" />
            </section>
        }
        else if (_activeTab == ReportTab.About)
        {
            <section class="about-panel">
                <nav class="about-subnav">
                    <button class="about-subtab @(_aboutSubView == AboutSubView.Overview ? "about-subtab--active" : "")" @onclick="() => _aboutSubView = AboutSubView.Overview">Overview</button>
                    <button class="about-subtab @(_aboutSubView == AboutSubView.Events ? "about-subtab--active" : "")" @onclick="() => _aboutSubView = AboutSubView.Events">Events</button>
                    <button class="about-subtab @(_aboutSubView == AboutSubView.Debug ? "about-subtab--active" : "")" @onclick="() => _aboutSubView = AboutSubView.Debug">Debug Annotations</button>
                </nav>

                @if (_aboutSubView == AboutSubView.Overview)
                {
                    <div class="about-overview">
                        <dl class="about-meta">
                            <dt>Report</dt><dd>@ReportCode</dd>
                            <dt>Fight</dt><dd>@FightId</dd>
                            <dt>Player</dt><dd>@PlayerId</dd>
                            <dt>Events</dt><dd>@_context.Analysis.Events.Count total</dd>
                            <dt>Fight Duration</dt><dd>@FightDuration</dd>
                        </dl>
                        <div class="about-overview-links">
                            <button class="about-subtab" @onclick="() => _aboutSubView = AboutSubView.Events">View Events List →</button>
                            <button class="about-subtab" @onclick="() => _aboutSubView = AboutSubView.Debug">View Debug Annotations →</button>
                        </div>
                    </div>
                }
                else if (_aboutSubView == AboutSubView.Events)
                {
                    <EventsView Events="@_context.Analysis.Events" FightStartTime="@_context.FightStartTime" />
                }
                else if (_aboutSubView == AboutSubView.Debug)
                {
                    <DebugAnnotationsView DebugAnnotations="@_context.Analysis.DebugAnnotations" FightStartTime="@_context.FightStartTime" />
                }
            </section>
        }
        </CascadingValue>
    }
</div>

@code {
    private enum ReportTab { Guide, Statistics, Timeline, About }
    private enum AboutSubView { Overview, Events, Debug }

    [Parameter] public string ReportCode { get; set; } = "";
    [Parameter] public int FightId { get; set; }
    [Parameter] public int PlayerId { get; set; }

    private ReportAnalysisContext? _context;
    private FellowshipAnalyzer.Core.FellowshipLogs.ReportInfo? _previewInfo;
    private FellowshipAnalyzer.Core.FellowshipLogs.ReportFight? _previewFight;
    private FellowshipAnalyzer.Core.FellowshipLogs.ReportActor? _previewPlayer;
    private bool _isLoading = true;
    private string? _error;
    private ReportTab _activeTab = ReportTab.Guide;
    private AboutSubView _aboutSubView = AboutSubView.Overview;

    // Resolved display values — prefer confirmed context, fall back to NavState preview.
    private FellowshipAnalyzer.Core.FellowshipLogs.ReportInfo? CurrentReport => _context?.ReportInfo ?? _previewInfo;
    private FellowshipAnalyzer.Core.FellowshipLogs.ReportFight? Fight => _context?.Fight ?? _previewFight;
    private FellowshipAnalyzer.Core.FellowshipLogs.ReportActor? Player => _context?.Player ?? _previewPlayer;

    private string? BossIcon => CurrentReport?.Actors.FirstOrDefault(a =>
        !string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase)
        && string.Equals(a.Name, Fight?.Name, StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrEmpty(a.Icon))?.Icon;

    private string? FightDuration
    {
        get
        {
            if (Fight is null) return null;
            var ts = TimeSpan.FromMilliseconds(Fight.EndTime - Fight.StartTime);
            return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Pre-populate header from NavState for snappy display on normal navigation.
        // Deep-link navigations skip the report list, so NavState will be empty here.
        if (NavState.TryGet(ReportCode, out var cached) && cached is not null)
        {
            _previewInfo = cached;
            _previewFight = cached.Fights.FirstOrDefault(f => f.Id == FightId);
            _previewPlayer = cached.Actors.FirstOrDefault(a => a.Id == PlayerId);
        }

        try
        {
            _context = await AnalysisService.RunAsync(ReportCode, FightId, PlayerId);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
