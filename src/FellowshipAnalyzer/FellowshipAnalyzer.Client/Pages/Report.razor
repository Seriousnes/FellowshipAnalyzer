@page "/report/{ReportCode}/{FightId:int}/{PlayerId:int}"
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events
@using FellowshipAnalyzer.Core.FellowshipLogs
@using FellowshipAnalyzer.Components.Timeline
@using FellowshipAnalyzer.Client.Services
@using Microsoft.Extensions.DependencyInjection
@using System.Text.Json
@inject IFellowshipLogsClient FellowshipLogs
@inject JsonSerializerOptions JsonOptions
@inject IServiceProvider ServiceProvider
@inject IReportCacheService ReportCache
@inject ReportLoadingTracker LoadingTracker
@inject ReportMasterDataService MasterDataService
@inject ReportNavigationState NavState

<PageTitle>Analysis Report</PageTitle>

<div class="analysis-page">
    <section class="hero-panel">
        <nav class="breadcrumbs" aria-label="breadcrumb">
            <a href="/report/@ReportCode">@(_reportTitle ?? ReportCode)</a>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">@(_fightName ?? $"Fight {FightId}")</span>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">@(_playerName ?? $"Player {PlayerId}")</span>
        </nav>
        <div class="hero-panel-body">
            <div class="encounter-block">
                @if (_bossIcon is not null)
                {
                    <img class="encounter-portrait"
                         src="https://assets.rpglogs.com/img/fellowship/abilities/@_bossIcon"
                         alt="@_fightName"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="encounter-portrait-placeholder" style="display:none">
                        @(_fightName?.Length > 0 ? _fightName[0].ToString() : "?")
                    </div>
                }
                else
                {
                    <div class="encounter-portrait-placeholder">
                        @(_fightName?.Length > 0 ? _fightName[0].ToString() : "?")
                    </div>
                }
                <div class="encounter-text">
                    <h1 class="encounter-title">@(_fightName ?? $"Fight {FightId}")</h1>
                    @if (_fightKill == true)
                    {
                        <span class="fight-badge kill">✓ Kill</span>
                    }
                    else if (_fightKill == false)
                    {
                        <span class="fight-badge wipe">✗ Wipe</span>
                    }
                    @if (_fightDuration is not null)
                    {
                        <span class="fight-duration">@_fightDuration</span>
                    }
                </div>
            </div>
            <div class="player-block">
                @if (_playerIcon is not null)
                {
                    <img class="player-portrait"
                         src="https://assets.rpglogs.com/img/fellowship/abilities/@_playerIcon"
                         alt="@_playerName"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="player-portrait-placeholder" style="display:none">
                        @(_playerName?.Length > 0 ? _playerName[0].ToString() : "?")
                    </div>
                }
                else
                {
                    <div class="player-portrait-placeholder">
                        @(_playerName?.Length > 0 ? _playerName[0].ToString() : "?")
                    </div>
                }
                <div class="player-text">
                    <h2 class="player-title">@(_playerName ?? $"Player {PlayerId}")</h2>
                    @if (_playerClass is not null)
                    {
                        <span class="player-class-label">@_playerClass</span>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (_isLoading)
    {
        <ReportLoadingScreen Tracker="@LoadingTracker" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="status-panel error">@_error</section>
    }
    else if (_result is not null)
    {
        <CascadingValue Value="@_parser" IsFixed="true">
        <nav class="report-tabs">
            <button class="report-tab @(_activeTab == ReportTab.Guide ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.Guide">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
                Guide
            </button>
            <button class="report-tab @(_activeTab == ReportTab.Statistics ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.Statistics">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                Statistics
            </button>
            <button class="report-tab @(_activeTab == ReportTab.Timeline ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.Timeline">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="15" y2="12"/><line x1="3" y1="18" x2="18" y2="18"/>
                </svg>
                Timeline
            </button>
            <button class="report-tab @(_activeTab == ReportTab.About ? "report-tab--active" : "")" @onclick="() => _activeTab = ReportTab.About">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                About
            </button>
        </nav>

        @if (_activeTab == ReportTab.Guide)
        {
            @* Guide tab — render the hero's Guide.razor via DynamicComponent *@
            <section class="guide-panel">
                <DynamicComponent Type="@_result.GuideComponentType" />
            </section>
        }
        else if (_activeTab == ReportTab.Statistics)
        {
            @* Statistics tab — auto-collected from modules with StatisticsComponentType set *@
            @if (_result.Statistics.Count > 0)
            {
                <section class="statistics-panel">
                    @foreach (var (module, componentType) in _result.Statistics)
                    {
                        <CascadingValue Value="@module">
                            <DynamicComponent Type="@componentType" />
                        </CascadingValue>
                    }
                </section>
            }
            else
            {
                <section class="status-panel">No statistics available.</section>
            }
        }
        else if (_activeTab == ReportTab.Timeline)
        {
            <section class="timeline-panel">
                <Timeline Result="@_result"
                          FightStartTime="@_fightStartTime"
                          FightEndTime="@_fightEndTime"
                          PlayerId="@PlayerId" />
            </section>
        }
        else if (_activeTab == ReportTab.About)
        {
            <section class="about-panel">
                <nav class="about-subnav">
                    <button class="about-subtab @(_aboutSubView == AboutSubView.Overview ? "about-subtab--active" : "")" @onclick="() => _aboutSubView = AboutSubView.Overview">Overview</button>
                    <button class="about-subtab @(_aboutSubView == AboutSubView.Events ? "about-subtab--active" : "")" @onclick="() => _aboutSubView = AboutSubView.Events">Events</button>
                    <button class="about-subtab @(_aboutSubView == AboutSubView.Debug ? "about-subtab--active" : "")" @onclick="() => _aboutSubView = AboutSubView.Debug">Debug Annotations</button>
                </nav>

                @if (_aboutSubView == AboutSubView.Overview)
                {
                    <div class="about-overview">
                        <dl class="about-meta">
                            <dt>Report</dt><dd>@ReportCode</dd>
                            <dt>Fight</dt><dd>@FightId</dd>
                            <dt>Player</dt><dd>@PlayerId</dd>
                            <dt>Events</dt><dd>@_result.Events.Count total</dd>
                            <dt>Fight Duration</dt><dd>@FormatDuration(_fightStartTime, _fightEndTime)</dd>
                        </dl>
                        <div class="about-overview-links">
                            <button class="about-subtab" @onclick="() => _aboutSubView = AboutSubView.Events">View Events List →</button>
                            <button class="about-subtab" @onclick="() => _aboutSubView = AboutSubView.Debug">View Debug Annotations →</button>
                        </div>
                    </div>
                }
                else if (_aboutSubView == AboutSubView.Events)
                {
                    <EventsView Events="@_result.Events" FightStartTime="@_fightStartTime" />
                }
                else if (_aboutSubView == AboutSubView.Debug)
                {
                    <DebugAnnotationsView DebugAnnotations="@_result.DebugAnnotations" FightStartTime="@_fightStartTime" />
                }
            </section>
        }
        </CascadingValue>
    }
</div>

@code {
    private enum ReportTab { Guide, Statistics, Timeline, About }
    private enum AboutSubView { Overview, Events, Debug }

    [Parameter] public string ReportCode { get; set; } = "";
    [Parameter] public int FightId { get; set; }
    [Parameter] public int PlayerId { get; set; }

    private HeroAnalysisResult? _result;
    private bool _isLoading = true;
    private string? _error;
    private ReportTab _activeTab = ReportTab.Guide;
    private AboutSubView _aboutSubView = AboutSubView.Overview;
    private int _fightStartTime;
    private int _fightEndTime;
    private string? _pendingCacheEventsJson;
    private CombatLogParser? _parser;

    private string? _reportTitle;
    private string? _fightName;
    private bool? _fightKill;
    private string? _fightDuration;
    private string? _bossIcon;
    private string? _playerName;
    private string? _playerClass;
    private string? _playerIcon;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LoadingTracker.Reset();
            LoadingTracker.FetchEventsState = ReportLoadingTracker.StepState.Loading;
            await Task.Yield();

            var preloadTask = FellowshipLogs.AnalysisPreload.GetAsync(ReportCode);

            // Check cache before hitting the events API
            string? cachedEventsJson = null; //await ReportCache.GetCachedEventsJsonAsync(ReportCode, FightId, PlayerId);
            List<Event> events;

            if (cachedEventsJson is not null)
            {
                LoadingTracker.FetchEventsState = ReportLoadingTracker.StepState.Ok;
                LoadingTracker.DeserializeState = ReportLoadingTracker.StepState.Loading;
                await Task.Yield();

                events = JsonSerializer.Deserialize<List<Event>>(cachedEventsJson, JsonOptions) ?? [];
            }
            else
            {
                var eventsRequest = new FellowshipLogsEventsRequest(ReportCode, PlayerId, FightId);
                var result = await FellowshipLogs.Events.GetAsync(eventsRequest);

                LoadingTracker.FetchEventsState = ReportLoadingTracker.StepState.Ok;
                LoadingTracker.DeserializeState = ReportLoadingTracker.StepState.Loading;
                await Task.Yield();

                events = [.. result.Events];

                // Only cache completed fights; serialize just the events array (not the wrapper)
                if (!result.InProgress)
                {
                    _pendingCacheEventsJson = JsonSerializer.Serialize(result.Events, JsonOptions);
                }
            }

            var preload = await preloadTask;
            var reportInfo = preload.ReportInfo;
            MasterDataService.Load(preload.MasterData);

            var fight = reportInfo.Fights.FirstOrDefault(f => f.Id == FightId)
                ?? throw new InvalidOperationException($"Fight {FightId} not found in report.");

            NavState.Set(ReportCode, reportInfo);
            _reportTitle = reportInfo.Title;
            _fightName = fight.Name;
            _fightKill = fight.Kill;
            var durationMs = fight.EndTime - fight.StartTime;
            var ts = TimeSpan.FromMilliseconds(durationMs);
            _fightDuration = ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
            var bossActor = reportInfo.Actors.FirstOrDefault(a =>
                !string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase)
                && string.Equals(a.Name, fight.Name, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrEmpty(a.Icon));
            _bossIcon = bossActor?.Icon;
            var playerActor = reportInfo.Actors.FirstOrDefault(a => a.Id == PlayerId);
            _playerName = playerActor?.Name;
            _playerClass = playerActor?.SubType;
            _playerIcon = playerActor?.Icon;

            LoadingTracker.DeserializeState = ReportLoadingTracker.StepState.Ok;
            await Task.Yield();

            var heroId = MasterDataService.GetHeroId(PlayerId)
                ?? throw new InvalidOperationException($"Could not determine hero for player {PlayerId}.");
            var analyzer = ServiceProvider.GetKeyedService<IHeroAnalyzer>(heroId)
                ?? throw new InvalidOperationException($"No hero analyzer found for '{heroId}'.");

            _fightStartTime = (int)fight.StartTime;
            _fightEndTime = (int)fight.EndTime;
            _parser = (CombatLogParser)analyzer;
            _parser.ActorNames = reportInfo.Actors.ToDictionary(a => a.Id, a => a.Name);
            _result = await _parser.Analyze(events, PlayerId, _fightStartTime);

            LoadingTracker.PrepareDisplayState = ReportLoadingTracker.StepState.Loading;
            await Task.Yield();

            // Persist to cache now that we have fight metadata
            if (_pendingCacheEventsJson is not null)
            {
                var actor = reportInfo.Actors.FirstOrDefault(a => a.Id == PlayerId);
                var entry = new ReportHistoryEntry(
                    ReportCode, FightId, PlayerId,
                    fight.Name, actor?.Name, heroId,
                    DateTimeOffset.UtcNow);
                await ReportCache.CacheAsync(entry, _pendingCacheEventsJson);
                _pendingCacheEventsJson = null;
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatDuration(int startMs, int endMs)
    {
        var totalSec = (endMs - startMs) / 1000;
        var min = totalSec / 60;
        var sec = totalSec % 60;
        return $"{min}:{sec:D2}";
    }
}
