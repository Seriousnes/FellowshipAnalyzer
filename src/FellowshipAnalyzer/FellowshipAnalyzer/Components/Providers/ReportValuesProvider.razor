@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events
@using FellowshipAnalyzer.Core.UI
@using FellowshipAnalyzer.Services

<CascadingValue Value="@Context.Analyzer" IsFixed="true">
    <CascadingValue Value="@(((CombatLogParser)Context.Analyzer).ThroughputTracker)" IsFixed="true">
        <CascadingValue Value="@(((CombatLogParser)Context.Analyzer).Hero?.Name)" IsFixed="true">
            <CascadingValue Value="@(new DungeonTimeContext(Context.DungeonStartTime, Context.DungeonEndTime))" IsFixed="true">
                <CascadingValue Value="@Context.Analysis">
                    <CascadingValue Value="@SelectedPull" Name="SelectedPull">
                        @ChildContent
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public ReportAnalysisContext Context { get; set; } = null!;

    [Parameter]
    public PullStartEvent? SelectedPull { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; } = null!;
}