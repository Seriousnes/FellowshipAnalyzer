@page "/report/{ReportCode}"
@page "/report/{ReportCode}/{FightId:int}"
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.FellowshipLogs
@using FellowshipAnalyzer.Core.UI
@using FellowshipAnalyzer.Core.UI.Components
@using CoreReportInfo = FellowshipAnalyzer.Core.FellowshipLogs.ReportInfo
@using FellowshipAnalyzer.Services
@inject FellowshipLogsApiClient FellowshipLogs
@inject ReportNavigationState NavState
@inject NavigationManager Navigation

<PageTitle>@(!string.IsNullOrWhiteSpace(_report?.Title) ? _report.Title : "Fellowship Analyzer")</PageTitle>

<div class="analysis-page">
    <PageHeader Title="@(_report?.Title ?? "")">
        <Eyebrow>Combat Report</Eyebrow>
        <Subtitle>Select a fight and player to analyze.</Subtitle>
    </PageHeader>

    @if (_isLoading)
    {
        <section class="status-panel">Loading report data...</section>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="status-panel error">@_error</section>
    }
    else if (_report is not null)
    {
        <section class="fights-section">
            <ButtonGroup TValue="bool" Options="_viewOptions" @bind-Value="ByPlayer" />

            @if (!ByPlayer)
            {
                @foreach (var group in GetFightGroups())
                {
                    var groupHasExpandedFight = _expandedFightId is { } expandedFightId && group.Value.Any(f => f.Id == expandedFightId);
                    <div class="encounter-group @(groupHasExpandedFight ? "selected" : "")">
                        <div class="encounter-header">
                            @{
                                var bossIcon = _bossIconByName.TryGetValue(group.Key, out var ic) ? ic : null;
                                var bossIconUrl = bossIcon is not null ? $"https://assets.rpglogs.com/img/fellowship/abilities/{bossIcon}" : null;
                                var dungeonIconUrl = group.Value.Count > 0 ? group.Value[0].DungeonIconUrl : null;
                                var firstLetter = group.Key.Length > 0 ? group.Key[0].ToString() : "?";
                            }
                            <Avatar Size="AvatarSize.Md"
                                    Src="@(bossIconUrl ?? dungeonIconUrl)"
                                    Alt="@group.Key"
                                    FallbackText="@firstLetter"
                                    AccentColorVar="var(--fa-gold)" />
                            <h3 class="encounter-name">@group.Key</h3>
                        </div>
                        <div class="attempts-row">
                            @{ int wipeIndex = 0; }
                            @foreach (var fight in group.Value)
                            {
                                var isKill = fight.Kill == true;
                                if (!isKill) wipeIndex++;
                                var isExpanded = _expandedFightId == fight.Id;
                                var variant = isKill ? BadgeVariant.Success : BadgeVariant.Failure;
                                var capturedFightId = fight.Id;
                                var capturedIsExpanded = isExpanded;
                                <Badge Variant="variant" Active="isExpanded" OnClick="@(() => _expandedFightId = capturedIsExpanded ? null : capturedFightId)">
                                    @if (isKill)
                                    {
                                        <Glyph Name="check" />
                                        <span>@FormatDuration(fight.EndTime - fight.StartTime)</span>
                                    }
                                    else
                                    {
                                        <Glyph Name="skull" />
                                        <span>Wipe @wipeIndex</span>
                                        @if (fight.FightPercentage is { } pct)
                                        {
                                            <span class="pill-pct">@pct.ToString("F2")%</span>
                                        }
                                        <span>@FormatDuration(fight.EndTime - fight.StartTime)</span>
                                    }
                                </Badge>
                            }
                        </div>
                        @if (_expandedFightId is { } expandedId && group.Value.Any(f => f.Id == expandedId))
                        {
                            var expandedFight = group.Value.First(f => f.Id == expandedId);
                            var players = GetPlayersForFight(expandedFight).ToList();
                            var tankCount = players.Count(p => GetRole(p.SubType) == HeroRole.Tank);
                            var healCount = players.Count(p => GetRole(p.SubType) == HeroRole.Healer);
                            var dpsCount = players.Count(p => GetRole(p.SubType) == HeroRole.Dps);
                            <div class="player-grid">
                                <div class="role-counts">
                                    <Glyph Name="shield" /> @tankCount Tank&nbsp;&nbsp;
                                    <Glyph Name="heart" /> @healCount Healer&nbsp;&nbsp;
                                    <Glyph Name="bolt" /> @dpsCount DPS
                                </div>
                                @foreach (var player in players.OrderBy(p => GetRole(p.SubType)).ThenBy(p => p.Name))
                                {
                                    var hasHero = Hero.TryParse(player.SubType, out var playerHero);
                                    var accent = hasHero ? playerHero.Color : HeroRoleStyles.GetAccentColorVar(GetRole(player.SubType));
                                    <a class="player-card"
                                       href="/report/@ReportCode/@expandedId/@player.Id"
                                       style="border-left-color: @accent">
                                        @if (hasHero)
                                        {
                                            <Avatar Size="AvatarSize.Sm" Src="@playerHero.IconUrl" Alt="@player.Name" FallbackText="@FirstLetter(player.Name)" AccentColorVar="@playerHero.Color" />
                                        }
                                        else
                                        {
                                            <Avatar Size="AvatarSize.Sm" FallbackText="@FirstLetter(player.Name)" />
                                        }
                                        <div class="player-info">
                                            <span class="player-name" style="@(hasHero ? $"color: {playerHero.Color}" : null)">@player.Name</span>
                                            <span class="player-class">@(player.SubType ?? "Unknown")</span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <Accordion @bind-ExpandedId="_expandedPlayerIdStr">
                    @foreach (var player in GetSortedPlayers())
                    {
                        var hasHero = Hero.TryParse(player.SubType, out var playerHero);
                        var accent = hasHero ? playerHero.Color : HeroRoleStyles.GetAccentColorVar(GetRole(player.SubType));
                        var playerFights = _report.Fights.Where(f => f.FriendlyPlayers?.Contains(player.Id) == true).ToList();
                        <AccordionItem Id="@($"player-{player.Id}")" BorderAccentColorVar="@accent">
                            <Header>
                                @if (hasHero)
                                {
                                    <Avatar Size="AvatarSize.Sm" Src="@playerHero.IconUrl" Alt="@player.Name" FallbackText="@FirstLetter(player.Name)" AccentColorVar="@playerHero.Color" />
                                }
                                else
                                {
                                    <Avatar Size="AvatarSize.Sm" FallbackText="@FirstLetter(player.Name)" />
                                }
                                <div class="player-info">
                                    <span class="player-name" style="@(hasHero ? $"color: {playerHero.Color}" : null)">@player.Name</span>
                                    <span class="player-class">@(player.SubType ?? "Unknown")</span>
                                </div>
                            </Header>
                            <ChildContent>
                                <div class="player-accordion-fights">
                                    @foreach (var fight in playerFights)
                                    {
                                        var isKill = fight.Kill == true;
                                        var variant = isKill ? BadgeVariant.Success : BadgeVariant.Failure;
                                        <Badge Variant="variant" Size="BadgeSize.Sm" Href="@($"/report/{ReportCode}/{fight.Id}/{player.Id}")">
                                            @if (isKill)
                                            {
                                                <Glyph Name="check" />
                                            }
                                            else
                                            {
                                                <Glyph Name="skull" />
                                            }
                                            @fight.Name — @FormatDuration(fight.EndTime - fight.StartTime)
                                        </Badge>
                                    }
                                </div>
                            </ChildContent>
                        </AccordionItem>
                    }
                </Accordion>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string ReportCode { get; set; } = "";
    [Parameter] public int? FightId { get; set; }

    private CoreReportInfo? _report;
    private bool _isLoading = true;
    private string? _error;
    private Dictionary<string, string?> _bossIconByName = [];
    private int? _expandedFightId;
    private string? _expandedPlayerIdStr;
    private bool _byPlayer = false;

    private static readonly IReadOnlyList<ButtonGroupOption<bool>> _viewOptions =
    [
        new(false, "By Fight"),
        new(true, "By Player"),
    ];

    private bool ByPlayer
    {
        get => _byPlayer;
        set
        {
            if (_byPlayer == value) return;
            _byPlayer = value;
            if (value)
                _expandedFightId = null;
            else
                _expandedPlayerIdStr = null;
        }
    }

    protected override void OnInitialized()
    {
        if (!NavState.TryGet(ReportCode, out _report) || _report is null)
            return;

        _bossIconByName = _report.Actors
            .Where(a => !string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase))
            .Where(a => !string.IsNullOrEmpty(a.Icon))
            .GroupBy(a => a.Name)
            .ToDictionary(g => g.Key, g => g.First().Icon, StringComparer.OrdinalIgnoreCase);
        SetInitialExpandedFight();
        _isLoading = false;
    }

    protected override async Task OnInitializedAsync()
    {
        if (_report is not null) return;

        try
        {
            _report = (await FellowshipLogs.GetAnalysisPreloadAsync(ReportCode)).ReportInfo;
            NavState.Set(ReportCode, _report);
            _bossIconByName = _report.Actors
                .Where(a => !string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase))
                .Where(a => !string.IsNullOrEmpty(a.Icon))
                .GroupBy(a => a.Name)
                .ToDictionary(g => g.Key, g => g.First().Icon, StringComparer.OrdinalIgnoreCase);
            SetInitialExpandedFight();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Dictionary<string, List<ReportFight>> GetFightGroups()
    {
        var groups = new Dictionary<string, List<ReportFight>>(StringComparer.OrdinalIgnoreCase);
        foreach (var fight in _report!.Fights)
        {
            if (!groups.TryGetValue(fight.Name, out var list))
            {
                list = [];
                groups[fight.Name] = list;
            }
            list.Add(fight);
        }
        return groups;
    }

    private IEnumerable<ReportActor> GetSortedPlayers()
    {
        if (_report is null) return [];
        return _report.Actors
            .Where(a => string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => GetRole(a.SubType))
            .ThenBy(a => a.Name);
    }

    private IEnumerable<ReportActor> GetPlayersForFight(ReportFight fight)
    {
        if (_report is null) return [];

        var players = _report.Actors.Where(a =>
            string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase));

        if (fight.FriendlyPlayers is { Count: > 0 } friendlies)
            players = players.Where(a => friendlies.Contains(a.Id));

        return players;
    }

    private static HeroRole GetRole(string? subType) =>
        Hero.TryParse(subType, out var hero) ? hero.Role : HeroRole.Unknown;

    private void SetInitialExpandedFight()
    {
        if (_report is null || FightId is not { } fightId)
            return;

        if (_report.Fights.Any(f => f.Id == fightId))
            _expandedFightId = fightId;
    }

    private static string FormatDuration(double milliseconds)
    {
        var ts = TimeSpan.FromMilliseconds(milliseconds);
        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}"
            : $"{ts.Seconds}s";
    }

    private static string FirstLetter(string value) =>
        value.Length > 0 ? value[0].ToString() : "?";
}
