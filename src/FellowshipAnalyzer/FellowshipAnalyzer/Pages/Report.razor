@page "/report/{ReportCode}/{DungeonId:int}/{PlayerId:int}"
@using FellowshipAnalyzer.Components.Providers
@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.Events
@using CoreReportActor = FellowshipAnalyzer.Core.FellowshipLogs.ReportActor
@using CoreReportDungeon = FellowshipAnalyzer.Core.FellowshipLogs.ReportDungeon
@using CoreReportInfo = FellowshipAnalyzer.Core.FellowshipLogs.ReportInfo
@using FellowshipAnalyzer.Core.UI.Deaths
@using FellowshipAnalyzer.Core.UI.Icons
@using FellowshipAnalyzer.Core.UI.Timeline
@using FellowshipAnalyzer.Services
@inject ReportAnalysisService AnalysisService
@inject ReportLoadingTracker LoadingTracker
@inject ReportNavigationState NavState
@inject NavigationManager NavigationManager

<PageTitle>@PageTitleText</PageTitle>

<div class="analysis-page">
    @if (Header is { } header)
    {
        <PageHeader Title="@header.Dungeon.Name">
            <Breadcrumbs>
                <FellowshipAnalyzer.Core.UI.Components.Breadcrumbs Items="@BuildBreadcrumbs(header)" />
            </Breadcrumbs>
            <Portrait>
                <Avatar Size="AvatarSize.Xl"
                        Src="@(header.BossIconUrl ?? header.Dungeon.DungeonIconUrl)"
                        Alt="@header.Dungeon.Name"
                        FallbackText="@FirstCharacter(header.Dungeon.Name)"
                        AccentColorVar="var(--fa-gold)" />
            </Portrait>
            <Badges>
                @if (header.Dungeon.Kill == true)
                {
                    <Badge Variant="BadgeVariant.Success" Size="BadgeSize.Sm"><Glyph Name="check" /> Kill</Badge>
                }
                else if (header.Dungeon.Kill == false)
                {
                    <Badge Variant="BadgeVariant.Failure" Size="BadgeSize.Sm"><Glyph Name="skull" /> Wipe</Badge>
                }
                <span class="dungeon-duration">@header.DungeonDuration</span>
            </Badges>
            <Secondary>
                @{
                    var hasHeaderHero = Hero.TryParse(header.Player.SubType, out var headerHero);
                    var headerHeroColor = hasHeaderHero ? headerHero.Color : null;
                }
                @if (hasHeaderHero)
                {
                    <Avatar Size="AvatarSize.Lg"
                            Src="@headerHero.IconUrl"
                            Alt="@header.Player.Name"
                            FallbackText="@FirstCharacter(header.Player.Name)"
                            AccentColorVar="@headerHero.Color" />
                }
                else
                {
                    <Avatar Size="AvatarSize.Lg" FallbackText="@FirstCharacter(header.Player.Name)" />
                }
                <div class="player-text">
                    <h2 class="player-title" style="@(headerHeroColor is not null ? $"color: {headerHeroColor}" : null)">@header.Player.Name</h2>
                    @if (header.Player.SubType is not null)
                    {
                        <span class="player-class-label" style="@(headerHeroColor is not null ? $"color: {headerHeroColor}" : null)">@header.Player.SubType</span>
                    }
                </div>
            </Secondary>
        </PageHeader>
    }
    else
    {
        <ReportHeaderSkeleton />
    }

    @if (_isLoading)
    {
        <ReportLoadingScreen Tracker="@LoadingTracker" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="status-panel error">@_error</section>
    }
    else if (_context is { IsWip: true })
    {
        <WipGuide Hero="@_context.Player.SubType" />
    }
    else if (_context is { Analysis: { } analysis })
    {
        <ReportValuesProvider Context="_context" SelectedPull="@_selectedPull">
            <Tabs Variant="TabsVariant.Underline" DefaultActiveId="guide" Actions="@RenderPullFilter()">
                <TabItem Id="guide">
                    <LabelTemplate>
                        <GuideIcon /> Guide
                    </LabelTemplate>
                    <ChildContent>
                        <section class="guide-panel">
                            @if (_context.Analysis.GuideComponentType is { } guideType)
                            {
                                <DynamicComponent Type="@guideType" @key="@_selectedPull" />
                            }
                            else
                            {
                                <WipGuide Hero="@_context.Player.SubType" />
                            }
                        </section>
                    </ChildContent>
                </TabItem>
                <TabItem Id="statistics">
                    <LabelTemplate>
                        <StatisticsIcon />
                        Statistics
                    </LabelTemplate>
                    <ChildContent>
                        <StatisticsTab />
                    </ChildContent>
                </TabItem>
                <TabItem Id="deaths">
                    <LabelTemplate>
                        <DeathsIcon />
                        Deaths
                    </LabelTemplate>
                    <ChildContent>
                        <section class="deaths-panel">
                            <DeathsTab />
                        </section>
                    </ChildContent>
                </TabItem>
                <TabItem Id="timeline">
                    <LabelTemplate>
                        <TimelineIcon />
                        Timeline
                    </LabelTemplate>
                    <ChildContent>
                        <section class="timeline-panel">
                            <Timeline />
                        </section>
                    </ChildContent>
                </TabItem>
                <TabItem Id="about">
                    <LabelTemplate>
                        <AboutIcon />
                        About
                    </LabelTemplate>
                    <ChildContent>
                        <Tabs Variant="TabsVariant.Pill" @bind-ActiveId="_aboutSubViewId">
                            <TabItem Id="overview" Label="Overview">
                                <Overview ReportCode="@ReportCode"
                                          DungeonId="@DungeonId"
                                          PlayerId="@PlayerId"
                                          OnViewEvents='@(() => _aboutSubViewId = "events")'
                                          OnViewDebugAnnotations='@(() => _aboutSubViewId = "debug")' />
                            </TabItem>
                            <TabItem Id="events" Label="Events">
                                <EventsView Events="@_context.Analysis.Events" />
                            </TabItem>
                            <TabItem Id="debug" Label="Debug Annotations">
                                <DebugAnnotationsView DebugAnnotations="@_context.Analysis.DebugAnnotations" />
                            </TabItem>
                        </Tabs>
                    </ChildContent>
                </TabItem>
            </Tabs>
        </ReportValuesProvider>

        var footerRole = Hero.TryParse(_context.Player.SubType, out var footerHero) ? footerHero.Role : HeroRole.Unknown;
        <ReportFooter ReportCode="@ReportCode"
                      DungeonId="@DungeonId"
                      SourceId="@PlayerId"
                      Role="@footerRole" />
    }
</div>

@code {
    [Parameter] public string ReportCode { get; set; } = "";
    [Parameter] public int DungeonId { get; set; }
    [Parameter] public int PlayerId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "pull")]
    public int? PullQuery { get; set; }

    private ReportAnalysisContext? _context;
    private CoreReportInfo? _reportInfo;
    private bool _isLoading = true;
    private string? _error;
    private string _aboutSubViewId = "overview";
    private PullStartEvent? _selectedPull;

    private ReportHeader? Header
    {
        get
        {
            if (_reportInfo is null)
                return null;

            var dungeon = _reportInfo.Dungeons.FirstOrDefault(f => f.Id == DungeonId);
            if (dungeon is null)
                return null;

            var player = _reportInfo.Actors.FirstOrDefault(a => a.Id == PlayerId);
            if (player is null)
                return null;

            return new ReportHeader(
                _reportInfo,
                dungeon,
                player,
                _reportInfo.FindNpcIconUrl(dungeon.Name),
                FormatDuration(dungeon.EndTime - dungeon.StartTime));
        }
    }

    protected override void OnInitialized()
    {
        if (NavState.TryGet(ReportCode, out var cached) && cached is not null)
        {
            _reportInfo = cached;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _context = await AnalysisService.RunAsync(ReportCode, DungeonId, PlayerId, UpdateReportInfoAsync);
            _reportInfo = _context.ReportInfo;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnParametersSet() => ApplyPullQuery();

    private Task UpdateReportInfoAsync(CoreReportInfo reportInfo) =>
        InvokeAsync(() =>
        {
            _reportInfo = reportInfo;
            StateHasChanged();
        });

    private void ApplyPullQuery()
    {
        if (_context is not { Analysis: not null } context)
            return;

        var resolved = PullQuery is { } number
            ? context.Analyzer.Pulls.FirstOrDefault(p => p.Index == number - 1)
            : null;

        if (ReferenceEquals(resolved, _selectedPull))
            return;

        _selectedPull = resolved;
        context.Analyzer.SelectedPull = resolved;
    }

    private void OnSelectedPullChanged(PullStartEvent? pull)
    {
        if (ReferenceEquals(pull, _selectedPull))
            return;

        _selectedPull = pull;
        if (_context is { } context)
            context.Analyzer.SelectedPull = pull;

        var uri = NavigationManager.GetUriWithQueryParameter("pull", pull?.Index + 1);
        NavigationManager.NavigateTo(uri, replace: true);
    }

    private RenderFragment? RenderPullFilter()
    {
        if (_context is not { Analysis: not null } context)
            return null;

        var dungeonPulls = context.Analyzer.Pulls.Where(p => p.Id != 0).ToList();
        if (dungeonPulls.Count == 0)
            return null;

        return @<PullSelect Pulls="dungeonPulls"
                            Value="_selectedPull"
                            ValueChanged="OnSelectedPullChanged"
                            DungeonStartTime="context.DungeonStartTime" />;
    }

    private List<BreadcrumbItem> BuildBreadcrumbs(ReportHeader header)
    {
        var items = new List<BreadcrumbItem>();
        if (!string.IsNullOrWhiteSpace(header.ReportInfo.Title))
            items.Add(new(header.ReportInfo.Title, $"/report/{ReportCode}"));
        items.Add(new(header.Dungeon.Name));
        items.Add(new(header.Player.Name));
        return items;
    }

    private static string FormatDuration(double milliseconds)
    {
        var ts = TimeSpan.FromMilliseconds(milliseconds);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
    }

    private static string FirstCharacter(string value) =>
        value.Length > 0 ? value[0].ToString() : "";

    private string PageTitleText
    {
        get
        {
            if (Header is not { } header)
                return !string.IsNullOrWhiteSpace(_reportInfo?.Title)
                    ? _reportInfo.Title
                    : "Fellowship Analyzer";

            var dungeonLabel = FormatDungeonLabel(_reportInfo!, header.Dungeon, header.DungeonDuration);
            return $"{dungeonLabel} by {header.Player.Name} in {header.ReportInfo.Title}";
        }
    }

    private static string FormatDungeonLabel(CoreReportInfo reportInfo, CoreReportDungeon dungeon, string duration)
    {
        string result;
        if (dungeon.Kill == true)
        {
            result = "Kill";
        }
        else
        {
            var wipeNumber = 0;
            foreach (var f in reportInfo.Dungeons.Where(f => string.Equals(f.Name, dungeon.Name, StringComparison.OrdinalIgnoreCase)))
            {
                if (f.Kill != true)
                    wipeNumber++;
                if (f.Id == dungeon.Id)
                    break;
            }
            result = wipeNumber > 0 ? $"Wipe {wipeNumber}" : "Wipe";
        }
        return $"{dungeon.Name} - {result} ({duration})";
    }

    private sealed record ReportHeader(
        CoreReportInfo ReportInfo,
        CoreReportDungeon Dungeon,
        CoreReportActor Player,
        string? BossIconUrl,
        string DungeonDuration);
}
