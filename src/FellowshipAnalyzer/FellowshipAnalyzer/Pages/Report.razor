@page "/report/{ReportCode}/{FightId:int}/{PlayerId:int}"
@using FellowshipAnalyzer.Components.Providers
@using FellowshipAnalyzer.Core.Analysis
@using CoreReportActor = FellowshipAnalyzer.Core.FellowshipLogs.ReportActor
@using CoreReportFight = FellowshipAnalyzer.Core.FellowshipLogs.ReportFight
@using CoreReportInfo = FellowshipAnalyzer.Core.FellowshipLogs.ReportInfo
@using FellowshipAnalyzer.Core.UI.Timeline
@using FellowshipAnalyzer.Services
@inject ReportAnalysisService AnalysisService
@inject ReportLoadingTracker LoadingTracker
@inject ReportNavigationState NavState

<PageTitle>@PageTitleText</PageTitle>

<div class="analysis-page">
    @if (Header is { } header)
    {
        <PageHeader Title="@header.Fight.Name">
            <Breadcrumbs>
                <FellowshipAnalyzer.Core.UI.Components.Breadcrumbs Items="@BuildBreadcrumbs(header)" />
            </Breadcrumbs>
            <Portrait>
                <Avatar Size="AvatarSize.Xl"
                        Src="@BossIconUrl(header.BossIcon)"
                        Alt="@header.Fight.Name"
                        FallbackText="@FirstCharacter(header.Fight.Name)" />
            </Portrait>
            <Badges>
                @if (header.Fight.Kill == true)
                {
                    <Badge Variant="BadgeVariant.Success" Size="BadgeSize.Sm">✓ Kill</Badge>
                }
                else if (header.Fight.Kill == false)
                {
                    <Badge Variant="BadgeVariant.Failure" Size="BadgeSize.Sm">✗ Wipe</Badge>
                }
                <span class="fight-duration">@header.FightDuration</span>
            </Badges>
            <Secondary>
                @{
                    var hasHeaderHero = Hero.TryParse(header.Player.SubType, out var headerHero);
                    var headerHeroColor = hasHeaderHero ? headerHero.Color : null;
                }
                @if (hasHeaderHero)
                {
                    <Avatar Size="AvatarSize.Lg"
                            Src="@headerHero.IconUrl"
                            Alt="@header.Player.Name"
                            FallbackText="@FirstCharacter(header.Player.Name)"
                            AccentColorVar="@headerHero.Color" />
                }
                else
                {
                    <Avatar Size="AvatarSize.Lg" FallbackText="@FirstCharacter(header.Player.Name)" />
                }
                <div class="player-text">
                    <h2 class="player-title" style="@(headerHeroColor is not null ? $"color: {headerHeroColor}" : null)">@header.Player.Name</h2>
                    @if (header.Player.SubType is not null)
                    {
                        <span class="player-class-label" style="@(headerHeroColor is not null ? $"color: {headerHeroColor}" : null)">@header.Player.SubType</span>
                    }
                </div>
            </Secondary>
        </PageHeader>
    }
    else
    {
        <PageHeader Title="Loading report details..." aria-busy="true">
            <Eyebrow>Combat Report</Eyebrow>
        </PageHeader>
    }

    @if (_isLoading)
    {
        <ReportLoadingScreen Tracker="@LoadingTracker" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <section class="status-panel error">@_error</section>
    }
    else if (_context is { IsWip: true })
    {
        <WipGuide Hero="@_context.Player.SubType" />
    }
    else if (_context is { Analysis: { } analysis })
    {
        <ReportValuesProvider Context="_context">
            <Tabs Variant="TabsVariant.Underline" DefaultActiveId="guide">
                <TabItem Id="guide">
                    <LabelTemplate>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="8" y1="6" x2="21" y2="6" />
                            <line x1="8" y1="12" x2="21" y2="12" />
                            <line x1="8" y1="18" x2="21" y2="18" />
                            <line x1="3" y1="6" x2="3.01" y2="6" />
                            <line x1="3" y1="12" x2="3.01" y2="12" />
                            <line x1="3" y1="18" x2="3.01" y2="18" />
                        </svg>
                        Guide
                    </LabelTemplate>
                    <ChildContent>
                        <section class="guide-panel">
                            @if (_context.Analysis.GuideComponentType is { } guideType)
                            {
                                <DynamicComponent Type="@guideType" />
                            }
                            else
                            {
                                <WipGuide Hero="@_context.Player.SubType" />
                            }
                        </section>
                    </ChildContent>
                </TabItem>
                <TabItem Id="statistics">
                    <LabelTemplate>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="18" y1="20" x2="18" y2="10" />
                            <line x1="12" y1="20" x2="12" y2="4" />
                            <line x1="6" y1="20" x2="6" y2="14" />
                        </svg>
                        Statistics
                    </LabelTemplate>
                    <ChildContent>
                        @if (_context.Analysis.Statistics.Count > 0)
                        {
                            <section class="statistics-tab">
                                @foreach (var section in _context.Analysis.Statistics
                                                            .GroupBy(entry => entry.Category)
                                                            .OrderBy(group => group.Key))
                                {
                                    <StatisticsSectionTitle Title="@section.Key.ToString()" />
                                    <div class="statistics-panel">
                                        @foreach (var entry in section.OrderBy(item => item.Order))
                                        {
                                            <CascadingValue Value="@entry.Module">
                                                <DynamicComponent Type="@entry.ComponentType" />
                                            </CascadingValue>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        else
                        {
                            <section class="status-panel">No statistics available.</section>
                        }
                    </ChildContent>
                </TabItem>
                <TabItem Id="timeline">
                    <LabelTemplate>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="3" y1="12" x2="15" y2="12" />
                            <line x1="3" y1="18" x2="18" y2="18" />
                        </svg>
                        Timeline
                    </LabelTemplate>
                    <ChildContent>
                        <section class="timeline-panel">
                            <Timeline />
                        </section>
                    </ChildContent>
                </TabItem>
                <TabItem Id="about">
                    <LabelTemplate>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        About
                    </LabelTemplate>
                    <ChildContent>
                        <Tabs Variant="TabsVariant.Pill" @bind-ActiveId="_aboutSubViewId">
                            <TabItem Id="overview" Label="Overview">
                                <div class="about-overview">
                                    <dl class="about-meta">
                                        <dt>Report</dt>
                                        <dd>@ReportCode</dd>
                                        <dt>Fight</dt>
                                        <dd>@FightId</dd>
                                        <dt>Player</dt>
                                        <dd>@PlayerId</dd>
                                        <dt>Events</dt>
                                        <dd>@_context.Analysis.Events.Count total</dd>
                                        <dt>Fight Duration</dt>
                                        <dd>@FormatDuration(_context.Fight.EndTime - _context.Fight.StartTime)</dd>
                                    </dl>
                                    <div class="about-overview-links">
                                        <Badge Variant="BadgeVariant.Gold" OnClick="@(() => _aboutSubViewId = "events")">View Events List →</Badge>
                                        <Badge Variant="BadgeVariant.Gold" OnClick="@(() => _aboutSubViewId = "debug")">View Debug Annotations →</Badge>
                                    </div>
                                </div>
                            </TabItem>
                            <TabItem Id="events" Label="Events">
                                <EventsView Events="@_context.Analysis.Events" />
                            </TabItem>
                            <TabItem Id="debug" Label="Debug Annotations">
                                <DebugAnnotationsView DebugAnnotations="@_context.Analysis.DebugAnnotations" />
                            </TabItem>
                        </Tabs>
                    </ChildContent>
                </TabItem>
            </Tabs>
        </ReportValuesProvider>
    }
</div>

@code {
    [Parameter] public string ReportCode { get; set; } = "";
    [Parameter] public int FightId { get; set; }
    [Parameter] public int PlayerId { get; set; }

    private ReportAnalysisContext? _context;
    private CoreReportInfo? _reportInfo;
    private bool _isLoading = true;
    private string? _error;
    private string _aboutSubViewId = "overview";

    private ReportHeader? Header
    {
        get
        {
            if (_reportInfo is null)
                return null;

            var fight = _reportInfo.Fights.FirstOrDefault(f => f.Id == FightId);
            if (fight is null)
                return null;

            var player = _reportInfo.Actors.FirstOrDefault(a => a.Id == PlayerId);
            if (player is null)
                return null;

            return new ReportHeader(
                _reportInfo,
                fight,
                player,
                GetBossIcon(_reportInfo, fight),
                FormatDuration(fight.EndTime - fight.StartTime));
        }
    }

    protected override void OnInitialized()
    {
        if (NavState.TryGet(ReportCode, out var cached) && cached is not null)
        {
            _reportInfo = cached;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _context = await AnalysisService.RunAsync(ReportCode, FightId, PlayerId, UpdateReportInfoAsync);
            _reportInfo = _context.ReportInfo;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task UpdateReportInfoAsync(CoreReportInfo reportInfo) =>
        InvokeAsync(() =>
        {
            _reportInfo = reportInfo;
            StateHasChanged();
        });

    private static string? GetBossIcon(CoreReportInfo reportInfo, CoreReportFight fight) =>
        reportInfo.Actors.FirstOrDefault(a =>
            !string.Equals(a.Type, "Player", StringComparison.OrdinalIgnoreCase)
            && string.Equals(a.Name, fight.Name, StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrEmpty(a.Icon))?.Icon;

    private static string? BossIconUrl(string? bossIcon) =>
        bossIcon is null ? null : $"https://assets.rpglogs.com/img/fellowship/abilities/{bossIcon}";

    private IReadOnlyList<BreadcrumbItem> BuildBreadcrumbs(ReportHeader header)
    {
        var items = new List<BreadcrumbItem>();
        if (!string.IsNullOrWhiteSpace(header.ReportInfo.Title))
            items.Add(new(header.ReportInfo.Title, $"/report/{ReportCode}"));
        items.Add(new(header.Fight.Name));
        items.Add(new(header.Player.Name));
        return items;
    }

    private static string FormatDuration(double milliseconds)
    {
        var ts = TimeSpan.FromMilliseconds(milliseconds);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.Seconds}s";
    }

    private static string FirstCharacter(string value) =>
        value.Length > 0 ? value[0].ToString() : "";

    private string PageTitleText
    {
        get
        {
            if (Header is not { } header)
                return !string.IsNullOrWhiteSpace(_reportInfo?.Title)
                    ? _reportInfo.Title
                    : "Fellowship Analyzer";

            var fightLabel = FormatFightLabel(_reportInfo!, header.Fight, header.FightDuration);
            return $"{fightLabel} by {header.Player.Name} in {header.ReportInfo.Title}";
        }
    }

    private static string FormatFightLabel(CoreReportInfo reportInfo, CoreReportFight fight, string duration)
    {
        string result;
        if (fight.Kill == true)
        {
            result = "Kill";
        }
        else
        {
            var wipeNumber = 0;
            foreach (var f in reportInfo.Fights.Where(f => string.Equals(f.Name, fight.Name, StringComparison.OrdinalIgnoreCase)))
            {
                if (f.Kill != true)
                    wipeNumber++;
                if (f.Id == fight.Id)
                    break;
            }
            result = wipeNumber > 0 ? $"Wipe {wipeNumber}" : "Wipe";
        }
        return $"{fight.Name} - {result} ({duration})";
    }

    private sealed record ReportHeader(
        CoreReportInfo ReportInfo,
        CoreReportFight Fight,
        CoreReportActor Player,
        string? BossIcon,
        string FightDuration);
}
