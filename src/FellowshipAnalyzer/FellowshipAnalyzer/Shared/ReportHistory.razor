@using FellowshipAnalyzer.Core.Analysis
@using FellowshipAnalyzer.Core.FellowshipLogs
@inject IReportCacheService ReportCache

<div class="report-history">
    <div class="report-history-header">
        <h3 class="report-history-title">Recently Viewed</h3>
        @if (_history.Count > 0)
        {
            <button type="button" class="report-history-clear" @onclick="ClearHistory">Clear history</button>
        }
    </div>
    @if (_history.Count > 0)
    {
        <ul class="report-history-list">
            @foreach (var entry in _history)
            {
                <li class="report-history-item">
                    <a href="/report/@entry.ReportCode/@entry.DungeonId/@entry.PlayerId"
                       class="report-history-link">
                        <span class="report-history-player" style="@(entry.Hero is { } hero ? $"color: {Hero.For(hero).Color}" : null)">@entry.PlayerName</span>
                        <span class="report-history-dungeon">@entry.DungeonName</span>
                        <span class="report-history-age">@FormatAge(entry.CachedAt)</span>
                    </a>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="report-history-empty">
            @if (_loaded)
            {
                <span>Reports you analyse will appear here.</span>
            }
        </div>
    }
</div>

@code {
    private const int MaxEntries = 5;

    private List<ReportHistoryEntry> _history = [];
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _history = (await ReportCache.GetHistoryAsync())
            .Where(entry => !string.IsNullOrWhiteSpace(entry.PlayerName)
                && !string.IsNullOrWhiteSpace(entry.DungeonName))
            .Take(MaxEntries)
            .ToList();
        _loaded = true;
        StateHasChanged();
    }

    private async Task ClearHistory()
    {
        await ReportCache.ClearAsync();
        _history = [];
    }

    private static string FormatAge(DateTimeOffset cachedAt)
    {
        var age = DateTimeOffset.UtcNow - cachedAt;

        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h ago";
        return $"{(int)age.TotalDays}d ago";
    }
}
