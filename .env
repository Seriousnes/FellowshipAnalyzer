# Copy this file to ".env" (kept out of git) for the tools in src/FellowshipAnalyzer.Tools.
# USER_SECRET_ID is the user-secrets store id that holds the FellowshipLogs credentials.
# It matches <UserSecretsId> in src/FellowshipAnalyzer/FellowshipAnalyzer.DevApi.
# Populate that store once with:
#   dotnet user-secrets set "FellowshipLogs:ClientId" "..."     --id <USER_SECRET_ID>
#   dotnet user-secrets set "FellowshipLogs:ClientSecret" "..." --id <USER_SECRET_ID>
USER_SECRET_ID=
